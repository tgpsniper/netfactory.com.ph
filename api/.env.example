# ============================================================
# Netfactory API — environment configuration
# ============================================================
# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# This file lists every variable the code actually reads (52 of them, verified
# by grepping process.env across src/ and scripts/). It exists because a
# previous version documented only 6, which made the repository close to
# useless as a rebuild aid: a restore would come up with payments, SMS, email
# and OLT provisioning silently dead and nothing saying why.
#
# Values here are placeholders and safe defaults. The real ones live in the DR
# backup at disaster_recovery_backups/*.tar.gz as ./app/env — that archive, not
# this file, is what restores a working server.
#
# Read the REQUIRED block before anything else. The rest have working defaults.


# ── REQUIRED — the app is unsafe or broken without these ─────
# Postgres. Restore with pg_restore from the DR backup, NEVER `prisma db push`:
# schema.prisma does not describe the 4 GENERATED balance columns or the
# trg_subscriber_account_number trigger, so a Prisma-built schema silently loses
# computed balances and stops issuing account numbers.
DATABASE_URL="postgresql://DBUSER:DBPASS@localhost:5432/DBNAME"

# Signs every admin and subscriber session token. SET THIS, always.
# Several modules still fall back to short built-in development defaults when it
# is empty. Those defaults are weak and not identical to each other, so an unset
# JWT_SECRET means tokens are both forgeable and inconsistent between modules.
# Treat an empty value as an outage, not a default.
# Generate with: openssl rand -base64 48
JWT_SECRET=""

JWT_EXPIRES_IN="24h"        # subscriber portal sessions
JWT_ADMIN_EXPIRES_IN="8h"   # CRM sessions — deliberately shorter

PORT=3001
NODE_ENV=production         # defaults to "development" if unset


# ── Public identity ──────────────────────────────────────────
# Used to build payment links, email/SMS content and CORS. Getting these wrong on
# a restored server produces links pointing at the OLD host.
DOMAIN="netfactory.com.ph"
APP_URL="https://netfactory.com.ph"
API_BASE_URL="https://netfactory.com.ph"
PUBLIC_BASE_URL="https://netfactory.com.ph"
CORS_ORIGINS="https://netfactory.com.ph"


# ── Payments (Xendit) ────────────────────────────────────────
# Without these the platform still bills but cannot collect.
XENDIT_SECRET_KEY=""
# Verifies incoming webhook callbacks. An empty value means unauthenticated
# callers can post "payment received" and clear a subscriber's balance.
XENDIT_WEBHOOK_TOKEN=""
# After restoring to a new host, repoint the webhook URL in the Xendit dashboard
# or payments will keep being delivered to the old server.

# Minutes a restricted subscriber's firewall payment window stays open.
PAYMENT_WINDOW_MIN=20

# Not implemented — placeholders only.
GCASH_API_KEY=""
MAYA_API_KEY=""


# ── SMS (Semaphore) ──────────────────────────────────────────
# Password resets and payment reminders go out over this.
SEMAPHORE_API_KEY=""
SEMAPHORE_SENDER_NAME="NETFACTORY"


# ── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE=false           # true only for implicit TLS on 465
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="Netfactory"


# ── RADIUS ───────────────────────────────────────────────────
# Shared secret for radclient self-tests. Historically hardcoded in
# src/routes/radius.js; keep it here so it never re-enters the source.
# Must match the client stanza in /etc/freeradius/clients.conf.
RADIUS_SECRET=""
# Secret for the NAS devices themselves, where it differs from the above.
NAS_RADIUS_SECRET=""
# Public IP the NAS devices are told to reach RADIUS on. The code default is an
# old AWS address left over from the J2 deployment — set this explicitly.
RADIUS_PUBLIC_IP=""
# MikroTik DHCP server name used for MAC authentication bypass.
MAB_DHCP_SERVER="dhcp1"


# ── Walled garden ────────────────────────────────────────────
# Where restricted subscribers get redirected, and the DNS responder that makes
# the captive-portal probe fire. See WALLED-GARDEN.md.
WG_PORTAL_INTERNAL="10.0.98.4"      # LAN address nginx listens on
WG_PORTAL_PUBLIC="36.50.30.102"     # public address in the router allow-list
WG_REDIRECT_PORT="8081"             # nginx vhost serving the restricted notice

GARDEN_DNS_ADDR="10.0.98.4"         # address src/services/garden-dns.js binds
GARDEN_DNS_PORT="5354"              # unprivileged; routers dst-nat :53 here
GARDEN_DNS_ANSWER="10.0.98.4"       # address returned for hijacked lookups
GARDEN_DNS_UPSTREAM="1.1.1.1"       # resolves the passthrough domains for real

# Router used for single-router restriction actions. Must be an id in
# mikrotik_devices — a stale id silently restricts nobody.
RESTRICT_ROUTER_ID=""


# ── SmartOLT (ONU provisioning) ──────────────────────────────
SMARTOLT_ENABLED=false
SMARTOLT_URL=""
SMARTOLT_SUBDOMAIN=""
SMARTOLT_API_TOKEN=""
SMARTOLT_OLT_DEVICE_ID=""


# ── Firmware upload area ─────────────────────────────────────
FW_UPLOAD_ROOT="/home/ashraf/firmware"
FW_UPLOAD_USER=""
# Code default is the literal 'CHANGE_ME_SET_FW_UPLOAD_PASS'. Set or disable.
FW_UPLOAD_PASS=""
FW_SESSION_SECRET=""        # separate from JWT_SECRET; generate independently
FW_LOCKOUT_THRESHOLD=5      # failed logins before lockout


# ── Operational ──────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX=100
AUDIT_ARCHIVE_DIR=""         # where rotated audit logs are written
PM2_APP_NAME="isp-api"       # must match the pm2 process name for self-restart

# Legacy test endpoint with a weak built-in fallback. Leave empty and keep that
# route out of production rather than setting it.
ADMIN_PASSWORD=""

# Optional developer tooling only; not needed to run the platform.
ANTHROPIC_API_KEY=""
