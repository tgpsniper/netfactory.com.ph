# ============================================
# J2 Network API - Environment Configuration
# Copy to .env and update values
# ============================================

# Database
DATABASE_URL="postgresql://DBUSER:DBPASS@localhost:5432/DBNAME"

# JWT Authentication
JWT_SECRET="change-this-to-a-long-random-string-at-least-64-chars"
JWT_EXPIRES_IN="24h"
JWT_ADMIN_EXPIRES_IN="8h"

# Server
PORT=3001
NODE_ENV=production

# Payment Gateways (add when ready)
# XENDIT_SECRET_KEY=""
# GCASH_API_KEY=""
# MAYA_API_KEY=""

# SMS Gateway (add when ready)
# SEMAPHORE_API_KEY=""
# SEMAPHORE_SENDER_NAME="J2NET"
