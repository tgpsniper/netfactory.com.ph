  id             Int             @id @default(autoincrement())
  type           String          @db.VarChar(20) // 'facebook' | 'viber' | 'gmail'
  name           String          @db.VarChar(100)
  external_id    String?         @db.VarChar(255) // fb page id / viber bot uri / gmail address
  enabled        Boolean         @default(false)
  status         String          @default("disconnected") @db.VarChar(20) // connected|disconnected|error
  status_detail  String?
  config         Json?           @default("{}")
  last_polled_at DateTime?       @db.Timestamptz(6)
  created_at     DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?       @default(now()) @db.Timestamptz(6)
  conversations  conversations[]

  @@index([type], map: "idx_message_channels_type")
}

model conversations {
  id               Int              @id @default(autoincrement())
  channel_id       Int
  external_user_id String           @db.VarChar(255)
  external_name    String?          @db.VarChar(200)
  external_avatar  String?
  subject          String?          @db.VarChar(500)
  subscriber_id    Int?
  status           String           @default("open") @db.VarChar(20) // open|pending|closed
  assigned_to      Int?
  last_message_at  DateTime?        @db.Timestamptz(6)
  last_preview     String?          @db.VarChar(280)
  last_direction   String?          @db.VarChar(3) // 'in' | 'out'
  unread_count     Int              @default(0)
  thread_ref       String?          @db.VarChar(998)
  created_at       DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?        @default(now()) @db.Timestamptz(6)
  channel          message_channels @relation(fields: [channel_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  subscriber       subscribers?     @relation(fields: [subscriber_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  admin            admin_users?     @relation(fields: [assigned_to], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messages         messages[]

  @@unique([channel_id, external_user_id], map: "uq_conversation_channel_user")
  @@index([status], map: "idx_conversations_status")
  @@index([assigned_to], map: "idx_conversations_assigned")
  @@index([subscriber_id], map: "idx_conversations_subscriber")
  @@index([last_message_at], map: "idx_conversations_last_msg")
}

model messages {
  id                  Int           @id @default(autoincrement())
  conversation_id     Int
  direction           String        @db.VarChar(3) // 'in' | 'out'
  body                String?
  attachments         Json?         @default("[]")
  external_message_id String?       @db.VarChar(998)
  status              String        @default("received") @db.VarChar(20) // received|sent|delivered|failed
  error_detail        String?
  created_by          String?       @db.VarChar(100)
  created_at          DateTime?     @default(now()) @db.Timestamptz(6)
  conversation        conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversation_id], map: "idx_messages_conversation")
  @@index([external_message_id], map: "idx_messages_external")
}


/// Prepaid top-ups: what each payment bought in service time.
/// invoice_id carries a partial unique index in SQL (WHERE invoice_id IS NOT NULL)
/// which Prisma cannot express, so the relation is modelled as a list.
model prepaid_topups {
  id             Int         @id @default(autoincrement())
  subscriber_id  Int
  invoice_id     Int?
  payment_id     Int?
  plan_id        Int?
  amount         Decimal     @db.Decimal(10, 2)
  days           Int
  expires_before DateTime?   @db.Timestamptz(6)
  expires_after  DateTime    @db.Timestamptz(6)
  source         String      @default("manual")
  created_by     String?
  created_at     DateTime    @default(now()) @db.Timestamptz(6)
  subscriber     subscribers @relation(fields: [subscriber_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invoice        invoices?   @relation(fields: [invoice_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payment        payments?   @relation(fields: [payment_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plan           plans?      @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([subscriber_id], map: "idx_prepaid_topups_subscriber")
}