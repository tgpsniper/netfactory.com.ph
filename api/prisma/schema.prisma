// ============================================================
// ⚠  DO NOT RUN `prisma db push` AGAINST PRODUCTION
// ============================================================
// Parts of this database are managed with raw SQL and are deliberately NOT modelled
// here. `db push` makes the database match this file, so it would DROP them:
//
//   • RADIUS tables            radcheck, radreply, radusergroup, radgroupreply,
//                              radacct, radpostauth
//   • Hotspot / MAC auth       hotspot_mac_devices, hotspot_vouchers,
//                              subscriber_hotspot
//   • Billing restriction      subscriber_restrictions,
//                              subscribers.restriction_exempt
//   • Message templates        message_templates  (staff-editable overrides for the
//                              outgoing subscriber email/SMS text)
//   • Columns on modelled tables that were added by hand, plus the account_number
//     trigger/sequence and the generated columns on subscribers
//
// Use an explicit migration, or raw SQL, for schema changes on production.
// ============================================================

generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model plans {
  id                   Int             @id @default(autoincrement())
  name                 String          @db.VarChar(50)
  slug                 String?         @unique @db.VarChar(50)
  speed_mbps           Int
  speed_label          String          @db.VarChar(20)
  price                Decimal         @db.Decimal(10, 2)
  description          String?
  long_description     String?
  color_hex            String?         @db.VarChar(7)
  is_popular           Boolean?        @default(false)
  is_active            Boolean?        @default(true)
  sort_order           Int?            @default(0)
  data_cap_gb          Int?
  router_type          String?         @db.VarChar(100)
  has_lock_in          Boolean?        @default(false)
  lock_in_months       Int?
  installation_fee     Decimal?        @default(0) @db.Decimal(10, 2)
  created_at           DateTime?       @default(now()) @db.Timestamptz(6)
  updated_at           DateTime?       @default(now()) @db.Timestamptz(6)
  activation_fee       Decimal?        @default(0) @db.Decimal(10, 2)
  show_fees_on_website Boolean?        @default(false)
  radius_group         String?         @db.VarChar(100)
  download_mbps        Int?
  upload_mbps          Int?
  burst_download_mbps  Int?
  burst_upload_mbps    Int?
  burst_threshold_pct  Int?            @default(80)
  burst_time_s         Int?            @default(16)
  plan_type            String?         @default("residential") @db.VarChar(20)
  billing_type         String?         @default("postpaid") @db.VarChar(20)
  terms                Json?           @default("[]")
  is_unlimited         Boolean?        @default(true)
  rd_offer_id          Int?
  validity_period      Int?
  features             plan_features[]
  notes                plan_notes[]
  subscribers          subscribers[]
  prepaid_topups       prepaid_topups[]
}

model plan_features {
  id           Int      @id @default(autoincrement())
  plan_id      Int
  feature_text String   @db.VarChar(200)
  sort_order   Int?     @default(0)
  is_active    Boolean? @default(true)
  plan         plans    @relation(fields: [plan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model installation_packages {
  id          Int                          @id @default(autoincrement())
  code        String                       @unique @db.VarChar(10)
  name        String                       @db.VarChar(100)
  description String?                      @db.VarChar(255)
  color_hex   String?                      @default("#3b82f6") @db.VarChar(7)
  is_active   Boolean?                     @default(true)
  sort_order  Int?                         @default(0)
  created_at  DateTime?                    @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?                    @default(now()) @db.Timestamptz(6)
  items       installation_package_items[]
}

model installation_package_items {
  id         Int                   @id @default(autoincrement())
  package_id Int
  item_text  String                @db.VarChar(200)
  sort_order Int?                  @default(0)
  is_active  Boolean?              @default(true)
  package    installation_packages @relation(fields: [package_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([package_id], map: "idx_pkg_items_package")
}

model referrals {
  id               Int          @id @default(autoincrement())
  referrer_id      Int
  referrer_account String       @db.VarChar(20)
  referee_id       Int?
  status           String       @default("pending") @db.VarChar(20)
  created_at       DateTime     @default(now()) @db.Timestamptz(6)
  expires_at       DateTime     @default(dbgenerated("(now() + '60 days'::interval)")) @db.Timestamptz(6)
  converted_at     DateTime?    @db.Timestamptz(6)
  referee          subscribers? @relation("referee", fields: [referee_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  referrer         subscribers  @relation("referrer", fields: [referrer_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([referrer_id], map: "idx_referrals_referrer")
  @@index([referee_id], map: "idx_referrals_referee")
  @@index([status], map: "idx_referrals_status")
}

model municipalities {
  id             Int           @id @default(autoincrement())
  name           String        @db.VarChar(100)
  province       String        @default("Bataan") @db.VarChar(100)
  is_serviceable Boolean?      @default(true)
  postal_code    String?       @db.VarChar(10)
  barangays      barangays[]
  subscribers    subscribers[]
}

model barangays {
  id              Int            @id @default(autoincrement())
  municipality_id Int
  name            String         @db.VarChar(100)
  is_serviceable  Boolean?       @default(true)
  latitude        Decimal?       @db.Decimal(10, 7)
  longitude       Decimal?       @db.Decimal(10, 7)
  municipality    municipalities @relation(fields: [municipality_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subscribers     subscribers[]
}

model subscribers {
  id                      Int                            @id @default(autoincrement())
  account_number          String                         @unique @db.VarChar(20)
  first_name              String?                        @db.VarChar(100)
  last_name               String?                        @db.VarChar(100)
  company_name            String?                        @db.VarChar(200)
  email                   String?                        @unique @db.VarChar(255)
  phone                   String                         @db.VarChar(20)
  address                 String                         @db.VarChar(255)
  barangay_id             Int?
  municipality_id         Int?
  plan_id                 Int?
  status                  String                         @default("inactive") @db.VarChar(20)
  balance                 Decimal?                       @default(0) @db.Decimal(10, 2)
  latitude                Decimal?                       @db.Decimal(10, 7)
  longitude               Decimal?                       @db.Decimal(10, 7)
  installed_at            DateTime?                      @db.Date
  next_bill_date          DateTime?                      @db.Date
  expires_at              DateTime?                      @db.Timestamptz(6)
  ont_serial              String?                        @db.VarChar(50)
  router_serial           String?                        @db.VarChar(50)
  notes                   String?
  id_type                 String?                        @db.VarChar(50)
  id_number               String?                        @db.VarChar(50)
  created_at              DateTime?                      @default(now()) @db.Timestamptz(6)
  updated_at              DateTime?                      @default(now()) @db.Timestamptz(6)
  postal_code             String?                        @db.VarChar(10)
  municipality_name       String?                        @db.VarChar(100)
  barangay_name           String?                        @db.VarChar(100)
  installation_package    String?                        @db.VarChar(10)
  middle_name             String?                        @db.VarChar(50)
  alternate_contact_name  String?                        @db.VarChar(100)
  alternate_contact_phone String?                        @db.VarChar(12)
  alt_contacts            Json?                          @default("[]")
  proof_of_billing        String?                        @db.VarChar(250)
  valid_id1               String?                        @db.VarChar(250)
  valid_id2               String?                        @db.VarChar(250)
  other_attachment        String?                        @db.VarChar(250)
  xui_user_id             Int?
  agent                   String?                        @db.VarChar(250)
  application_date        DateTime?                      @db.Date
  date_installed          DateTime?                      @db.Date
  address_street1         String?                        @db.VarChar(50)
  address_street2         String?                        @db.VarChar(50)
  address_city            String?                        @db.VarChar(50)
  address_state           String?                        @db.VarChar(50)
  address_postal_code     String?                        @db.VarChar(10)
  remarks                 String?
  credit_balance          Decimal?                       @default(0) @db.Decimal(10, 2)
  mac_address             String?                        @db.VarChar(17)
  agent_id                Int?
  is_system               Boolean                        @default(false)
  call_logs               call_logs[]
  invoices                invoices[]
  olt_onu_mappings        olt_onu_mappings[]
  onu_devices             onu_inventory[]
  payments                payments[]
  referrals_received      referrals[]                    @relation("referee")
  referrals_made          referrals[]                    @relation("referrer")
  sms_logs                sms_logs[]
  auth                    subscriber_auth?
  subscriber_credits      subscriber_credits[]
  prepaid_topups          prepaid_topups[]
  notification_prefs      subscriber_notification_prefs?
  subscriber_radius       subscriber_radius[]
  sales_agents            sales_agents?                  @relation(fields: [agent_id], references: [id], onUpdate: NoAction)
  barangay                barangays?                     @relation(fields: [barangay_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  municipality            municipalities?                @relation(fields: [municipality_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plan                    plans?                         @relation(fields: [plan_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subscriber_notes                 subscriber_notes[]
  surveys                 surveys[]
  tickets                 tickets[]
  conversations           conversations[]
  tr069_devices           tr069_devices[]
  usage_data              usage_data[]
  work_orders             work_orders[]

  @@index([account_number], map: "idx_subscribers_account")
  @@index([barangay_id], map: "idx_subscribers_barangay")
  @@index([email], map: "idx_subscribers_email")
  @@index([municipality_id], map: "idx_subscribers_municipality")
  @@index([last_name, first_name], map: "idx_subscribers_name")
  @@index([plan_id], map: "idx_subscribers_plan")
  @@index([status], map: "idx_subscribers_status")
  @@index([agent_id], map: "idx_subscribers_agent_id")
}

model subscriber_auth {
  id               Int         @id @default(autoincrement())
  subscriber_id    Int         @unique
  password_hash    String      @db.VarChar(255)
  is_2fa_enabled   Boolean?    @default(false)
  two_fa_secret    String?     @db.VarChar(100)
  session_token    String?     @db.VarChar(255)
  token_expires_at DateTime?   @db.Timestamptz(6)
  last_login_at    DateTime?   @db.Timestamptz(6)
  last_login_ip    String?     @db.VarChar(45)
  failed_attempts  Int?        @default(0)
  locked_until     DateTime?   @db.Timestamptz(6)
  reset_token      String?     @db.VarChar(255)
  reset_expires_at DateTime?   @db.Timestamptz(6)
  created_at       DateTime?   @default(now()) @db.Timestamptz(6)
  subscriber       subscribers @relation(fields: [subscriber_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([session_token], map: "idx_auth_session")
}

model subscriber_notification_prefs {
  id            Int         @id @default(autoincrement())
  subscriber_id Int         @unique
  email_billing Boolean?    @default(true)
  sms_payment   Boolean?    @default(true)
  outage_alerts Boolean?    @default(true)
  promos        Boolean?    @default(false)
  updated_at    DateTime?   @default(now()) @db.Timestamptz(6)
  subscriber    subscribers @relation(fields: [subscriber_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([subscriber_id], map: "idx_notif_prefs_sub_id")
  @@index([subscriber_id], map: "idx_notif_prefs_subscriber")
}

model invoices {
  id                  Int                  @id @default(autoincrement())
  subscriber_id       Int
  invoice_number      String               @unique @db.VarChar(30)
  amount              Decimal              @db.Decimal(10, 2)
  billing_period      String?              @db.VarChar(30)
  due_date            DateTime             @db.Date
  status              String               @default("pending") @db.VarChar(20)
  overdue_fee         Decimal?             @default(0) @db.Decimal(10, 2)
  prepaid_days        Int?
  // Advance payment / downpayment. Paying this invoice moves the money into
  // subscriber credit rather than settling service already rendered — used for
  // pre-installation collections, where an emailed pay link is the normal channel
  // but the money has no service period to consume.
  is_advance          Boolean              @default(false)
  notes               String?
  generated_at        DateTime?            @default(now()) @db.Timestamptz(6)
  created_at          DateTime?            @default(now()) @db.Timestamptz(6)
  xendit_invoice_id   String?              @db.VarChar(255)
  xendit_external_id  String?              @db.VarChar(255)
  accounts_receivable accounts_receivable?
  subscriber          subscribers          @relation(fields: [subscriber_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments            payments[]
  subscriber_credits  subscriber_credits[]
  prepaid_topups      prepaid_topups[]

  @@index([due_date], map: "idx_invoices_due")
  @@index([billing_period], map: "idx_invoices_period")
  @@index([status], map: "idx_invoices_status")
  @@index([subscriber_id], map: "idx_invoices_subscriber")
  @@index([xendit_external_id], map: "idx_invoices_xendit_ext_id")
  @@index([xendit_invoice_id], map: "idx_invoices_xendit_id")
}

model payments {
  id                 Int                  @id @default(autoincrement())
  invoice_id         Int
  subscriber_id      Int
  amount             Decimal              @db.Decimal(10, 2)
  method             String               @db.VarChar(30)
  reference_number   String?              @db.VarChar(100)
  status             String               @default("pending") @db.VarChar(20)
  gateway_response   Json?
  paid_at            DateTime?            @db.Timestamptz(6)
  created_at         DateTime?            @default(now()) @db.Timestamptz(6)
  or_number          String?              @db.VarChar(50)
  deposit_items      DepositItem[]
  invoice            invoices             @relation(fields: [invoice_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subscriber         subscribers          @relation(fields: [subscriber_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subscriber_credits subscriber_credits[]
  prepaid_topups     prepaid_topups[]

  @@index([invoice_id], map: "idx_payments_invoice")
  @@index([method], map: "idx_payments_method")
  @@index([status], map: "idx_payments_status")
  @@index([subscriber_id], map: "idx_payments_subscriber")
}

model admin_users {
  id                                               Int                      @id @default(autoincrement())
  username                                         String                   @unique @db.VarChar(50)
  email                                            String                   @unique @db.VarChar(255)
  password_hash                                    String                   @db.VarChar(255)
  full_name                                        String                   @db.VarChar(100)
  role                                             String                   @db.VarChar(30)
  is_active                                        Boolean?                 @default(true)
  last_login_at                                    DateTime?                @db.Timestamptz(6)
  created_at                                       DateTime?                @default(now()) @db.Timestamptz(6)
  allowed_pages                                    String[]                 @default(["dashboard"])
  phone                                            String?                  @db.VarChar(20)
  receive_email_alerts                             Boolean?                 @default(false)
  receive_sms_alerts                               Boolean?                 @default(false)
  inventory_transactions                           inventory_transactions[]
  approved_pos                                     purchase_orders[]        @relation("po_approver")
  created_pos                                      purchase_orders[]        @relation("po_creator")
  tickets                                          tickets[]
  conversations                                    conversations[]
  work_orders_work_orders_assigned_toToadmin_users work_orders[]            @relation("work_orders_assigned_toToadmin_users")
  work_orders_work_orders_created_byToadmin_users  work_orders[]            @relation("work_orders_created_byToadmin_users")
}

model tickets {
  id            Int              @id @default(autoincrement())
  subscriber_id Int
  ticket_number String           @unique @db.VarChar(30)
  category      String           @db.VarChar(30)
  priority      String           @db.VarChar(20)
  status        String           @default("open") @db.VarChar(20)
  subject       String           @db.VarChar(255)
  description   String?
  assigned_to   Int?
  resolved_at   DateTime?        @db.Timestamptz(6)
  closed_at     DateTime?        @db.Timestamptz(6)
  created_at    DateTime?        @default(now()) @db.Timestamptz(6)
  updated_at    DateTime?        @default(now()) @db.Timestamptz(6)
  updates       ticket_updates[]
  admin         admin_users?     @relation(fields: [assigned_to], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subscriber    subscribers      @relation(fields: [subscriber_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([assigned_to], map: "idx_tickets_assigned")
  @@index([priority], map: "idx_tickets_priority")
  @@index([status], map: "idx_tickets_status")
  @@index([subscriber_id], map: "idx_tickets_subscriber")
}

model ticket_updates {
  id          Int       @id @default(autoincrement())
  ticket_id   Int
  message     String
  created_by  String    @db.VarChar(100)
  is_internal Boolean?  @default(false)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  ticket      tickets   @relation(fields: [ticket_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([ticket_id], map: "idx_ticket_updates_ticket")
}

model usage_data {
  id                 Int         @id @default(autoincrement())
  subscriber_id      Int
  usage_date         DateTime    @db.Date
  download_gb        Decimal?    @default(0) @db.Decimal(8, 2)
  upload_gb          Decimal?    @default(0) @db.Decimal(8, 2)
  peak_download_mbps Decimal?    @db.Decimal(8, 2)
  peak_upload_mbps   Decimal?    @db.Decimal(8, 2)
  session_count      Int?        @default(0)
  created_at         DateTime?   @default(now()) @db.Timestamptz(6)
  subscriber         subscribers @relation(fields: [subscriber_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([subscriber_id, usage_date])
  @@index([usage_date], map: "idx_usage_date")
}

model notifications {
  id          Int       @id @default(autoincrement())
  type        String    @db.VarChar(20)
  title       String    @db.VarChar(255)
  message     String?
  target_type String?   @db.VarChar(20)
  target_id   Int?
  is_read     Boolean?  @default(false)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)

  @@index([target_type, target_id, is_read], map: "idx_notif_target")
}

model network_nodes {
  id          Int       @id @default(autoincrement())
  type        String    @db.VarChar(20)
  name        String    @db.VarChar(100)
  status      String    @default("online") @db.VarChar(20)
  total_ports Int?
  used_ports  Int?
  latitude    Decimal?  @db.Decimal(10, 7)
  longitude   Decimal?  @db.Decimal(10, 7)
  address     String?   @db.VarChar(255)
  notes       String?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
}

model fiber_routes {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(100)
  distance_km   Decimal?  @db.Decimal(8, 2)
  status        String    @default("active") @db.VarChar(30)
  fiber_type    String?   @db.VarChar(50)
  route_geojson Json?
  notes         String?
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
}

model system_settings {
  id         Int       @id @default(autoincrement())
  key        String    @unique @db.VarChar(100)
  value      String
  category   String?   @db.VarChar(50)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
  label      String?   @db.VarChar(200)
  updated_by String?   @db.VarChar(100)
}

model audit_log {
  id          Int       @id @default(autoincrement())
  user_type   String    @db.VarChar(20)
  user_id     BigInt
  action      String    @db.VarChar(100)
  entity_type String?   @db.VarChar(50)
  entity_id   BigInt?
  details     Json?
  ip_address  String?   @db.VarChar(45)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)

  @@index([created_at], map: "idx_audit_created")
  @@index([user_type, user_id], map: "idx_audit_user")
}

model plan_notes {
  id         Int       @id @default(autoincrement())
  plan_id    Int
  note       String
  created_by Int?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  plan       plans     @relation(fields: [plan_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([plan_id], map: "idx_plan_notes_plan_id")
}

model bugs {
  id             Int               @id @default(autoincrement())
  bug_id         String            @unique @db.VarChar(20)
  date_found     DateTime          @default(dbgenerated("CURRENT_DATE")) @db.Date
  tester         String            @db.VarChar(100)
  module         String            @db.VarChar(100)
  severity       String            @default("Medium") @db.VarChar(20)
  test_account   String?           @db.VarChar(50)
  steps          String
  expected       String?
  actual         String
  screenshot_url String?
  console_errors String?
  server_logs    String?
  status         String            @default("Open") @db.VarChar(30)
  notes          String?
  created_at     DateTime          @default(now()) @db.Timestamptz(6)
  updated_at     DateTime          @default(now()) @updatedAt @db.Timestamptz(6)
  screenshots    bug_screenshots[]

  @@index([date_found(sort: Desc)], map: "idx_bugs_date_found")
  @@index([module], map: "idx_bugs_module")
  @@index([severity], map: "idx_bugs_severity")
  @@index([status], map: "idx_bugs_status")
  @@index([tester], map: "idx_bugs_tester")
}

model bug_screenshots {
  id          Int      @id @default(autoincrement())
  bug_id      String   @db.VarChar(20)
  filename    String   @db.VarChar(255)
  filepath    String   @db.VarChar(500)
  filesize    Int?     @default(0)
  mimetype    String?  @db.VarChar(100)
  uploaded_at DateTime @default(now()) @db.Timestamptz(6)
  bug         bugs     @relation(fields: [bug_id], references: [bug_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([bug_id], map: "idx_bug_screenshots_bug_id")
}

model vendors {
  id                  Int                @id @default(autoincrement())
  name                String             @unique @db.VarChar(100)
  contact             String?            @db.VarChar(255)
  phone               String?            @db.VarChar(50)
  email               String?            @db.VarChar(255)
  notes               String?
  is_active           Boolean?           @default(true)
  created_at          DateTime?          @default(now()) @db.Timestamptz(6)
  address             String?
  city                String?            @db.VarChar(100)
  terms               String?            @db.VarChar(100)
  phone2              String?            @db.VarChar(50)
  phone3              String?            @db.VarChar(50)
  website             String?            @db.VarChar(255)
  municipality        String?            @db.VarChar(100)
  province            String?            @db.VarChar(100)
  postal_code         String?            @db.VarChar(20)
  vendor_code         String?            @db.VarChar(20)
  tin_number          String?            @db.VarChar(20)
  category            String?            @db.VarChar(50)
  bank_name           String?            @db.VarChar(100)
  bank_account_number String?            @db.VarChar(50)
  updated_at          DateTime?          @default(now()) @db.Timestamp(6)
  accounts_payable    accounts_payable[]
  expenses            Expense[]
  onu_devices         onu_inventory[]
  products            products[]
  purchase_orders     purchase_orders[]
}

model onu_inventory {
  id               Int                      @id @default(autoincrement())
  subscriber_id    Int?
  mac_address      String                   @unique @db.VarChar(17)
  serial_number    String?                  @db.VarChar(100)
