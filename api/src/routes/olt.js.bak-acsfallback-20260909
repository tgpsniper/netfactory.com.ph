// ── POST /devices/:id/test — Test SSH connection ────────────
router.post('/devices/:id/test', adminAuth(), requireDevice, async (req, res) => {
  try {
    const results = { system: null, ssh: null };

    // Test via getSystemInfo (uses SSH)
    try {
      results.system = await vsolOlt.getSystemInfo(req.prisma, req.deviceId);
    } catch (sysErr) {
      results.system = { error: sysErr.message };
    }

    // Test direct SSH command
    const device = await vsolOlt.getDeviceConfig(req.prisma, req.deviceId);
    if (device.use_ssh) {
      try {
        const sshOutput = await vsolOlt.sshShellExec(device, ['show version', 'exit'], 10000);
        results.ssh = { connected: true, output: vsolOlt.stripAnsi(sshOutput).substring(0, 2000) };
      } catch (sshErr) {
        results.ssh = { connected: false, error: sshErr.message };
      }
    } else {
      results.ssh = { connected: false, message: 'SSH is not enabled for this device' };
    }

    res.json({ success: true, results });
  } catch (err) {
    console.error('[OLT] Error testing device:', err.message);
    res.status(500).json({ error: err.message });
  }
});

