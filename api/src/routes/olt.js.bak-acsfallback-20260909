//  ALARM ROUTES
// ============================================================

// ── GET /devices/:id/alarms — Alarm info via SSH ─────────────
router.get('/devices/:id/alarms', adminAuth(), requireDevice, async (req, res) => {
  try {
    const config = await vsolOlt.getConfig(req.prisma);
    if (!config.enabled) return res.status(503).json({ error: 'OLT management is disabled' });

    const device = await vsolOlt.getDeviceConfig(req.prisma, req.deviceId);

    let alarms = [];
    try {
      const output = await vsolOlt.sshShellExec(device, ['terminal length 0', 'show alarm', 'exit'], 10000);
      const clean = vsolOlt.stripAnsi(output);
      const lines = clean.split('\n').filter(l => l.trim() && !l.includes('#') && !l.includes('show alarm'));
      alarms = lines.filter(l => l.match(/alarm|warning|error|critical/i)).map((line, idx) => ({
        index: idx + 1,
        message: line.trim(),
      }));
    } catch (_) {
      alarms = [];
    }

    res.json({ deviceId: req.deviceId, alarms });
  } catch (err) {
    console.error('[OLT] Error getting alarms:', err.message);
    res.status(500).json({ error: err.message });
  }
});

// ============================================================
//  SUBSCRIBER-SPECIFIC ROUTES (no requireDevice)
//  These look up the subscriber's mapped OLT device automatically
// ============================================================

// ── GET /subscriber/:id/onu-info — Get subscriber's ONU info ─
router.get('/subscriber/:id/onu-info', adminAuth(), async (req, res) => {
  try {
    const subscriberId = parseInt(req.params.id, 10);
    if (isNaN(subscriberId) || subscriberId <= 0) {
      return res.status(400).json({ error: 'Invalid subscriber ID' });
    }

    // Find the subscriber's ONU mapping
    const mapping = await req.prisma.olt_onu_mappings.findFirst({
      where: { subscriber_id: subscriberId },
      include: {
        olt_device: true,
        onu_inventory: {
          select: { id: true, mac_address: true, serial_number: true, model: true },
        },
      },
    });

    if (!mapping) {
      return res.status(404).json({ error: 'No ONU mapping found for this subscriber' });
    }

    // Fetch live ONU detail from the OLT
    let onuDetail = null;
    try {
      onuDetail = await vsolOlt.getONUDetail(
        req.prisma, mapping.olt_device_id, mapping.pon_port, mapping.onu_id
      );
    } catch (detailErr) {
      onuDetail = { error: detailErr.message };
    }

    res.json({
      mapping: {
        id: mapping.id,
        oltDeviceId: mapping.olt_device_id,
        oltLabel: mapping.olt_device?.label || null,
        oltHost: mapping.olt_device?.host || null,
        ponPort: mapping.pon_port,
        onuId: mapping.onu_id,
        serialNumber: mapping.serial_number,
        macAddress: mapping.mac_address,
        lineProfile: mapping.line_profile,
        srvProfile: mapping.srv_profile,
        description: mapping.description,
      },
      inventory: mapping.onu_inventory || null,
      liveStatus: onuDetail,
    });
  } catch (err) {
    console.error('[OLT] Error getting subscriber ONU info:', err.message);
    res.status(500).json({ error: err.message });
  }
});

// ── POST /subscriber/:id/onu-reboot — Reboot subscriber's ONU
router.post('/subscriber/:id/onu-reboot', adminAuth(), async (req, res) => {
  try {
    const subscriberId = parseInt(req.params.id, 10);
    if (isNaN(subscriberId) || subscriberId <= 0) {
      return res.status(400).json({ error: 'Invalid subscriber ID' });
    }

    // Find the subscriber's ONU mapping
    const mapping = await req.prisma.olt_onu_mappings.findFirst({
      where: { subscriber_id: subscriberId },
      include: { olt_device: true },
    });

    if (!mapping) {
      return res.status(404).json({ error: 'No ONU mapping found for this subscriber' });
    }

    const result = await vsolOlt.rebootONU(
      req.prisma, mapping.olt_device_id, mapping.pon_port, mapping.onu_id
    );

    res.json({
      success: true,
      subscriberId,
      oltDeviceId: mapping.olt_device_id,
      oltLabel: mapping.olt_device?.label || null,
      ponPort: mapping.pon_port,
      onuId: mapping.onu_id,
      result,
    });
  } catch (err) {
    console.error('[OLT] Error rebooting subscriber ONU:', err.message);
    res.status(500).json({ error: err.message });
  }
});

module.exports = router;
