// ── GET /devices/:id/pon-ports/:port/optical — Optical levels for port ONUs
router.get('/devices/:id/pon-ports/:port/optical', adminAuth(), requireDevice, async (req, res) => {
  try {
    const ponPort = parseInt(req.params.port, 10);
    if (isNaN(ponPort) || ponPort <= 0) {
      return res.status(400).json({ error: 'Invalid PON port number' });
    }

    // Get all ONUs on the port, then fetch optical levels for each
    const onus = await vsolOlt.getONUs(req.prisma, req.deviceId, ponPort);

    const opticalData = await Promise.all(
      onus.map(async (onu) => {
        try {
          const levels = await vsolOlt.getONUOpticalLevels(
            req.prisma, req.deviceId, onu.ponPort, onu.onuId
          );
          return { ...onu, ...levels };
        } catch (optErr) {
          return { ...onu, rxPower: null, txPower: null, distance: null, signalLevel: null, error: optErr.message };
        }
      })
    );

    res.json({ ponPort, onus: opticalData });
  } catch (err) {
    console.error('[OLT] Error getting port optical levels:', err.message);
    res.status(500).json({ error: err.message });
  }
});

