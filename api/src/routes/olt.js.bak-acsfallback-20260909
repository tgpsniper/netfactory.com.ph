// ── GET /devices/:id/onu-mappings — List mappings for device ─
router.get('/devices/:id/onu-mappings', adminAuth(), requireDevice, async (req, res) => {
  try {
    const mappings = await req.prisma.olt_onu_mappings.findMany({
      where: { olt_device_id: req.deviceId },
      include: {
        subscriber: {
          select: {
            id: true,
            first_name: true,
            last_name: true,
            account_number: true,
            status: true,
          },
        },
        onu_inventory: {
          select: {
            id: true,
            mac_address: true,
            serial_number: true,
            model: true,
            status: true,
          },
        },
      },
      orderBy: [{ pon_port: 'asc' }, { onu_id: 'asc' }],
