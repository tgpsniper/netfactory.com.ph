// ── POST /devices/:id/onu-mappings — Create/upsert mapping ──
router.post('/devices/:id/onu-mappings', adminAuth(), requireDevice, async (req, res) => {
  try {
    const {
      ponPort, onuId, serialNumber, macAddress,
      subscriberId, onuInventoryId, lineProfile, srvProfile, description,
    } = req.body;

    if (ponPort == null || onuId == null) {
      return res.status(400).json({ error: 'ponPort and onuId are required' });
    }

    const data = {
      olt_device_id:    req.deviceId,
      pon_port:         parseInt(ponPort, 10),
      onu_id:           parseInt(onuId, 10),
      serial_number:    serialNumber || null,
      mac_address:      macAddress || null,
      subscriber_id:    subscriberId != null ? parseInt(subscriberId, 10) : null,
      onu_inventory_id: onuInventoryId != null ? parseInt(onuInventoryId, 10) : null,
      line_profile:     lineProfile || null,
      srv_profile:      srvProfile || null,
      description:      description || null,
      updated_at:       new Date(),
    };

    // Upsert: update if the same device+port+onu already exists
    const mapping = await req.prisma.olt_onu_mappings.upsert({
      where: {
        uq_olt_pon_onu: {
          olt_device_id: req.deviceId,
          pon_port:      parseInt(ponPort, 10),
          onu_id:        parseInt(onuId, 10),
        },
      },
      create: data,
      update: {
        serial_number:    data.serial_number,
        mac_address:      data.mac_address,
        subscriber_id:    data.subscriber_id,
        onu_inventory_id: data.onu_inventory_id,
        line_profile:     data.line_profile,
        srv_profile:      data.srv_profile,
        description:      data.description,
        updated_at:       data.updated_at,
      },
    });

    res.json(mapping);
  } catch (err) {
    console.error('[OLT] Error creating ONU mapping:', err.message);
    res.status(500).json({ error: err.message });
  }
});

