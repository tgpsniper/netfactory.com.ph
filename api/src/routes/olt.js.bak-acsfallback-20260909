// ── GET /devices — List all OLT devices ─────────────────────
router.get('/devices', adminAuth(), async (req, res) => {
  try {
    const devices = await req.prisma.olt_devices.findMany({
      orderBy: { id: 'asc' },
    });

    // Mask ssh_password in response
    const masked = devices.map(d => ({
      ...d,
      ssh_password: d.ssh_password ? '••••••••' : null,
      enable_password: d.enable_password ? '••••••••' : null,
    }));

    res.json({ devices: masked });
  } catch (err) {
    console.error('[OLT] Error listing devices:', err.message);
    res.status(500).json({ error: err.message });
  }
});

// ── POST /devices — Create a new OLT device ────────────────
router.post('/devices', adminAuth(), async (req, res) => {
  try {
    const {
      label, host, olt_model, snmp_community, snmp_version, snmp_port,
      ssh_username, ssh_password, enable_password, ssh_port, telnet_port, use_ssh,
      pon_port_count, notes,
    } = req.body;

    if (!label || !host) {
      return res.status(400).json({ error: 'label and host are required' });
    }

    const device = await req.prisma.olt_devices.create({
      data: {
        label,
        host,
        olt_model:      olt_model || null,
        snmp_community: snmp_community || 'public',
        snmp_version:   snmp_version || '2c',
        snmp_port:      snmp_port != null ? parseInt(snmp_port, 10) : 161,
        ssh_username:   ssh_username || null,
        ssh_password:   ssh_password || null,
        enable_password: enable_password || null,
        ssh_port:       ssh_port != null ? parseInt(ssh_port, 10) : 22,
        telnet_port:    telnet_port != null ? parseInt(telnet_port, 10) : 23,
        use_ssh:        use_ssh != null ? Boolean(use_ssh) : true,
        pon_port_count: pon_port_count != null ? parseInt(pon_port_count, 10) : 8,
        notes:          notes || null,
      },
    });

    res.json({
      ...device,
      ssh_password: device.ssh_password ? '••••••••' : null,
      enable_password: device.enable_password ? '••••••••' : null,
    });
  } catch (err) {
    console.error('[OLT] Error creating device:', err.message);
    res.status(500).json({ error: err.message });
  }
});

// ── PUT /devices/:id — Update an OLT device ────────────────
router.put('/devices/:id', adminAuth(), requireDevice, async (req, res) => {
  try {
    const {
      label, host, olt_model, snmp_community, snmp_version, snmp_port,
      ssh_username, ssh_password, enable_password, ssh_port, telnet_port, use_ssh,
      pon_port_count, notes, is_active,
    } = req.body;

    const data = { updated_at: new Date() };

    if (label !== undefined)          data.label = label;
    if (host !== undefined)           data.host = host;
    if (olt_model !== undefined)      data.olt_model = olt_model || null;
    if (snmp_community !== undefined) data.snmp_community = snmp_community;
    if (snmp_version !== undefined)   data.snmp_version = snmp_version;
    if (snmp_port !== undefined)      data.snmp_port = parseInt(snmp_port, 10);
    if (ssh_username !== undefined)   data.ssh_username = ssh_username || null;
    if (ssh_port !== undefined)       data.ssh_port = parseInt(ssh_port, 10);
    if (telnet_port !== undefined)    data.telnet_port = parseInt(telnet_port, 10);
    if (use_ssh !== undefined)        data.use_ssh = Boolean(use_ssh);
    if (pon_port_count !== undefined) data.pon_port_count = parseInt(pon_port_count, 10);
    if (notes !== undefined)          data.notes = notes || null;
    if (is_active !== undefined)      data.is_active = Boolean(is_active);

    // Skip password update if the masked placeholder is sent back
    if (ssh_password !== undefined && ssh_password !== '••••••••') {
      data.ssh_password = ssh_password || null;
    }
    if (enable_password !== undefined && enable_password !== '••••••••') {
      data.enable_password = enable_password || null;
    }

    const device = await req.prisma.olt_devices.update({
      where: { id: req.deviceId },
      data,
    });

    // The driver is chosen from olt_model and cached; without this an operator who
    // corrects a wrong model keeps talking to the old vendor's CLI for another minute.
    vsolOlt.invalidate(req.deviceId);

    res.json({
      ...device,
      ssh_password: device.ssh_password ? '••••••••' : null,
      enable_password: device.enable_password ? '••••••••' : null,
    });
  } catch (err) {
    console.error('[OLT] Error updating device:', err.message);
    res.status(500).json({ error: err.message });
  }
});

