// ── POST /devices/:id/onu-mappings/auto-discover — Auto-map ONUs
router.post('/devices/:id/onu-mappings/auto-discover', adminAuth(), requireDevice, async (req, res) => {
  try {
    // Walk all ONUs on the device
    const onus = await vsolOlt.getONUs(req.prisma, req.deviceId, null);

    // Fetch all onu_inventory and subscriber records for matching
    const [inventoryRecords, existingMappings] = await Promise.all([
      req.prisma.onu_inventory.findMany({
        include: {
          subscriber: {
            select: { id: true, first_name: true, last_name: true, account_number: true },
          },
        },
      }),
      req.prisma.olt_onu_mappings.findMany({
        where: { olt_device_id: req.deviceId },
      }),
    ]);

    // Index inventory by serial and MAC for fast lookup
    const bySerial = {};
    const byMac = {};
    for (const inv of inventoryRecords) {
      if (inv.serial_number) bySerial[inv.serial_number.toLowerCase()] = inv;
      if (inv.mac_address) byMac[inv.mac_address.toLowerCase()] = inv;
    }

    // Index existing mappings by pon_port.onu_id
    const existingKeys = new Set(
      existingMappings.map(m => `${m.pon_port}.${m.onu_id}`)
    );

    const created = [];
    const skipped = [];

    for (const onu of onus) {
      const key = `${onu.ponPort}.${onu.onuId}`;

      // Skip if mapping already exists
      if (existingKeys.has(key)) {
        skipped.push({ ponPort: onu.ponPort, onuId: onu.onuId, reason: 'mapping already exists' });
        continue;
      }

      // Try matching by serial number, then by MAC-like serial patterns
      let matchedInventory = null;
      if (onu.serial) {
        matchedInventory = bySerial[onu.serial.toLowerCase()] || byMac[onu.serial.toLowerCase()] || null;
      }

      const mappingData = {
        olt_device_id:    req.deviceId,
        pon_port:         onu.ponPort,
        onu_id:           onu.onuId,
        serial_number:    onu.serial || null,
        description:      onu.description || null,
        status:           onu.status || 'unknown',
        subscriber_id:    matchedInventory?.subscriber_id || null,
        onu_inventory_id: matchedInventory?.id || null,
        mac_address:      matchedInventory?.mac_address || null,
        // The line profile is the ONU's data path. Without one it registers, reports
        // itself working, and can never get an address — so record it here rather than
        // leaving the mapping to imply an ONU is fine because it says "online".
        line_profile:     onu.lineProfile || null,
        srv_profile:      onu.srvProfile || null,
      };

      const mapping = await req.prisma.olt_onu_mappings.create({ data: mappingData });
      created.push(mapping);
    }

    res.json({
      success: true,
      discovered: onus.length,
      created: created.length,
      skipped: skipped.length,
      details: { created, skipped },
    });
  } catch (err) {
    console.error('[OLT] Error in auto-discover:', err.message);
    res.status(500).json({ error: err.message });
  }
});

