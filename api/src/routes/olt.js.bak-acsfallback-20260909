// ── GET /devices/:id/system/fans — Fan info via SSH ──────────
router.get('/devices/:id/system/fans', adminAuth(), requireDevice, async (req, res) => {
  try {
    const config = await vsolOlt.getConfig(req.prisma);
    if (!config.enabled) return res.status(503).json({ error: 'OLT management is disabled' });

    const device = await vsolOlt.getDeviceConfig(req.prisma, req.deviceId);

    let fans = [];
    try {
      const output = await vsolOlt.sshShellExec(device, ['terminal length 0', 'show fan', 'exit'], 10000);
      const clean = vsolOlt.stripAnsi(output);
      // Parse fan status from output
      const lines = clean.split('\n');
      let idx = 0;
      for (const line of lines) {
        const m = line.match(/[Ff]an\s*(\d+)\s*[:=]\s*(\S+)/);
        if (m) {
          idx++;
          fans.push({
            index: idx,
            status: m[2].toLowerCase().includes('ok') || m[2].toLowerCase().includes('run') ? 1 : 2,
            statusText: m[2],
          });
        }
      }
    } catch (_) {
      fans = [];
    }

    res.json({ deviceId: req.deviceId, fans });
  } catch (err) {
    console.error('[OLT] Error getting fan status:', err.message);
    res.status(500).json({ error: err.message });
  }
});

