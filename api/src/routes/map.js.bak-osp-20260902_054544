router.post('/extract-gps', adminAuth(), gisPhotoUpload.single('photo'), async (req, res) => {
  try {
    if (!req.file) return res.status(400).json({ error: 'No photo' });
    let lat = null, lng = null, source = null;

    // Try EXIF
    try {
      const gps = await exifr.gps(req.file.path);
      if (gps && gps.latitude && gps.longitude) {
        lat = gps.latitude; lng = gps.longitude; source = 'exif';
      }
    } catch (_) {}

    // Try OCR
    if (!source) {
      const ocr = await extractCoordsFromWatermark(req.file.path);
      if (ocr) { lat = ocr.latitude; lng = ocr.longitude; source = 'ocr'; }
    }

    // Clean up temp file
    try { fs.unlinkSync(req.file.path); } catch (_) {}

    if (source) {
      res.json({ latitude: lat, longitude: lng, source });
    } else {
      res.json({ latitude: null, longitude: null, source: null });
    }
  } catch (err) {
    if (req.file) try { fs.unlinkSync(req.file.path); } catch (_) {}
    res.status(500).json({ error: 'GPS extraction failed' });
  }
});

