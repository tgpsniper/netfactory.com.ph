// PUT /api/admin/map/elements/:id/roles — replace the ODF's role set
// Body: { roles: [{ role, label?, focRouteId?, config? }] }
router.put('/elements/:id/roles', adminAuth(), async (req, res) => {
  try {
    const id = parseInt(req.params.id);
    const el = await req.prisma.$queryRaw`SELECT id, type FROM network_elements WHERE id = ${id}`;
    if (el.length === 0) return res.status(404).json({ error: 'Element not found' });
    if (el[0].type !== 'odf') return res.status(400).json({ error: 'Roles are only managed for ODF elements' });

    const incoming = Array.isArray(req.body.roles) ? req.body.roles : [];
    for (const r of incoming) {
      if (!VALID_ODF_ROLES.includes(r.role)) {
        return res.status(400).json({ error: `Invalid role "${r.role}". Must be: ${VALID_ODF_ROLES.join(', ')}` });
      }
    }
    // Replace-all: clear then re-insert (deduped by role)
    await req.prisma.$executeRawUnsafe(`DELETE FROM odf_roles WHERE odf_id = $1`, id);
    const seen = new Set();
    for (const r of incoming) {
      if (seen.has(r.role)) continue;
      seen.add(r.role);
      const focId = r.focRouteId ? parseInt(r.focRouteId) : null;
      const cfg = r.config ? JSON.stringify(r.config) : null;
      await req.prisma.$executeRawUnsafe(
        `INSERT INTO odf_roles (odf_id, role, label, foc_route_id, config) VALUES ($1, $2, $3, $4, $5::jsonb)`,
        id, r.role, r.label || null, focId, cfg
      );
    }
    res.json({ message: 'Roles updated', count: seen.size });
  } catch (err) {
    console.error('ODF roles update error:', err);
    res.status(500).json({ error: 'Failed to update ODF roles' });
  }
});

