    const focInventory = await req.prisma.$queryRaw`
      SELECT f.id, f.name, f.type, f.cable_size, f.cable_type, f.length_meters, f.status,
             f.municipality, f.barangay,
             COUNT(s.id)::int AS total_strands,
             COUNT(s.id) FILTER (WHERE s.status = 'available')::int AS available_strands,
             COUNT(s.id) FILTER (WHERE s.status = 'used')::int AS used_strands,
             COUNT(s.id) FILTER (WHERE s.status = 'reserved')::int AS reserved_strands,
             COUNT(s.id) FILTER (WHERE s.status = 'damaged')::int AS damaged_strands
      FROM foc_routes f
      LEFT JOIN foc_strands s ON s.foc_route_id = f.id
      GROUP BY f.id
      ORDER BY f.name ASC
    `;

    // NAP inventory with port counts  
    const napInventory = await req.prisma.$queryRaw`
      SELECT n.id, n.name, n.type, n.total_ports, n.status,
             n.municipality, n.barangay,
             f.name AS foc_route_name, f.cable_size AS foc_cable_size,
             COUNT(p.id)::int AS tracked_ports,
             COUNT(p.id) FILTER (WHERE p.status = 'available')::int AS available_ports,
             COUNT(p.id) FILTER (WHERE p.status = 'used')::int AS used_ports,
             COUNT(p.id) FILTER (WHERE p.status = 'reserved')::int AS reserved_ports,
             COUNT(p.id) FILTER (WHERE p.status = 'damaged')::int AS damaged_ports
      FROM naps n
      LEFT JOIN nap_ports p ON p.nap_id = n.id
      LEFT JOIN foc_routes f ON f.id = n.foc_route_id
      GROUP BY n.id, f.name, f.cable_size
      ORDER BY n.name ASC
    `;

