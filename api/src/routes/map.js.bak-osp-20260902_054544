    const routes = await req.prisma.$queryRaw`
      SELECT fr.id, fr.name, fr.type, fr.cable_type, fr.cable_size, fr.length_meters,
             fr.coordinates, fr.color, fr.municipality, fr.barangay, fr.notes, fr.status,
             fr.created_at, fr.updated_at,
             (SELECT COUNT(*)::int FROM foc_strands fs
               WHERE fs.foc_route_id = fr.id
                 AND (fs.status != 'available' OR fs.destination_type IS NOT NULL)) AS used_strands
      FROM foc_routes fr
      ORDER BY fr.name ASC
    `;

    res.json({
      routes: routes.map(r => ({
        id: r.id,
        name: r.name,
        type: r.type,
        cableType: r.cable_type,
        cableSize: r.cable_size,
        length: r.length_meters ? Number(r.length_meters) : null,
        usedStrands: Number(r.used_strands || 0),
        coordinates: typeof r.coordinates === 'string' ? JSON.parse(r.coordinates) : r.coordinates,
        color: r.color,
        municipality: r.municipality,
        barangay: r.barangay,
        notes: r.notes,
        status: r.status,
        createdAt: r.created_at,
        updatedAt: r.updated_at
      }))
    });
  } catch (err) {
    console.error('FOC routes fetch error:', err);
    res.status(500).json({ error: 'Failed to load FOC routes' });
  }
});

// POST /api/admin/map/foc-routes
router.post('/foc-routes', adminOrTagger(), async (req, res) => {
  try {
    const { name, type, cableType, cableSize, length, coordinates, color, municipality, barangay, notes } = req.body;

    if (!name || !coordinates || !Array.isArray(coordinates) || coordinates.length < 2) {
      return res.status(400).json({ error: 'Name and at least 2 coordinate points are required' });
    }

    // Enforce unique route name (case-insensitive + trimmed)
    const dupe = await req.prisma.$queryRaw`
      SELECT id FROM foc_routes WHERE LOWER(TRIM(name)) = LOWER(TRIM(${name})) LIMIT 1`;
    if (dupe.length) {
      return res.status(409).json({ error: `A FOC route named "${String(name).trim()}" already exists` });
    }

    const validTypes = ['aerial', 'underground'];
    const routeType = validTypes.includes(type) ? type : 'aerial';

    const result = await req.prisma.$queryRaw`
      INSERT INTO foc_routes (name, type, cable_type, cable_size, length_meters, coordinates, color, municipality, barangay, notes, created_by)
      VALUES (${name}, ${routeType}, ${cableType || null}, ${cableSize ? parseInt(cableSize) : null},
              ${length ? parseFloat(length) : null}, ${JSON.stringify(coordinates)}::jsonb,
              ${color || null}, ${municipality || null}, ${barangay || null}, ${notes || null}, ${req.userId})
      RETURNING id, name, created_at
    `;

    console.log(`📍 FOC route created: ${name} (${coordinates.length} points, ${routeType})`);

    // Auto-generate strands
    if (cableSize) {
      await generateStrands(req.prisma, result[0].id, cableSize);
      console.log(`   └─ Generated ${cableSize} strands with fiber color codes`);
    }

    res.status(201).json({
      message: 'FOC route created',
      route: { id: result[0].id, name: result[0].name, createdAt: result[0].created_at }
    });
  } catch (err) {
    console.error('FOC route create error:', err);
    res.status(500).json({ error: 'Failed to create FOC route' });
  }
});

// PUT /api/admin/map/foc-routes/:id
router.put('/foc-routes/:id', adminAuth(), async (req, res) => {
  try {
    const id = parseInt(req.params.id);
    const { name, type, cableType, cableSize, length, coordinates, color, municipality, barangay, notes, status } = req.body;

    // Enforce unique route name (case-insensitive + trimmed), ignoring this same route
    if (name !== undefined) {
      const dupe = await req.prisma.$queryRaw`
        SELECT id FROM foc_routes WHERE LOWER(TRIM(name)) = LOWER(TRIM(${name})) AND id <> ${id} LIMIT 1`;
      if (dupe.length) {
        return res.status(409).json({ error: `A FOC route named "${String(name).trim()}" already exists` });
      }
    }

    const fields = [];
    const values = [];
    let paramIdx = 1;

    if (name !== undefined) { fields.push(`name = $${paramIdx++}`); values.push(name); }
    if (type !== undefined) { fields.push(`type = $${paramIdx++}`); values.push(type); }
    if (cableType !== undefined) { fields.push(`cable_type = $${paramIdx++}`); values.push(cableType); }
    if (cableSize !== undefined) { fields.push(`cable_size = $${paramIdx++}`); values.push(parseInt(cableSize)); }
    if (length !== undefined) { fields.push(`length_meters = $${paramIdx++}`); values.push(parseFloat(length)); }
    if (coordinates !== undefined) { fields.push(`coordinates = $${paramIdx++}::jsonb`); values.push(JSON.stringify(coordinates)); }
    if (color !== undefined) { fields.push(`color = $${paramIdx++}`); values.push(color); }
    if (municipality !== undefined) { fields.push(`municipality = $${paramIdx++}`); values.push(municipality); }
    if (barangay !== undefined) { fields.push(`barangay = $${paramIdx++}`); values.push(barangay); }
    if (notes !== undefined) { fields.push(`notes = $${paramIdx++}`); values.push(notes); }
    if (status !== undefined) { fields.push(`status = $${paramIdx++}`); values.push(status); }
    fields.push(`updated_at = NOW()`);

    if (fields.length <= 1) return res.status(400).json({ error: 'No fields to update' });

    values.push(id);
    const sql = `UPDATE foc_routes SET ${fields.join(', ')} WHERE id = $${paramIdx} RETURNING id, name`;
    const result = await req.prisma.$queryRawUnsafe(sql, ...values);

    if (result.length === 0) return res.status(404).json({ error: 'FOC route not found' });

    res.json({ message: 'FOC route updated', route: result[0] });
  } catch (err) {
    console.error('FOC route update error:', err);
    res.status(500).json({ error: 'Failed to update FOC route' });
  }
});

// DELETE /api/admin/map/foc-routes/:id
router.delete('/foc-routes/:id', adminAuth(), async (req, res) => {
  try {
    const id = parseInt(req.params.id);
    
    // Check for assigned strands
    const usedStrands = await req.prisma.$queryRaw`
      SELECT strand_number, status, destination_label 
      FROM foc_strands WHERE foc_route_id = ${id} AND (status != 'available' OR destination_type IS NOT NULL)
      ORDER BY strand_number
    `;
    if (usedStrands.length > 0) {
      const strandNums = usedStrands.map(s => 'S' + s.strand_number).join(', ');
      return res.status(400).json({ 
        error: `Cannot delete FOC route. ${usedStrands.length} strand(s) have active assignments (${strandNums}). Remove all assignments first.` 
      });
    }

    // Check for attached NAPs / Closures (legacy direct FK) and
    // closure_connections (Side A/B/C attachments). Any of these block the delete.
    const attachedNaps = await req.prisma.$queryRaw`SELECT name FROM naps WHERE foc_route_id = ${id}`;
    const attachedClosures = await req.prisma.$queryRaw`SELECT name FROM closures WHERE foc_route_id = ${id}`;
    const attachedConns = await req.prisma.$queryRaw`
      SELECT c.name AS closure_name, cc.side
      FROM closure_connections cc
      JOIN closures c ON c.id = cc.closure_id
      WHERE cc.connection_type = 'foc_route' AND cc.ref_id = ${id}
      ORDER BY c.name, cc.side
    `;
    if (attachedNaps.length > 0 || attachedClosures.length > 0 || attachedConns.length > 0) {
      const items = [
        ...attachedNaps.map(n => 'NAP: ' + n.name),
        ...attachedClosures.map(c => 'Closure: ' + c.name),
        ...attachedConns.map(r => 'Closure: ' + r.closure_name + ' (Side ' + r.side + ')')
      ];
      return res.status(400).json({
        error: `Cannot delete FOC route. Still attached to: ${items.join(', ')}. Detach from each closure's Connections tab first.`
      });
    }

    const result = await req.prisma.$queryRaw`DELETE FROM foc_routes WHERE id = ${id} RETURNING id, name`;
    if (result.length === 0) return res.status(404).json({ error: 'FOC route not found' });
    res.json({ message: `FOC route "${result[0].name}" deleted` });
  } catch (err) {
    console.error('FOC route delete error:', err);
    res.status(500).json({ error: 'Failed to delete FOC route' });
  }
});


