router.get('/closures/connections-bulk', adminOrGuest(), async (req, res) => {
  try {
    const rows = await req.prisma.$queryRaw`
      SELECT cc.id, cc.closure_id, cc.side, cc.sort_order,
             cc.connection_type, cc.ref_id, cc.ref_name,
             cc.fiber_count, cc.core_start, cc.core_end,
             CASE
               WHEN cc.connection_type = 'foc_route' THEN f.name
               WHEN cc.connection_type = 'nap'       THEN n.name
               ELSE NULL
             END AS resolved_name,
             CASE
               WHEN cc.connection_type = 'foc_route' THEN f.cable_size::text
               ELSE NULL
             END AS foc_cable_size,
             CASE
               WHEN cc.connection_type = 'nap' THEN n.total_ports::text
               ELSE NULL
             END AS nap_ports
      FROM closure_connections cc
      LEFT JOIN foc_routes f ON cc.connection_type = 'foc_route' AND cc.ref_id = f.id
      LEFT JOIN naps n       ON cc.connection_type = 'nap'       AND cc.ref_id = n.id
      ORDER BY cc.closure_id ASC, cc.side ASC, cc.sort_order ASC, cc.id ASC
    `;
    const byClosure = {};
    for (const r of rows) {
      const cid = r.closure_id;
      if (!byClosure[cid]) byClosure[cid] = [];
      byClosure[cid].push({
        id: r.id, side: r.side, sortOrder: r.sort_order,
        connectionType: r.connection_type, refId: r.ref_id,
        refName: r.ref_name || r.resolved_name || '',
        fiberCount: r.fiber_count, coreStart: r.core_start, coreEnd: r.core_end,
        focCableSize: r.foc_cable_size, napPorts: r.nap_ports,
      });
    }
    res.json({ byClosure });
  } catch (err) {
    console.error('Closure bulk-connections fetch error:', err);
    res.status(500).json({ error: 'Failed to load closure connections' });
  }
});

