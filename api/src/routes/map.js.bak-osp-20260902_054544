// POST /api/admin/map/closures
router.post('/closures', adminOrTagger(), async (req, res) => {
  try {
    const { name, type, capacity, lat, lng, municipality, barangay, poleNumber, focRouteId, notes, isLcp, lcpTotalPorts } = req.body;

    if (!name || lat === undefined || lng === undefined) {
      return res.status(400).json({ error: 'Name, lat, and lng are required' });
    }

    const validTypes = ['inline', 'branching', 'terminal', 'maintenance_loop'];
    const closureType = validTypes.includes(type) ? type : 'inline';
    const lcpFlag = !!isLcp;
    const lcpPorts = lcpFlag ? (lcpTotalPorts ? parseInt(lcpTotalPorts) : 8) : 8;

    const result = await req.prisma.$queryRaw`
      INSERT INTO closures (name, type, capacity, latitude, longitude, municipality, barangay, pole_number, foc_route_id, notes, is_lcp, lcp_total_ports, created_by)
      VALUES (${name}, ${closureType}, ${capacity ? parseInt(capacity) : 24},
              ${parseFloat(lat)}, ${parseFloat(lng)},
              ${municipality || null}, ${barangay || null}, ${poleNumber || null},
              ${focRouteId ? parseInt(focRouteId) : null}, ${notes || null},
              ${lcpFlag}, ${lcpPorts}, ${req.userId})
      RETURNING id, name, created_at
    `;

    // When the closure acts as an LCP/NAP, auto-generate its subscriber ports.
    if (lcpFlag) {
      await generateClosurePorts(req.prisma, result[0].id, lcpPorts);
      console.log(`   └─ Generated ${lcpPorts} LCP/NAP port records`);
    }

    console.log(`📍 Closure created: ${name} at ${lat}, ${lng}${lcpFlag ? ' (LCP/NAP)' : ''}`);

    res.status(201).json({
      message: 'Closure created',
      closure: { id: result[0].id, name: result[0].name, createdAt: result[0].created_at }
    });
  } catch (err) {
    console.error('Closure create error:', err);
    res.status(500).json({ error: 'Failed to create closure' });
  }
});

// PUT /api/admin/map/closures/:id
router.put('/closures/:id', adminAuth(), async (req, res) => {
  try {
    const id = parseInt(req.params.id);
    const { name, type, capacity, usedCapacity, lat, lng, municipality, barangay, poleNumber, focRouteId, notes, status, isLcp, lcpTotalPorts } = req.body;

    const fields = [];
    const values = [];
    let paramIdx = 1;

    if (name !== undefined) { fields.push(`name = $${paramIdx++}`); values.push(name); }
    if (type !== undefined) { fields.push(`type = $${paramIdx++}`); values.push(type); }
    if (capacity !== undefined) { fields.push(`capacity = $${paramIdx++}`); values.push(parseInt(capacity)); }
    if (usedCapacity !== undefined) { fields.push(`used_capacity = $${paramIdx++}`); values.push(parseInt(usedCapacity)); }
    if (lat !== undefined) { fields.push(`latitude = $${paramIdx++}`); values.push(parseFloat(lat)); }
    if (lng !== undefined) { fields.push(`longitude = $${paramIdx++}`); values.push(parseFloat(lng)); }
    if (municipality !== undefined) { fields.push(`municipality = $${paramIdx++}`); values.push(municipality); }
    if (barangay !== undefined) { fields.push(`barangay = $${paramIdx++}`); values.push(barangay); }
    if (poleNumber !== undefined) { fields.push(`pole_number = $${paramIdx++}`); values.push(poleNumber); }
    if (focRouteId !== undefined) { fields.push(`foc_route_id = $${paramIdx++}`); values.push(focRouteId ? parseInt(focRouteId) : null); }
    if (notes !== undefined) { fields.push(`notes = $${paramIdx++}`); values.push(notes); }
    if (status !== undefined) { fields.push(`status = $${paramIdx++}`); values.push(status); }
    if (isLcp !== undefined) { fields.push(`is_lcp = $${paramIdx++}`); values.push(!!isLcp); }
    if (lcpTotalPorts !== undefined) { fields.push(`lcp_total_ports = $${paramIdx++}`); values.push(parseInt(lcpTotalPorts)); }
    fields.push(`updated_at = NOW()`);

    if (fields.length <= 1) return res.status(400).json({ error: 'No fields to update' });

    values.push(id);
    const sql = `UPDATE closures SET ${fields.join(', ')} WHERE id = $${paramIdx} RETURNING id, name`;
    const result = await req.prisma.$queryRawUnsafe(sql, ...values);

    if (result.length === 0) return res.status(404).json({ error: 'Closure not found' });

    // ── When enabling LCP/NAP, generate ports if none exist yet ──
    if (isLcp === true) {
      const cur = await req.prisma.$queryRaw`SELECT COUNT(*)::int AS count FROM closure_ports WHERE closure_id = ${id}`;
      if (cur[0].count === 0) {
        const ports = lcpTotalPorts !== undefined ? parseInt(lcpTotalPorts) : 8;
        await generateClosurePorts(req.prisma, id, ports);
      }
    }

    // ── Sync closure_ports when lcpTotalPorts changes (mirrors NAP port sync) ──
    if (lcpTotalPorts !== undefined) {
      const newTotal = parseInt(lcpTotalPorts);
      const existing = await req.prisma.$queryRaw`SELECT id, port_number, status, subscriber_id, strand_id FROM closure_ports WHERE closure_id = ${id} ORDER BY port_number`;
      const currentCount = existing.length;

      if (newTotal < currentCount) {
        const portsAbove = existing.filter(p => p.port_number > newTotal);
        const usedAbove = portsAbove.filter(p => p.status !== 'available' || p.subscriber_id || p.strand_id);
        if (usedAbove.length > 0) {
          const portNums = usedAbove.map(p => 'Port ' + p.port_number).join(', ');
          return res.status(400).json({ error: `Cannot reduce to ${newTotal} ports. ${usedAbove.length} port(s) above that limit have active assignments (${portNums}). Remove assignments first.` });
        }
        const toRemove = portsAbove.map(p => p.id);
        if (toRemove.length > 0) {
          await req.prisma.$executeRawUnsafe(`DELETE FROM closure_ports WHERE id = ANY($1::int[])`, toRemove);
        }
      } else if (newTotal > currentCount) {
        for (let i = currentCount + 1; i <= newTotal; i++) {
          await req.prisma.$executeRawUnsafe(`INSERT INTO closure_ports (closure_id, port_number, status) VALUES ($1, $2, 'available') ON CONFLICT DO NOTHING`, id, i);
        }
      }
      await req.prisma.$executeRawUnsafe(`UPDATE closures SET lcp_used_ports = (SELECT COUNT(*) FROM closure_ports WHERE closure_id = $1 AND status = 'used') WHERE id = $1`, id);
    }

    res.json({ message: 'Closure updated', closure: result[0] });
  } catch (err) {
    console.error('Closure update error:', err);
    res.status(500).json({ error: 'Failed to update closure' });
  }
});

// DELETE /api/admin/map/closures/:id
router.delete('/closures/:id', adminAuth(), async (req, res) => {
  try {
    const id = parseInt(req.params.id);
    
    // Check for attached NAPs
    const attachedNaps = await req.prisma.$queryRaw`SELECT name FROM naps WHERE closure_id = ${id}`;
    if (attachedNaps.length > 0) {
      const names = attachedNaps.map(n => n.name).join(', ');
      return res.status(400).json({ 
        error: `Cannot delete closure. Still attached to NAP(s): ${names}. Detach them first.` 
      });
    }

    // Check for strands referencing this closure
    const linkedStrands = await req.prisma.$queryRaw`
      SELECT s.strand_number, f.name AS foc_name FROM foc_strands s
      JOIN foc_routes f ON f.id = s.foc_route_id
      WHERE s.destination_type = 'closure' AND s.destination_id = ${id}
    `;
    if (linkedStrands.length > 0) {
      const refs = linkedStrands.map(s => s.foc_name + ' S' + s.strand_number).join(', ');
      return res.status(400).json({
        error: `Cannot delete closure. Referenced by strand(s): ${refs}. Remove assignments first.`
      });
    }

    // Check for assigned LCP/NAP ports (closure_ports cascade-deletes, but block if in use)
    const usedClosurePorts = await req.prisma.$queryRaw`
      SELECT port_number FROM closure_ports
      WHERE closure_id = ${id} AND (status != 'available' OR subscriber_id IS NOT NULL OR strand_id IS NOT NULL)
      ORDER BY port_number
    `;
    if (usedClosurePorts.length > 0) {
      const portNums = usedClosurePorts.map(p => 'Port ' + p.port_number).join(', ');
      return res.status(400).json({
        error: `Cannot delete closure. ${usedClosurePorts.length} LCP/NAP port(s) have active assignments (${portNums}). Remove all assignments first.`
      });
    }

    const result = await req.prisma.$queryRaw`DELETE FROM closures WHERE id = ${id} RETURNING id, name`;
    if (result.length === 0) return res.status(404).json({ error: 'Closure not found' });
    res.json({ message: `Closure "${result[0].name}" deleted` });
  } catch (err) {
    console.error('Closure delete error:', err);
    res.status(500).json({ error: 'Failed to delete closure' });
  }
});


// ════════════════════════════════════════════════════════════
// CLOSURE SEAL HISTORY
// ════════════════════════════════════════════════════════════
// Each closure tracks a seal (tamper indicator) lifecycle. Every time the
// seal is placed or replaced we record a row in closure_seals with the
// reason. The denormalized seal_* columns on closures hold the CURRENT
// seal so simple GETs don't need a join.

// GET /api/admin/map/closures/:id/seals — history (newest first)
router.get('/closures/:id/seals', adminOrGuest(), async (req, res) => {
  try {
    const id = parseInt(req.params.id);
    const rows = await req.prisma.$queryRaw`
      SELECT s.id, s.seal_number, s.seal_date, s.seal_state, s.reason,
             s.previous_seal_number, s.created_by, s.created_at,
             a.name AS created_by_name
      FROM closure_seals s
      LEFT JOIN admin_users a ON a.id = s.created_by
      WHERE s.closure_id = ${id}
      ORDER BY COALESCE(s.seal_date, s.created_at::date) DESC, s.created_at DESC
    `;
    res.json({
      seals: rows.map(r => ({
        id: Number(r.id),
        sealNumber: r.seal_number,
        sealDate: r.seal_date,
        sealState: r.seal_state,
        reason: r.reason,
        previousSealNumber: r.previous_seal_number,
        createdBy: r.created_by ? Number(r.created_by) : null,
        createdByName: r.created_by_name,
        createdAt: r.created_at
      }))
    });
  } catch (err) {
    console.error('Closure seals fetch error:', err);
    res.status(500).json({ error: 'Failed to load seal history' });
  }
});

// POST /api/admin/map/closures/:id/seals — record a new seal event
router.post('/closures/:id/seals', adminAuth(), async (req, res) => {
  try {
    const id = parseInt(req.params.id);
    const { sealNumber, sealDate, sealState, reason } = req.body;
    if (!sealState || !['new','replaced'].includes(sealState)) {
      return res.status(400).json({ error: 'sealState must be "new" or "replaced"' });
    }
    if (sealState === 'replaced' && !reason) {
      return res.status(400).json({ error: 'A reason is required when replacing a seal' });
    }
    // Carry forward the previous seal number for audit context.
    const cur = await req.prisma.$queryRaw`SELECT seal_number FROM closures WHERE id = ${id}`;
    if (cur.length === 0) return res.status(404).json({ error: 'Closure not found' });
    const previousSealNumber = cur[0].seal_number || null;
    const inserted = await req.prisma.$queryRaw`
      INSERT INTO closure_seals (closure_id, seal_number, seal_date, seal_state, reason, previous_seal_number, created_by)
      VALUES (${id}, ${sealNumber || null}, ${sealDate ? new Date(sealDate) : null}, ${sealState}, ${reason || null}, ${previousSealNumber}, ${req.userId || null})
      RETURNING id, created_at
    `;
    // Sync the denormalized current-seal fields on the closure.
    await req.prisma.$queryRaw`
      UPDATE closures
      SET seal_number = ${sealNumber || null},
          seal_date = ${sealDate ? new Date(sealDate) : null},
          seal_state = ${sealState},
          updated_at = NOW()
      WHERE id = ${id}
    `;
    res.status(201).json({
      message: 'Seal recorded',
      seal: { id: Number(inserted[0].id), createdAt: inserted[0].created_at, previousSealNumber }
    });
  } catch (err) {
    console.error('Closure seal create error:', err);
    res.status(500).json({ error: 'Failed to record seal' });
  }
});

