// GET /api/admin/map/closures/:id/splices
router.get('/closures/:id/splices', adminOrGuest(), async (req, res) => {
  try {
    const closureId = parseInt(req.params.id);

    const splices = await req.prisma.$queryRaw`
      SELECT cs.id, cs.a_conn_id, cs.a_strand_id, cs.b_conn_id, cs.b_strand_id, cs.notes,
             sa.strand_number AS a_number, sa.color_code AS a_color,
             sb.strand_number AS b_number, sb.color_code AS b_color
      FROM closure_splices cs
      LEFT JOIN foc_strands sa ON sa.id = cs.a_strand_id
      LEFT JOIN foc_strands sb ON sb.id = cs.b_strand_id
      WHERE cs.closure_id = ${closureId}
      ORDER BY sa.strand_number ASC
    `;

    const connsA = await req.prisma.$queryRaw`
      SELECT cc.id AS conn_id, cc.ref_id, cc.ref_name, cc.connection_type,
             f.name AS foc_name, f.cable_size
      FROM closure_connections cc
      LEFT JOIN foc_routes f ON f.id = cc.ref_id AND cc.connection_type = 'foc_route'
      WHERE cc.closure_id = ${closureId} AND cc.side = 'A'
      ORDER BY cc.sort_order
    `;

    const connsB = await req.prisma.$queryRaw`
      SELECT cc.id AS conn_id, cc.ref_id, cc.ref_name, cc.connection_type,
             f.name AS foc_name, f.cable_size
      FROM closure_connections cc
      LEFT JOIN foc_routes f ON f.id = cc.ref_id AND cc.connection_type = 'foc_route'
      WHERE cc.closure_id = ${closureId} AND cc.side = 'B'
      ORDER BY cc.sort_order
    `;

    const connsC = await req.prisma.$queryRaw`
      SELECT cc.id AS conn_id, cc.ref_id, cc.ref_name, cc.connection_type,
             f.name AS foc_name, f.cable_size
      FROM closure_connections cc
      LEFT JOIN foc_routes f ON f.id = cc.ref_id AND cc.connection_type = 'foc_route'
      WHERE cc.closure_id = ${closureId} AND cc.side = 'C'
      ORDER BY cc.sort_order
    `;

    // For any strand on any side, look up ALL splices that involve it
    // (a strand may participate in multiple splices, e.g. Side B as both
    // pass-through from A and tap to C). Map<id, Array<{splice, role}>>.
    const strandToSplice = new Map();
    splices.forEach(s => {
      if (s.a_strand_id) {
        const arr = strandToSplice.get(Number(s.a_strand_id)) || [];
        arr.push({ splice: s, role: 'a' });
        strandToSplice.set(Number(s.a_strand_id), arr);
      }
      if (s.b_strand_id) {
        const arr = strandToSplice.get(Number(s.b_strand_id)) || [];
        arr.push({ splice: s, role: 'b' });
        strandToSplice.set(Number(s.b_strand_id), arr);
      }
    });

    // Side-agnostic strand loader. Looks up each strand's splice via the
    // global strandToSplice map (works regardless of which side is "a"/"b"
    // in the splice row).
    async function loadConnStrands(conn) {
      if (conn.connection_type !== 'foc_route' || !conn.ref_id) {
        if (conn.connection_type === 'nap') {
          const napSplices = await req.prisma.$queryRaw`SELECT nap_port_number, id as splice_id FROM closure_splices WHERE closure_id = ${closureId} AND b_conn_id = ${parseInt(conn.conn_id)} AND nap_port_number IS NOT NULL`;
          const portSplices = {};
          napSplices.forEach(sp => { portSplices[Number(sp.nap_port_number)] = { spliceId: Number(sp.splice_id) }; });
          return { connId: conn.conn_id, connectionType: 'nap', refName: conn.ref_name, napPorts: parseInt(conn.cable_size)||8, portSplices, strands: [] };
        }
        return { connId: conn.conn_id, connectionType: conn.connection_type, refName: conn.ref_name, strands: [] };
      }
      const strands = await req.prisma.$queryRaw`
        SELECT id, strand_number AS number, color_code AS color, tube_number AS tube,
               tube_color AS "tubeColor", status, destination_label AS "destLabel"
        FROM foc_strands
        WHERE foc_route_id = ${parseInt(conn.ref_id)}
        ORDER BY strand_number
      `;
      return {
        connId: conn.conn_id, connectionType: conn.connection_type,
        refId: Number(conn.ref_id), refName: conn.foc_name || conn.ref_name,
        cableSize: Number(conn.cable_size || 0),
        strands: strands.map(s => {
          const ents = strandToSplice.get(Number(s.id)) || [];
          const base = { ...s, id: Number(s.id), number: Number(s.number), tube: Number(s.tube) };
          if (ents.length === 0) return { ...base, spliceId: null, splices: [] };
          const peers = ents.map(ent => {
            const sp = ent.splice;
            const isA = ent.role === 'a';
            return {
              spliceId:          Number(sp.id),
              splicedToStrandId: isA ? (sp.b_strand_id ? Number(sp.b_strand_id) : null) : Number(sp.a_strand_id),
              splicedToNumber:   sp.nap_port_number ? null : Number(isA ? sp.b_number : sp.a_number),
              splicedToNapPort:  sp.nap_port_number ? Number(sp.nap_port_number) : null,
              splicedToColor:    isA ? sp.b_color : sp.a_color,
              splicedToConnId:   isA ? (sp.b_conn_id ? Number(sp.b_conn_id) : null) : Number(sp.a_conn_id)
            };
          });
          // Legacy single-peer fields point to the first splice (for back-compat)
          return { ...base, ...peers[0], splices: peers };
        })
      };
    }

    const sideA = await Promise.all(connsA.map(c => loadConnStrands(c)));
    const sideB = await Promise.all(connsB.map(c => loadConnStrands(c)));
    const sideC = await Promise.all(connsC.map(c => loadConnStrands(c)));

    res.json({
      splices: splices.map(s => ({
        id: Number(s.id),
        aConnId: s.a_conn_id ? Number(s.a_conn_id) : null,
        aStrandId: Number(s.a_strand_id),
        bConnId: s.b_conn_id ? Number(s.b_conn_id) : null,
        bStrandId: Number(s.b_strand_id),
        notes: s.notes
      })),
      sideA, sideB, sideC
    });
  } catch (err) {
    console.error('Splices fetch error:', err);
    res.status(500).json({ error: 'Failed to load splices' });
  }
});

// POST /api/admin/map/closures/:id/splices
router.post('/closures/:id/splices', adminAuth(), async (req, res) => {
  try {
    const closureId = parseInt(req.params.id);
    let { aConnId, aStrandId, bConnId, bStrandId, bNapPort, notes } = req.body;
    if (!aStrandId || (!bStrandId && !bNapPort)) return res.status(400).json({ error: 'aStrandId and either bStrandId or bNapPort required' });
    // Reject self-splices (a strand spliced to itself). This happens when two
    // closure_connections on different sides reference the same foc_route, so
    // the "two sides" actually share the same physical strand.
    if (bStrandId && parseInt(aStrandId) === parseInt(bStrandId)) {
      return res.status(400).json({ error: 'Cannot splice a fiber to itself. The two sides appear to share the same FOC route — use a different cable for the lateral.' });
    }
    // Auto-swap a/b sides to avoid uq_splice_a / uq_splice_b conflicts when one
    // strand is already in another splice. This lets a single Side B fiber
    // participate in both an A↔B and a B↔C splice (a "branch" / pass-through tap).
    if (!bNapPort && bStrandId) {
      const aStr = parseInt(aStrandId), bStr = parseInt(bStrandId);
      const aOnA = await req.prisma.$queryRaw`SELECT 1 FROM closure_splices WHERE closure_id = ${closureId} AND a_strand_id = ${aStr} LIMIT 1`;
      const bOnB = await req.prisma.$queryRaw`SELECT 1 FROM closure_splices WHERE closure_id = ${closureId} AND b_strand_id = ${bStr} LIMIT 1`;
      // If a_strand conflicts on a-side OR b_strand conflicts on b-side, swap.
      if (aOnA.length > 0 || bOnB.length > 0) {
        // Verify swap is safe (no conflict on the other side either)
        const aOnB = await req.prisma.$queryRaw`SELECT 1 FROM closure_splices WHERE closure_id = ${closureId} AND b_strand_id = ${aStr} LIMIT 1`;
        const bOnA = await req.prisma.$queryRaw`SELECT 1 FROM closure_splices WHERE closure_id = ${closureId} AND a_strand_id = ${bStr} LIMIT 1`;
        if (aOnB.length === 0 && bOnA.length === 0) {
          [aConnId, bConnId] = [bConnId, aConnId];
          [aStrandId, bStrandId] = [bStrandId, aStrandId];
        }
      }
    }
    const result = await req.prisma.$queryRaw`
      INSERT INTO closure_splices (closure_id, a_conn_id, a_strand_id, b_conn_id, b_strand_id, notes, nap_port_number)
      VALUES (${closureId}, ${aConnId ? parseInt(aConnId) : null}, ${parseInt(aStrandId)},
              ${bConnId ? parseInt(bConnId) : null}, ${bNapPort ? null : parseInt(bStrandId)}, ${notes || null},
              ${bNapPort ? parseInt(bNapPort) : null})
      RETURNING id
    `;
    // Update strand statuses to 'used'
    if (aStrandId) await req.prisma.$queryRaw`UPDATE foc_strands SET status = 'used' WHERE id = ${parseInt(aStrandId)}`;
    if (bStrandId && !bNapPort) await req.prisma.$queryRaw`UPDATE foc_strands SET status = 'used' WHERE id = ${parseInt(bStrandId)}`;
    // Update NAP port status + link strand when splicing to NAP
    if (bNapPort && bConnId) {
      const napConn = await req.prisma.$queryRaw`SELECT ref_id, (SELECT name FROM naps WHERE id = cc.ref_id) AS nap_name FROM closure_connections cc WHERE id = ${parseInt(bConnId)}`;
      if (napConn[0]) {
        const napId = napConn[0].ref_id;
        const napName = napConn[0].nap_name;
        await req.prisma.$queryRaw`UPDATE nap_ports SET status = 'used', strand_id = ${parseInt(aStrandId)} WHERE nap_id = ${napId} AND port_number = ${parseInt(bNapPort)}`;
        // Update naps.used_ports counter
        await req.prisma.$queryRaw`UPDATE naps SET used_ports = (SELECT COUNT(*) FROM nap_ports WHERE nap_id = ${napId} AND status = 'used') WHERE id = ${napId}`;
        // Set destination on the A strand
        await req.prisma.$queryRaw`UPDATE foc_strands SET destination_type = 'nap', destination_id = ${napId}, destination_label = ${napName + ' Port ' + bNapPort} WHERE id = ${parseInt(aStrandId)}`;
      }
    } else if (bStrandId && aStrandId) {
      // Get route names for destination labels
      const aInfo = await req.prisma.$queryRaw`SELECT fr.name AS route_name, fs.strand_number FROM foc_strands fs JOIN foc_routes fr ON fs.foc_route_id = fr.id WHERE fs.id = ${parseInt(aStrandId)}`;
      const bInfo = await req.prisma.$queryRaw`SELECT fr.name AS route_name, fs.strand_number FROM foc_strands fs JOIN foc_routes fr ON fs.foc_route_id = fr.id WHERE fs.id = ${parseInt(bStrandId)}`;
      if (aInfo[0] && bInfo[0]) {
        await req.prisma.$queryRaw`UPDATE foc_strands SET destination_type = 'foc', destination_id = ${parseInt(bStrandId)}, destination_label = ${bInfo[0].route_name + ' F' + bInfo[0].strand_number} WHERE id = ${parseInt(aStrandId)}`;
        await req.prisma.$queryRaw`UPDATE foc_strands SET destination_type = 'foc', destination_id = ${parseInt(aStrandId)}, destination_label = ${aInfo[0].route_name + ' F' + aInfo[0].strand_number} WHERE id = ${parseInt(bStrandId)}`;
      }
    }
    await req.prisma.$queryRaw`UPDATE closures SET used_capacity = (SELECT COUNT(*) FROM closure_splices WHERE closure_id = ${closureId}) WHERE id = ${closureId}`;
    res.status(201).json({ message: 'Splice created', spliceId: Number(result[0].id) });
  } catch (err) {
    if (err.message && err.message.includes('unique')) return res.status(409).json({ error: 'Fiber already spliced' });
    console.error('Splice create error:', err);
    res.status(500).json({ error: 'Failed to create splice' });
  }
});

// DELETE /api/admin/map/closures/:id/splices/:spliceId
router.delete('/closures/:id/splices/:spliceId', adminAuth(), async (req, res) => {
  try {
    // Fetch strand IDs before deleting
    const spliceRow = await req.prisma.$queryRaw`SELECT a_strand_id, b_strand_id, nap_port_number, b_conn_id FROM closure_splices WHERE id = ${parseInt(req.params.spliceId)}`;
    const sp = spliceRow[0] || {};
    await req.prisma.$queryRaw`
      DELETE FROM closure_splices
      WHERE id = ${parseInt(req.params.spliceId)} AND closure_id = ${parseInt(req.params.id)}
    `;
    // Reset strand statuses back to 'available' — but only if the strand has
    // no other splice rows referencing it (a strand may participate in multiple
    // splices, e.g. Side B passing A↔B and tapping B↔C).
    const stillSpliced = async (strandId) => {
      const r = await req.prisma.$queryRaw`SELECT 1 FROM closure_splices WHERE a_strand_id = ${strandId} OR b_strand_id = ${strandId} LIMIT 1`;
      return r.length > 0;
    };
    if (sp.a_strand_id && !(await stillSpliced(sp.a_strand_id))) await req.prisma.$queryRaw`UPDATE foc_strands SET status = 'available' WHERE id = ${sp.a_strand_id}`;
    if (sp.b_strand_id && !(await stillSpliced(sp.b_strand_id))) await req.prisma.$queryRaw`UPDATE foc_strands SET status = 'available' WHERE id = ${sp.b_strand_id}`;
    // Reset NAP port if this was a NAP splice
    if (sp.nap_port_number && sp.b_conn_id) {
      const napConn = await req.prisma.$queryRaw`SELECT ref_id FROM closure_connections WHERE id = ${sp.b_conn_id}`;
      if (napConn[0]) {
        const napId = napConn[0].ref_id;
        await req.prisma.$queryRaw`UPDATE nap_ports SET status = 'available', strand_id = NULL WHERE nap_id = ${napId} AND port_number = ${sp.nap_port_number}`;
        // Update naps.used_ports counter
        await req.prisma.$queryRaw`UPDATE naps SET used_ports = (SELECT COUNT(*) FROM nap_ports WHERE nap_id = ${napId} AND status = 'used') WHERE id = ${napId}`;
      }
    }
    // Clear destination labels on strands — same conditional as status reset.
    if (sp.a_strand_id && !(await stillSpliced(sp.a_strand_id))) await req.prisma.$queryRaw`UPDATE foc_strands SET destination_type = NULL, destination_id = NULL, destination_label = NULL WHERE id = ${sp.a_strand_id}`;
    if (sp.b_strand_id && !(await stillSpliced(sp.b_strand_id))) await req.prisma.$queryRaw`UPDATE foc_strands SET destination_type = NULL, destination_id = NULL, destination_label = NULL WHERE id = ${sp.b_strand_id}`;
    await req.prisma.$queryRaw`UPDATE closures SET used_capacity = (SELECT COUNT(*) FROM closure_splices WHERE closure_id = ${parseInt(req.params.id)}) WHERE id = ${parseInt(req.params.id)}`;
    res.json({ message: 'Splice removed' });
  } catch (err) {
    console.error('Splice delete error:', err);
    res.status(500).json({ error: 'Failed to remove splice' });
  }
});

