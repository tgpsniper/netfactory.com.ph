// POST /api/admin/map/validate-code — public endpoint to validate a share code
// (no auth required — this is how guests get their JWT)
router.post('/validate-code', async (req, res) => {
  try {
    const { code } = req.body;
    if (!code) return res.status(400).json({ error: 'Code is required' });

    const rows = await req.prisma.$queryRaw`
      SELECT * FROM gis_share_tokens
      WHERE code = ${code.toUpperCase()} AND is_active = true AND expires_at > NOW()
    `;

    if (!rows.length) return res.status(401).json({ error: 'Invalid or expired share code' });

    const token_row = rows[0];

    // Update usage stats
    await req.prisma.$queryRaw`
      UPDATE gis_share_tokens
      SET use_count = use_count + 1, last_used_at = NOW()
      WHERE id = ${token_row.id}
    `;

    // Issue a guest JWT (expires when the share link expires, max 24h)
    const jwt = require('jsonwebtoken');
    const maxMs = Math.min(token_row.expires_at.getTime() - Date.now(), 86400000);
    const guestToken = jwt.sign(
      { guestCode: token_row.code, permissions: token_row.permissions, label: token_row.label },
      process.env.JWT_SECRET,
      { expiresIn: Math.floor(maxMs / 1000) }
    );

    res.json({
      token: guestToken,
      permissions: token_row.permissions,
      label: token_row.label,
      expiresAt: new Date(Date.now() + maxMs).toISOString(),
    });
  } catch (err) {
    console.error('Code validation error:', err);
    res.status(500).json({ error: 'Validation failed' });
  }
});
