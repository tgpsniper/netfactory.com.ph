// PUT /api/admin/map/strands/:id — Update a single strand (with cascading)
router.put('/strands/:id', adminAuth(), async (req, res) => {
  try {
    const id = parseInt(req.params.id);
    const { status, destinationType, destinationId, destinationLabel, notes } = req.body;

    // Auto-set status to 'used' if assigning a destination
    const finalStatus = (destinationType && destinationId) ? 'used' : (status || null);

    const result = await req.prisma.$queryRaw`
      UPDATE foc_strands SET
        status = COALESCE(${finalStatus}, status),
        destination_type = ${destinationType || null},
        destination_id = ${destinationId ? parseInt(destinationId) : null},
        destination_label = ${destinationLabel || null},
        notes = ${notes !== undefined ? notes : null},
        updated_at = NOW()
      WHERE id = ${id}
      RETURNING id, strand_number, foc_route_id, color_code, tube_number
    `;
    if (result.length === 0) return res.status(404).json({ error: 'Strand not found' });

    const strand = result[0];
    const focRoute = await req.prisma.$queryRaw`SELECT id, name, cable_size FROM foc_routes WHERE id = ${strand.foc_route_id}`;
    const focName = focRoute.length > 0 ? focRoute[0].name : 'Unknown';
    const focCableSize = focRoute.length > 0 ? focRoute[0].cable_size : '?';

    // ── CASCADE: NAP port ──
    // If destination is NAP + port selected (destinationLabel contains "Port X")
    if (destinationType === 'nap' && destinationId) {
      const napId = parseInt(destinationId);
      
      // Parse port ID from destinationLabel if present (format: "p123" prefix from frontend)
      const portMatch = destinationLabel && destinationLabel.match(/Port (\d+)/);
      
      if (portMatch) {
        const portNumber = parseInt(portMatch[1]);
        // Update the specific NAP port
        await req.prisma.$executeRawUnsafe(
          `UPDATE nap_ports SET 
            status = 'used',
            strand_id = $1,
            notes = COALESCE(notes, '') || CASE WHEN notes IS NOT NULL AND notes != '' THEN '; ' ELSE '' END || $2,
            updated_at = NOW()
          WHERE nap_id = $3 AND port_number = $4 AND status = 'available'`,
          id,
          'Auto-linked: ' + focName + ' (' + focCableSize + 'C) S' + strand.strand_number + ' ' + strand.color_code,
          napId,
          portNumber
        );
        // Update NAP used_ports count
        await req.prisma.$executeRawUnsafe(
          `UPDATE naps SET used_ports = (SELECT COUNT(*) FROM nap_ports WHERE nap_id = $1 AND status = 'used'), foc_route_id = COALESCE(foc_route_id, $2) WHERE id = $1`,
          napId, strand.foc_route_id
        );
        console.log(`   └─ Auto-linked: Strand S${strand.strand_number} → NAP port ${portNumber} (NAP #${napId})`);
      }
    }

    // ── CASCADE: FOC strand-to-strand ──
    if (destinationType === 'foc' && destinationId) {
      const destFocId = parseInt(destinationId);
      // Parse strand ID from destinationLabel if present (format: "s123" prefix from frontend)
      const strandMatch = destinationLabel && destinationLabel.match(/S(\d+)/);
      
      if (strandMatch) {
        const destStrandNum = parseInt(strandMatch[1]);
        // Update the destination strand to point back
        await req.prisma.$executeRawUnsafe(
          `UPDATE foc_strands SET 
            status = 'used',
            destination_type = 'foc',
            destination_id = $1,
            destination_label = $2,
            updated_at = NOW()
          WHERE foc_route_id = $3 AND strand_number = $4 AND status = 'available'`,
          strand.foc_route_id,
          focName + ' (' + focCableSize + 'C) → S' + strand.strand_number + ' (' + strand.color_code + ', T' + strand.tube_number + ')',
          destFocId,
          destStrandNum
        );
        console.log(`   └─ Auto-linked: Strand S${strand.strand_number} ↔ Dest FOC #${destFocId} S${destStrandNum}`);
      }
    }

    // ── CASCADE: Clear old links if destination removed ──
    if (!destinationType && !destinationId) {
      // Get old strand data to clean up
      // (strand was already updated, but we can check if there were old links in nap_ports)
      await req.prisma.$executeRawUnsafe(
        `UPDATE nap_ports SET status = 'available', strand_id = NULL, updated_at = NOW() WHERE strand_id = $1`,
        id
      );
      // Recount NAP used_ports for any affected NAPs
      await req.prisma.$executeRawUnsafe(
        `UPDATE naps SET used_ports = (SELECT COUNT(*) FROM nap_ports WHERE nap_id = naps.id AND status = 'used')
         WHERE id IN (SELECT DISTINCT nap_id FROM nap_ports WHERE strand_id IS NULL)`
      );
    }

    res.json({ message: 'Strand updated', strand: strand });
  } catch (err) {
    console.error('Strand update error:', err);
    res.status(500).json({ error: 'Failed to update strand' });
  }
});

