    if (notes !== undefined)    { fields.push('notes = $' + (vals.length + 1)); vals.push(notes || null); }
    if (status !== undefined)   { fields.push('status = $' + (vals.length + 1)); vals.push(status); }
    fields.push('updated_at = NOW()');
    if (fields.length <= 1) return res.status(400).json({ error: 'No fields to update' });
    vals.push(id);
    await req.prisma.$queryRawUnsafe(`UPDATE network_elements SET ${fields.join(', ')} WHERE id = $${vals.length}`, ...vals);

    // Keep an ODF's port array in sync with its port count (add new, trim unused tail — never drop a used port).
    const el = await req.prisma.$queryRaw`SELECT type, port_count FROM network_elements WHERE id = ${id}`;
    if (el.length && el[0].type === 'odf' && portCount !== undefined) {
      const target = parseInt(el[0].port_count) || 0;
      const existing = await req.prisma.$queryRaw`SELECT port_number, status FROM odf_ports WHERE odf_id = ${id} ORDER BY port_number`;
      const have = existing.length;
      if (target > have) {
        for (let i = have + 1; i <= target; i++) {
          await req.prisma.$executeRawUnsafe(`INSERT INTO odf_ports (odf_id, port_number, status) VALUES ($1, $2, 'available') ON CONFLICT DO NOTHING`, id, i);
        }
      } else if (target < have) {
        const removable = existing.filter(p => p.port_number > target && p.status === 'available').map(p => p.port_number);
        if (removable.length) {
          await req.prisma.$executeRawUnsafe(`DELETE FROM odf_ports WHERE odf_id = $1 AND port_number = ANY($2::int[])`, id, removable);
        }
      }
    }
    res.json({ message: 'Element updated' });
  } catch (err) {
    console.error('Network element update error:', err);
    res.status(500).json({ error: 'Failed to update element' });
  }
});

