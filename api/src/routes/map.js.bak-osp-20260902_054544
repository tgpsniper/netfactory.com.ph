// PUT /api/admin/map/ports/:id — Update a single port (with cascading)
router.put('/ports/:id', adminAuth(), async (req, res) => {
  try {
    const id = parseInt(req.params.id);
    const { status, subscriberId, subscriberLabel, strandId, notes } = req.body;

    // Coerce strandId: blank / 0 / negative / non-numeric → null (FK is nullable).
    // This prevents `strand_id = 0` FK violations when the user clears the field.
    const sidNum = parseInt(strandId);
    const sidFinal = (Number.isFinite(sidNum) && sidNum > 0) ? sidNum : null;

    // If a strand was supplied, verify it exists — fail with a friendly 400 instead
    // of letting Postgres throw a generic 23503.
    if (sidFinal !== null) {
      const exists = await req.prisma.$queryRaw`SELECT 1 AS ok FROM foc_strands WHERE id = ${sidFinal} LIMIT 1`;
      if (exists.length === 0) {
        return res.status(400).json({ error: `Strand ID ${sidFinal} does not exist. Use the strand picker.` });
      }
    }

    // Auto-set status to 'used' if assigning a subscriber
    const finalStatus = subscriberId ? 'used' : (status || null);

    const result = await req.prisma.$queryRaw`
      UPDATE nap_ports SET
        status = COALESCE(${finalStatus}, status),
        subscriber_id = ${subscriberId ? parseInt(subscriberId) : null},
        subscriber_label = ${subscriberLabel || null},
        strand_id = ${sidFinal},
        notes = ${notes !== undefined ? notes : null},
        updated_at = NOW()
      WHERE id = ${id}
      RETURNING id, port_number, nap_id, strand_id
    `;
    if (result.length === 0) return res.status(404).json({ error: 'Port not found' });

    const port = result[0];
    const napId = port.nap_id;

    // Update NAP used_ports count
    await req.prisma.$executeRawUnsafe(
      `UPDATE naps SET used_ports = (SELECT COUNT(*) FROM nap_ports WHERE nap_id = $1 AND status = 'used') WHERE id = $1`,
      napId
    );

    // ── CASCADE: Update linked strand with subscriber info ──
    if (port.strand_id && subscriberId && subscriberLabel) {
      // Get NAP name
      const nap = await req.prisma.$queryRaw`SELECT name FROM naps WHERE id = ${napId}`;
      const napName = nap.length > 0 ? nap[0].name : 'NAP';
      
      // Update the strand destination label to include subscriber
      await req.prisma.$executeRawUnsafe(
        `UPDATE foc_strands SET 
          destination_label = $1,
          updated_at = NOW()
        WHERE id = $2`,
        napName + ' Port ' + port.port_number + ' → ' + subscriberLabel,
        port.strand_id
      );
      console.log(`   └─ Auto-updated: Strand #${port.strand_id} label → ${subscriberLabel}`);
    }

    // ── CASCADE: Clear strand link if port freed ──
    if (!subscriberId && finalStatus === 'available' && port.strand_id) {
      // Don't clear the strand, but note port is freed
      console.log(`   └─ Port ${port.port_number} freed, strand #${port.strand_id} still linked`);
    }

    res.json({ message: 'Port updated', port: port });
  } catch (err) {
    console.error('Port update error:', err);
    res.status(500).json({ error: 'Failed to update port' });
  }
});


