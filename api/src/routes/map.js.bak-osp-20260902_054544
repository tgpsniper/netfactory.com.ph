// Standard 12-color fiber code
const FIBER_COLORS = ['blue','orange','green','brown','slate','white','red','black','yellow','violet','rose','aqua'];

function getStrandColor(strandNum) {
  return FIBER_COLORS[(strandNum - 1) % 12];
}
function getTubeNumber(strandNum) {
  return Math.ceil(strandNum / 12);
}
function getTubeColor(tubeNum) {
  return FIBER_COLORS[(tubeNum - 1) % 12];
}

// Auto-generate strands for a FOC route
async function generateStrands(prisma, focRouteId, cableSize) {
  const count = parseInt(cableSize) || 12;
  const values = [];
  for (let i = 1; i <= count; i++) {
    values.push(`(${focRouteId}, ${i}, '${getStrandColor(i)}', ${getTubeNumber(i)}, '${getTubeColor(getTubeNumber(i))}', 'available')`);
  }
  if (values.length > 0) {
    await prisma.$executeRawUnsafe(
      `INSERT INTO foc_strands (foc_route_id, strand_number, color_code, tube_number, tube_color, status)
       VALUES ${values.join(',')}
       ON CONFLICT (foc_route_id, strand_number) DO NOTHING`
    );
  }
  return count;
}

