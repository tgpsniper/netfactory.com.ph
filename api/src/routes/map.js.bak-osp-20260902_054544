// Auth middleware — reuse the admin auth from existing setup
const adminAuth = () => {
  return async (req, res, next) => {
    try {
      const token = req.headers.authorization?.split(' ')[1];
      if (!token) return res.status(401).json({ error: 'No token provided' });

      const jwt = require('jsonwebtoken');
      const decoded = jwt.verify(token, process.env.JWT_SECRET);
      // Reject guest tokens — admin routes require real admin credentials
      if (decoded.guestCode) return res.status(403).json({ error: 'Admin access required' });
      req.userId = decoded.id || decoded.userId;
      req.userRole = 'admin';
      next();
    } catch (err) {
      return res.status(401).json({ error: 'Invalid or expired token' });
    }
  };
};

// Admin or Guest-with-tag-permission — for POST routes that taggers can use
const adminOrTagger = () => {
  return async (req, res, next) => {
    try {
      const token = req.headers.authorization?.split(' ')[1];
      if (!token) return res.status(401).json({ error: 'No token provided' });

      const jwt = require('jsonwebtoken');
      const decoded = jwt.verify(token, process.env.JWT_SECRET);

      if (decoded.guestCode) {
        if (decoded.permissions !== 'view_tag') {
          return res.status(403).json({ error: 'Tagging permission required' });
        }
        req.userId = null;
        req.userRole = 'guest';
        req.guestCode = decoded.guestCode;
        req.guestPermissions = decoded.permissions;
      } else {
        req.userId = decoded.id || decoded.userId;
        req.userRole = 'admin';
      }
      next();
    } catch (err) {
      return res.status(401).json({ error: 'Invalid or expired token' });
    }
  };
};

// Guest or Admin auth — accepts admin JWT OR guest JWT (from share links)
const adminOrGuest = () => {
  return async (req, res, next) => {
    try {
      const token = req.headers.authorization?.split(' ')[1];
      if (!token) return res.status(401).json({ error: 'No token provided' });

      const jwt = require('jsonwebtoken');
      const decoded = jwt.verify(token, process.env.JWT_SECRET);

      if (decoded.guestCode) {
        // Guest token — set limited context
        req.userId = null;
        req.userRole = 'guest';
        req.guestCode = decoded.guestCode;
        req.guestPermissions = decoded.permissions || 'view';
      } else {
        // Admin token
        req.userId = decoded.id || decoded.userId;
        req.userRole = 'admin';
      }
      next();
    } catch (err) {
      return res.status(401).json({ error: 'Invalid or expired token' });
    }
  };
};


