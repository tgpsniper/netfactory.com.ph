const exifr = require('exifr');
const tesseract = require('node-tesseract-ocr');

// Extract lat/lng from GPS Map Camera watermark text via OCR
async function extractCoordsFromWatermark(filePath) {
  try {
    const text = await tesseract.recognize(filePath, { lang: 'eng', oem: 1, psm: 6 });
    // Match patterns like: Lat 14.625218° Long 120.461208°
    // or: Lat 14.625218 Long 120.461208
    // or: 14.625218°N 120.461208°E
    // or: Lat: 14.625218, Long: 120.461208
    let lat = null, lng = null;
    const patterns = [
      /Lat[:\s]*([+-]?\d+\.\d+)[°]?\s*(?:Long|Lon|Lng)[:\s]*([+-]?\d+\.\d+)/i,
      /(\d{1,3}\.\d{4,})\s*°?\s*[NS]?\s*[,\s]+\s*(\d{1,3}\.\d{4,})\s*°?\s*[EW]?/,
      /latitude[:\s]*([+-]?\d+\.\d+)[°]?\s*longitude[:\s]*([+-]?\d+\.\d+)/i,
    ];
    for (const pat of patterns) {
      const m = text.match(pat);
      if (m) {
        lat = parseFloat(m[1]);
        lng = parseFloat(m[2]);
        if (!isNaN(lat) && !isNaN(lng)) break;
      }
    }
    return (lat && lng) ? { latitude: lat, longitude: lng, source: 'ocr' } : null;
  } catch (e) {
    return null;
  }
}

