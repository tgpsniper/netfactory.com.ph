// POST /api/admin/map/closures/:id/connections
router.post('/closures/:id/connections', adminAuth(), async (req, res) => {
  try {
    const closureId = parseInt(req.params.id);
    const { side, connectionType, refId, refName, fiberCount, coreStart, coreEnd, notes } = req.body;

    if (!side || !['A', 'B', 'C'].includes(side)) {
      return res.status(400).json({ error: 'Side must be A, B, or C' });
    }
    const validTypes = ['foc_route', 'nap', 'drop_fiber', 'olt', 'splice', 'custom'];
    if (!connectionType || !validTypes.includes(connectionType)) {
      return res.status(400).json({ error: 'Invalid connection type' });
    }
    // Block reusing the same foc_route on multiple sides of a single closure.
    // Same FOC ref_id on different sides means the "sides" share physical
    // strands, which produces self-splices and visually duplicated columns.
    if (connectionType === 'foc_route' && refId) {
      const dup = await req.prisma.$queryRaw`
        SELECT side FROM closure_connections
        WHERE closure_id = ${closureId} AND connection_type = 'foc_route' AND ref_id = ${parseInt(refId)}
        LIMIT 1
      `;
      if (dup.length > 0) {
        return res.status(409).json({ error: 'This FOC route is already attached to this closure on Side ' + dup[0].side + '. A single FOC route cannot be on two sides — use a different cable for the lateral.' });
      }
    }

    // Get current max sort_order for this side
    const maxOrder = await req.prisma.$queryRaw`
      SELECT COALESCE(MAX(sort_order), -1)::int AS max_ord
      FROM closure_connections WHERE closure_id = ${closureId} AND side = ${side}
    `;
    const nextOrder = (maxOrder[0]?.max_ord ?? -1) + 1;

    // Resolve ref_name if refId given
    let resolvedName = refName || null;
    if (refId && !resolvedName) {
      if (connectionType === 'foc_route') {
        const r = await req.prisma.$queryRaw`SELECT name FROM foc_routes WHERE id = ${parseInt(refId)}`;
        if (r.length) resolvedName = r[0].name;
      } else if (connectionType === 'nap') {
        const r = await req.prisma.$queryRaw`SELECT name FROM naps WHERE id = ${parseInt(refId)}`;
        if (r.length) resolvedName = r[0].name;
      }
    }

    const result = await req.prisma.$queryRaw`
      INSERT INTO closure_connections
        (closure_id, side, sort_order, connection_type, ref_id, ref_name, fiber_count, core_start, core_end, notes)
      VALUES
        (${closureId}, ${side}, ${nextOrder}, ${connectionType},
         ${refId ? parseInt(refId) : null}, ${resolvedName},
         ${fiberCount ? parseInt(fiberCount) : null},
         ${coreStart ? parseInt(coreStart) : null},
         ${coreEnd   ? parseInt(coreEnd)   : null},
         ${notes || null})
      RETURNING id, side, connection_type, ref_name, fiber_count, core_start, core_end
    `;

    console.log(`🔌 Closure connection added: Closure ${closureId} Side ${side} → ${connectionType} ${resolvedName || ''}`);

    res.status(201).json({ message: 'Connection added', connection: result[0] });
  } catch (err) {
    console.error('Closure connection add error:', err);
    res.status(500).json({ error: 'Failed to add connection' });
  }
});

