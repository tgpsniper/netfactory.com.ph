        status: f.status, municipality: f.municipality, barangay: f.barangay,
        totalStrands: f.total_strands, availableStrands: f.available_strands,
        usedStrands: f.used_strands, reservedStrands: f.reserved_strands,
        damagedStrands: f.damaged_strands
