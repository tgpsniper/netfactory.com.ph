function generateCode() {
  return crypto.randomBytes(4).toString('hex').toUpperCase(); // 8-char hex
}

// POST /api/admin/map/share-links — generate a share link
router.post('/share-links', adminAuth(), async (req, res) => {
  try {
    const { label, permissions, expiresInDays } = req.body;
    const perm = ['view', 'view_tag'].includes(permissions) ? permissions : 'view_tag';
    const days = Math.min(Math.max(parseInt(expiresInDays) || 7, 1), 90);
    const code = generateCode();
    const expiresAt = new Date(Date.now() + days * 86400000);

    await req.prisma.$queryRaw`
      INSERT INTO gis_share_tokens (code, label, permissions, created_by, expires_at)
      VALUES (${code}, ${label || null}, ${perm}, ${req.userId}, ${expiresAt})
    `;

    res.json({
      code,
      label: label || null,
      permissions: perm,
      expiresAt: expiresAt.toISOString(),
      shareUrl: `/gis/?code=${code}`,
    });
  } catch (err) {
    console.error('Share link create error:', err);
    res.status(500).json({ error: 'Failed to create share link' });
  }
});

