// PUT /api/admin/map/naps/:id
router.put('/naps/:id', adminAuth(), async (req, res) => {
  try {
    const id = parseInt(req.params.id);
    const { name, type, totalPorts, usedPorts, lat, lng, municipality, barangay, poleNumber, focRouteId, closureId, notes, status, olt, pon, accessCore, napCore, isLcpPort, lcpNapId } = req.body;

    const fields = [];
    const values = [];
    let paramIdx = 1;

    if (name !== undefined) { fields.push(`name = $${paramIdx++}`); values.push(name); }
    if (type !== undefined) { fields.push(`type = $${paramIdx++}`); values.push(type); }
    if (totalPorts !== undefined) { fields.push(`total_ports = $${paramIdx++}`); values.push(parseInt(totalPorts)); }
    if (usedPorts !== undefined) { fields.push(`used_ports = $${paramIdx++}`); values.push(parseInt(usedPorts)); }
    if (lat !== undefined) { fields.push(`latitude = $${paramIdx++}`); values.push(parseFloat(lat)); }
    if (lng !== undefined) { fields.push(`longitude = $${paramIdx++}`); values.push(parseFloat(lng)); }
    if (municipality !== undefined) { fields.push(`municipality = $${paramIdx++}`); values.push(municipality); }
    if (barangay !== undefined) { fields.push(`barangay = $${paramIdx++}`); values.push(barangay); }
    if (poleNumber !== undefined) { fields.push(`pole_number = $${paramIdx++}`); values.push(poleNumber); }
    if (focRouteId !== undefined) { fields.push(`foc_route_id = $${paramIdx++}`); values.push(focRouteId ? parseInt(focRouteId) : null); }
    if (closureId !== undefined) { fields.push(`closure_id = $${paramIdx++}`); values.push(closureId ? parseInt(closureId) : null); }
    if (notes !== undefined) { fields.push(`notes = $${paramIdx++}`); values.push(notes); }
    if (status !== undefined) { fields.push(`status = $${paramIdx++}`); values.push(status); }
    if (olt !== undefined) { fields.push(`olt = $${paramIdx++}`); values.push(olt || null); }
    if (pon !== undefined) { fields.push(`pon = $${paramIdx++}`); values.push(pon || null); }
    if (accessCore !== undefined) { fields.push(`access_core = $${paramIdx++}`); values.push(accessCore || null); }
    if (napCore !== undefined) {
      const validNapCores = ['Blue', 'Orange', 'Green', 'Brown'];
      const v = napCore && validNapCores.includes(napCore) ? napCore : null;
      fields.push(`nap_core = $${paramIdx++}`); values.push(v);
    }
    if (isLcpPort !== undefined) { fields.push(`is_lcp_port = $${paramIdx++}`); values.push(!!isLcpPort); }
    if (lcpNapId !== undefined) { fields.push(`lcp_nap_id = $${paramIdx++}`); values.push(lcpNapId ? parseInt(lcpNapId) : null); }
    fields.push(`updated_at = NOW()`);

    if (fields.length <= 1) return res.status(400).json({ error: 'No fields to update' });

    values.push(id);
    const sql = `UPDATE naps SET ${fields.join(', ')} WHERE id = $${paramIdx} RETURNING id, name`;
    const result = await req.prisma.$queryRawUnsafe(sql, ...values);

    if (result.length === 0) return res.status(404).json({ error: 'NAP not found' });

    // ── Sync nap_ports when totalPorts changes ──
    if (totalPorts !== undefined) {
      const newTotal = parseInt(totalPorts);
      const existing = await req.prisma.$queryRaw`SELECT id, port_number, status, subscriber_id, strand_id FROM nap_ports WHERE nap_id = ${id} ORDER BY port_number`;
      const currentCount = existing.length;

      if (newTotal < currentCount) {
        // Check if any ports above newTotal have data
        const portsAbove = existing.filter(p => p.port_number > newTotal);
        const usedAbove = portsAbove.filter(p => p.status !== 'available' || p.subscriber_id || p.strand_id);
        
        if (usedAbove.length > 0) {
          const portNums = usedAbove.map(p => 'Port ' + p.port_number).join(', ');
          return res.status(400).json({ 
            error: `Cannot reduce to ${newTotal} ports. ${usedAbove.length} port(s) above that limit have active assignments (${portNums}). Remove assignments first.` 
          });
        }

        // Safe to remove — all ports above newTotal are available
        const toRemove = portsAbove.map(p => p.id);
        if (toRemove.length > 0) {
          await req.prisma.$executeRawUnsafe(
            `DELETE FROM nap_ports WHERE id = ANY($1::int[])`,
            toRemove
          );
          console.log(`   └─ Removed ${toRemove.length} excess ports from NAP #${id}`);
        }
      } else if (newTotal > currentCount) {
        // Add new ports
        for (let i = currentCount + 1; i <= newTotal; i++) {
          await req.prisma.$executeRawUnsafe(
            `INSERT INTO nap_ports (nap_id, port_number, status) VALUES ($1, $2, 'available') ON CONFLICT DO NOTHING`,
            id, i
          );
        }
        console.log(`   └─ Added ${newTotal - currentCount} new ports to NAP #${id}`);
      }

      // Recount used_ports
      await req.prisma.$executeRawUnsafe(
        `UPDATE naps SET used_ports = (SELECT COUNT(*) FROM nap_ports WHERE nap_id = $1 AND status = 'used') WHERE id = $1`,
        id
      );
    }

    res.json({ message: 'NAP updated', nap: result[0] });
  } catch (err) {
    console.error('NAP update error:', err);
    res.status(500).json({ error: 'Failed to update NAP' });
  }
});

