// POST /api/admin/map/infra-photos/:entityType/:entityId
// Same GPS extraction as Geo Photo: manual → EXIF → OCR watermark
router.post('/infra-photos/:entityType/:entityId', adminOrTagger(), infraPhotoUpload.array('photos', 10), async (req, res) => {
  try {
    const { entityType, entityId } = req.params;
    if (!VALID_ENTITY_TYPES.includes(entityType)) return res.status(400).json({ error: 'Invalid entity type' });
    if (!req.files || req.files.length === 0) return res.status(400).json({ error: 'No photos uploaded' });

    const saved = [];
    for (const file of req.files) {
      const caption = req.body.caption || null;
      let lat = parseFloat(req.body.latitude);
      let lng = parseFloat(req.body.longitude);
      let gpsSource = ((!isNaN(lat)) && (!isNaN(lng))) ? 'manual' : null;

      // EXIF GPS extraction
      if (!gpsSource) {
        try {
          const gps = await exifr.gps(file.path);
          if (gps && gps.latitude && gps.longitude) {
            lat = gps.latitude;
            lng = gps.longitude;
            gpsSource = 'exif';
          }
        } catch (exifErr) { /* no EXIF data */ }
      }

      // OCR watermark extraction (GPS Map Camera, etc.)
      if (!gpsSource) {
        const ocr = await extractCoordsFromWatermark(file.path);
        if (ocr) {
          lat = ocr.latitude;
          lng = ocr.longitude;
          gpsSource = 'ocr';
        }
      }

      const finalLat = (!isNaN(lat)) ? lat : null;
      const finalLng = (!isNaN(lng)) ? lng : null;

      const rows = await req.prisma.$queryRaw`
        INSERT INTO infrastructure_photos (entity_type, entity_id, filename, original_name, file_type, file_size, caption, latitude, longitude, gps_source, uploaded_by)
        VALUES (${entityType}, ${parseInt(entityId)}, ${file.filename}, ${file.originalname}, ${file.mimetype}, ${file.size}, ${caption}, ${finalLat}, ${finalLng}, ${gpsSource}, ${req.userId})
        RETURNING id
      `;
      saved.push({
        id: Number(rows[0].id),
        filename: file.filename,
        original_name: file.originalname,
        url: `/uploads/gis-photos/${file.filename}`,
        latitude: finalLat,
        longitude: finalLng,
        gpsSource
      });
    }
    console.log(`📸 ${saved.length} photo(s) uploaded for ${entityType} #${entityId}`);
    res.status(201).json({ message: 'Photos uploaded', photos: saved });
  } catch (err) {
    console.error('Infra photo upload error:', err);
    res.status(500).json({ error: 'Upload failed' });
  }
});

