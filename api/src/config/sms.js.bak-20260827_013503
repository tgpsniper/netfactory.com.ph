// NETFACTORY — SMS Configuration (Semaphore Philippines)
// ============================================================
// Usage:
//   const { sms } = require('../config');
//
//   // Send a simple SMS:
//   await sms.send('09171112222', 'Your payment of ₱1,599 has been received.');
//
//   // Send using a template:
//   await sms.sendTemplate('09171112222', 'payment_received', {
//     name: 'Juan',
//     amount: '₱1,599',
//     invoiceNumber: 'INV-2026-0042'
//   });
//
//   // Send priority SMS (2 credits, instant delivery):
//   await sms.sendPriority('09171112222', 'URGENT: Service notice...');
//
//   // Send OTP via dedicated endpoint (2 credits):
//   await sms.sendOTP('09171112222');  // auto-generates code
//   await sms.sendOTP('09171112222', '483291');  // custom code
//
//   // Check remaining credits:
//   const credits = await sms.checkCredits();
// ============================================================

const { getToggle } = require('../middleware/systemToggles');

// ── Settings from .env (used as fallback when DB is unavailable) ─────────────
const settings = {
  apiKey: process.env.SEMAPHORE_API_KEY || '',
  senderName: process.env.SEMAPHORE_SENDER_NAME || 'NETFACTORY',
  // Semaphore docs use both URLs in examples; semaphore.co is the canonical one
  baseUrl: 'https://semaphore.co/api/v4',
};

/**
 * Read Semaphore settings from the system_settings DB table.
 * Falls back to env vars if DB is unavailable or keys are missing.
 * DB keys: semaphore_api_key, semaphore_sender
 *
 * @param {Object} prisma - Prisma client instance
 * @returns {Promise<{apiKey: string, senderName: string}>}
 */
async function getSmsSettings(prisma) {
  if (!prisma) return { apiKey: settings.apiKey, senderName: settings.senderName };
  try {
    const rows = await prisma.system_settings.findMany({
      where: { key: { in: ['semaphore_api_key', 'semaphore_sender'] } },
    });
    const s = {};
    rows.forEach(r => { s[r.key] = r.value; });
    return {
      apiKey:     s.semaphore_api_key || settings.apiKey,
      senderName: s.semaphore_sender  || settings.senderName,
    };
  } catch {
    return { apiKey: settings.apiKey, senderName: settings.senderName };
  }
}

/**
 * Check if SMS is properly configured.
 */
function isConfigured() {
  return !!settings.apiKey;
}

/**
 * Safely parse a Semaphore API response.
 * Semaphore returns plain text for rate limit errors ("Too Many Attempts.")
 * instead of JSON, so we need to handle that gracefully.
 */
async function safeParseResponse(response) {
  const text = await response.text();
  try {
    return JSON.parse(text);
  } catch {
    // Non-JSON response (e.g., rate limit message)
    if (response.status === 429 || text.toLowerCase().includes('too many')) {
      return { error: 'Rate limited — Semaphore allows max 2 calls/min on this endpoint. Wait and try again.' };
    }
    return { error: text || `HTTP ${response.status}` };
  }
}

/**
 * Normalize a Philippine phone number to the format Semaphore expects.
 * Accepts: 09171112222, +639171112222, 639171112222, 0917-111-2222
 * Returns: 09171112222
 */
function normalizePhone(phone) {
  // Remove all non-digit characters (dashes, spaces, parens, plus sign)
  let digits = phone.replace(/\D/g, '');

  // Handle +63 prefix (e.g., 639171112222 → 09171112222)
  if (digits.startsWith('63') && digits.length === 12) {
    digits = '0' + digits.substring(2);
  }

  // Handle missing leading 0 (e.g., 9171112222 → 09171112222)
  if (digits.startsWith('9') && digits.length === 10) {
    digits = '0' + digits;
  }

  return digits;
}

/**
 * Build form-encoded body string from an object.
 * Semaphore API requires application/x-www-form-urlencoded, NOT JSON.
 * (Per their docs: all cURL examples use --data which is form-encoded)
 */
function buildFormBody(params) {
  return Object.entries(params)
    .filter(([, v]) => v !== undefined && v !== null)
    .map(([k, v]) => `${encodeURIComponent(k)}=${encodeURIComponent(v)}`)
    .join('&');
}

/**
 * Send an SMS message via Semaphore (standard queue).
 * Cost: 1 credit per 160 characters.
 *
 * @param {string} to - Recipient phone number (PH format)
 * @param {string} message - SMS text (160 chars = 1 credit, 306 = 2 credits)
 * @param {Object} [overrides] - Optional { apiKey, senderName } to override env settings
 *
 * @returns {Promise<Object>} { ok, messageId, data } or { ok, error }
 */
async function send(to, message, overrides = {}) {
  const apiKey     = overrides.apiKey     || settings.apiKey;
  const senderName = overrides.senderName || settings.senderName;

  if (!apiKey) {
    console.warn('⚠ SMS not configured — skipping send to:', to);
    return { ok: false, error: 'Semaphore not configured' };
  }

  const phone = normalizePhone(to);

  try {
    const response = await fetch(`${settings.baseUrl}/messages`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: buildFormBody({
        apikey: apiKey,
        number: phone,
        message: message,
        sendername: senderName,
      }),
    });

    const data = await safeParseResponse(response);

    if (response.ok && Array.isArray(data) && data.length > 0 && !data[0]?.error) {
      const messageId = data[0]?.message_id || 'sent';
      console.log(`📱 SMS sent to ${phone} — ID: ${messageId}`);
      return { ok: true, messageId, data: data[0] };
    } else {
      const errorMsg = Array.isArray(data)
        ? (data[0]?.error || data[0]?.message || 'Unknown error')
        : (data?.error || data?.message || JSON.stringify(data));
      console.error(`✗ SMS failed to ${phone}:`, errorMsg);
      return { ok: false, error: errorMsg };
    }
  } catch (err) {
    console.error(`✗ SMS failed to ${phone}:`, err.message);
    return { ok: false, error: err.message };
  }
}

