/**
 * Send OTP via Semaphore's dedicated /otp endpoint.
 * Uses the {otp} placeholder — Semaphore auto-generates a code if none provided.
 * Cost: 2 credits per message.
 * NOT rate limited.
 *
 * @param {string} to - Recipient phone number
 * @param {string} [code] - Optional custom OTP code. If omitted, Semaphore auto-generates one.
 *
 * @returns {Promise<Object>} { ok, messageId, code, data } or { ok, error }
 */
async function sendOTP(to, code, overrides = {}) {
  const apiKey     = overrides.apiKey     || settings.apiKey;
  const senderName = overrides.senderName || settings.senderName;

  if (!apiKey) {
    console.warn('⚠ SMS not configured — skipping OTP send to:', to);
    return { ok: false, error: 'Semaphore not configured' };
  }

  const phone = normalizePhone(to);

  const params = {
    apikey: apiKey,
    number: phone,
    message: 'Your Netfactory verification code is {otp}. Valid for 10 minutes. Do not share this code.',
    sendername: senderName,
  };

  // If a custom code is provided, pass it so Semaphore uses it instead of auto-generating
  if (code) {
    params.code = code;
  }

  try {
    const response = await fetch(`${settings.baseUrl}/otp`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: buildFormBody(params),
    });

    const data = await safeParseResponse(response);

    if (response.ok && Array.isArray(data) && data.length > 0 && !data[0]?.error) {
      const messageId = data[0]?.message_id || 'sent';
      const otpCode = data[0]?.code || code || 'auto';
      console.log(`📱 OTP sent to ${phone} — ID: ${messageId}, Code: ${otpCode}`);
      return { ok: true, messageId, code: otpCode, data: data[0] };
    } else {
      const errorMsg = Array.isArray(data)
        ? (data[0]?.error || data[0]?.message || 'Unknown error')
        : (data?.error || data?.message || JSON.stringify(data));
      console.error(`✗ OTP failed to ${phone}:`, errorMsg);
      return { ok: false, error: errorMsg };
    }
  } catch (err) {
    console.error(`✗ OTP failed to ${phone}:`, err.message);
    return { ok: false, error: err.message };
  }
}

/**
 * Check remaining Semaphore credits.
 * NOTE: This endpoint is limited to 2 calls per minute.
 *
 * @returns {Promise<Object>} { ok, credits, data } or { ok, error }
 */
async function checkCredits() {
  if (!isConfigured()) {
    return { ok: false, error: 'Semaphore not configured' };
  }

  try {
    const response = await fetch(
      `${settings.baseUrl}/account?apikey=${encodeURIComponent(settings.apiKey)}`
    );
    const data = await safeParseResponse(response);

    if (response.ok) {
      return {
        ok: true,
        credits: data.credit_balance || data.credits || 0,
        accountName: data.account_name || null,
        status: data.status || null,
        data,
      };
    } else {
      return { ok: false, error: data?.message || 'Failed to check credits' };
    }
  } catch (err) {
    return { ok: false, error: err.message };
  }
}

/**
 * Retrieve sender names registered on the account.
 * NOTE: This endpoint is limited to 2 calls per minute.
 *
 * @returns {Promise<Object>} { ok, senderNames } or { ok, error }
 */
async function getSenderNames() {
  if (!isConfigured()) {
    return { ok: false, error: 'Semaphore not configured' };
  }

  try {
    const response = await fetch(
      `${settings.baseUrl}/account/sendernames?apikey=${encodeURIComponent(settings.apiKey)}`
    );
    const data = await safeParseResponse(response);

    if (response.ok) {
      return { ok: true, senderNames: data };
    } else {
      return { ok: false, error: data?.message || 'Failed to retrieve sender names' };
    }
  } catch (err) {
    return { ok: false, error: err.message };
  }
}

// ── SMS Templates ───────────────────────────────────────────
// All templates designed to stay within 160 characters (1 credit)

const templates = {
  // Payment received
  payment_received: (data) => {
    const base = `Netfactory: Invoice ${data.invoiceNumber} of ${data.amount} is now PAID. Thank you!`;
    return data.overpayment
      ? base + ` Overpayment of ${data.overpayment} credited to your acct for next invoice.`
      : base;
  },

  // Invoice reminder
  invoice_reminder: (data) =>
    `Netfactory: Your invoice ${data.invoiceNumber} for ${data.amount} is due on ${data.dueDate}. Pay at netfactory.com.ph/user/ or GCash/Maya.`,

  // Account suspended
  account_suspended: (data) =>
    `Netfactory: Your account ${data.accountNumber} has been suspended. Outstanding balance: ${data.balance}. Please settle to restore service. Call 0992-236-7050.`,

  // Installation schedule
  installation_scheduled: (data) =>
    `Netfactory: Your installation is scheduled for ${data.date} at ${data.time}. Our team will arrive at your location. Call 0992-236-7050 for questions.`,

  // Ticket update
  ticket_update: (data) =>
    `Netfactory: Ticket ${data.ticketNumber} has been updated to "${data.status}". ${data.note || 'Check your portal for details.'}`,

  // Welcome
  welcome: (data) =>
    `Welcome to Netfactory! Account: ${data.accountNumber}, Plan: ${data.plan}. Access your portal at netfactory.com.ph/user/`,

  // Password reset
  password_reset: (data) =>
    `Netfactory: Your password reset code is ${data.code}. Valid for 1 hour. Do not share this code.`,

  // Service restored
  service_restored: (data) =>
    `Netfactory: Your service has been restored! Account ${data.accountNumber} is now active. Thank you for your payment.`,
};

/**
 * Send an SMS using a predefined template.
 *
 * @param {string} to - Recipient phone number
 * @param {string} templateName - Template key
 * @param {Object} data - Data to populate the template
 * @param {Object} [overrides] - Optional { apiKey, senderName } to override env settings
 *
 * @returns {Promise<Object>} { ok, messageId } or { ok, error }
 */
async function sendTemplate(to, templateName, data, overrides = {}) {
  const templateFn = templates[templateName];
  if (!templateFn) {
    console.error(`✗ Unknown SMS template: ${templateName}`);
    return { ok: false, error: `Unknown template: ${templateName}` };
  }

  return send(to, templateFn(data), overrides);
}

/**
 * Send an SMS reading API key and sender name from the system_settings DB table.
 * Falls back to env vars if DB settings are not found.
 *
 * @param {Object} prisma - Prisma client instance
 * @param {string} to - Recipient phone number
 * @param {string} message - SMS text
 */
async function sendWithPrisma(prisma, to, message) {
  if (!getToggle('sms_enabled')) {
    console.log(`[SMS] ⏸ Globally disabled — skipping send to ${to}`);
    return { ok: false, skipped: true, reason: 'SMS disabled by system toggle' };
  }
  const cfg = await getSmsSettings(prisma);
  return send(to, message, cfg);
}

/**
 * Send an SMS template reading API key and sender name from the system_settings DB table.
 * Falls back to env vars if DB settings are not found.
 *
 * @param {Object} prisma - Prisma client instance
 * @param {string} to - Recipient phone number
 * @param {string} templateName - Template key
 * @param {Object} data - Data to populate the template
 */
async function sendTemplateWithPrisma(prisma, to, templateName, data) {
  if (!getToggle('sms_enabled')) {
    console.log(`[SMS] ⏸ Globally disabled — skipping ${templateName} to ${to}`);
    return { ok: false, skipped: true, reason: 'SMS disabled by system toggle' };
  }
  const cfg = await getSmsSettings(prisma);
  return sendTemplate(to, templateName, data, cfg);
}

module.exports = {
  settings,
  isConfigured,
  getSmsSettings,
  send,
  sendPriority,
  sendOTP,
  sendTemplate,
  sendWithPrisma,
  sendTemplateWithPrisma,
  checkCredits,
  getSenderNames,
  normalizePhone,
};
