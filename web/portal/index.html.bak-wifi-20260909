                <div ref={aiChatEndRef} />
                {aiLoading && (
                  <div style={{display:'flex', justifyContent:'flex-start'}}>
                    <div style={{
                      padding:'9px 14px', borderRadius:'16px 16px 16px 4px',
                      background:c.bg, border:`1px solid ${c.border}`,
                      color:c.textMuted, fontSize:13
                    }}>
                      <span style={{animation:'pulse 1s infinite'}}>● ● ●</span>
                    </div>
                  </div>
                )}
              </div>

              {/* Input */}
              <div style={{
                padding:'10px 12px',
                borderTop:`1px solid ${c.border}`,
                display:'flex', gap:8, alignItems:'center'
              }}>
                <input
                  value={aiInput}
                  onChange={e => setAiInput(e.target.value)}
                  onKeyDown={e => { if(e.key==='Enter' && !e.shiftKey){ e.preventDefault(); handleAiSend(); } }}
                  placeholder={`Ask ${aiName}...`}
                  style={{
                    flex:1, padding:'9px 13px',
                    background:c.bg, border:`1px solid ${c.border}`,
                    borderRadius:12, color:c.text, fontSize:13,
                    outline:'none'
                  }}
                  disabled={aiLoading}
                />
                <div
                  onClick={handleAiSend}
                  style={{
                    width:36, height:36, borderRadius:10, flexShrink:0,
                    background: aiLoading || !aiInput.trim()
                      ? c.border
                      : 'linear-gradient(135deg,#6366f1,#8b5cf6)',
                    display:'flex', alignItems:'center', justifyContent:'center',
                    cursor: aiLoading || !aiInput.trim() ? 'default' : 'pointer',
                    fontSize:16, transition:'background .2s'
                  }}
                >
                  <i className="fas fa-paper-plane" style={{color:"#fff",fontSize:14}}></i>
                </div>
              </div>
              <div style={{textAlign:'center', padding:'6px 0 10px', color:c.textMuted, fontSize:10}}>
                Powered by {(siteSettings.company_short_name || 'NF')} Virtual Support
              </div>
            </div>
          )}
        </div>
      )}

      {/* ========== PDF VIEWER MODAL ========== */}
      {pdfModal && (
        <div style={{position:"fixed", inset:0, background:"rgba(0,0,0,.7)", backdropFilter:"blur(6px)", zIndex:400, display:"flex", alignItems:"center", justifyContent:"center", padding:16, animation:"fadeIn .2s"}}
>
          <div style={{background:c.bgCard, borderRadius:24, maxWidth:900, width:"100%", height:"85vh", display:"flex", flexDirection:"column", boxShadow:"0 40px 80px rgba(0,0,0,.4)", border:`1px solid ${c.border}`, overflow:"hidden"}}>
            <div style={{padding:"16px 24px", borderBottom:`1px solid ${c.border}`, display:"flex", justifyContent:"space-between", alignItems:"center", flexShrink:0}}>
              <div style={{display:"flex", alignItems:"center", gap:12}}>
                <span style={{fontSize:22}}><i className="fas fa-file-lines" style={{color:c.primary}}></i></span>
                <div>
                  <h2 style={{fontSize:16, fontWeight:700, color:c.text, fontFamily:fontMono}}>{pdfModal.invoiceNumber}</h2>
                  <p style={{fontSize:11, color:c.textMuted}}>Invoice Document</p>
                </div>
              </div>
              <div style={{display:"flex", alignItems:"center", gap:10}}>
                <a href={`${API}/portal/invoices/${pdfModal.invoiceId}/pdf?token=${localStorage.getItem("j2_token")}`} target="_blank" rel="noopener"
                  style={{padding:"8px 14px", background:`${c.primary}15`, border:`1px solid ${c.primary}30`, borderRadius:8, color:c.primary, fontSize:12, fontWeight:600, textDecoration:"none", display:"inline-flex", alignItems:"center", gap:6, cursor:"pointer"}}>
                  <i className="fas fa-download" style={{marginRight:6}}></i> Download
                </a>
                <div style={{cursor:"pointer", fontSize:18, color:c.textMuted, padding:4}} onClick={() => setPdfModal(null)}><i className="fas fa-xmark"></i></div>
              </div>
            </div>
            <div style={{flex:1, background:"#1e293b"}}>
              <iframe src={`${API}/portal/invoices/${pdfModal.invoiceId}/pdf?token=${localStorage.getItem("j2_token")}`}
                style={{width:"100%", height:"100%", border:"none"}} title="Invoice PDF" />
            </div>
          </div>
        </div>
      )}

      {/* Toast notifications */}
      <div style={{position:"fixed",top:20,right:20,zIndex:99999,display:"flex",flexDirection:"column",gap:10,pointerEvents:"none"}}>
        {toasts.map(t => (
          <div key={t.id} style={{
            pointerEvents:"auto",
            minWidth:320, maxWidth:420, padding:"14px 20px", borderRadius:14,
            background: t.type==="success" ? "#059669" : t.type==="warning" ? "#d97706" : "#dc2626",
            color:"#fff", fontSize:13, fontWeight:600, fontFamily:font,
            boxShadow:"0 8px 32px rgba(0,0,0,.25)", display:"flex", alignItems:"center", gap:10,
            animation:"slideInRight .3s ease",
            cursor:"pointer"
          }} onClick={() => setToasts(prev => prev.filter(x => x.id !== t.id))}>
            <span style={{fontSize:18}}>{t.type==="success"?<i className="fas fa-circle-check"></i>:t.type==="warning"?<i className="fas fa-triangle-exclamation"></i>:<i className="fas fa-circle-xmark"></i>}</span>
            <span style={{flex:1, lineHeight:1.4}}>{t.msg}</span>
          </div>
        ))}
      </div>
    </div>
  );
};

ReactDOM.createRoot(document.getElementById('root')).render(<Portal />);
</script>
</body>
</html>
