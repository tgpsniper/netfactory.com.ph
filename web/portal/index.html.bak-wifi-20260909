                    finally{setForgotLoading(false);}
                  }} style={{width:"100%",padding:"15px",borderRadius:12,border:"none",fontSize:15,fontWeight:700,fontFamily:font,background:forgotLoading?"rgba(255,255,255,.1)":`linear-gradient(135deg,${c.primary},${c.primaryDk})`,color:"#fff",cursor:forgotLoading?"not-allowed":"pointer",boxShadow:"0 4px 20px rgba(37,99,235,.3)",opacity:forgotLoading?0.7:1}}>{forgotLoading?"Sending...":"Send Reset Link"}</button>
