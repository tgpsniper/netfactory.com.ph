        </div>
      )}

      {unpaidInvoices.length > 0 && currentUser.status !== "suspended" && (
        <div style={{background:c.warningLt, border:`1px solid ${c.warning}30`, borderRadius:16, padding:"18px 24px", marginBottom:20, display:"flex", alignItems:"center", gap:14, flexWrap:"wrap"}}>
