  const PAYABLE_STATUSES = ["pending", "overdue", "partial"];
  const unpaidInvoices = myInvoices.filter(i => PAYABLE_STATUSES.includes(i.status)).map(i => {
    const dueDate = i.dueDate ? new Date(i.dueDate) : null;
    const now = new Date();
    const daysPastDue = dueDate ? Math.floor((now - dueDate) / (1000 * 60 * 60 * 24)) : 0;
    const displayStatus = daysPastDue >= 7 ? "overdue" : (i.totalPaid > 0 ? "balance" : "unpaid");
    return { ...i, displayStatus };
  });
  const paidInvoices = myInvoices.filter(i => i.status === "paid");

  const navItems = [
    { id:"dashboard", icon:"fas fa-chart-line", label:"Dashboard" },
    { id:"billing", icon:"fas fa-file-invoice-dollar", label:"Billing & Payments" },
    { id:"usage", icon:"fas fa-chart-area", label:"Data Usage" },
    { id:"plan", icon:"fas fa-clipboard-list", label:"Subscription" },
    { id:"support", icon:"fas fa-headset", label:"Support" },
    { id:"referral", icon:"fas fa-user-plus", label:"Referral" },
    { id:"account", icon:"fas fa-user-cog", label:"Account Settings" },
