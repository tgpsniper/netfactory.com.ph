          {icon:"fas fa-money-bill-wave", label:"Monthly Rate", value:plan.price ? fmt(plan.price) : "—", sub:"per month", color:c.success},
          {icon:"fas fa-wallet", label:"Account Balance", value: currentUser.balance > 0 ? fmt(currentUser.balance) : "₱0", sub: currentUser.balance > 0 ? "Outstanding" : "All paid", color: currentUser.balance > 0 ? c.danger : c.success},
