          <div style={{flex:1, minWidth:200}}>
            <div style={{fontWeight:700, color:darkMode?"#fff":"#92400e", fontSize:15}}>You have {unpaidInvoices.length} unpaid invoice{unpaidInvoices.length > 1 ? "s" : ""}</div>
