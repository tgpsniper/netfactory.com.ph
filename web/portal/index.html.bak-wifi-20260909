            {l:"Address", v:currentUser.address},
            {l:"Barangay", v:currentUser.barangay || "—"},
            {l:"Town / Municipality", v:currentUser.municipality || "—"},
            {l:"Province", v:currentUser.province || "—"},
            {l:"Postal Code", v:currentUser.postalCode || getPostalCode(currentUser.municipality) || "—"},
            {l:"Account Status", v:currentUser.status, badge:true},
            {l:"Installed Date", v:fmtDate(currentUser.installed)},
          ].map((f,i,arr) => (
            <div key={i} style={{display:"flex", justifyContent:"space-between", alignItems:"center", padding:"12px 0", borderBottom: i < arr.length - 1 ? `1px solid ${c.borderLight}` : "none"}}>
              <span style={{fontSize:12, fontWeight:600, color:c.textMuted, textTransform:"uppercase", letterSpacing:.3}}>{f.l}</span>
              {f.badge ? <Badge status={f.v} large /> : <span style={{fontSize:14, fontWeight:500, color:c.text, fontFamily: f.mono ? fontMono : font}}>{f.v}</span>}
            </div>
          ))}
          <div style={{marginTop:16}}>
            <Btn outline style={{width:"100%"}} onClick={() => {
              const normTown = normalizeTown(currentUser.municipality);
              const normBrgy = normalizeBarangay(normTown, currentUser.barangay);
              setEditProfileForm({ firstName:currentUser.firstName||"", middleName:currentUser.middleName||"", lastName:currentUser.lastName||"", email:currentUser.email||"", phone:currentUser.phone||"", address:currentUser.address||"", barangay:normBrgy, municipality:normTown, province:getProvinceForTown(normTown)||currentUser.province||"", postalCode:getPostalCode(normTown)||currentUser.postalCode||"" });
              setEditProfileSaved(false);
              setShowEditProfile(true);
            }}><i className="fas fa-pen-to-square" style={{marginRight:6}}></i> Update Profile Information</Btn>
          </div>
        </Card>

        <div style={{display:"grid", gap:20}}>
          <Card>
            <h3 style={{fontSize:16, fontWeight:700, color:c.text, marginBottom:16}}>Security</h3>
            <Btn outline style={{width:"100%", marginBottom:10}} onClick={() => { setChangePassForm({current:"",newPass:"",confirm:""}); setChangePassDone(false); setChangePassError(""); setShowChangePass(true); }}><i className="fas fa-key" style={{marginRight:6}}></i> Change Password</Btn>
            <Btn outline style={{width:"100%", borderColor: twoFAEnabled ? c.success : undefined, color: twoFAEnabled ? c.success : undefined}} onClick={() => {
              setTwoFACode(""); setShow2FA(true);
              if (twoFAEnabled) {
                setTwoFAStep(4);
              } else {
                setTwoFAStep(1); setTwoFASecret("");
                fetch(`${API}/portal/2fa/setup`,{method:"POST",headers:authHeaders()})
                  .then(r=>r.ok?r.json():null)
                  .then(data=>{ if(data?.secret) setTwoFASecret(data.secret); })
                  .catch(()=>showToast("Failed to start 2FA setup. Please try again."));
              }
            }}>{twoFAEnabled ? <><i className="fas fa-shield-halved" style={{marginRight:6}}></i> Two-Factor Auth Enabled</> : <><i className="fas fa-mobile-screen" style={{marginRight:6}}></i> Enable Two-Factor Auth</>}</Btn>
          </Card>
          <Card>
            <h3 style={{fontSize:16, fontWeight:700, color:c.text, marginBottom:16}}>Notification Preferences</h3>
            {[
              {l:"Email billing reminders", k:"emailBilling"},
              {l:"SMS payment confirmations", k:"smsPayment"},
              {l:"Service outage alerts", k:"outageAlerts"},
              {l:"Promotional offers", k:"promos"},
            ].map((n,i) => (
              <div key={i} style={{display:"flex", justifyContent:"space-between", alignItems:"center", padding:"10px 0", borderBottom: i < 3 ? `1px solid ${c.borderLight}` : "none"}}>
                <span style={{fontSize:13, color:c.textSec}}>{n.l}</span>
                <div onClick={() => {
                  const newVal = !notifPrefs[n.k];
                  setNotifPrefs(prev => ({...prev, [n.k]: newVal}));
                  fetch(`${API}/portal/notifications/preferences`,{method:"PUT",headers:authHeaders(),body:JSON.stringify({...notifPrefs, [n.k]: newVal})}).then(r=>{if(!r.ok) throw r; showToast("Notification preference updated","success");}).catch(()=>{setNotifPrefs(prev=>({...prev,[n.k]:!newVal})); showToast("Failed to save notification preference. Please try again.");});
                }} style={{width:44, height:24, borderRadius:12, background: notifPrefs[n.k] ? c.success : c.border, cursor:"pointer", position:"relative", transition:"all .2s"}}>
                  <div style={{width:20, height:20, borderRadius:10, background:"#fff", position:"absolute", top:2, left: notifPrefs[n.k] ? 22 : 2, transition:"left .2s", boxShadow:"0 1px 3px rgba(0,0,0,.15)"}} />
                </div>
              </div>
            ))}
          </Card>
          <Card style={{background:darkMode?`${c.danger}15`:c.dangerLt, border:`1px solid ${c.danger}${darkMode?"40":"20"}`}}>
            <h3 style={{fontSize:16, fontWeight:700, color:c.danger, marginBottom:8}}>Disconnect Service</h3>
            {unpaidInvoices.length > 0 ? (
              <>
                <p style={{fontSize:13, color:c.danger, marginBottom:16, fontWeight:600}}><i className="fas fa-ban" style={{marginRight:6}}></i> Not allowed | Disabled due to unsettled balance on this account.</p>
                <Btn danger small disabled style={{opacity:.6, cursor:"not-allowed"}}>Request Disconnection</Btn>
              </>
            ) : (
              <>
                <p style={{fontSize:13, color:c.textSec, marginBottom:16}}>Request to permanently disconnect your internet service. This action requires approval.</p>
                <Btn danger small onClick={() => { setDisconnectStep(1); setDisconnectReason(""); setDisconnectConfirm(""); setShowDisconnect(true); }}>Request Disconnection</Btn>
              </>
            )}
          </Card>
        </div>
      </div>
    </div>
  );

  // ---------- Referral Page ----------
  const handleSubmitReferral = () => {
    const { firstName, lastName, contactNumber } = referralForm;
    if (!firstName.trim() || !lastName.trim() || !contactNumber.trim()) {
      showToast("First name, last name, and contact number are required");
      return;
    }
    setReferralLoading(true);
    fetch(`${API}/portal/referrals`, {
      method: "POST",
      headers: authHeaders(),
      body: JSON.stringify(referralForm)
    }).then(r => r.json().then(d => ({ ok: r.ok, data: d })))
      .then(({ ok, data }) => {
        if (!ok) { showToast(data.error || "Failed to submit referral"); return; }
        showToast("Referral submitted successfully!", "success");
        setReferralForm({ firstName:"", middleName:"", lastName:"", email:"", contactNumber:"" });
        fetchReferrals();
      })
      .catch(() => showToast("Network error. Please try again."))
      .finally(() => setReferralLoading(false));
  };

  const ReferralPage = () => {
    const statusColor = (s) => ({ pending:c.warning, contacted:c.info, converted:c.success, expired:c.danger, declined:c.textMuted }[s] || c.textMuted);
    const statusBg = (s) => ({ pending:c.warningLt, contacted:c.infoLt, converted:c.successLt, expired:c.dangerLt, declined:c.borderLight }[s] || c.borderLight);
    return (
      <div>
        <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr", gap:20, marginBottom:24 }}>
          {/* Referral Form */}
          <Card>
            <h3 style={{fontSize:16, fontWeight:700, color:c.text, marginBottom:4}}><i className="fas fa-user-plus" style={{marginRight:8, color:c.primary}}></i>Refer a Friend</h3>
            <p style={{fontSize:12, color:c.textMuted, marginBottom:20}}>Know someone who needs internet? Submit their details and we'll reach out.</p>
            <div style={{display:"grid", gridTemplateColumns:"1fr 1fr", gap:12, marginBottom:12}}>
              <div>
                <label style={{fontSize:11, fontWeight:600, color:c.textMuted, display:"block", marginBottom:4}}>First Name *</label>
                <input value={referralForm.firstName} onChange={e => setReferralForm(f => ({...f, firstName:e.target.value}))} placeholder="First name" style={{width:"100%", padding:"10px 12px", background:c.bg, border:`1px solid ${c.border}`, borderRadius:10, color:c.text, fontSize:13, outline:"none", fontFamily:font}} />
              </div>
              <div>
                <label style={{fontSize:11, fontWeight:600, color:c.textMuted, display:"block", marginBottom:4}}>Middle Name</label>
                <input value={referralForm.middleName} onChange={e => setReferralForm(f => ({...f, middleName:e.target.value}))} placeholder="Middle name (optional)" style={{width:"100%", padding:"10px 12px", background:c.bg, border:`1px solid ${c.border}`, borderRadius:10, color:c.text, fontSize:13, outline:"none", fontFamily:font}} />
              </div>
            </div>
            <div style={{marginBottom:12}}>
              <label style={{fontSize:11, fontWeight:600, color:c.textMuted, display:"block", marginBottom:4}}>Last Name *</label>
              <input value={referralForm.lastName} onChange={e => setReferralForm(f => ({...f, lastName:e.target.value}))} placeholder="Last name" style={{width:"100%", padding:"10px 12px", background:c.bg, border:`1px solid ${c.border}`, borderRadius:10, color:c.text, fontSize:13, outline:"none", fontFamily:font}} />
            </div>
            <div style={{marginBottom:12}}>
              <label style={{fontSize:11, fontWeight:600, color:c.textMuted, display:"block", marginBottom:4}}>Contact Number *</label>
              <input value={referralForm.contactNumber} onChange={e => setReferralForm(f => ({...f, contactNumber:e.target.value}))} placeholder="09XX XXX XXXX" style={{width:"100%", padding:"10px 12px", background:c.bg, border:`1px solid ${c.border}`, borderRadius:10, color:c.text, fontSize:13, outline:"none", fontFamily:font}} />
            </div>
            <div style={{marginBottom:20}}>
              <label style={{fontSize:11, fontWeight:600, color:c.textMuted, display:"block", marginBottom:4}}>Email Address</label>
              <input value={referralForm.email} onChange={e => setReferralForm(f => ({...f, email:e.target.value}))} placeholder="email@example.com (optional)" style={{width:"100%", padding:"10px 12px", background:c.bg, border:`1px solid ${c.border}`, borderRadius:10, color:c.text, fontSize:13, outline:"none", fontFamily:font}} />
            </div>
            <Btn primary onClick={handleSubmitReferral} disabled={referralLoading} style={{width:"100%"}}>
              {referralLoading ? <><i className="fas fa-spinner fa-spin" style={{marginRight:6}}></i>Submitting...</> : <><i className="fas fa-paper-plane" style={{marginRight:6}}></i>Submit Referral</>}
            </Btn>
          </Card>

          {/* Stats */}
          <div>
            <div style={{display:"grid", gridTemplateColumns:"1fr 1fr", gap:12, marginBottom:20}}>
              {[
                { label:"Total Referrals", value:referrals.length, icon:"fa-users", color:c.primary },
                { label:"Pending", value:referrals.filter(r=>r.status==="pending").length, icon:"fa-hourglass-half", color:c.warning },
                { label:"Converted", value:referrals.filter(r=>r.status==="converted").length, icon:"fa-check-circle", color:c.success },
                { label:"Expired", value:referrals.filter(r=>r.status==="expired").length, icon:"fa-clock", color:c.danger },
              ].map(s => (
                <Card key={s.label} style={{padding:16, textAlign:"center"}}>
                  <i className={`fas ${s.icon}`} style={{fontSize:20, color:s.color, marginBottom:8, display:"block"}}></i>
                  <div style={{fontSize:22, fontWeight:800, color:s.color, fontFamily:"'Space Grotesk',monospace"}}>{s.value}</div>
                  <div style={{fontSize:11, fontWeight:600, color:c.textMuted, marginTop:4}}>{s.label}</div>
                </Card>
              ))}
            </div>
            <Card style={{padding:16}}>
              <div style={{display:"flex", alignItems:"center", gap:8, marginBottom:8}}>
                <i className="fas fa-info-circle" style={{color:c.info}}></i>
                <span style={{fontSize:13, fontWeight:600, color:c.text}}>How it works</span>
              </div>
              <ul style={{fontSize:12, color:c.textSec, lineHeight:1.8, paddingLeft:16, margin:0}}>
                <li>Submit your friend's contact details</li>
                <li>They will be added as a prospective subscriber</li>
                <li>Our team will reach out to them</li>
                <li>Referrals expire after 60 days if not converted</li>
              </ul>
            </Card>
          </div>
        </div>

        {/* Referral History */}
        <Card style={{padding:0, overflow:"hidden"}}>
          <div style={{padding:"16px 24px", borderBottom:`1px solid ${c.border}`}}>
            <h3 style={{fontSize:14, fontWeight:700, color:c.text, margin:0}}><i className="fas fa-history" style={{marginRight:8, color:c.textMuted}}></i>Referral History</h3>
          </div>
          {referrals.length === 0 ? (
            <div style={{padding:40, textAlign:"center"}}>
              <i className="fas fa-user-friends" style={{fontSize:32, color:c.border, marginBottom:12, display:"block"}}></i>
              <p style={{fontSize:13, color:c.textMuted}}>No referrals yet. Start referring friends!</p>
            </div>
          ) : (
            <div style={{overflowX:"auto"}}>
              <table style={{width:"100%", borderCollapse:"collapse"}}>
                <thead>
                  <tr>
                    {["Name","Contact","Email","Status","Submitted","Expires"].map(h => (
                      <th key={h} style={{padding:"10px 16px", textAlign:"left", fontSize:11, fontWeight:700, color:c.textMuted, textTransform:"uppercase", letterSpacing:.5, borderBottom:`2px solid ${c.border}`, background:c.bgCard, whiteSpace:"nowrap"}}>{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody>
                  {referrals.map(r => (
                    <tr key={r.id} style={{borderBottom:`1px solid ${c.border}`}}>
                      <td style={{padding:"12px 16px", fontSize:13, color:c.text, fontWeight:600}}>{r.referee?.name || "—"}</td>
                      <td style={{padding:"12px 16px", fontSize:13, color:c.textSec}}>{r.referee?.phone || "—"}</td>
                      <td style={{padding:"12px 16px", fontSize:13, color:c.textSec}}>{r.referee?.email || "—"}</td>
                      <td style={{padding:"12px 16px"}}>
                        <span style={{display:"inline-flex", alignItems:"center", gap:5, padding:"4px 12px", borderRadius:20, fontSize:11, fontWeight:600, background:statusBg(r.status), color:statusColor(r.status), textTransform:"capitalize"}}>
                          <span style={{width:6, height:6, borderRadius:"50%", background:statusColor(r.status)}}></span>
                          {r.status}
                        </span>
                      </td>
                      <td style={{padding:"12px 16px", fontSize:12, color:c.textMuted}}>{new Date(r.createdAt).toLocaleDateString('en-PH', {month:'short', day:'numeric', year:'numeric'})}</td>
                      <td style={{padding:"12px 16px", fontSize:12, color: r.status==="expired" ? c.danger : c.textMuted}}>{new Date(r.expiresAt).toLocaleDateString('en-PH', {month:'short', day:'numeric', year:'numeric'})}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </Card>
      </div>
    );
  };

  const pages = { dashboard:DashboardPage, billing:BillingPage, usage:UsagePage, plan:PlanPage, support:SupportPage, account:AccountPage, referral:ReferralPage };
  const ActivePage = pages[activePage] || DashboardPage;

  // ============================================================
  // PORTAL LAYOUT
  // ============================================================
  return (
    <div style={{fontFamily:font, color:c.text, background:c.bg, minHeight:"100vh", display:"flex"}}>
      <style>{`
        @keyframes fadeIn { from{opacity:0} to{opacity:1} }
        @keyframes slideIn { from{opacity:0;transform:translateX(-20px)} to{opacity:1;transform:translateX(0)} }
        @keyframes spin { to{transform:rotate(360deg)} }
        ::-webkit-scrollbar { width:6px; height:6px; }
        ::-webkit-scrollbar-track { background:transparent; }
        ::-webkit-scrollbar-thumb { background:${c.border}; border-radius:3px; }
        @media(max-width:768px) {
          .portal-sidebar { position:fixed !important; z-index:200 !important; transform:translateX(-100%); transition:transform .3s !important; }
          .portal-sidebar.open { transform:translateX(0) !important; }
          .portal-main { margin-left:0 !important; }
          .portal-hamburger { display:flex !important; }
          .portal-overlay { display:block !important; }
        }
        @media(min-width:769px) {
          .portal-hamburger { display:none !important; }
          .portal-overlay { display:none !important; }
        }
      `}</style>

      {/* Mobile Overlay */}
      {mobileNav && <div className="portal-overlay" onClick={() => setMobileNav(false)} style={{position:"fixed",inset:0,background:"rgba(0,0,0,.5)",zIndex:199}} />}

      {/* Sidebar */}
      <aside className={`portal-sidebar ${mobileNav ? "open" : ""}`} style={{width:260, background:darkMode?"#111827":"#0f172a", height:"100vh", position:"sticky", top:0, display:"flex", flexDirection:"column", flexShrink:0, overflow:"hidden"}}>
        <div style={{padding:"20px 18px", borderBottom:"1px solid rgba(255,255,255,.08)"}}>
          <div style={{display:"flex", alignItems:"center", justifyContent:"center", gap:10}}>
            <div style={{width:38, height:38, borderRadius:10, background:`linear-gradient(135deg,${c.primary},${c.primaryDk})`, display:"flex", alignItems:"center", justifyContent:"center", color:"#fff", fontWeight:800, fontSize:16, fontFamily:fontMono, flexShrink:0}}>{siteSettings.company_short_name||"J2"}</div>
            <div style={{minWidth:0}}>
              <div style={{color:"#fff", fontWeight:700, fontSize:13, whiteSpace:"nowrap", overflow:"hidden", textOverflow:"ellipsis"}}>{siteSettings.company_name||"Netfactory"}</div>
              <div style={{fontSize:9, color:"rgba(255,255,255,.4)", letterSpacing:.5, lineHeight:1.6}}>{siteSettings.company_tagline||""}</div>
            </div>
          </div>
        </div>

        {/* Nav */}
        <div style={{flex:1, padding:"12px 10px", overflowY:"auto"}}>
          {navItems.map(n => (
            <div key={n.id} onClick={() => { setActivePage(n.id); setMobileNav(false); }} style={{
              display:"flex", alignItems:"center", gap:12, padding:"12px 14px",
              borderRadius:10, marginBottom:2, cursor:"pointer", transition:"all .2s",
              background: activePage === n.id ? `${c.primary}20` : "transparent",
              color: activePage === n.id ? "#fff" : "rgba(255,255,255,.6)",
            }}>
              <span style={{width:20, textAlign:"center", display:"inline-flex", justifyContent:"center"}}><i className={n.icon} style={{fontSize:15}}></i></span>
              <span style={{fontSize:13, fontWeight: activePage === n.id ? 700 : 500}}>{n.label}</span>
              {n.id === "billing" && unpaidInvoices.length > 0 && (
                <span style={{marginLeft:"auto",width:20,height:20,borderRadius:10,background:c.danger,color:"#fff",fontSize:10,fontWeight:700,display:"flex",alignItems:"center",justifyContent:"center"}}>{unpaidInvoices.length}</span>
              )}
            </div>
          ))}
        </div>

        {/* Dark Mode Toggle */}
        <div style={{padding:"12px 20px", borderTop:"1px solid rgba(255,255,255,.08)"}}>
          <div style={{display:"flex", alignItems:"center", justifyContent:"space-between"}}>
            <span style={{fontSize:13, fontWeight:500, color:"rgba(255,255,255,.6)"}}><i className={darkMode?"fas fa-moon":"fas fa-sun"} style={{marginRight:8}}></i>{darkMode?"Dark":"Light"}</span>
            <div onClick={toggleDark} style={{width:42, height:24, borderRadius:12, background:darkMode?"#3b82f6":"#475569", cursor:"pointer", position:"relative", transition:"background .3s"}}>
              <div style={{width:18, height:18, borderRadius:"50%", background:"#fff", position:"absolute", top:3, left:darkMode?21:3, transition:"left .3s", boxShadow:"0 1px 3px rgba(0,0,0,.3)"}}></div>
            </div>
          </div>
        </div>
        {/* Logout */}
        <div style={{padding:"12px 10px", borderTop:"1px solid rgba(255,255,255,.08)"}}>
          <div onClick={() => { handleLogout(); window.location.href = "/index.html"; }}
            style={{display:"flex", alignItems:"center", gap:12, padding:"12px 14px", borderRadius:10, cursor:"pointer", color:"rgba(255,255,255,.4)", transition:"all .2s"}}>
            <span><i className="fas fa-sign-out-alt" style={{fontSize:16}}></i></span>
            <span style={{fontSize:13, fontWeight:500}}>Sign Out</span>
          </div>
        </div>
      </aside>

      {/* Main */}
      <div className="portal-main" style={{flex:1, display:"flex", flexDirection:"column", minWidth:0}}>
        {/* Top Bar */}
        <header style={{height:60, background:darkMode?"#253347":c.bgCard, borderBottom:`1px solid ${c.border}`, display:"flex", alignItems:"center", justifyContent:"space-between", padding:"0 24px", position:"sticky", top:0, zIndex:50, boxShadow:c.shadow}}>
          <div style={{display:"flex", alignItems:"center", gap:12}}>
            <div className="portal-hamburger" onClick={() => setMobileNav(!mobileNav)} style={{cursor:"pointer", padding:8, alignItems:"center", gap:4, flexDirection:"column", display:"none"}}>
              <div style={{width:20,height:2,background:c.textSec,marginBottom:4}} />
              <div style={{width:20,height:2,background:c.textSec,marginBottom:4}} />
              <div style={{width:20,height:2,background:c.textSec}} />
            </div>
            <div>
              <h2 style={{fontSize:16, fontWeight:700, color:c.text}}>{activePage==="dashboard" ? <>Good {new Date().getHours() < 12 ? "morning" : new Date().getHours() < 18 ? "afternoon" : "evening"}, {currentUser.firstName}!</> : activePage==="support" ? <>Need assistance? Talk to <strong onClick={() => setShowAiChat(true)} style={{color:"#8b5cf6", cursor:"pointer"}}>{aiName}</strong> or send us a ticket.</> : activePage==="plan" ? "Current Subscription" : (navItems.find(n=>n.id===activePage)?.label || "Dashboard")}</h2>
              {activePage==="dashboard" && <p style={{fontSize:12, color:c.textMuted, marginTop:2}}>Here's your account overview for today.</p>}
              {activePage==="billing" && <p style={{fontSize:12, color:c.textMuted, marginTop:2}}>View your invoices and make payments online.</p>}
              {activePage==="usage" && <p style={{fontSize:12, color:c.textMuted, marginTop:2}}>Your internet usage over the last 30 days.</p>}
              {activePage==="plan" && <p style={{fontSize:12, color:c.textMuted, marginTop:2}}>View your current plan and upgrade or downgrade anytime.</p>}
              {activePage==="account" && <p style={{fontSize:12, color:c.textMuted, marginTop:2}}>Manage your personal information and preferences.</p>}
              {activePage==="referral" && <p style={{fontSize:12, color:c.textMuted, marginTop:2}}>Refer friends and family to Netfactory.</p>}
            </div>
          </div>
          <div style={{display:"flex", alignItems:"center", gap:12}}>
            {activePage !== "support" && <span onClick={() => setShowAiChat(true)} style={{fontSize:12, color:c.textMuted, cursor:"pointer", whiteSpace:"nowrap"}}>Need assistance? <span style={{color:"#8b5cf6", fontWeight:600}}>Talk to our virtual assistant</span></span>}
            <Badge status={currentUser.status} large />
            <div style={{fontSize:13, color:c.textMuted, fontFamily:fontMono}}>{currentUser.acct}</div>
          </div>
        </header>

        {/* Page Content */}
        <main style={{flex:1, padding:24, overflowY:"auto"}}>
          {activePage === "dashboard" && DashboardPage()}
          {activePage === "billing" && BillingPage()}
          {activePage === "usage" && UsagePage()}
          {activePage === "plan" && PlanPage()}
          {activePage === "support" && SupportPage()}
          {activePage === "account" && AccountPage()}
          {activePage === "referral" && ReferralPage()}
        </main>

        {/* Footer */}
        <footer style={{padding:"12px 24px", borderTop:`1px solid ${c.border}`, background:c.bgCard, display:"flex", justifyContent:"space-between", alignItems:"center", flexWrap:"wrap", gap:8}}>
          <span style={{fontSize:11, color:c.textMuted}}>© 2026 {siteSettings.company_name || 'Netfactory'}. All Rights Reserved.</span>
          <span style={{fontSize:11, color:c.textMuted}}>{(companyInfo.company_address||"") + (companyInfo.company_address && companyInfo.company_phone ? " • " : "") + (companyInfo.company_phone||"")}</span>
        </footer>
      </div>

