// Drop-in replacement for native confirm(). Returns Promise<boolean>.
// opts: { title, body (str|html), icon, iconColor, kind ('info'|'warn'|'danger'),
//         actionLabel, actionIcon, actionClass, kv (array of [k,v]) }
function customConfirm(opts){
  return new Promise(resolve => {
    const o = Object.assign({
      title: 'Confirm', body: '', icon: 'fa-circle-question', iconColor: 'var(--accent)',
      kind: 'info', actionLabel: 'Confirm', actionIcon: 'fa-check', actionClass: 'btn-primary',
      kv: null,
    }, opts || {});
    const iconEl = document.getElementById('cnf-icon');
    iconEl.className = 'fas '+o.icon;
    iconEl.style.color = o.iconColor || 'var(--accent)';
    document.getElementById('cnf-title').textContent = o.title;
    // KV block (optional)
    const kvEl = document.getElementById('cnf-kv');
    if(o.kv && o.kv.length){
      kvEl.style.display='grid';
      kvEl.innerHTML = o.kv.map(([k,v]) => '<dt>'+esc(k)+'</dt><dd>'+esc(v)+'</dd>').join('');
    } else { kvEl.style.display='none'; kvEl.innerHTML=''; }
    // Warning panel — color depends on kind
    const wEl = document.getElementById('cnf-warning');
    const tones = {
      danger: { bg:'var(--red-bg)', border:'rgba(239,68,68,.25)', strong:'var(--red)', wIcon:'fa-circle-exclamation' },
      warn:   { bg:'rgba(245,158,11,.10)', border:'rgba(245,158,11,.30)', strong:'#f59e0b', wIcon:'fa-triangle-exclamation' },
      info:   { bg:'var(--accent-glow)', border:'rgba(59,130,246,.30)', strong:'var(--accent)', wIcon:'fa-circle-info' },
    };
    const t = tones[o.kind] || tones.info;
    if(o.body){
      wEl.style.display='block';
      wEl.style.background=t.bg;
      wEl.style.border='1px solid '+t.border;
      wEl.innerHTML = '<i class="fas '+t.wIcon+'" style="color:'+t.strong+'"></i> '+o.body;
    } else { wEl.style.display='none'; }
    document.getElementById('cnf-body').innerHTML = '';
    // Action button
    const okBtn = document.getElementById('cnf-ok');
    okBtn.className = 'btn '+(o.actionClass||'btn-primary');
    okBtn.innerHTML = '<i class="fas '+(o.actionIcon||'fa-check')+'"></i> '+esc(o.actionLabel);
    const cancelBtn = document.getElementById('cnf-cancel');
    const modal = document.getElementById('modal-confirm');
    function cleanup(result){
      modal.classList.remove('show');
      okBtn.onclick = null;
      cancelBtn.onclick = null;
      document.removeEventListener('keydown', keyHandler);
      resolve(result);
    }
    function keyHandler(e){
      if(e.key==='Escape'){ e.preventDefault(); cleanup(false); }
      else if(e.key==='Enter'){ e.preventDefault(); cleanup(true); }
    }
    okBtn.onclick = () => cleanup(true);
    cancelBtn.onclick = () => cleanup(false);
    document.addEventListener('keydown', keyHandler);
    modal.classList.add('show');
    setTimeout(() => okBtn.focus(), 50);
  });
}

