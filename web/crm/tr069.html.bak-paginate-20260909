function isSipDevice(d){
  if(!d) return false;
  const m=(d.manufacturer||'').toLowerCase();
  const pc=(d.product_class||'').toLowerCase();
  return m.includes('yealink') || pc.includes('sip-') || pc.includes('sip_') || pc.startsWith('t2') || pc.startsWith('t3') || pc.startsWith('t4') || pc.startsWith('t5') || pc.startsWith('w6');
}

function factoryReset(id){
  const d=findDevice(id); if(!d) return;
  ACTIVE_DEVICE=d;
  const serial=d.serial_number||d.device_id;
  document.getElementById('fr-device').textContent=serial;
  const sel=document.getElementById('fr-mode-select');
  sel.value = isSipDevice(d) ? 'soft' : 'hard';
  updateFactoryResetMode();
  const inp=document.getElementById('fr-confirm');
  const btn=document.getElementById('fr-submit');
  inp.value=''; btn.disabled=true;
  inp.oninput=()=>{ btn.disabled = (inp.value !== 'RESET'); };
  inp.onkeydown=(e)=>{ if(e.key==='Enter' && inp.value==='RESET'){ e.preventDefault(); submitFactoryReset(); } };
  document.getElementById('modal-factory-reset').classList.add('show');
  setTimeout(()=>inp.focus(),50);
}

function updateFactoryResetMode(){
  const mode=document.getElementById('fr-mode-select').value;
  document.getElementById('fr-warning-soft').style.display=(mode==='soft'?'block':'none');
  document.getElementById('fr-warning-hard').style.display=(mode==='hard'?'block':'none');
  document.getElementById('fr-mode').textContent = mode==='soft'
    ? 'Soft — preserve TR-069 (SIP / voice)'
    : 'Hard — full factoryReset RPC';
  const btn=document.getElementById('fr-submit');
  btn.innerHTML = mode==='soft'
    ? '<i class="fas fa-shield-halved"></i> Soft reset device'
    : '<i class="fas fa-triangle-exclamation"></i> Factory reset (full wipe)';
}

async function submitFactoryReset(){
  const d=ACTIVE_DEVICE; if(!d) return;
  const inp=document.getElementById('fr-confirm');
  if(inp.value!=='RESET'){ toast('Must type RESET in CAPS','err'); return; }
  const mode=document.getElementById('fr-mode-select').value;
  const id=encodeURIComponent(d.device_id);
  const serial=d.serial_number||d.device_id;
  closeModal('modal-factory-reset');
  try{
