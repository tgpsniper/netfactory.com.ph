// ── CWMP task queue ───────────────────────────────────────
let QUEUE_TIMER = null;
let QUEUE_LIVE_TIMER = null;
let QUEUE_ITEMS = [];

function startQueueAutoRefresh(){
  stopQueueAutoRefresh();
  QUEUE_TIMER = setInterval(loadQueue, 10000);
  // Tick the ETA countdowns once per second without a network call
  QUEUE_LIVE_TIMER = setInterval(tickQueueEtas, 1000);
}
function stopQueueAutoRefresh(){
  if (QUEUE_TIMER) { clearInterval(QUEUE_TIMER); QUEUE_TIMER = null; }
  if (QUEUE_LIVE_TIMER) { clearInterval(QUEUE_LIVE_TIMER); QUEUE_LIVE_TIMER = null; }
}

function fmtEta(secs){
  if (secs <= 0) return 'due now';
  if (secs < 60) return secs + 's';
  if (secs < 3600) {
    const m = Math.floor(secs/60), s = secs%60;
    return m + 'm ' + String(s).padStart(2,'0') + 's';
  }
  const h = Math.floor(secs/3600), m = Math.floor((secs%3600)/60);
  return h + 'h ' + m + 'm';
}

function actionPillHtml(item){
  let cls = '';
  let icon = 'fa-bolt';
  switch (item.name) {
    case 'download':
      cls = (item.file_type||'').includes('Firmware') ? 'firmware' : 'config';
      icon = (item.file_type||'').includes('Firmware') ? 'fa-microchip' : 'fa-gear';
      break;
    case 'reboot': cls = 'reboot'; icon = 'fa-power-off'; break;
    case 'factoryReset': cls = 'reboot'; icon = 'fa-triangle-exclamation'; break;
    case 'setParameterValues': icon = 'fa-pen-to-square'; break;
    case 'getParameterValues': icon = 'fa-magnifying-glass'; break;
    case 'refreshObject': icon = 'fa-rotate'; break;
  }
  return '<span class="action-pill '+cls+'"><i class="fas '+icon+'"></i> '+esc(item.action)+'</span>';
}

function etaPillHtml(item){
  if (item.fault) {
    return '<span class="eta-pill faulted" title="'+esc(item.fault.message||'')+'"><i class="fas fa-circle-exclamation"></i> faulted ('+(item.fault.retries||0)+' retries)</span>';
  }
  let cls = '';
  if (item.eta_seconds <= 0) cls = 'due';
  else if (item.eta_seconds < 60) cls = 'imminent';
  return '<span class="eta-pill '+cls+'" data-eta="'+item.eta_seconds+'"><i class="fas fa-clock"></i> '+fmtEta(item.eta_seconds)+'</span>';
}

function tickQueueEtas(){
  // Decrement live without re-fetching
  document.querySelectorAll('#queue-tbody .eta-pill[data-eta]').forEach(el => {
    let s = parseInt(el.getAttribute('data-eta'), 10);
    if (isNaN(s)) return;
    s -= 1;
    el.setAttribute('data-eta', s);
    el.querySelector('i').nextSibling.nodeValue = ' ' + fmtEta(Math.max(0, s));
    if (s <= 0) el.classList.add('due');
    else if (s < 60) el.classList.add('imminent');
  });
}

async function loadQueue(){
  try{
    const r = await fetch(API+'/queue');
    if(!r.ok) throw new Error('HTTP '+r.status);
    const j = await r.json();
    QUEUE_ITEMS = j.items || [];
    renderQueue();
    updateQueueBadge();
  } catch(e){
    document.getElementById('queue-tbody').innerHTML =
      '<tr><td colspan="6" class="empty"><i class="fas fa-circle-exclamation" style="color:var(--red)"></i>'+esc(e.message)+'</td></tr>';
  }
}

function updateQueueBadge(){
  const badge = document.getElementById('queue-badge');
  const n = QUEUE_ITEMS.length;
  const faulted = QUEUE_ITEMS.filter(t => t.fault).length;
  if (n === 0) { badge.style.display = 'none'; return; }
  badge.style.display = 'inline-block';
  badge.textContent = n;
  badge.className = 'tab-badge' + (faulted ? ' err' : (n > 5 ? ' warn' : ''));
}

function renderQueue(){
  const tb = document.getElementById('queue-tbody');
  if (!QUEUE_ITEMS.length) {
    tb.innerHTML = '<tr><td colspan="5" class="empty"><i class="fas fa-check-circle" style="color:var(--green)"></i>Queue is empty — no pending CWMP tasks.</td></tr>';
    return;
  }
  // Group tasks by device id. Order devices by earliest ETA.
  const groups = new Map();
  for (const it of QUEUE_ITEMS) {
    const id = (it.device && it.device.device_id) || 'unknown';
    if (!groups.has(id)) groups.set(id, { device: it.device || {}, tasks: [] });
    groups.get(id).tasks.push(it);
  }
  const rows = Array.from(groups.values()).sort((a, b) => {
    const ea = Math.min(...a.tasks.map(t => t.eta_seconds));
    const eb = Math.min(...b.tasks.map(t => t.eta_seconds));
    const fa = a.tasks.some(t => t.fault) ? 1 : 0;
    const fb = b.tasks.some(t => t.fault) ? 1 : 0;
    if (fa !== fb) return fb - fa;
    return ea - eb;
  });

  tb.innerHTML = rows.map(g => {
    const dev = g.device || {};
    const serial = dev.serial_number || dev.device_id || '?';
    const model = (dev.manufacturer || '') + (dev.product_class ? ' ' + dev.product_class : '');
    const lastInf = dev.last_inform ? ago(dev.last_inform) : 'never';
    const tip = 'Inform interval: '+(dev.inform_interval_sec||300)+'s. Tasks fire on next inform.';
    const earliestEta = Math.min(...g.tasks.map(t => t.eta_seconds));
    const earliest = g.tasks.find(t => t.eta_seconds === earliestEta) || g.tasks[0];
    const tasksHtml = g.tasks.map(it => {
      const targetTxt = it.target ? esc(it.target.length > 80 ? it.target.slice(0, 80) + '…' : it.target) : '';
      const cls = it.fault ? 'qtask faulted' : 'qtask';
      const faultLine = it.fault
        ? '<div class="target" style="color:var(--red)" title="'+esc(it.fault.message||'')+'"><i class="fas fa-circle-exclamation"></i> '+esc(it.fault.message||'fault')+' ('+(it.fault.retries||0)+' retries)</div>'
        : '';
      return '<div class="'+cls+'">'
        + actionPillHtml(it)
        + '<div class="qtask-body">'
        +   '<div class="purpose">'+esc(it.purpose||it.action)+'</div>'
        +   (targetTxt ? '<div class="target" title="'+(it.target?esc(it.target):'')+'">'+targetTxt+'</div>' : '')
        +   faultLine
        + '</div>'
        + '<button class="qtask-x" onclick="cancelQueueItem(\''+esc(it.task_id)+'\')" title="Cancel this task"><i class="fas fa-xmark"></i></button>'
        + '</div>';
    }).join('');
    return '<tr>'
      + '<td><div class="serial">'+esc(serial)+'<span class="qcount-badge">'+g.tasks.length+'</span></div>'
      +     '<div style="color:var(--text-muted);font-size:11px;margin-top:3px">'+esc(model||'—')+'</div></td>'
      + '<td><div class="qrow-tasks">'+tasksHtml+'</div></td>'
      + '<td class="ago" title="'+esc(tip)+'">'+lastInf+'</td>'
      + '<td>'+etaPillHtml(earliest)+'</td>'
      + '<td style="text-align:right;white-space:nowrap">'
      +   '<button class="btn btn-sm btn-danger" onclick="cancelDeviceTasks(\''+esc(dev.device_id)+'\','+g.tasks.length+')" title="Cancel all '+g.tasks.length+' task(s) for this device"><i class="fas fa-trash"></i> Cancel all</button>'
      + '</td>'
      + '</tr>';
  }).join('');
}

async function cancelDeviceTasks(deviceId, count){
  const tasks = QUEUE_ITEMS.filter(t => t.device && t.device.device_id === deviceId);
  if (!tasks.length) return;
  const ok = await customConfirm({
    title: 'Cancel device tasks', icon: 'fa-trash', iconColor: 'var(--red)',
    kind: 'warn',
    kv: [['Tasks', tasks.length+' pending']],
    body: 'Remove all queued CWMP tasks for this device. None will fire on its next inform.',
    actionLabel: 'Cancel '+tasks.length+' task'+(tasks.length===1?'':'s'),
    actionIcon: 'fa-trash', actionClass: 'btn-danger',
  });
  if(!ok) return;
  let okCount = 0, failCount = 0;
  for (const t of tasks) {
    try {
      const r = await fetch(API+'/queue/'+encodeURIComponent(t.task_id), { method:'DELETE' });
      if (r.ok) okCount++; else failCount++;
    } catch { failCount++; }
  }
  toast('Cancelled '+okCount+(failCount?(' • failed '+failCount):''), failCount?'warn':'ok');
  loadQueue();
}

