<!DOCTYPE html>
<html lang="en">
<head>
<script>
(function(){
  const _fetch = window.fetch;
  window.fetch = function(url, opts) {
    opts = opts || {};
    const urlStr = typeof url === 'string' ? url : (url.url || '');
    if (urlStr.startsWith('/api') || urlStr.includes('/api/')) {
      opts.credentials = 'include';
      const method = (opts.method || 'GET').toUpperCase();
      if (['POST','PUT','DELETE','PATCH'].includes(method)) {
        opts.headers = opts.headers || {};
        if (!opts.headers['X-CSRF-Token'] && !opts.headers['x-csrf-token']) {
          const m = document.cookie.match(/j2_csrf=([^;]+)/);
          if (m) opts.headers['X-CSRF-Token'] = m[1];
        }
      }
    }
    return _fetch.call(this, url, opts);
  };
})();
</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>TR-069 Manager — Netfactory CRM</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%233b82f6'/><text x='50%25' y='55%25' dominant-baseline='middle' text-anchor='middle' fill='white' font-size='14' font-weight='800' font-family='sans-serif'>NF</text></svg>">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
<style>
  :root {
    --bg:#0c1222; --bg-card:#131c31; --bg-alt:#1a2540; --bg-hover:#1e2d4a;
    --border:#1e2d4a; --border-light:#253552;
    --text:#e8ecf4; --text-sec:#8896b0; --text-muted:#5a6a84;
    --accent:#3b82f6; --accent-glow:rgba(59,130,246,0.15);
    --green:#22c55e; --green-bg:rgba(34,197,94,.12);
    --yellow:#f59e0b; --yellow-bg:rgba(245,158,11,.12);
    --red:#ef4444; --red-bg:rgba(239,68,68,.12);
    --purple:#a855f7; --purple-bg:rgba(168,85,247,.12);
  }
  *{margin:0;padding:0;box-sizing:border-box}
  body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--text);min-height:100vh}
  .topbar{display:flex;align-items:center;justify-content:space-between;padding:16px 28px;background:var(--bg-card);
    border-bottom:1px solid var(--border);position:sticky;top:0;z-index:100}
  .topbar-left{display:flex;align-items:center;gap:14px}
  .logo{width:36px;height:36px;border-radius:9px;background:linear-gradient(135deg,#60a5fa,#2563eb);
    display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:14px;font-family:'JetBrains Mono',monospace}
  .topbar h1{font-size:17px;font-weight:700}
  .topbar h1 span{color:var(--text-muted);font-weight:400;font-size:14px;margin-left:8px}
  .status-banner.inline{display:inline-flex;padding:6px 12px;margin:0 0 0 10px;font-size:12px;font-weight:500;border-radius:8px;gap:8px;vertical-align:middle}
  .status-banner.inline .ts{display:none}
  .topbar-right{display:flex;align-items:center;gap:12px}
  .btn{padding:8px 16px;border-radius:8px;border:1px solid var(--border);background:var(--bg-alt);
    color:var(--text-sec);font-size:13px;font-weight:600;cursor:pointer;font-family:inherit;transition:all .2s;
    text-decoration:none;display:inline-flex;align-items:center;gap:6px}
  .btn:hover{background:var(--bg-hover);color:var(--text);border-color:var(--accent)}
  .btn-primary{background:linear-gradient(135deg,#60a5fa,#2563eb);color:#fff;border-color:transparent}
  .btn-primary:hover{background:linear-gradient(135deg,#3b82f6,#1d4ed8);color:#fff}
  .btn-danger{background:var(--red-bg);color:var(--red);border-color:rgba(239,68,68,.25)}
  .btn-danger:hover{background:rgba(239,68,68,.2);color:#fff}
  .btn-sm{padding:5px 10px;font-size:12px}
  .main{max-width:1360px;margin:0 auto;padding:24px}
  .status-banner{display:flex;align-items:center;gap:12px;padding:14px 20px;border-radius:12px;margin-bottom:24px;font-size:14px;font-weight:500}
  .status-banner.ok{background:var(--green-bg);border:1px solid rgba(34,197,94,.2);color:var(--green)}
  .status-banner.warn{background:var(--yellow-bg);border:1px solid rgba(245,158,11,.2);color:var(--yellow)}
  .status-banner.err{background:var(--red-bg);border:1px solid rgba(239,68,68,.2);color:var(--red)}
  .status-banner .ts{margin-left:auto;color:var(--text-muted);font-size:12px;font-family:'JetBrains Mono',monospace}
  .cards{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-bottom:24px}
  @media(max-width:900px){.cards{grid-template-columns:repeat(2,1fr)}}
  .stat{background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:20px}
  .stat-label{font-size:12px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.8px;margin-bottom:6px}
  .stat-value{font-size:28px;font-weight:700;font-family:'JetBrains Mono',monospace;color:var(--text)}
  .stat-sub{font-size:12px;color:var(--text-sec);margin-top:6px}
  .table-wrap{background:var(--bg-card);border:1px solid var(--border);border-radius:14px;overflow:hidden}
  .table-head{display:flex;align-items:center;justify-content:space-between;padding:14px 20px;border-bottom:1px solid var(--border)}
  .table-head h2{font-size:14px;font-weight:700;color:var(--text);display:flex;align-items:center;gap:10px}
  .table-head .tools{display:flex;gap:8px;align-items:center}
  input[type=text],input[type=password],select{background:var(--bg-alt);border:1px solid var(--border);color:var(--text);
    padding:7px 10px;border-radius:7px;font-family:inherit;font-size:13px;outline:none}
  input[type=text]:focus,input[type=password]:focus,select:focus{border-color:var(--accent)}
  table{width:100%;border-collapse:collapse}
  th{padding:12px 16px;text-align:left;font-size:11px;font-weight:700;color:var(--text-muted);
    text-transform:uppercase;letter-spacing:.8px;background:var(--bg-alt);border-bottom:1px solid var(--border)}
  td{padding:12px 16px;font-size:13px;color:var(--text-sec);border-bottom:1px solid var(--border);vertical-align:middle}
  tr:last-child td{border-bottom:none}
  tr:hover td{background:rgba(59,130,246,.04)}
  .serial{font-family:'JetBrains Mono',monospace;color:var(--text);font-size:12px}
  .pill{display:inline-flex;align-items:center;gap:5px;padding:3px 9px;border-radius:999px;font-size:11px;font-weight:600}
  .pill.on{background:var(--green-bg);color:var(--green)}
  .pill.off{background:var(--red-bg);color:var(--red)}
  .pill.linked{background:var(--accent-glow);color:var(--accent)}
  .pill.unlinked{background:var(--yellow-bg);color:var(--yellow)}
  .pill.stale{background:rgba(148,163,184,.15);color:#94a3b8}
  .ago{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--text-muted)}
  .empty{padding:60px 20px;text-align:center;color:var(--text-muted)}
  .empty i{font-size:36px;margin-bottom:10px;opacity:.4;display:block}
  .modal-bg{position:fixed;inset:0;background:rgba(5,10,20,.75);display:none;align-items:center;justify-content:center;z-index:1000;backdrop-filter:blur(4px)}
  .modal-bg.show{display:flex}
  .modal{background:var(--bg-card);border:1px solid var(--border);border-radius:14px;padding:24px;width:min(90vw,480px);max-height:90vh;overflow:auto}
  .modal h3{font-size:16px;margin-bottom:16px;display:flex;align-items:center;gap:10px}
  .field{margin-bottom:14px}
  .field label{display:block;font-size:12px;font-weight:600;color:var(--text-muted);text-transform:uppercase;letter-spacing:.8px;margin-bottom:6px}
  .field input,.field select{width:100%}
  .modal-actions{display:flex;gap:8px;justify-content:flex-end;margin-top:18px;padding-top:16px;border-top:1px solid var(--border)}
  .hint{font-size:12px;color:var(--text-muted);margin-top:4px}
  .cfg-tab{background:transparent;border:0;padding:8px 14px;color:var(--text-muted);font-size:13px;font-weight:600;cursor:pointer;border-bottom:2px solid transparent;margin-bottom:-1px}
  .cfg-tab:hover{color:var(--text)}
  .cfg-tab.active{color:var(--accent);border-bottom-color:var(--accent)}
  .cfg-pane{max-height:55vh;overflow-y:auto;padding-right:4px}
  .cfg-adv-row{display:grid;grid-template-columns:1fr 1fr 100px 30px;gap:6px;margin-bottom:6px}
  .cfg-adv-row input,.cfg-adv-row select{width:100%}
  /* Inputs with a current pulled value: green placeholder/border accent. */
  .field input.has-current::placeholder{color:#22c55e;opacity:.85}
  .field input.has-current{border-color:rgba(34,197,94,.35)}
  .field select.has-current{border-color:rgba(34,197,94,.35);color:#22c55e}
  /* Eye toggle wrap for password fields. */
  .pw-wrap{position:relative}
  .pw-wrap input{padding-right:38px}
  .pw-eye{position:absolute;right:8px;top:50%;transform:translateY(-50%);background:transparent;border:0;color:var(--text-muted);cursor:pointer;padding:4px 8px;border-radius:6px}
  .pw-eye:hover{color:var(--accent);background:var(--bg-alt)}
  .kv{display:grid;grid-template-columns:140px 1fr;gap:6px 14px;font-size:13px;margin-bottom:18px}
  .kv dt{color:var(--text-muted)}
  .kv dd{color:var(--text);font-family:'JetBrains Mono',monospace;font-size:12px;word-break:break-all}
  .toast{position:fixed;bottom:24px;right:24px;background:var(--bg-card);border:1px solid var(--border);border-radius:10px;
    padding:12px 16px;color:var(--text);font-size:13px;z-index:2000;display:none;box-shadow:0 8px 24px rgba(0,0,0,.4);max-width:380px}
  .toast.show{display:block}
  .toast.ok{border-color:rgba(34,197,94,.3)}
  .toast.err{border-color:rgba(239,68,68,.3)}
  .spinner{display:inline-block;width:12px;height:12px;border:2px solid rgba(255,255,255,.25);border-top-color:#fff;border-radius:50%;animation:spin .8s linear infinite}
  @keyframes spin{to{transform:rotate(360deg)}}
  .tabs{display:flex;gap:4px;margin-bottom:22px;border-bottom:1px solid var(--border)}
  .tab{padding:10px 18px;color:var(--text-muted);font-weight:600;font-size:13px;cursor:pointer;border:none;background:none;
    border-bottom:2px solid transparent;font-family:inherit}
  .tab:hover{color:var(--text)}
  .tab.active{color:var(--accent);border-bottom-color:var(--accent)}
  .tab-badge{background:var(--accent);color:#fff;font-size:10px;font-weight:700;padding:2px 6px;border-radius:10px;margin-left:6px;line-height:1;display:inline-block;min-width:16px;text-align:center}
  .tab-badge.warn{background:var(--yellow)}
  .tab-badge.err{background:var(--red)}
  .eta-pill{display:inline-flex;align-items:center;gap:6px;font-family:'JetBrains Mono',monospace;font-size:12px;padding:3px 8px;border-radius:6px;background:var(--bg-alt);border:1px solid var(--border)}
  .eta-pill.due{background:rgba(245,158,11,.10);border-color:rgba(245,158,11,.35);color:var(--yellow)}
  .eta-pill.imminent{background:var(--accent-glow);border-color:rgba(59,130,246,.35);color:var(--accent)}
  .eta-pill.faulted{background:var(--red-bg);border-color:rgba(239,68,68,.35);color:var(--red)}
  .action-pill{display:inline-flex;align-items:center;gap:6px;font-size:12px;font-weight:600;padding:3px 9px;border-radius:6px;background:var(--bg-alt);border:1px solid var(--border)}
  .action-pill i{font-size:10px}
  .action-pill.firmware{background:var(--accent-glow);border-color:rgba(59,130,246,.35);color:var(--accent)}
  .action-pill.config{background:rgba(168,85,247,.10);border-color:rgba(168,85,247,.35);color:#a855f7}
  .action-pill.reboot{background:var(--red-bg);border-color:rgba(239,68,68,.35);color:var(--red)}
  /* Per-device task list (each row = one device, multiple tasks stacked) */
  .qrow-tasks{display:flex;flex-direction:column;gap:8px}
  .qtask{display:flex;align-items:flex-start;gap:10px;padding:8px 10px;background:var(--bg-alt);
         border:1px solid var(--border);border-radius:8px}
  .qtask.faulted{border-color:rgba(239,68,68,.35);background:var(--red-bg)}
  .qtask-body{flex:1;min-width:0}
  .qtask-body .purpose{font-size:13px;font-weight:500;color:var(--text);line-height:1.3}
  .qtask-body .target{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--text-muted);
                       margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:520px}
  .qtask-x{background:transparent;border:0;color:var(--text-muted);cursor:pointer;padding:4px 8px;border-radius:4px;font-size:13px}
  .qtask-x:hover{color:var(--red);background:var(--red-bg)}
  .qcount-badge{display:inline-block;background:var(--accent-glow);color:var(--accent);font-size:11px;
                font-weight:700;padding:2px 8px;border-radius:10px;margin-left:6px}
  .panel{display:none}
  .panel.active{display:block}
  .up-form{display:flex;gap:10px;align-items:center;flex-wrap:wrap;padding:16px 20px;border-bottom:1px solid var(--border);background:var(--bg-alt)}
  .up-form input[type=file]{color:var(--text-sec)}
  .metric-rows{display:grid;grid-template-columns:100px 1fr;gap:6px 12px;font-size:12px;font-family:'JetBrains Mono',monospace}
  .metric-rows dt{color:var(--text-muted)}
  .spark{display:inline-block;height:18px;vertical-align:middle;margin-left:8px}
  .sev-critical{color:var(--red)}
  .sev-warning{color:var(--yellow)}
  .sev-info{color:var(--accent)}
  .sev-test{color:var(--text-muted)}
  dl.alert-detail dt{font-weight:600;color:var(--text-muted)}
  dl.alert-detail dd{margin-bottom:8px;font-family:'JetBrains Mono',monospace;font-size:12px;white-space:pre-wrap}
</style>
</head>
<body>
<div class="topbar">
  <div class="topbar-left">
    <div class="logo">NF</div>
    <h1>TR-069 Manager <span id="banner" class="status-banner inline warn" style="display:none"></span></h1>
  </div>
  <div class="topbar-right">
    <a href="/crm/" class="btn"><i class="fas fa-arrow-left"></i> Back</a>
    <!-- The panel is its own origin, not a sub-path of this site: the GenieACS UI
         fetches root-absolute /api/ and owns the routes /devices and /login, so it
         cannot be mounted under /genieacs/ — which is why that path 404s. -->
    <a href="https://acs.netfactory.com.ph/" target="_blank" rel="noopener" class="btn"><i class="fas fa-wrench"></i> GenieACS UI</a>
    <button class="btn btn-primary" onclick="refreshAll()"><i class="fas fa-rotate"></i> Refresh</button>
  </div>
</div>

<div class="main">
  <nav class="tabs">
    <button class="tab active" data-tab="devices" onclick="switchTab('devices')"><i class="fas fa-router"></i> Devices</button>
    <button class="tab" data-tab="firmware" onclick="switchTab('firmware')"><i class="fas fa-microchip"></i> Firmware</button>
    <button class="tab" data-tab="queue" onclick="switchTab('queue')"><i class="fas fa-list-check"></i> Queue <span id="queue-badge" class="tab-badge" style="display:none">0</span></button>
    <button class="tab" data-tab="alerts" onclick="switchTab('alerts')"><i class="fas fa-bell"></i> Alerts</button>
  </nav>

  <div id="panel-devices" class="panel active">
  <div class="cards">
    <div class="stat"><div class="stat-label">Total Devices</div><div id="stat-total" class="stat-value">—</div><div class="stat-sub">seen by ACS</div></div>
    <div class="stat"><div class="stat-label">Online</div><div id="stat-online" class="stat-value" style="color:var(--green)">—</div><div class="stat-sub">informed &lt;10 min ago</div></div>
    <div class="stat"><div class="stat-label">Linked</div><div id="stat-linked" class="stat-value" style="color:var(--accent)">—</div><div class="stat-sub">bound to subscriber</div></div>
    <div class="stat"><div class="stat-label">Unlinked</div><div id="stat-unlinked" class="stat-value" style="color:var(--yellow)">—</div><div class="stat-sub">awaiting assignment</div></div>
  </div>

  <div id="bulk-bar" style="display:none;margin-bottom:14px;padding:12px 16px;background:var(--accent-glow);border:1px solid rgba(59,130,246,.35);border-radius:12px;align-items:center;gap:10px">
    <span id="bulk-count" style="font-weight:700;color:var(--accent)"></span>
    <span style="color:var(--text-sec);font-size:13px">selected</span>
    <button class="btn btn-sm btn-danger" onclick="bulkReboot()"><i class="fas fa-power-off"></i> Reboot selected</button>
    <button class="btn btn-sm" onclick="openBulkWifi()"><i class="fas fa-wifi"></i> Bulk WiFi</button>
    <button class="btn btn-sm" style="margin-left:auto" onclick="clearSelection()">Clear</button>
  </div>

  <div class="table-wrap">
    <div class="table-head">
      <h2><i class="fas fa-router"></i> Devices</h2>
      <div class="tools">
        <button class="btn btn-sm btn-danger" onclick="lockAllYealinks()" title="Push security cfg to all Yealink phones — disables LCD factory reset and rotates admin password"><i class="fas fa-lock"></i> Lock all Yealinks</button>
        <input type="text" id="filter" placeholder="Filter serial / manufacturer / subscriber…" oninput="renderTable()" style="width:260px">
        <select id="filter-status" onchange="renderTable()">
          <option value="">All statuses</option>
          <option value="online">Online only</option>
          <option value="offline">Offline only</option>
          <option value="linked">Linked only</option>
          <option value="unlinked">Unlinked only</option>
        </select>
      </div>
    </div>
    <div id="table-body-wrap">
      <table>
        <thead><tr>
          <th style="width:32px"><input type="checkbox" id="sel-all" onchange="toggleAll(this.checked)"></th>
          <th>Status</th><th>Serial</th><th>Manufacturer / Model</th><th>Subscriber</th><th>IP</th><th>Last Inform</th><th>Actions</th>
        </tr></thead>
        <tbody id="tbody"><tr><td colspan="8" class="empty"><i class="fas fa-satellite-dish"></i>Loading…</td></tr></tbody>
      </table>
    </div>
  </div>
  </div><!-- /panel-devices -->

  <!-- ── Firmware panel ─────────────────────────────── -->
  <div id="panel-firmware" class="panel">
    <div class="table-wrap">
      <div class="table-head">
        <h2><i class="fas fa-microchip"></i> Firmware store</h2>
        <div class="tools">
          <button class="btn btn-sm" onclick="refreshFirmwares()"><i class="fas fa-rotate"></i> Refresh</button>
        </div>
      </div>
      <form class="up-form" id="fw-upload-form" onsubmit="uploadFirmware(event)">
        <input type="file" id="fw-file" accept=".bin,.img,.pkg,.tar,.gz,.upg,.trx" required>
        <input type="text" id="fw-oui" placeholder="OUI (optional)" style="width:130px">
        <input type="text" id="fw-product" placeholder="Product class (optional)" style="width:180px">
        <input type="text" id="fw-version" placeholder="Version (optional)" style="width:150px">
        <button class="btn btn-primary btn-sm" type="submit"><i class="fas fa-upload"></i> Upload</button>
      </form>
      <table>
        <thead><tr><th>Filename</th><th>Size</th><th>OUI / Product</th><th>Version</th><th>Uploaded</th><th>Actions</th></tr></thead>
        <tbody id="fw-tbody"><tr><td colspan="6" class="empty"><i class="fas fa-inbox"></i>No firmware files uploaded yet.</td></tr></tbody>
      </table>
    </div>
  </div><!-- /panel-firmware -->

  <!-- ── Queue panel ────────────────────────────────── -->
  <div id="panel-queue" class="panel">
    <div class="table-wrap">
      <div class="table-head">
        <h2><i class="fas fa-list-check"></i> CWMP task queue</h2>
        <div class="tools">
          <span style="font-size:12px;color:var(--text-muted)">Auto-refresh every 10 s</span>
          <button class="btn btn-sm" onclick="loadQueue()"><i class="fas fa-rotate"></i> Refresh</button>
          <button class="btn btn-sm btn-danger" onclick="clearAllQueue()"><i class="fas fa-trash"></i> Clear all</button>
        </div>
      </div>
      <table>
        <thead>
          <tr>
            <th style="width:200px">Device</th>
            <th>Pending tasks</th>
            <th style="width:130px">Last inform</th>
            <th style="width:120px">Next ETA</th>
            <th style="width:140px;text-align:right">Actions</th>
          </tr>
        </thead>
        <tbody id="queue-tbody"><tr><td colspan="5" class="empty"><i class="fas fa-hourglass-half"></i> Loading…</td></tr></tbody>
      </table>
    </div>
  </div><!-- /panel-queue -->

  <!-- ── Alerts panel ───────────────────────────────── -->
  <div id="panel-alerts" class="panel">
    <div class="table-wrap" style="margin-bottom:20px">
      <div class="table-head">
        <h2><i class="fas fa-sliders"></i> Alert rules</h2>
        <div class="tools">
          <button class="btn btn-sm" onclick="fireAlertTest()"><i class="fas fa-paper-plane"></i> Send test</button>
          <button class="btn btn-sm" onclick="runAlertsNow()"><i class="fas fa-play"></i> Run now</button>
          <button class="btn btn-primary btn-sm" onclick="saveAlertsConfig()"><i class="fas fa-save"></i> Save</button>
        </div>
      </div>
      <div style="padding:20px;display:grid;grid-template-columns:1fr 1fr;gap:16px">
        <div class="field" style="margin:0;grid-column:span 2">
          <label>Alerts enabled</label>
          <select id="ac-enabled"><option value="true">Yes</option><option value="false">No</option></select>
          <div class="hint">Cron runs every 5 min. When disabled, no alerts fire or deliver.</div>
        </div>
        <div class="field" style="margin:0">
          <label>SMS numbers (comma-separated)</label>
          <input type="text" id="ac-sms" placeholder="09171112222,09182223333">
        </div>
        <div class="field" style="margin:0">
          <label>Email (single address)</label>
          <input type="text" id="ac-email" placeholder="ops@netfactory.com.ph">
        </div>
        <div class="field" style="margin:0">
