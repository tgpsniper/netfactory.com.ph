<script>
const API='/api/admin/tr069';
let DEVICES=[]; let SETTINGS=null; let ACTIVE_DEVICE=null;
let SELECTED=new Set();

function ago(iso){ if(!iso) return 'never'; const s=Math.floor((Date.now()-new Date(iso).getTime())/1000);
  if(s<60) return s+'s ago'; if(s<3600) return Math.floor(s/60)+'m ago'; if(s<86400) return Math.floor(s/3600)+'h ago'; return Math.floor(s/86400)+'d ago'; }
function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c])); }

function isPrivateIp(ip){
  if(!ip) return false;
  if(ip==='127.0.0.1' || ip==='::1') return true;
  if(/^10\./.test(ip)) return true;
  if(/^192\.168\./.test(ip)) return true;
  if(/^172\.(1[6-9]|2\d|3[01])\./.test(ip)) return true;
  if(/^169\.254\./.test(ip)) return true;
  return false;
}

function renderIpCell(d){
  const lan = d.ip_address || '';
  const wan = d.public_ip || '';
  if(!lan && !wan) return '—';
  if(!wan) return esc(lan); // no public-IP correlation yet
  if(!lan) return '<span title="Public WAN IP"><i class="fas fa-globe" style="color:var(--accent);font-size:10px"></i> '+esc(wan)+'</span>';
  if(lan === wan){
    // Same network as ACS — direct (no NAT)
    return '<span title="Direct (no NAT — phone on same network as ACS)">'+esc(lan)+'</span>'
      +'<br><span style="color:var(--text-muted);font-size:10px"><i class="fas fa-link"></i> direct</span>';
  }
  // LAN + public differ → stacked. Show LAN above (private) and WAN below (public/NAT).
  const lanIsPrivate = isPrivateIp(lan);
  const wanIsPrivate = isPrivateIp(wan);
  const wanColor = wanIsPrivate ? 'var(--text-muted)' : '#22c55e';
  const wanIcon = wanIsPrivate ? 'fa-network-wired' : 'fa-globe';
  const wanLabel = wanIsPrivate ? 'VPN' : 'WAN';
  return '<span title="Device LAN IP (private)"><i class="fas fa-house" style="color:var(--text-muted);font-size:10px"></i> '+esc(lan)+(lanIsPrivate?'':'')+'</span>'
    +'<br><span title="ACS-side source IP" style="color:'+wanColor+';font-size:11px"><i class="fas '+wanIcon+'" style="font-size:10px"></i> '+esc(wan)+' <span style="opacity:.6">'+wanLabel+'</span></span>';
}

