async function openConfig(id){
  const d=findDevice(id); if(!d) return;
  ACTIVE_DEVICE=d;
  document.getElementById('cfg-device-id').textContent=d.device_id;
  document.getElementById('cfg-device-model').textContent=(d.manufacturer||'')+' '+(d.product_class||'');
  // Reset all fields and clear pulled-value styling
  CFG_FIELDS.forEach(f=>{
    const el=document.getElementById('cfg-'+f);
    if(!el) return;
    el.value='';
    el.classList.remove('has-current');
    el.removeAttribute('data-original');
    if(el.type==='password'){ el.type='password'; const eye=el.parentElement.querySelector('.pw-eye i'); if(eye) eye.className='fas fa-eye'; }
  });
  document.getElementById('cfg-adv-list').innerHTML='';
  cfgTab('net');
  document.getElementById('modal-config').classList.add('show');
  try{
    const r=await fetch(API+'/devices/'+id+'/config');
    if(!r.ok) throw new Error('load failed');
    const j=await r.json();
    Object.entries(j.values||{}).forEach(([k,v])=>{
      const el=document.getElementById('cfg-'+k);
      if(!el) return;
      if(v===null || v===undefined || v==='' || v===false) return;
      const sval=String(v);
      el.classList.add('has-current');
      el.setAttribute('data-original', sval);
      if(el.tagName==='SELECT'){
        // Match value or boolean-ish
        const opt=Array.from(el.options).find(o=>o.value===sval || o.value===sval.toLowerCase() || (o.value==='true'&&sval==='true') || (o.value==='false'&&sval==='false'));
        if(opt){ el.value=opt.value; }
        else el.value='';
      } else {
        // Pre-fill the actual current value so the operator can see it
        // (and reveal it via the eye toggle for password inputs).
        el.value=sval;
        el.placeholder='current: '+sval;
      }
    });
  } catch(e){ /* non-fatal: just show empty form */ }
}

async function submitConfig(){
  if(!ACTIVE_DEVICE) return;
  const fields={};
  CFG_FIELDS.forEach(f=>{
    const el=document.getElementById('cfg-'+f);
    if(!el) return;
    const v=(el.value||'').trim();
    if(v==='') return;
    // Skip if the value matches what was pulled from the device
    // (avoids re-pushing unchanged values).
    const orig=el.getAttribute('data-original');
    if(orig!==null && v===orig) return;
    fields[f]=v;
  });
  const advanced=[];
  document.querySelectorAll('#cfg-adv-list .cfg-adv-row').forEach(row=>{
    const inputs=row.querySelectorAll('input');
    const sel=row.querySelector('select');
    const path=inputs[0].value.trim();
    const value=inputs[1].value;
    if(path && value!=='') advanced.push({path, value, type: sel.value});
  });
  if(!Object.keys(fields).length && !advanced.length){ toast('Nothing to apply','err'); return; }
  try{
    const r=await fetch(API+'/devices/'+encodeURIComponent(ACTIVE_DEVICE.device_id)+'/config',{
      method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({fields,advanced})
    });
    const j=await r.json();
    if(!r.ok) throw new Error(j.error||r.statusText);
    toast('Applied '+j.applied+' parameter(s); CPE will pick up on next inform','ok');
    closeModal('modal-config');
  } catch(e){ toast('Config apply failed: '+e.message,'err'); }
}

