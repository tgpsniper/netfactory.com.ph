async function openMetrics(id){
  const d = findDevice(id); if(!d) return;
  document.getElementById('metrics-device').textContent = d.device_id;
  const body = document.getElementById('metrics-body');
  body.innerHTML = '<div class="empty"><i class="fas fa-hourglass-half"></i>Loading…</div>';
  document.getElementById('modal-metrics').classList.add('show');
  try {
    const r = await fetch(API+'/devices/'+encodeURIComponent(d.device_id)+'/metrics?hours=24');
    const j = await r.json();
    if (!r.ok) throw new Error(j.error||r.statusText);
    const pts = j.points || [];
    if (!pts.length){
      body.innerHTML = '<div class="empty"><i class="fas fa-chart-line"></i>No metrics yet. Collection runs every 10 min on linked devices.</div>';
      return;
    }
    const latest = pts[pts.length-1];
    const firstRx = pts.find(p=>p.rx_power!=null);
    const rxSeries = pts.filter(p=>p.rx_power!=null).map(p=>p.rx_power);
    const txSeries = pts.filter(p=>p.tx_power!=null).map(p=>p.tx_power);
    body.innerHTML = '<dl class="metric-rows">'
      + '<dt>Latest sample</dt><dd>'+ago(latest.t)+'</dd>'
      + '<dt>RX power</dt><dd>'+(latest.rx_power!=null?latest.rx_power+' dBm':'—')+renderSpark(rxSeries,'#22c55e')+'</dd>'
      + '<dt>TX power</dt><dd>'+(latest.tx_power!=null?latest.tx_power+' dBm':'—')+renderSpark(txSeries,'#3b82f6')+'</dd>'
      + '<dt>Voltage</dt><dd>'+(latest.voltage!=null?latest.voltage+' V':'—')+'</dd>'
      + '<dt>Temp</dt><dd>'+(latest.temperature!=null?latest.temperature+' °C':'—')+'</dd>'
      + '<dt>CPU</dt><dd>'+(latest.cpu_usage!=null?latest.cpu_usage.toFixed(1)+' %':'—')+'</dd>'
      + '<dt>Memory</dt><dd>'+(latest.mem_usage!=null?latest.mem_usage.toFixed(1)+' %':'—')+'</dd>'
      + '<dt>Uptime</dt><dd>'+(latest.uptime_sec!=null?Math.round(latest.uptime_sec/3600)+' h':'—')+'</dd>'
      + '<dt>Samples</dt><dd>'+pts.length+' in 24 h</dd>'
      + '</dl>';
  } catch(e){
    body.innerHTML = '<div class="empty" style="color:var(--red)"><i class="fas fa-triangle-exclamation"></i>'+esc(e.message)+'</div>';
  }
}

function renderSpark(series, color){
  if (!series || series.length < 2) return '';
  const w=120, h=18, min=Math.min(...series), max=Math.max(...series);
  const range=max-min || 1;
  const pts = series.map((v,i)=>{
    const x = (i/(series.length-1))*w;
    const y = h - ((v-min)/range)*h;
    return x.toFixed(1)+','+y.toFixed(1);
  }).join(' ');
  return '<svg class="spark" viewBox="0 0 '+w+' '+h+'" width="'+w+'" height="'+h+'"><polyline points="'+pts+'" fill="none" stroke="'+color+'" stroke-width="1.5"/></svg>';
}

// ── Alerts config + history ───────────────────────────────
async function loadAlertsConfig(){
  try {
    const r = await fetch(API+'/alerts/config');
    const cfg = await r.json();
    document.getElementById('ac-enabled').value = cfg.tr069_alerts_enabled || 'false';
    document.getElementById('ac-sms').value = cfg.tr069_alerts_sms_numbers || '';
    document.getElementById('ac-email').value = cfg.tr069_alerts_email_to || '';
    document.getElementById('ac-offline-pct').value = cfg.tr069_alerts_offline_pct || '20';
    document.getElementById('ac-offline-min').value = cfg.tr069_alerts_offline_min_fleet || '10';
    document.getElementById('ac-fault').value = cfg.tr069_alerts_fault_threshold || '25';
    document.getElementById('ac-optical').value = cfg.tr069_alerts_optical_rx_dbm || '-27';
    document.getElementById('ac-cooldown').value = cfg.tr069_alerts_cooldown_min || '60';
  } catch(e){ toast('Failed to load alerts config: '+e.message,'err'); }
}

async function saveAlertsConfig(){
  const payload = {
    tr069_alerts_enabled: document.getElementById('ac-enabled').value,
    tr069_alerts_sms_numbers: document.getElementById('ac-sms').value.trim(),
    tr069_alerts_email_to: document.getElementById('ac-email').value.trim(),
    tr069_alerts_offline_pct: document.getElementById('ac-offline-pct').value.trim(),
    tr069_alerts_offline_min_fleet: document.getElementById('ac-offline-min').value.trim(),
    tr069_alerts_fault_threshold: document.getElementById('ac-fault').value.trim(),
    tr069_alerts_optical_rx_dbm: document.getElementById('ac-optical').value.trim(),
    tr069_alerts_cooldown_min: document.getElementById('ac-cooldown').value.trim(),
  };
  try {
    const r = await fetch(API+'/alerts/config', { method:'PUT', headers:{'Content-Type':'application/json'}, body: JSON.stringify(payload) });
    const j = await r.json();
    if (!r.ok) throw new Error(j.error||r.statusText);
    toast('Alerts config saved','ok');
  } catch(e){ toast('Save failed: '+e.message,'err'); }
}

async function loadAlertsHistory(){
  try {
    const r = await fetch(API+'/alerts?limit=100');
    const j = await r.json();
    const tb = document.getElementById('alerts-tbody');
    if (!j.alerts || !j.alerts.length){
      tb.innerHTML = '<tr><td colspan="5" class="empty"><i class="fas fa-bell-slash"></i>No alerts recorded yet.</td></tr>';
      return;
    }
    tb.innerHTML = j.alerts.map(a => {
      const channels = [a.sent_sms_to ? 'SMS:'+esc(a.sent_sms_to) : '', a.sent_email_to ? 'Email:'+esc(a.sent_email_to) : ''].filter(Boolean).join(' · ') || '<span style="color:var(--text-muted)">none</span>';
      return '<tr onclick="showAlert('+JSON.stringify(a).replace(/"/g,'&quot;')+')" style="cursor:pointer">'
        +'<td class="ago">'+ago(a.fired_at)+'</td>'
        +'<td><span class="sev-'+esc(a.severity)+'"><i class="fas fa-circle" style="font-size:7px"></i> '+esc(a.severity)+'</span></td>'
        +'<td class="serial">'+esc(a.alert_type)+'</td>'
        +'<td>'+esc(a.summary)+'</td>'
        +'<td class="serial">'+channels+'</td>'
        +'</tr>';
    }).join('');
  } catch(e){ toast('Failed to load history: '+e.message,'err'); }
}

function showAlert(a){
  const body = document.getElementById('alert-detail-body');
  body.innerHTML = '<dt>Fired</dt><dd>'+esc(a.fired_at)+'</dd>'
    +'<dt>Severity</dt><dd class="sev-'+esc(a.severity)+'">'+esc(a.severity)+'</dd>'
    +'<dt>Type</dt><dd>'+esc(a.alert_type)+'</dd>'
    +'<dt>Summary</dt><dd>'+esc(a.summary)+'</dd>'
    +'<dt>Detail</dt><dd>'+esc(a.detail||'—')+'</dd>'
    +'<dt>SMS to</dt><dd>'+esc(a.sent_sms_to||'—')+'</dd>'
    +'<dt>Email to</dt><dd>'+esc(a.sent_email_to||'—')+'</dd>';
  document.getElementById('modal-alert').classList.add('show');
}

async function fireAlertTest(){
  const ok = await customConfirm({
    title: 'Send test alert', icon: 'fa-paper-plane', iconColor: 'var(--accent)',
    kind: 'info',
    body: 'A real SMS and email will be dispatched to the configured alert recipients to verify the channel works. Use sparingly to avoid SMS spend / inbox spam.',
    actionLabel: 'Send test', actionIcon: 'fa-paper-plane', actionClass: 'btn-primary',
  });
  if(!ok) return;
  try {
    const r = await fetch(API+'/alerts/test', { method:'POST' });
    const j = await r.json();
    if (!r.ok) throw new Error(j.error||r.statusText);
    toast('Test alert dispatched','ok');
    loadAlertsHistory();
  } catch(e){ toast('Test failed: '+e.message,'err'); }
}

async function runAlertsNow(){
  try {
    const r = await fetch(API+'/alerts/run-now', { method:'POST' });
    const j = await r.json();
    if (!r.ok) throw new Error(j.error||r.statusText);
    toast((j.recent_alerts||[]).length ? 'Alerts run — '+j.recent_alerts.length+' recent' : 'Alerts run — no conditions triggered','ok');
    loadAlertsHistory();
  } catch(e){ toast('Run failed: '+e.message,'err'); }
}

