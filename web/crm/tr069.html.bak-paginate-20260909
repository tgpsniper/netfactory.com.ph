function renderTable(){
  const q=(document.getElementById('filter').value||'').toLowerCase();
  const fs=document.getElementById('filter-status').value;
  const rows=DEVICES.filter(d=>{
    if(fs==='online'&&!d.online) return false;
    if(fs==='offline'&&d.online) return false;
    if(fs==='linked'&&!d.linked) return false;
    if(fs==='unlinked'&&d.linked) return false;
    if(!q) return true;
    const sub=d.subscriber?(d.subscriber.account_number+' '+(d.subscriber.first_name||'')+' '+(d.subscriber.last_name||'')):'';
    return (d.serial_number||'').toLowerCase().includes(q)
        || (d.manufacturer||'').toLowerCase().includes(q)
        || (d.product_class||'').toLowerCase().includes(q)
        || sub.toLowerCase().includes(q);
  });
  const tb=document.getElementById('tbody');
  if(!rows.length){
    tb.innerHTML='<tr><td colspan="8" class="empty"><i class="fas fa-satellite-dish"></i>No devices yet. CPE will appear here once they INFORM.</td></tr>';
    updateBulkBar(); return;
  }
  tb.innerHTML=rows.map(d=>{
    const statusPill = d.stale
      ? '<span class="pill stale"><i class="fas fa-ghost"></i> stale</span>'
      : (d.online?'<span class="pill on"><i class="fas fa-circle" style="font-size:7px"></i> online</span>':'<span class="pill off"><i class="fas fa-circle" style="font-size:7px"></i> offline</span>');
    const linkPill = d.linked
      ? '<span class="pill linked"><i class="fas fa-user"></i> '+esc(d.subscriber.account_number)+'</span> '+esc((d.subscriber.first_name||'')+' '+(d.subscriber.last_name||''))
      : '<span class="pill unlinked">unlinked</span>';
    const encId = encodeURIComponent(d.device_id);
    const checked = SELECTED.has(d.device_id) ? 'checked' : '';
    return '<tr>'
      +'<td><input type="checkbox" data-did="'+esc(d.device_id)+'" onchange="toggleRow(this)" '+checked+'></td>'
      +'<td>'+statusPill+'</td>'
      +'<td class="serial">'+esc(d.serial_number||'?')+'</td>'
      +'<td>'+esc(d.manufacturer||'—')+'<br><span style="color:var(--text-muted);font-size:11px">'+esc(d.product_class||'')+'</span></td>'
      +'<td>'+linkPill+'</td>'
      +'<td class="serial">'+renderIpCell(d)+'</td>'
      +'<td class="ago">'+ago(d.last_inform)+'</td>'
      +'<td style="white-space:nowrap">'
        +(d.linked
          ? '<button class="btn btn-sm" onclick="unlink(\''+encId+'\')" title="Unlink"><i class="fas fa-unlink"></i></button> '
          : '<button class="btn btn-sm btn-primary" onclick="openLink(\''+encId+'\')"><i class="fas fa-link"></i> Link</button> ')
        +'<button class="btn btn-sm" onclick="openConfig(\''+encId+'\')" title="Configure"><i class="fas fa-sliders"></i></button> '
        +'<button class="btn btn-sm" onclick="openWifi(\''+encId+'\')" title="WiFi"><i class="fas fa-wifi"></i></button> '
        +'<button class="btn btn-sm" onclick="openOptical(\''+encId+'\')" title="Optical"><i class="fas fa-bolt"></i></button> '
        +'<button class="btn btn-sm" onclick="openMetrics(\''+encId+'\')" title="Diagnostics"><i class="fas fa-chart-line"></i></button> '
        +'<button class="btn btn-sm" onclick="openFirmwarePush(\''+encId+'\')" title="Push firmware"><i class="fas fa-microchip"></i></button> '
        +'<button class="btn btn-sm" onclick="refreshOne(\''+encId+'\')" title="Refresh params"><i class="fas fa-rotate"></i></button> '
        +'<button class="btn btn-sm btn-danger" onclick="rebootDev(\''+encId+'\')" title="Reboot"><i class="fas fa-power-off"></i></button> '
        +'<button class="btn btn-sm btn-danger" onclick="factoryReset(\''+encId+'\')" title="Factory reset"><i class="fas fa-triangle-exclamation"></i></button>'
      +'</td>'
      +'</tr>';
  }).join('');
  updateBulkBar();
}

