</script>

<!-- Boot Script: localStorage cache for transpiled JSX -->
<script>
(function() {
  var CACHE_KEY = 'j2crm_compiled_v84';
  var src = document.getElementById('jsx-source').textContent;

  function showError(stage, err) {
    var msg = (err && (err.message || err.toString())) || 'unknown error';
    var stack = (err && err.stack) ? String(err.stack).substring(0, 800) : '';
    var ua = navigator.userAgent;
    var root = document.getElementById('root');
    if (root) {
      root.innerHTML =
        '<div style="font-family:system-ui,sans-serif;padding:24px;max-width:760px;margin:40px auto;border:1px solid #fca5a5;background:#fef2f2;border-radius:10px;color:#7f1d1d">' +
        '<h2 style="margin:0 0 12px;color:#b91c1c">CRM failed to load</h2>' +
        '<p style="margin:0 0 8px"><b>Stage:</b> ' + stage + '</p>' +
        '<p style="margin:0 0 8px"><b>Error:</b> <code style="background:#fee2e2;padding:2px 6px;border-radius:4px">' + msg.replace(/</g,'&lt;') + '</code></p>' +
        (stack ? '<pre style="background:#fff;padding:8px;border-radius:6px;font-size:11px;overflow:auto;max-height:200px">' + stack.replace(/</g,'&lt;') + '</pre>' : '') +
        '<p style="margin:12px 0 4px;font-size:12px;color:#991b1b"><b>Browser:</b> ' + ua + '</p>' +
        '<p style="margin:8px 0 0;font-size:12px">Try: <button onclick="try{localStorage.clear()}catch(e){};location.reload()" style="padding:6px 12px;border:0;background:#dc2626;color:#fff;border-radius:6px;cursor:pointer">Clear cache &amp; reload</button></p>' +
        '</div>';
    }
    console.error('[CRM] ' + stage + ':', err);
  }

  // Catch any global error from later script execution
  window.addEventListener('error', function(ev) {
    if (document.getElementById('root') && !document.getElementById('root').firstChild) {
      showError('runtime', ev.error || { message: ev.message + ' @ ' + ev.filename + ':' + ev.lineno });
    }
  });

  // Fast hash (djb2)
  function fastHash(s) {
    for (var h = 5381, i = 0; i < s.length; i++) h = ((h << 5) + h) ^ s.charCodeAt(i);
    return (h >>> 0).toString(36);
  }

  var hash = fastHash(src);

  function runCode(code, label) {
    try {
      var s = document.createElement('script');
      s.textContent = code;
      document.body.appendChild(s);
      console.log('[CRM] ' + label);
      return true;
    } catch(e) {
      showError(label + ' execute', e);
      return false;
    }
  }

  // Try cache
  try {
    var cached = localStorage.getItem(CACHE_KEY);
    if (cached) {
      var sep = cached.indexOf('|');
      if (sep > 0 && cached.substring(0, sep) === hash) {
        var code = cached.substring(sep + 1);
        if (runCode(code, 'Loaded from cache (' + hash + ')')) return;
        // Cache execute failed — clear and fall through to fresh transpile
        try { localStorage.removeItem(CACHE_KEY); } catch(e) {}
      }
    }
  } catch(e) {}

  // Cache miss — load Babel and transpile
  console.log('[CRM] Cache miss — loading Babel...');
  var babel = document.createElement('script');
  babel.src = 'https://cdnjs.cloudflare.com/ajax/libs/babel-standalone/7.23.9/babel.min.js';
  babel.onerror = function() {
    showError('Babel CDN load', new Error('Failed to load babel.min.js from cdnjs.cloudflare.com — likely blocked by network/firewall'));
  };
  babel.onload = function() {
    try {
      var t0 = performance.now();
      var result = Babel.transform(src, {
        presets: ['react'],
        plugins: [
          'transform-optional-chaining',
          'transform-nullish-coalescing-operator',
          'transform-logical-assignment-operators'
        ]
      }).code;
      console.log('[CRM] Transpiled in ' + Math.round(performance.now() - t0) + 'ms');

      // Cache it
      try { localStorage.setItem(CACHE_KEY, hash + '|' + result); } catch(e) { console.warn('[CRM] Cache write failed:', e); }

      // Execute
      runCode(result, 'Fresh transpile executed');
    } catch(e) {
      showError('Babel transpile', e);
    }
  };
  document.head.appendChild(babel);

  // Also flag if React itself didn't load
  setTimeout(function() {
    if (typeof React === 'undefined') {
      showError('React CDN load', new Error('window.React is undefined — react.production.min.js failed to load from cdnjs.cloudflare.com'));
    }
  }, 4000);
})();
</script>
