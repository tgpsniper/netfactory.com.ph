                  onMouseEnter={e => { if(!blastSelectedIds.includes(s.id)) e.currentTarget.style.background = `${t.accent}08`; }}
                  onMouseLeave={e => { e.currentTarget.style.background = blastSelectedIds.includes(s.id) ? `${t.accent}10` : "transparent"; }}
                  onClick={() => { setSelectedSub(s); setShowSubModal(true); loadCreditHistory(s.id); loadCallHistory(s.id); loadSmsHistory(s.id); }}>
                  <TableCell style={{textAlign:"center",padding:"8px 4px"}} onClick={e=>e.stopPropagation()}>
                    <input type="checkbox" checked={blastSelectedIds.includes(s.id)} onChange={e=>{
                      if (e.target.checked) setBlastSelectedIds(prev => [...prev, s.id]);
                      else setBlastSelectedIds(prev => prev.filter(id => id !== s.id));
                    }} style={{cursor:"pointer"}}/>
                  </TableCell>
                  <TableCell style={{ fontWeight:600, color:t.accent, fontFamily:"monospace", fontSize:12 }}>{s.acct}</TableCell>
                  <TableCell>
                    <div style={{ fontWeight:600, color:t.text, display:"flex", alignItems:"center", gap:6, flexWrap:"wrap" }}>
                      {subDisplayName(s)}
                      {s.referred && <span title={s.referredByName ? ("Referred by "+s.referredByName+(s.referredByAccount?" ("+s.referredByAccount+")":"")) : "Referred account"} style={{ padding:"2px 7px", borderRadius:6, fontSize:9, fontWeight:700, letterSpacing:.3, background: s.referralStatus==="converted"?"#10b98118":"#f59e0b18", color: s.referralStatus==="converted"?"#10b981":"#f59e0b", textTransform:"uppercase", display:"inline-flex", alignItems:"center", gap:3 }}><i className="fas fa-user-plus" style={{fontSize:8}}></i>Referred</span>}
                    </div>
                    {s.email && <div style={{ fontSize:11, color:t.textMuted }}>{s.email}</div>}
                    {s.phone && <div style={{ fontSize:11, color:t.textMuted }}><a href="#" onClick={e=>{e.preventDefault();e.stopPropagation();handleClickToCall(s.phone,s.id,subDisplayName(s));}} style={{color:t.accent,textDecoration:"none",cursor:"pointer"}} title="Click to call"><i className="fas fa-phone" style={{marginRight:4,fontSize:10}}></i>{formatPhoneDisplay(s.phone)}</a></div>}
                  </TableCell>
                  <TableCell>
                    <span style={{ padding:"4px 10px", borderRadius:6, fontSize:11, fontWeight:600, background:`${t.accent}12`, color:t.accent }}>{getPlan(s.planId).name} — {getPlan(s.planId).speed}</span>
                    {s.pkg && <span style={{ padding:"3px 8px", borderRadius:6, fontSize:10, fontWeight:700, background: s.pkg.toUpperCase()==="A"?"#3b82f615":s.pkg.toUpperCase()==="B"?"#8b5cf615":"#10b98115", color: s.pkg.toUpperCase()==="A"?"#3b82f6":s.pkg.toUpperCase()==="B"?"#8b5cf6":"#10b981", marginLeft:4 }}>PKG {s.pkg.toUpperCase()}</span>}
                  </TableCell>
                  <TableCell>
                    <div>{s.barangay}</div>
                    <div style={{ fontSize:11, color:t.textMuted }}>{s.municipality}</div>
                  </TableCell>
                  <TableCell><Badge color={statusColor(s.status)} label={s.status} /></TableCell>
                  <TableCell style={{ fontWeight:600, textAlign:"right", color: (s.status === "prospective" || s.status === "surveyed" || s.status === "approved" || s.status === "declined") ? t.textMuted : s.balance > 0 ? t.danger : t.success }}>{(s.status === "prospective" || s.status === "surveyed" || s.status === "approved" || s.status === "declined") ? "—" : s.balance > 0 ? fmt(s.balance) : "₱0.00"}</TableCell>
                  <TableCell style={{ fontSize:12, color:t.textSec, whiteSpace:"nowrap" }}>{s.createdAt ? (<><div>{new Date(s.createdAt).toLocaleDateString("en-US",{year:"numeric",month:"short",day:"numeric"})}</div><div style={{fontSize:10,color:t.textMuted}}>{new Date(s.createdAt).toLocaleTimeString("en-US",{hour:"2-digit",minute:"2-digit"})}</div></>) : <span style={{color:t.textMuted}}>—</span>}</TableCell>
                  <TableCell style={{ fontSize:12, color:t.textSec, whiteSpace:"nowrap" }}>{s.updatedAt ? (<><div>{new Date(s.updatedAt).toLocaleDateString("en-US",{year:"numeric",month:"short",day:"numeric"})}</div><div style={{fontSize:10,color:t.textMuted}}>{new Date(s.updatedAt).toLocaleTimeString("en-US",{hour:"2-digit",minute:"2-digit"})}</div></>) : <span style={{color:t.textMuted}}>—</span>}</TableCell>
                  <TableCell>
                    <div style={{display:"flex",gap:10,alignItems:"center",justifyContent:"flex-end",paddingRight:32}}>
                      <i className="fas fa-eye" title="View Details" onClick={e => { e.stopPropagation(); setSelectedSub(s); setShowSubModal(true); loadCreditHistory(s.id); loadCallHistory(s.id); loadSmsHistory(s.id); }} style={{fontSize:14,color:t.accent,cursor:"pointer",opacity:.7,transition:"opacity .2s"}} onMouseEnter={e=>e.currentTarget.style.opacity=1} onMouseLeave={e=>e.currentTarget.style.opacity=.7}></i>
                      <i className="fas fa-pen" title="Edit" onClick={e => { e.stopPropagation(); setSelectedSub(s); setShowSubModal(true); loadCreditHistory(s.id); loadCallHistory(s.id); loadSmsHistory(s.id); }} style={{fontSize:14,color:t.textSec,cursor:"pointer",opacity:.7,transition:"opacity .2s"}} onMouseEnter={e=>e.currentTarget.style.opacity=1} onMouseLeave={e=>e.currentTarget.style.opacity=.7}></i>
                      <i className="fas fa-key" title="Reset Password" onClick={e => { e.stopPropagation(); handlePasswordReset(s); }} style={{fontSize:14,color:t.warning||"#f59e0b",cursor:"pointer",opacity:.7,transition:"opacity .2s"}} onMouseEnter={e=>e.currentTarget.style.opacity=1} onMouseLeave={e=>e.currentTarget.style.opacity=.7}></i>
                      {s.status==='active' && <i className="fas fa-ban" title="Suspend" onClick={e => { e.stopPropagation(); handleSuspendSubscriber(s); }} style={{fontSize:14,color:"#f59e0b",cursor:"pointer",opacity:.7,transition:"opacity .2s"}} onMouseEnter={e=>e.currentTarget.style.opacity=1} onMouseLeave={e=>e.currentTarget.style.opacity=.7}></i>}
                      {adminUser?.role==='superadmin' && <i className="fas fa-trash-can" title="Delete" onClick={e => { e.stopPropagation(); handleDeleteSubscriber(s); }} style={{fontSize:14,color:t.danger,cursor:"pointer",opacity:.7,transition:"opacity .2s"}} onMouseEnter={e=>e.currentTarget.style.opacity=1} onMouseLeave={e=>e.currentTarget.style.opacity=.7}></i>}
                    </div>
                  </TableCell>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {filteredSubs.length > subsPerPage && <div style={{ padding:"14px 20px", borderTop:`1px solid ${t.border}`, display:"flex", justifyContent:"space-between", alignItems:"center", flexWrap:"wrap", gap:8 }}>
          <span style={{ fontSize:12, color:t.textMuted }}>{subShowAll ? `Showing all ${filteredSubs.length} subscribers` : `Showing ${filteredSubs.length > 0 ? (subPage-1)*subsPerPage+1 : 0}–${Math.min(subPage*subsPerPage, filteredSubs.length)} of ${filteredSubs.length} subscribers`}</span>
          <div style={{ display:"flex", gap:4, alignItems:"center" }}>
            {!subShowAll && (() => {
              const totalPages = Math.ceil(filteredSubs.length / subsPerPage);
              const pages = [];
              pages.push(1);
              if (subPage > 3) pages.push("...");
              for (let i = Math.max(2, subPage-1); i <= Math.min(totalPages-1, subPage+1); i++) pages.push(i);
              if (subPage < totalPages - 2) pages.push("...");
              if (totalPages > 1) pages.push(totalPages);
              return [
                <button key="prev" onClick={() => setSubPage(Math.max(1, subPage-1))} disabled={subPage<=1} style={{ padding:"6px 12px", borderRadius:8, border:"1px solid "+t.border, background:subPage<=1?t.bg:t.bgCard, color:subPage<=1?t.textMuted:t.text, fontSize:12, fontWeight:600, cursor:subPage<=1?"default":"pointer", fontFamily:"inherit" }}>Prev</button>,
                ...pages.map((p, i) => p === "..." ?
                  <span key={"e"+i} style={{ padding:"0 4px", color:t.textMuted, fontSize:12 }}>...</span> :
                  <button key={p} onClick={() => setSubPage(p)} style={{ width:32, height:32, borderRadius:8, border:"1px solid "+(subPage===p?t.accent:t.border), background:subPage===p?t.accent:t.bgCard, color:subPage===p?"#fff":t.textSec, fontSize:12, fontWeight:600, cursor:"pointer", fontFamily:"inherit" }}>{p}</button>
                ),
                <button key="next" onClick={() => setSubPage(Math.min(totalPages, subPage+1))} disabled={subPage>=totalPages} style={{ padding:"6px 12px", borderRadius:8, border:"1px solid "+t.border, background:subPage>=totalPages?t.bg:t.bgCard, color:subPage>=totalPages?t.textMuted:t.text, fontSize:12, fontWeight:600, cursor:subPage>=totalPages?"default":"pointer", fontFamily:"inherit" }}>Next</button>,
              ];
            })()}
            <button onClick={() => { setSubShowAll(!subShowAll); if (subShowAll) setSubPage(1); }} style={{ padding:"6px 14px", borderRadius:8, border:"1px solid "+(subShowAll?t.danger:t.border), background:subShowAll?t.danger+"15":t.bgCard, color:subShowAll?t.danger:t.textSec, fontSize:12, fontWeight:600, cursor:"pointer", fontFamily:"inherit", marginLeft:4 }}>{subShowAll ? "Paginated" : "Show All"}</button>
          </div>
        </div>}
      </Card>
    </div>
  );

  const InvoicesPage = () => {
    const searchedInvoices = filteredInvoices.filter(inv => {
      if (!invoiceSearch) return true;
      const q = invoiceSearch.toLowerCase();
      const sub = getSub(inv.subId);
      const subName = subDisplayName(sub).toLowerCase() || (inv.subName||"").toLowerCase();
      return inv.number?.toLowerCase().includes(q) || subName.includes(q) || (sub.acct||inv.subAcct||"").toLowerCase().includes(q);
    });
    const totalInvPages = Math.ceil(searchedInvoices.length / invoicesPerPage);
    const pagedInv = showAllInvoices ? searchedInvoices : searchedInvoices.slice((invoicePage-1)*invoicesPerPage, invoicePage*invoicesPerPage);

    const totalAmount = invoices.reduce((s,i) => s + i.amount, 0);
    const paidAmount = invoices.filter(i => i.status === "paid").reduce((s,i) => s + i.amount, 0);
    const pendingAmount = invoices.filter(i => i.status === "pending" || i.status === "overdue").reduce((s,i) => s + i.amount, 0);
    const collectionRate = totalAmount > 0 ? Math.round(paidAmount / totalAmount * 100) : 0;

    const defaultPeriod = new Date().toLocaleString("en-US",{month:"long",year:"numeric"});
    const defaultDue = new Date(new Date().getFullYear(), new Date().getMonth()+1, 1).toISOString().split("T")[0];

    return (
    <div>

      {/* KPI Cards */}
      <div style={{ display:"grid", gridTemplateColumns:"repeat(auto-fit, minmax(180px, 1fr))", gap:12, marginBottom:20 }}>
        {[
          {label:"Total Billed",value:fmt(totalAmount),color:t.accent,icon:"fa-file-invoice"},
          {label:"Collected",value:fmt(paidAmount),color:t.success,icon:"fa-circle-check"},
          {label:"Pending",value:fmt(pendingAmount),color:t.warning,icon:"fa-hourglass-half"},
          {label:"Collection Rate",value:collectionRate+"%",color:collectionRate>=80?t.success:collectionRate>=50?t.warning:t.danger,icon:"fa-percent"},
        ].map(s=>(
          <div key={s.label} style={{background:t.bgCard,borderRadius:12,border:`1px solid ${t.border}`,padding:"16px 18px"}}>
            <div style={{fontSize:11,fontWeight:600,color:t.textMuted,textTransform:"uppercase",letterSpacing:".5px",marginBottom:6}}><_Icon name={s.icon} /> {s.label}</div>
            <div style={{fontSize:22,fontWeight:800,color:s.color,fontFamily:"'Space Grotesk'",textAlign:"right"}}>{s.value}</div>
          </div>
        ))}
      </div>

      {/* Status Filter Cards */}
      <div style={{ display:"grid", gridTemplateColumns:"repeat(auto-fit, minmax(130px, 1fr))", gap:10, marginBottom:16 }}>
        {[
          { label:"All", status:"all", icon:"fa-list", color:t.accent },
          { label:"Paid", status:"paid", icon:"fa-circle-check", color:t.success },
          { label:"Pending", status:"pending", icon:"fa-hourglass-half", color:t.warning },
          { label:"Overdue", status:"overdue", icon:"fa-triangle-exclamation", color:t.danger },
          { label:"Cancelled", status:"cancelled", icon:"fa-circle-xmark", color:t.textMuted },
        ].map(st => {
          const count = st.status === "all" ? invoices.length : invoices.filter(i => i.status === st.status).length;
          const isActive = invoiceFilter === st.status;
          return (
            <div key={st.status} onClick={() => { setInvoiceFilter(st.status); setInvoicePage(1); setInvoiceSearch(""); }} style={{
              background: isActive ? st.color + "15" : t.bgCard,
              border: isActive ? "2px solid " + st.color : "1px solid " + t.border,
              borderRadius:12, padding:"12px 10px", cursor:"pointer", transition:"all .2s",
              boxShadow: isActive ? t.shadowLg : t.shadow, textAlign:"center",
            }}>
              <div style={{ fontSize:20, marginBottom:4 }}><_Icon name={st.icon} /></div>
              <div style={{ fontSize:20, fontWeight:800, color: isActive ? st.color : t.text, fontFamily:"'Space Grotesk'", lineHeight:1 }}>{count}</div>
              <div style={{ fontSize:11, fontWeight:600, color: isActive ? st.color : t.textMuted, marginTop:4 }}>{st.label}</div>
            </div>
          );
        })}
      </div>

      {/* Search Bar */}
      <div style={{ display:"flex", alignItems:"center", gap:10, marginBottom:16 }}>
        <div style={{ position:"relative", flex:1 }}>
          <i className="fas fa-search" style={{ position:"absolute", left:12, top:"50%", transform:"translateY(-50%)", color:t.textMuted, fontSize:13 }}></i>
          <input value={invoiceSearch} onChange={e => { setInvoiceSearch(e.target.value); setInvoicePage(1); }} placeholder="Search by invoice #, subscriber name, or account number..." style={{ width:"100%", padding:"10px 12px 10px 36px", background:t.bgCard, border:`1px solid ${t.border}`, borderRadius:10, color:t.text, fontSize:13, outline:"none" }} />
          {invoiceSearch && <i className="fas fa-times-circle" onClick={() => { setInvoiceSearch(""); setInvoicePage(1); }} style={{ position:"absolute", right:12, top:"50%", transform:"translateY(-50%)", color:t.textMuted, cursor:"pointer", fontSize:13 }}></i>}
        </div>
        {invoiceSearch && <div style={{ fontSize:12, color:t.textMuted, whiteSpace:"nowrap" }}>{searchedInvoices.length} result{searchedInvoices.length!==1?"s":""}</div>}
      </div>

      {/* Table */}
      <Card style={{ padding:0, overflow:"hidden" }}>
        <div className={showAllInvoices?"billing-scroll":""} style={{ overflowX:"auto", overflowY: showAllInvoices ? "auto" : "visible", maxHeight: showAllInvoices ? 520 : "none" }}>
          <table style={{ width:"100%", borderCollapse:"collapse", minWidth:800 }}>
            <thead>
              <tr style={{ position: showAllInvoices ? "sticky" : "static", top:0, zIndex:2 }}>
                <TableHead>Invoice #</TableHead>
                <TableHead>Subscriber</TableHead>
                <TableHead>Period</TableHead>
                <TableHead style={{textAlign:"right"}}>Amount</TableHead>
                <TableHead style={{textAlign:"right"}}>Paid</TableHead>
                <TableHead style={{textAlign:"right"}}>Balance</TableHead>
                <TableHead>Due Date</TableHead>
                <TableHead>Status</TableHead>
                <TableHead>Payment</TableHead>
                <TableHead>Actions</TableHead>
              </tr>
            </thead>
            <tbody>
              {pagedInv.map(inv => {
                const sub = getSub(inv.subId);
                const subName = subDisplayName(sub) || (inv.subName || "—");
                const subAcct = sub.acct || inv.subAcct || "";
                const isOverdue = inv.status === "pending" && new Date(inv.dueDate) < new Date();
                return (
                  <tr key={inv.id} style={{borderBottom:`1px solid ${t.border}`}}>
                    <TableCell>
                      <span onClick={()=>openInvoiceDetail(inv.id)} style={{fontWeight:600,fontFamily:"monospace",fontSize:12,color:t.accent,cursor:"pointer",textDecoration:"underline"}}>{inv.number}</span>
                    </TableCell>
                    <TableCell>
                      <div style={{ fontWeight:600, color:t.text, fontSize:13 }}>{subName}</div>
                      <div style={{ fontSize:11, color:t.textMuted }}>{subAcct}</div>
                    </TableCell>
                    <TableCell style={{fontSize:12,color:t.textSec}}>
                      <div>{inv.period||"—"}</div>
                      {inv.referralDiscount > 0 && <div title="Credit earned from referrals this subscriber made" style={{fontSize:10,color:"#10b981",fontWeight:600,marginTop:2,display:"flex",alignItems:"center",gap:3}}><i className="fas fa-handshake" style={{fontSize:9}}></i>Referral discount −{fmt(inv.referralDiscount)}</div>}
                    </TableCell>
                    <TableCell style={{ fontWeight:700, color:t.text, fontFamily:"'Space Grotesk'", textAlign:"right" }}>{fmt(inv.amount)}</TableCell>
                    <TableCell style={{ fontWeight:600, color:inv.totalPaid>0?t.success:t.textMuted, fontFamily:"'Space Grotesk'", textAlign:"right" }}>{inv.totalPaid>0?fmt(inv.totalPaid):"—"}</TableCell>
                    <TableCell style={{ fontWeight:700, color:inv.balance>0?t.danger:t.success, fontFamily:"'Space Grotesk'", textAlign:"right" }}>{inv.status==="cancelled"?"—":inv.balance>0?fmt(inv.balance):"₱0.00"}</TableCell>
                    <TableCell>
                      <span style={{fontSize:12,color:isOverdue?t.danger:t.textSec,fontWeight:isOverdue?700:400}}>
                        {inv.dueDate ? new Date(inv.dueDate).toLocaleDateString("en-US",{month:"short",day:"numeric",year:"numeric"}) : "—"}
                      </span>
                      {isOverdue && <div style={{fontSize:10,color:t.danger,fontWeight:600}}>OVERDUE</div>}
                    </TableCell>
                    <TableCell><Badge color={statusColor(inv.status)} label={inv.status} /></TableCell>
                    <TableCell style={{fontSize:12,color:t.textSec}}>{(paymentMethods.find(m=>m.code===inv.method)||{}).name || inv.method || <span style={{ color:t.textMuted }}>—</span>}</TableCell>
                    <TableCell>
                      <div style={{ display:"flex", gap:4, flexWrap:"wrap" }}>
                        {((selectedSub?.creditBalance > 0) || (inv.creditBalance > 0)) && inv.status !== "paid" && inv.status !== "cancelled" && <Btn small onClick={()=>handleApplyCredit(inv.id)} title={`Apply credit (₱${Number(selectedSub?.creditBalance || inv.creditBalance || 0).toLocaleString(undefined,{minimumFractionDigits:2})} available)`} style={{background:"rgba(16,185,129,.15)",color:"#10b981",border:"1px solid rgba(16,185,129,.3)"}}><i className="fas fa-coins"></i></Btn>}
                        {inv.status !== "paid" && inv.status !== "cancelled" && <Btn small primary onClick={()=>{setPayForm({method:"gcash",referenceNumber:"",amount:(inv.balance>0?inv.balance:inv.amount).toFixed(2),orNumber:"",paymentDate:new Date().toISOString().slice(0,10),invoiceDate:inv.invoiceDate?new Date(inv.invoiceDate).toISOString().slice(0,10):""}); setShowPayModal(inv);}} title="Record Payment"><i className="fas fa-money-bill-wave"></i></Btn>}
                        {(inv.status === "paid" || inv.status === "partial") && <Btn small onClick={()=>printThermalReceipt(inv.id)} title={"Print "+receiptWidth+"mm thermal receipt"} style={{background:"rgba(139,92,246,.15)",color:"#a78bfa",border:"1px solid rgba(139,92,246,.3)"}}><i className="fas fa-receipt"></i></Btn>}
                        {(inv.status === "paid" || inv.status === "partial") && adminUser?.role==='superadmin' && <Btn small onClick={()=>handleVoidPayment(inv)} title="Void Payment" style={{background:"rgba(251,146,60,.15)",color:"#fb923c",border:"1px solid rgba(251,146,60,.3)"}}><i className="fas fa-rotate-left"></i></Btn>}
                        {inv.status === "pending" && <Btn small onClick={()=>handleInvoiceStatus(inv.id,"overdue")} title="Mark as Overdue"><i className="fas fa-triangle-exclamation"></i></Btn>}
                        {(inv.status === "pending" || inv.status === "overdue") && <Btn small onClick={()=>handleInvoiceStatus(inv.id,"cancelled")} title="Cancel Invoice"><i className="fas fa-xmark"></i></Btn>}
                        {adminUser?.role==='superadmin' && <Btn small onClick={()=>handleDeleteInvoice(inv)} title="Delete Invoice" style={{background:"rgba(239,68,68,.15)",color:"#ef4444",border:"1px solid rgba(239,68,68,.3)"}}><i className="fas fa-trash-can"></i></Btn>}
                      </div>
                    </TableCell>
                  </tr>
                );
              })}
              {pagedInv.length === 0 && <tr><td colSpan={11} style={{textAlign:"center",padding:40,color:t.textMuted,fontSize:13}}>No invoices found</td></tr>}
            </tbody>
          </table>
        </div>

        {/* Pagination Footer */}
        <div style={{display:"flex",alignItems:"center",justifyContent:"space-between",padding:"12px 18px",borderTop:`1px solid ${t.border}`,flexWrap:"wrap",gap:10}}>
          <span style={{fontSize:12,color:t.textMuted}}>
            {showAllInvoices
              ? `Showing all ${searchedInvoices.length} invoice${searchedInvoices.length!==1?"s":""}`
              : `Showing ${searchedInvoices.length > 0 ? (invoicePage-1)*invoicesPerPage+1 : 0}–${Math.min(invoicePage*invoicesPerPage, searchedInvoices.length)} of ${searchedInvoices.length}`
            }
          </span>
          <div style={{display:"flex",alignItems:"center",gap:4}}>
            {!showAllInvoices && (<>
              <button onClick={()=>setInvoicePage(Math.max(1,invoicePage-1))} disabled={invoicePage<=1} style={{padding:"6px 12px",borderRadius:8,border:`1px solid ${t.border}`,background:invoicePage<=1?t.bg:t.bgCard,color:invoicePage<=1?t.textMuted:t.text,fontSize:12,fontWeight:600,cursor:invoicePage<=1?"default":"pointer",fontFamily:"inherit"}}>Prev</button>
              {(()=>{
                const pages=[];
                const tp=totalInvPages;
                const cp=invoicePage;
                if(tp<=7){for(let i=1;i<=tp;i++) pages.push(i);}
                else{
                  pages.push(1);
                  if(cp>3) pages.push("...");
                  const start=Math.max(2,cp-1);
                  const end=Math.min(tp-1,cp+1);
                  for(let i=start;i<=end;i++) pages.push(i);
                  if(cp<tp-2) pages.push("...");
                  pages.push(tp);
                }
                return pages.map((p,i)=>
                  p==="..."
                    ? <span key={"e"+i} style={{fontSize:11,color:t.textMuted,padding:"0 2px"}}>…</span>
                    : <button key={p} onClick={()=>setInvoicePage(p)} style={{minWidth:32,height:32,borderRadius:8,border:`1px solid ${invoicePage===p?t.accent:t.border}`,background:invoicePage===p?t.accent:t.bgCard,color:invoicePage===p?"#fff":t.textSec,fontSize:12,fontWeight:600,cursor:"pointer",fontFamily:"inherit"}}>{p}</button>
                );
              })()}
              <button onClick={()=>setInvoicePage(Math.min(totalInvPages,invoicePage+1))} disabled={invoicePage>=totalInvPages} style={{padding:"6px 12px",borderRadius:8,border:`1px solid ${t.border}`,background:invoicePage>=totalInvPages?t.bg:t.bgCard,color:invoicePage>=totalInvPages?t.textMuted:t.text,fontSize:12,fontWeight:600,cursor:invoicePage>=totalInvPages?"default":"pointer",fontFamily:"inherit"}}>Next</button>
            </>)}
            <button onClick={()=>{setShowAllInvoices(!showAllInvoices);setInvoicePage(1);}} style={{padding:"6px 14px",borderRadius:8,border:`1px solid ${showAllInvoices?t.danger:t.border}`,background:showAllInvoices?t.danger+"15":t.bgCard,color:showAllInvoices?t.danger:t.textSec,fontSize:12,fontWeight:600,cursor:"pointer",fontFamily:"inherit",marginLeft:4}}>{showAllInvoices?"Paginated":"Show All"}</button>
          </div>
        </div>
      </Card>
    </div>
    );
  };

  const TicketsPage = () => {
    const ticketStats = {
      open: tickets.filter(tk => tk.status === "open").length,
      in_progress: tickets.filter(tk => tk.status === "in_progress").length,
      resolved: tickets.filter(tk => tk.status === "resolved").length,
      closed: tickets.filter(tk => tk.status === "closed").length,
      critical: tickets.filter(tk => tk.priority === "critical" && tk.status !== "closed" && tk.status !== "resolved" && tk.status !== "archived").length,
