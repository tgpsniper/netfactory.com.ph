        setProfiles(p.profiles || []);
        setDevices(d.devices || []);
      }).catch(()=>{}).finally(()=>setLoading(false));
    };
    useEffect(() => { loadAll(); }, []);

    const register = () => {
      if (!form.mac) return;
      setBusy(true);
      fetch(RAPI + "/mac-devices", { method:"POST", headers: authHeaders(),
        body: JSON.stringify({ mac: form.mac, label: form.label, profile: form.profile || null, staticIp: form.staticIp || null }) })
        .then(r=>r.json()).then(d => {
          if (d.success) { setForm({ mac:"", label:"", profile: form.profile, staticIp:"" }); loadAll(); }
          else alert(d.error || "Register failed");
        }).catch(()=>alert("Network error")).finally(()=>setBusy(false));
    };
    const toggle = (mac) => {
      fetch(RAPI + "/mac-devices/" + encodeURIComponent(mac) + "/toggle", { method:"PUT", headers: authHeaders() })
        .then(r=>r.json()).then(()=>loadAll());
    };
    const del = (mac) => {
      if (!confirm("Remove device " + mac + "?")) return;
      fetch(RAPI + "/mac-devices/" + encodeURIComponent(mac), { method:"DELETE", headers: authHeaders() })
        .then(r=>r.json()).then(()=>loadAll());
    };

    const shown = devices.filter(v => filter==="all" || v.status===filter);
    const stat = (s) => devices.filter(v=>v.status===s).length;
    const colFor = (s) => s==="online"?"#22c55e":s==="seen"?"#3b82f6":s==="disabled"?"#ef4444":"#64748b";

    return (
      <div>
        <div style={{marginBottom:20}}>
          <h1 style={{fontSize:24,fontWeight:800,color:t.text,fontFamily:"'Space Grotesk'",margin:0}}>MAC Login Devices</h1>
          <div style={{fontSize:13,color:t.textMuted,marginTop:2}}>Registered devices auto-authenticate by MAC on the hotspot (no voucher needed)</div>
        </div>
        <div style={{display:"grid",gridTemplateColumns:"repeat(auto-fit,minmax(150px,1fr))",gap:14,marginBottom:20}}>
          {[["Total",devices.length,t.accent],["Online now",stat("online"),"#22c55e"],["Idle",stat("idle"),"#64748b"],["Disabled",stat("disabled"),"#ef4444"]].map(a=>(
            <div key={a[0]} style={{background:t.bgCard,border:"1px solid "+t.border,borderRadius:14,padding:"14px 16px"}}>
              <div style={{fontSize:12,color:t.textMuted,textTransform:"uppercase",letterSpacing:.5}}>{a[0]}</div>
              <div style={{fontSize:22,fontWeight:800,color:a[2],marginTop:4,fontFamily:"'Space Grotesk'"}}>{a[1]}</div>
            </div>
          ))}
        </div>
        <div style={{background:t.bgCard,border:"1px solid "+t.border,borderRadius:16,padding:20,marginBottom:20}}>
          <div style={{fontSize:15,fontWeight:700,color:t.text,marginBottom:14}}>Register a device</div>
          <div style={{display:"flex",gap:12,flexWrap:"wrap",alignItems:"flex-end"}}>
            <div>
              <label style={{fontSize:11,fontWeight:600,color:t.textMuted,display:"block",marginBottom:4}}>MAC ADDRESS</label>
              <input value={form.mac} onChange={e=>setForm({...form,mac:e.target.value})} placeholder="AA:BB:CC:DD:EE:FF" style={{padding:"10px 12px",borderRadius:8,border:"1px solid "+t.inputBorder,background:t.input,color:t.text,fontSize:13,minWidth:200,fontFamily:"monospace"}} />
            </div>
            <div>
              <label style={{fontSize:11,fontWeight:600,color:t.textMuted,display:"block",marginBottom:4}}>LABEL (optional)</label>
              <input value={form.label} onChange={e=>setForm({...form,label:e.target.value})} placeholder="e.g. Front desk iPad" style={{padding:"10px 12px",borderRadius:8,border:"1px solid "+t.inputBorder,background:t.input,color:t.text,fontSize:13,minWidth:180}} />
            </div>
            <div>
              <label style={{fontSize:11,fontWeight:600,color:t.textMuted,display:"block",marginBottom:4}}>PLAN (optional)</label>
              <select value={form.profile} onChange={e=>setForm({...form,profile:e.target.value})} style={{padding:"10px 12px",borderRadius:8,border:"1px solid "+t.inputBorder,background:t.input,color:t.text,fontSize:13,minWidth:220}}>
                <option value="">No limit (accept only)</option>
                {profiles.map(p=>(<option key={p.profile} value={p.profile}>{p.profile} — {p.rate_limit}, {Math.round(Number(p.session_timeout)/3600)}h</option>))}
              </select>
            </div>
            <div>
              <label style={{fontSize:11,fontWeight:600,color:t.textMuted,display:"block",marginBottom:4}}>STATIC IP (optional)</label>
              <input value={form.staticIp} onChange={e=>setForm({...form,staticIp:e.target.value})} placeholder="e.g. 100.64.0.50" style={{padding:"10px 12px",borderRadius:8,border:"1px solid "+t.inputBorder,background:t.input,color:t.text,fontSize:13,minWidth:150,fontFamily:"monospace"}} />
            </div>
            <button onClick={register} disabled={busy} style={{padding:"11px 22px",borderRadius:10,background:"linear-gradient(135deg,"+t.accent+","+t.accentDk+")",color:"#fff",border:"none",fontSize:13,fontWeight:700,cursor:busy?"default":"pointer",opacity:busy?.6:1}}>{busy?"Registering…":"Register"}</button>
          </div>
          <div style={{fontSize:11,color:t.textMuted,marginTop:12}}><i className="fas fa-info-circle"/> The device authenticates using its MAC as both username and password. Requires the hotspot profile to allow MAC login (already enabled on hs-prof).</div>
        </div>
        <div style={{background:t.bgCard,border:"1px solid "+t.border,borderRadius:16,padding:20}}>
          <div style={{display:"flex",alignItems:"center",justifyContent:"space-between",marginBottom:14,flexWrap:"wrap",gap:10}}>
            <div style={{fontSize:15,fontWeight:700,color:t.text}}>Registered devices ({shown.length})</div>
            <div style={{display:"flex",gap:6}}>
              {["all","online","idle","disabled"].map(f=>(
                <button key={f} onClick={()=>setFilter(f)} style={{padding:"6px 12px",borderRadius:8,fontSize:12,fontWeight:600,cursor:"pointer",border:"1px solid "+(filter===f?t.accent:t.border),background:filter===f?t.accent:"transparent",color:filter===f?"#fff":t.textMuted,textTransform:"capitalize"}}>{f}</button>
              ))}
            </div>
          </div>
          {loading ? <div style={{color:t.textMuted,padding:20,textAlign:"center"}}>Loading…</div> :
           shown.length===0 ? <div style={{color:t.textMuted,padding:20,textAlign:"center"}}>No devices registered yet.</div> :
          <div style={{overflowX:"auto"}}>
            <table style={{width:"100%",borderCollapse:"collapse",fontSize:13}}>
              <thead><tr style={{textAlign:"left",color:t.textMuted,fontSize:11,textTransform:"uppercase"}}>
                <th style={{padding:"8px 10px"}}>MAC</th><th style={{padding:"8px 10px"}}>Label</th><th style={{padding:"8px 10px"}}>Plan</th><th style={{padding:"8px 10px"}}>Static IP</th><th style={{padding:"8px 10px"}}>Status</th><th style={{padding:"8px 10px"}}>Created</th><th style={{padding:"8px 10px"}}></th>
              </tr></thead>
              <tbody>
                {shown.map(v=>{
                  const col = colFor(v.status);
                  return (<tr key={v.mac} style={{borderTop:"1px solid "+t.border}}>
                    <td style={{padding:"8px 10px",fontFamily:"monospace",fontWeight:700,color:t.text}}>{v.mac}</td>
                    <td style={{padding:"8px 10px",color:t.textMuted}}>{v.label||"—"}</td>
                    <td style={{padding:"8px 10px",color:t.textMuted}}>{v.profile||"No limit"}</td>
                    <td style={{padding:"8px 10px",fontFamily:"monospace",color:v.static_ip?t.text:t.textMuted}}>{v.static_ip||"—"}</td>
                    <td style={{padding:"8px 10px"}}><span style={{fontSize:11,fontWeight:700,padding:"2px 8px",borderRadius:6,background:col+"22",color:col,textTransform:"capitalize"}}>{v.status}</span></td>
                    <td style={{padding:"8px 10px",color:t.textMuted}}>{v.created_at?new Date(v.created_at).toLocaleDateString():"—"}</td>
                    <td style={{padding:"8px 10px",textAlign:"right",whiteSpace:"nowrap"}}>
                      <button onClick={()=>toggle(v.mac)} title={v.enabled?"Disable":"Enable"} style={{background:"none",border:"none",color:v.enabled?"#f59e0b":"#22c55e",cursor:"pointer",fontSize:13,marginRight:10}}><i className={v.enabled?"fas fa-pause":"fas fa-play"}/></button>
                      <button onClick={()=>del(v.mac)} title="Remove" style={{background:"none",border:"none",color:"#ef4444",cursor:"pointer",fontSize:13}}><i className="fas fa-trash"/></button>
                    </td>
                  </tr>);
                })}
              </tbody>
            </table>
          </div>}
        </div>
      </div>
    );
  };

  // ═══ SmartOLT (remote ZTE fiber plant, via cloud API) ═══
  const SmartOltPage = () => {
    const [cfg, setCfg] = useState({ enabled:false, url:"", hasToken:false, oltDeviceId:null, configured:false });
    const [form, setForm] = useState({ subdomain:"", token:"", oltDeviceId:"" });
    const [status, setStatus] = useState(null);
    const [onus, setOnus] = useState([]);
    const [filter, setFilter] = useState("all");
    const [loading, setLoading] = useState(false);
    const [saving, setSaving] = useState(false);
    const [syncing, setSyncing] = useState(false);
    const [testing, setTesting] = useState(false);
    const [syncResult, setSyncResult] = useState(null);
    const SAPI = API + "/admin/smartolt";

    const loadCfg = () => {
      fetch(SAPI + "/settings", { headers: authHeaders() }).then(r=>r.json()).then(d=>{
        setCfg(d); setForm(f=>({ ...f, subdomain: d.url || "", oltDeviceId: d.oltDeviceId || "" }));
      }).catch(()=>{});
    };
    useEffect(() => { loadCfg(); }, []);

    const save = (enabledOverride) => {
      setSaving(true);
      const body = { subdomain: form.subdomain, oltDeviceId: form.oltDeviceId || null };
      if (form.token) body.token = form.token;
      if (enabledOverride !== undefined) body.enabled = enabledOverride;
      fetch(SAPI + "/settings", { method:"PUT", headers: authHeaders(), body: JSON.stringify(body) })
        .then(r=>r.json()).then(d=>{ if(d.ok){ setForm(f=>({...f, token:""})); loadCfg(); } else alert(d.error||"Save failed"); })
        .catch(()=>alert("Network error")).finally(()=>setSaving(false));
    };
    const test = () => {
      setTesting(true); setStatus(null);
      fetch(SAPI + "/status", { headers: authHeaders() }).then(r=>r.json()).then(setStatus)
        .catch(()=>setStatus({ ok:false, error:"Network error" })).finally(()=>setTesting(false));
    };
    const loadOnus = () => {
      setLoading(true);
      fetch(SAPI + "/onus", { headers: authHeaders() }).then(r=>r.json()).then(d=>{ setOnus(d.onus||[]); })
        .catch(()=>{}).finally(()=>setLoading(false));
    };
    const sync = () => {
      setSyncing(true); setSyncResult(null);
      fetch(SAPI + "/sync", { method:"POST", headers: authHeaders() }).then(r=>r.json()).then(d=>{
        setSyncResult(d); if(d.ok) loadOnus();
      }).catch(()=>setSyncResult({ error:"Network error" })).finally(()=>setSyncing(false));
    };

    const shown = onus.filter(o => filter==="all" || o.status===filter);
    const stat = (s) => onus.filter(o=>o.status===s).length;
    const colFor = (s)=> s==="online"?"#22c55e":s==="offline"?"#ef4444":"#64748b";
    const rxCol = (v)=>{ const n=parseFloat(v); if(!isFinite(n))return t.textMuted; if(n<=-28)return "#ef4444"; if(n<=-25)return "#f59e0b"; return "#22c55e"; };

    return (
      <div>
        <div style={{marginBottom:20}}>
          <h1 style={{fontSize:24,fontWeight:800,color:t.text,fontFamily:"'Space Grotesk'",margin:0}}>SmartOLT — Fiber Plant</h1>
          <div style={{fontSize:13,color:t.textMuted,marginTop:2}}>Live ONU status and optical accounting for the remote ZTE OLT via the SmartOLT cloud API</div>
        </div>

        <div style={{background:cfg.configured?(cfg.enabled?"#22c55e18":"#f59e0b18"):"#ef444418",border:"1px solid "+(cfg.configured?(cfg.enabled?"#22c55e":"#f59e0b"):"#ef4444")+"55",borderRadius:12,padding:"12px 16px",marginBottom:20,fontSize:13,color:t.text}}>
          <i className={cfg.configured?(cfg.enabled?"fas fa-check-circle":"fas fa-pause-circle"):"fas fa-exclamation-circle"} style={{marginRight:8,color:cfg.configured?(cfg.enabled?"#22c55e":"#f59e0b"):"#ef4444"}}/>
          {cfg.configured ? (cfg.enabled?"SmartOLT connected and enabled.":"SmartOLT configured but disabled — control actions are blocked until you enable it.") : "SmartOLT is not configured yet. Add your account subdomain and API token below to activate."}
        </div>

        <div style={{background:t.bgCard,border:"1px solid "+t.border,borderRadius:16,padding:20,marginBottom:20}}>
          <div style={{fontSize:15,fontWeight:700,color:t.text,marginBottom:14}}>Account connection</div>
          <div style={{display:"flex",gap:12,flexWrap:"wrap",alignItems:"flex-end"}}>
            <div>
              <label style={{fontSize:11,fontWeight:600,color:t.textMuted,display:"block",marginBottom:4}}>SUBDOMAIN OR URL</label>
              <input value={form.subdomain} onChange={e=>setForm({...form,subdomain:e.target.value})} placeholder="netfactory (→ netfactory.smartolt.com)" style={{padding:"10px 12px",borderRadius:8,border:"1px solid "+t.inputBorder,background:t.input,color:t.text,fontSize:13,minWidth:260}} />
            </div>
            <div>
              <label style={{fontSize:11,fontWeight:600,color:t.textMuted,display:"block",marginBottom:4}}>API TOKEN {cfg.hasToken && <span style={{color:"#22c55e"}}>• saved</span>}</label>
              <input type="password" value={form.token} onChange={e=>setForm({...form,token:e.target.value})} placeholder={cfg.hasToken?"•••• (leave blank to keep)":"X-Token from SmartOLT → System settings → API"} style={{padding:"10px 12px",borderRadius:8,border:"1px solid "+t.inputBorder,background:t.input,color:t.text,fontSize:13,minWidth:280,fontFamily:"monospace"}} />
            </div>
            <div>
              <label style={{fontSize:11,fontWeight:600,color:t.textMuted,display:"block",marginBottom:4}}>OLT ID</label>
              <input value={form.oltDeviceId} onChange={e=>setForm({...form,oltDeviceId:e.target.value})} placeholder="auto" style={{padding:"10px 12px",borderRadius:8,border:"1px solid "+t.inputBorder,background:t.input,color:t.text,fontSize:13,width:80}} />
            </div>
            <button onClick={()=>save()} disabled={saving} style={{padding:"11px 22px",borderRadius:10,background:"linear-gradient(135deg,"+t.accent+","+t.accentDk+")",color:"#fff",border:"none",fontSize:13,fontWeight:700,cursor:saving?"default":"pointer",opacity:saving?.6:1}}>{saving?"Saving…":"Save"}</button>
            <button onClick={test} disabled={testing} style={{padding:"11px 18px",borderRadius:10,background:"transparent",color:t.accent,border:"1px solid "+t.accent,fontSize:13,fontWeight:700,cursor:testing?"default":"pointer"}}>{testing?"Testing…":"Test connection"}</button>
            <button onClick={()=>save(!cfg.enabled)} disabled={saving||!cfg.configured} style={{padding:"11px 18px",borderRadius:10,background:"transparent",color:cfg.enabled?"#f59e0b":"#22c55e",border:"1px solid "+(cfg.enabled?"#f59e0b":"#22c55e"),fontSize:13,fontWeight:700,cursor:(saving||!cfg.configured)?"default":"pointer",opacity:cfg.configured?1:.5}}>{cfg.enabled?"Disable":"Enable"}</button>
          </div>
          {status && <div style={{marginTop:14,fontSize:12,padding:"10px 12px",borderRadius:8,background:status.ok?"#22c55e18":"#ef444418",color:t.text,border:"1px solid "+(status.ok?"#22c55e":"#ef4444")+"55"}}>
            {status.ok ? <span><i className="fas fa-check" style={{color:"#22c55e",marginRight:6}}/>Reachable — SmartOLT responded{status.url?" at "+status.url:""}.</span>
                       : <span><i className="fas fa-times" style={{color:"#ef4444",marginRight:6}}/>{status.message || status.error || "Not reachable"}</span>}
          </div>}
          <div style={{fontSize:11,color:t.textMuted,marginTop:12}}><i className="fas fa-info-circle"/> The token is stored server-side and never shown again. Requires a SmartOLT account whose on-site controller can reach the OLT.</div>
        </div>

        <div style={{background:t.bgCard,border:"1px solid "+t.border,borderRadius:16,padding:20}}>
          <div style={{display:"flex",alignItems:"center",justifyContent:"space-between",marginBottom:14,flexWrap:"wrap",gap:10}}>
            <div style={{fontSize:15,fontWeight:700,color:t.text}}>ONU accounting ({shown.length})</div>
            <div style={{display:"flex",gap:6,alignItems:"center",flexWrap:"wrap"}}>
              {["all","online","offline","unknown"].map(f=>(
                <button key={f} onClick={()=>setFilter(f)} style={{padding:"6px 12px",borderRadius:8,fontSize:12,fontWeight:600,cursor:"pointer",border:"1px solid "+(filter===f?t.accent:t.border),background:filter===f?t.accent:"transparent",color:filter===f?"#fff":t.textMuted,textTransform:"capitalize"}}>{f}{f!=="all"?" ("+stat(f)+")":""}</button>
              ))}
              <button onClick={loadOnus} disabled={loading||!cfg.configured} style={{padding:"6px 12px",borderRadius:8,fontSize:12,fontWeight:600,cursor:"pointer",border:"1px solid "+t.border,background:"transparent",color:t.textMuted}}><i className="fas fa-sync"/> {loading?"Loading…":"Refresh"}</button>
              <button onClick={sync} disabled={syncing||!cfg.configured} style={{padding:"6px 14px",borderRadius:8,fontSize:12,fontWeight:700,cursor:(syncing||!cfg.configured)?"default":"pointer",border:"none",background:"linear-gradient(135deg,"+t.accent+","+t.accentDk+")",color:"#fff",opacity:cfg.configured?1:.5}}>{syncing?"Syncing…":"Sync now"}</button>
            </div>
          </div>
          {syncResult && <div style={{marginBottom:12,fontSize:12,padding:"8px 12px",borderRadius:8,background:syncResult.ok?"#22c55e18":"#ef444418",color:t.text}}>
            {syncResult.ok ? "Sync complete — "+syncResult.total+" ONUs from SmartOLT · "+syncResult.updated+" updated · "+syncResult.inserted+" new · "+syncResult.skipped+" skipped · "+syncResult.stale+" stale."
                           : "Sync failed: "+(syncResult.error||"unknown")}
          </div>}
          {!cfg.configured ? <div style={{color:t.textMuted,padding:20,textAlign:"center"}}>Configure SmartOLT above to pull live ONU data.</div> :
           onus.length===0 ? <div style={{color:t.textMuted,padding:20,textAlign:"center"}}>No ONUs loaded. Click <b>Sync now</b> to pull from SmartOLT, or <b>Refresh</b>.</div> :
          <div style={{overflowX:"auto"}}>
            <table style={{width:"100%",borderCollapse:"collapse",fontSize:13}}>
              <thead><tr style={{textAlign:"left",color:t.textMuted,fontSize:11,textTransform:"uppercase"}}>
                <th style={{padding:"8px 10px"}}>Serial</th><th style={{padding:"8px 10px"}}>Name</th><th style={{padding:"8px 10px"}}>Zone</th><th style={{padding:"8px 10px"}}>B/P/O</th><th style={{padding:"8px 10px"}}>Status</th><th style={{padding:"8px 10px"}}>Rx (dBm)</th><th style={{padding:"8px 10px"}}>Tx (dBm)</th><th style={{padding:"8px 10px"}}>Sub</th>
              </tr></thead>
              <tbody>
                {shown.map(o=>{
                  const col = colFor(o.status);
                  return (<tr key={o.external_id||o.serial} style={{borderTop:"1px solid "+t.border}}>
                    <td style={{padding:"8px 10px",fontFamily:"monospace",fontWeight:700,color:t.text}}>{o.serial||"—"}</td>
                    <td style={{padding:"8px 10px",color:t.textMuted}}>{o.name||"—"}</td>
                    <td style={{padding:"8px 10px",color:t.textMuted}}>{o.zone||"—"}</td>
                    <td style={{padding:"8px 10px",color:t.textMuted,fontFamily:"monospace"}}>{[o.board,o.port,o.onu].filter(x=>x!=null&&x!=="").join("/")||"—"}</td>
                    <td style={{padding:"8px 10px"}}><span style={{fontSize:11,fontWeight:700,padding:"2px 8px",borderRadius:6,background:col+"22",color:col,textTransform:"capitalize"}}>{o.status}</span></td>
                    <td style={{padding:"8px 10px",fontFamily:"monospace",color:rxCol(o.rx_power)}}>{o.rx_power!=null&&o.rx_power!==""?o.rx_power:"—"}</td>
                    <td style={{padding:"8px 10px",fontFamily:"monospace",color:t.textMuted}}>{o.tx_power!=null&&o.tx_power!==""?o.tx_power:"—"}</td>
                    <td style={{padding:"8px 10px",color:o.subscriber_id?t.accent:t.textMuted}}>{o.subscriber_id?("#"+o.subscriber_id):"—"}</td>
                  </tr>);
                })}
              </tbody>
            </table>
          </div>}
        </div>
      </div>
    );
  };

  const pages = { dashboard:DashboardPage, onu:OnuPage, subscribers:SubscribersPage, invoices:InvoicesPage, tickets:TicketsPage, staff:StaffPage, map:MapPage, plans:PlansPage, packages:PackagesPage, reports:ReportsPage, settings:SettingsPage, radius:RadiusPage, vouchers:VouchersPage, macdevices:MacDevicesPage, smartolt:SmartOltPage, devtools:DevToolsPage, coverage:CoveragePage };
  // Enforce page access — non-admin roles can only see their allowed pages
  const canViewPage = (pageId) => {
    if (!adminUser || adminUser.role === 'superadmin' || adminUser.role === 'admin') return true;
    if (pageId === 'dashboard') return true;
    return (adminUser.allowedPages || []).includes(pageId);
  };
  const ActivePage = canViewPage(activePage) ? (pages[activePage] || DashboardPage) : DashboardPage;

  // ========== ADMIN LOGIN GATE ==========
  if(!crmLoggedIn) {
    return (
      <div style={{fontFamily:"'Plus Jakarta Sans','Segoe UI',system-ui,sans-serif", minHeight:"100vh", display:"flex", alignItems:"center", justifyContent:"center", background:"linear-gradient(135deg,#0f172a 0%,#1e293b 100%)"}}>
        <style>{`@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap');`}</style>
        <div style={{background:"#fff", borderRadius:24, padding:40, maxWidth:420, width:"90%", boxShadow:"0 25px 60px rgba(0,0,0,.3)"}}>
          <div style={{textAlign:"center", marginBottom:28}}>
            {pubLogo ? <img src={pubLogo} alt="logo" onError={()=>setPubLogo("")} style={{height:56, maxWidth:200, objectFit:"contain", marginBottom:14}} /> : <div style={{width:56,height:56,borderRadius:14,background:"linear-gradient(135deg,#3b82f6,#1d4ed8)",display:"inline-flex",alignItems:"center",justifyContent:"center",color:"#fff",fontWeight:800,fontSize:20,fontFamily:"'Space Grotesk'",marginBottom:14}}>NF</div>}
            <h2 style={{fontSize:22,fontWeight:800,color:"#0f172a",fontFamily:"'Space Grotesk'"}}>{forgotPwMode ? "Reset Password" : "CRM Admin"}</h2>
            <p style={{color:"#64748b",fontSize:13,marginTop:4}}>{forgotPwMode ? "Enter your username or email to receive a new password" : "Sign in to manage your network"}</p>
          </div>

          {!forgotPwMode ? (
            <>
              <div style={{marginBottom:16}}>
                <label style={{fontSize:12,fontWeight:600,color:"#475569",marginBottom:6,display:"block"}}>Username</label>
                <input value={crmLoginForm.username} onChange={e=>setCrmLoginForm({...crmLoginForm,username:e.target.value})} placeholder="admin"
                  style={{width:"100%",padding:"12px 14px",border:"1px solid #e2e8f0",borderRadius:10,fontSize:13,background:"#f8fafc",fontFamily:"inherit",outline:"none"}}
                  onKeyDown={e=>{if(e.key==="Enter")document.getElementById("login-pw")?.focus();}} />
              </div>
              <div style={{marginBottom:12}}>
