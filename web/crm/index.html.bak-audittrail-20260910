  };


  // ========== PAGES ==========

  const DashboardPage = () => {
    const [latestApk, setLatestApk] = React.useState(null);
    React.useEffect(() => { fetch('/docs/latest-apk.json?t=' + Date.now()).then(r => r.ok ? r.json() : null).then(setLatestApk).catch(() => {}); }, []);
    const [fiber, setFiber] = React.useState(null);
    React.useEffect(() => { fetch(API + '/admin/smartolt/summary', { headers: authHeaders() }).then(r => r.ok ? r.json() : null).then(setFiber).catch(() => {}); }, []);
    const activePlans = revByPlan.filter(r=>r.count>0);
    const totalActivityPages = Math.ceil(notifications.length / activitiesPerPage);
    const pagedActivities = notifications.slice((activityPage-1)*activitiesPerPage, activityPage*activitiesPerPage);

    // ── Installations per month (last 12 months, from installed date) ──
    const installsByMonth = (() => {
      const now = new Date();
      const buckets = [];
      for (let i = 11; i >= 0; i--) {
        const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
        buckets.push({ key: d.getFullYear()+"-"+d.getMonth(), label: d.toLocaleString("en-US",{month:"short"}), full: d.toLocaleString("en-US",{month:"long",year:"numeric"}), count: 0 });
      }
      const idx = {}; buckets.forEach((b,i)=>idx[b.key]=i);
      subscribers.forEach(s => {
        if (!s.installed) return;
        const d = new Date(s.installed); if (isNaN(d)) return;
        const k = d.getFullYear()+"-"+d.getMonth();
        if (idx[k] !== undefined) buckets[idx[k]].count++;
      });
      return buckets;
    })();
    const installsMax = Math.max(...installsByMonth.map(b=>b.count), 1);

    // ── Collections per day (last 14 days, from invoice payments; excludes credit) ──
    const collectionsByDay = (() => {
      const now = new Date();
      const buckets = [];
      for (let i = 13; i >= 0; i--) {
        const d = new Date(now.getFullYear(), now.getMonth(), now.getDate() - i);
        buckets.push({ key: d.toISOString().slice(0,10), label: d.toLocaleString("en-US",{weekday:"short"}), full: d.toLocaleString("en-US",{month:"short",day:"numeric"}), total: 0 });
      }
      const idx = {}; buckets.forEach((b,i)=>idx[b.key]=i);
      invoices.forEach(inv => {
        (inv.payments||[]).forEach(p => {
          if (!p || !p.paidAt || p.method === 'credit') return;
          const d = new Date(p.paidAt); if (isNaN(d)) return;
          const k = d.toISOString().slice(0,10);
          if (idx[k] !== undefined) buckets[idx[k]].total += Number(p.amount)||0;
        });
      });
      return buckets;
    })();
    const collectionsMax = Math.max(...collectionsByDay.map(b=>b.total), 1);

    // Pie chart math
    const pieColors = ["#10b981","#3b82f6","#8b5cf6","#f59e0b","#ef4444","#0ea5e9","#ec4899","#6366f1"];
    const pieTotal = activePlans.reduce((s,r) => s + r.revenue, 0) || 1;
    let cumAngle = 0;
    const slices = activePlans.map((r,i) => {
      const pct = r.revenue / pieTotal;
      const sa = cumAngle;
      cumAngle += pct * 360;
      const ea = cumAngle;
      const sr = (sa - 90) * Math.PI / 180;
      const er = (ea - 90) * Math.PI / 180;
      const la = pct > 0.5 ? 1 : 0;
      const x1 = 100 + 80 * Math.cos(sr);
      const y1 = 100 + 80 * Math.sin(sr);
      const x2 = 100 + 80 * Math.cos(er);
      const y2 = 100 + 80 * Math.sin(er);
      const color = r.color || pieColors[i % pieColors.length];
      const path = pct >= 0.999 ? "M 100 20 A 80 80 0 1 1 99.99 20 Z" : "M 100 100 L "+x1+" "+y1+" A 80 80 0 "+la+" 1 "+x2+" "+y2+" Z";
      return { ...r, pct, color, path };
    });
    const totalPieSubs = activePlans.reduce((s,r)=>s+r.count,0);

    // Active subscribers per barangay
    const brgyMap = {};
    subscribers.filter(s => s.status === "active").forEach(s => {
      const key = (s.barangay && String(s.barangay).trim()) || "Unspecified";
      brgyMap[key] = (brgyMap[key] || 0) + 1;
    });
    const brgyList = Object.entries(brgyMap).map(([name,count]) => ({name,count})).sort((a,b)=>b.count-a.count);
    const brgyTotal = brgyList.reduce((s,r)=>s+r.count,0) || 1;
    let brgyCum = 0;
    const brgySlices = brgyList.map((r,i) => {
      const pct = r.count / brgyTotal;
      const sa = brgyCum;
      brgyCum += pct * 360;
      const ea = brgyCum;
      const sr = (sa - 90) * Math.PI / 180;
      const er = (ea - 90) * Math.PI / 180;
      const la = pct > 0.5 ? 1 : 0;
      const x1 = 100 + 80 * Math.cos(sr);
      const y1 = 100 + 80 * Math.sin(sr);
      const x2 = 100 + 80 * Math.cos(er);
      const y2 = 100 + 80 * Math.sin(er);
      const color = pieColors[i % pieColors.length];
      const path = pct >= 0.999 ? "M 100 20 A 80 80 0 1 1 99.99 20 Z" : "M 100 100 L "+x1+" "+y1+" A 80 80 0 "+la+" 1 "+x2+" "+y2+" Z";
      return { ...r, pct, color, path };
    });
    const totalBrgySubs = brgyList.reduce((s,r)=>s+r.count,0);

    return (
    <div>
      {/* Dashboard heading, welcome text, and date moved to header */}

      {/* KPI Cards */}
