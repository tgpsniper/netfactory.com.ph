                  handleNewInvChange('amount', fmt);
                }}
                onBlur={e=>{const n=parseFloat(String(e.target.value).replace(/,/g,'')); if(!isNaN(n)) handleNewInvChange('amount',n.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}));}}
                style={{width:"100%",padding:"10px 14px",border:`1px solid ${t.inputBorder}`,borderRadius:10,fontSize:13,background:t.input,color:t.text,fontFamily:"inherit",outline:"none",boxSizing:"border-box"}} />
