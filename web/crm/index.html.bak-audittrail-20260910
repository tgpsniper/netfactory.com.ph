                <div key={o.value} onClick={()=>{onChange(String(o.value));setOpen(false);setSearch("");}} style={{padding:"10px 14px",fontSize:12,color:String(o.value)===String(value)?t.accent:t.text,fontWeight:String(o.value)===String(value)?600:400,cursor:"pointer",borderBottom:`1px solid ${t.border}`,background:String(o.value)===String(value)?`${t.accent}10`:"transparent"}}>{o.label}</div>
              ))}
              {filtered.length>50 && <div style={{padding:10,fontSize:11,color:t.textMuted,textAlign:"center"}}>Showing 50 of {filtered.length} — type to narrow</div>}
