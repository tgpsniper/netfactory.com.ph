const { useState, useEffect, useRef } = React;



// ── Helper components defined OUTSIDE J2CRM to prevent remount on every render ──
const _Card = ({ children, style = {}, t }) => (
  <div style={{ background: t.bgCard, borderRadius: 16, border: `1px solid ${t.border}`, boxShadow: t.shadow, padding: 24, transition: "all .3s", ...style }}>{children}</div>
);

const _Badge = ({ color, label }) => (
  <span style={{ display:"inline-flex", alignItems:"center", gap:5, padding:"4px 12px", borderRadius:20, fontSize:11, fontWeight:600, background:`${color}18`, color, textTransform:"capitalize" }}>
    <span style={{ width:6, height:6, borderRadius:"50%", background:color }} />{label}
  </span>
);

const _StatCard = ({ icon, label, value, sub, color, t }) => (
  <_Card t={t} style={{ display:"flex", gap:16, alignItems:"center" }}>
    <div style={{ width:52, height:52, borderRadius:14, background:`${color}15`, display:"flex", alignItems:"center", justifyContent:"center", fontSize:24 }}><_Icon name={icon} /></div>
    <div style={{ flex:1 }}>
      <div style={{ fontSize:12, color:t.textMuted, fontWeight:500, marginBottom:2 }}>{label}</div>
      <div style={{ fontSize:24, fontWeight:800, color:t.text, fontFamily:"'Space Grotesk',sans-serif" }}>{value}</div>
      {sub && <div style={{ fontSize:11, color:t.textMuted, marginTop:2 }}>{sub}</div>}
    </div>
  </_Card>
);

const _TableHead = ({ children, style: s = {}, t, ...rest }) => (
  <th {...rest} style={{ padding:"12px 16px", textAlign:"left", fontSize:11, fontWeight:700, color:t.textMuted, textTransform:"uppercase", letterSpacing:.5, borderBottom:`2px solid ${t.border}`, background:t.bgCard, whiteSpace:"nowrap", ...s }}>{children}</th>
);
const _TableCell = ({ children, style = {}, t }) => (
  <td style={{ padding:"14px 16px", fontSize:13, color:t.textSec, borderBottom:`1px solid ${t.border}`, ...style }}>{children}</td>
);

// ...rest so callers can pass title/disabled/type through; without it those were
// accepted at the call site and silently dropped, so tooltips never appeared.
const _Btn = ({ children, primary, danger, small, onClick, style = {}, t, ...rest }) => (
  <button onClick={onClick} {...rest} style={{
    padding: small ? "6px 14px" : "10px 20px", borderRadius:10,
    background: danger ? t.danger : primary ? `linear-gradient(135deg,${t.accent},${t.accentDk})` : t.bgCard,
    color: primary || danger ? "#fff" : t.textSec,
    border: primary || danger ? "none" : `1px solid ${t.border}`,
    fontSize: small ? 12 : 13, fontWeight:600, cursor:"pointer", transition:"all .3s", fontFamily:"inherit",
    display:"inline-flex", alignItems:"center", gap:6, ...style,
  }}>{children}</button>
);

const _InputField = ({ label, value, onChange, placeholder, type = "text", options, t }) => (
  <div style={{ marginBottom:14 }}>
    <label style={{ fontSize:12, fontWeight:600, color:t.textSec, marginBottom:6, display:"block" }}>{label}</label>
    {options ? (
      <select value={value} onChange={e => onChange(e.target.value)} style={{ width:"100%", padding:"12px 14px", border:`1px solid ${t.inputBorder}`, borderRadius:10, fontSize:13, background:t.input, color:t.text, fontFamily:"inherit", outline:"none" }}>
        {options.map(o => <option key={o.value} value={o.value}>{o.label}</option>)}
      </select>
    ) : (
      <input type={type} value={value} onChange={e => onChange(e.target.value)} placeholder={placeholder}
        style={{ width:"100%", padding:"12px 14px", border:`1px solid ${t.inputBorder}`, borderRadius:10, fontSize:13, background:t.input, color:t.text, fontFamily:"inherit", outline:"none" }} />
    )}
  </div>
);

const _Icon = ({ name, style = {} }) => {
  if (!name) return null;
  if (name.startsWith('fa-')) return <i className={"fas " + name} style={style}></i>;
  if (name.startsWith('far ')) return <i className={name} style={style}></i>;
  if (name.startsWith('fas ')) return <i className={name} style={style}></i>;
  return <span style={style}>{name}</span>;
};

// ==========================================
// NETFACTORY — CRM ADMIN DASHBOARD
// ==========================================

const J2CRM = () => {
  const [sidebarOpen, setSidebarOpen] = useState(true);
  const [openCategories, setOpenCategories] = useState({"customer":true,"finance":true,"operations":false,"network":false,"system":false,"website":false,"app":false});
  const [activePage, setActivePage] = useState("dashboard");
  const [theme, setTheme] = useState(localStorage.getItem("j2_crm_theme") || "medium");
  const [showNotif, setShowNotif] = useState(false);
  const [showNotifModal, setShowNotifModal] = useState(false);
  const [notifModalPage, setNotifModalPage] = useState(1);
  const [notifShowAll, setNotifShowAll] = useState(false);
  const [notifExpanded, setNotifExpanded] = useState(false);
  const notifsPerPage = 10;
  const [planPage, setPlanPage] = useState(1);
  const [planShowAll, setPlanShowAll] = useState(false);
  // Plans are grouped Active / Inactive, both shown by default — the point of the
  // grouping is to see the retired price books set apart, not to hide them. The
  // toolbar toggle collapses the inactive group for anyone who wants it out of the way.
  const [planShowInactive, setPlanShowInactive] = useState(true);
  const [planCols, setPlanCols] = useState(3);
  const planGridRef = useRef(null);
  const globalSearchRef = useRef(null);
  const [showProfile, setShowProfile] = useState(false);
  const [searchQuery, setSearchQuery] = useState("");
  const [subStatusFilter, setSubStatusFilter] = useState("all");
  const [subBarangayFilter, setSubBarangayFilter] = useState("");
  const [showBlastModal, setShowBlastModal] = useState(false);
  const [blastMessage, setBlastMessage] = useState("");
  const [blastScope, setBlastScope] = useState("filtered"); // 'filtered' | 'selected'
  const [blastPriority, setBlastPriority] = useState(false);
  const [blastSelectedIds, setBlastSelectedIds] = useState([]);
  const [blastStatusFilters, setBlastStatusFilters] = useState([]); // empty = all
  const [blastBarangayFilters, setBlastBarangayFilters] = useState([]); // empty = all
  const [blastPreview, setBlastPreview] = useState(null);
  const [blastSending, setBlastSending] = useState(false);
  const [blastResult, setBlastResult] = useState(null);
  const [globalSearch, setGlobalSearch] = useState("");
  const [showGlobalResults, setShowGlobalResults] = useState(false);
  const [barangaysByMuni, setBarangaysByMuni] = useState({});
  const [muniList, setMuniList] = useState([]);
  const [muniIdMap, setMuniIdMap] = useState({});
  const formatPhone = (val) => {
    var d = val.replace(/\D/g, "").substring(0, 11);
    if (d.length <= 4) return d.length > 0 ? "(" + d : "";
    if (d.length <= 7) return "(" + d.substring(0,4) + ") " + d.substring(4);
    return "(" + d.substring(0,4) + ") " + d.substring(4,7) + " - " + d.substring(7);
  };
  const unformatPhone = (val) => val.replace(/\D/g, "").substring(0, 11);
  const toTitleCase = (s) => (s||"").toLowerCase().replace(/(?:^|\s|[\-\/\(])\S/g, c => c.toUpperCase());
  const subDisplayName = (s) => {
    if (s.firstName || s.lastName) return `${s.firstName||""}${s.middleName ? " " + s.middleName : ""} ${s.lastName||""}`.trim();
    return s.companyName || s.acct || "—";
  };


  const [subPage, setSubPage] = useState(1);
  const [subShowAll, setSubShowAll] = useState(false);
  const [subSortKey, setSubSortKey] = useState("acct");
  const [subSortDir, setSubSortDir] = useState("asc");
  const subsPerPage = 8;
  const [selectedSub, setSelectedSub] = useState(null);
  const [showSubModal, setShowSubModal] = useState(false);
  const [creditHistory, setCreditHistory] = useState([]);
  const [creditLoading, setCreditLoading] = useState(false);
  const [showCreditAdjust, setShowCreditAdjust] = useState(null);
  const [creditAdjustForm, setCreditAdjustForm] = useState({type:"add",amount:"",notes:""});
  const [showAttachModal, setShowAttachModal] = useState(false);
  const [attachUploading, setAttachUploading] = useState(null); // field name being uploaded
  const [attachDeleting, setAttachDeleting] = useState(null);   // field name being deleted
  const [showAttachViewer, setShowAttachViewer] = useState(false);
  const [viewerFile, setViewerFile] = useState(null); // { url, label } for full-screen preview
  const [showNetworkModal, setShowNetworkModal] = useState(false);
  const [networkData, setNetworkData] = useState(null);  // { subscriber, nap, strand, foc, lateral, closure }
  const [networkLoading, setNetworkLoading] = useState(false);
  // XUI / IPTV line linkage (per-subscriber)
  const [xuiLine, setXuiLine] = useState(null);
  const [xuiLineLoading, setXuiLineLoading] = useState(false);
  const [showCreateXui, setShowCreateXui] = useState(false);
  const [createXuiForm, setCreateXuiForm] = useState({ownerId:"1",maxConnections:"1",expMode:"1year",customExpDate:""});
  const [xuiResellers, setXuiResellers] = useState([]);
  const [xuiSaving, setXuiSaving] = useState(false);
  const [showXuiDetails, setShowXuiDetails] = useState(false);
  const [xuiActivity, setXuiActivity] = useState(null);
  const [xuiActivityLoading, setXuiActivityLoading] = useState(false);
  const [xuiActionBusy, setXuiActionBusy] = useState(false);
  const [showXuiExtend, setShowXuiExtend] = useState(false);
  const [xuiExtendBusy, setXuiExtendBusy] = useState(false);
  const [xuiExtendCustomDate, setXuiExtendCustomDate] = useState("");
  // XUI bouquet editor
  const [showXuiBouquets, setShowXuiBouquets] = useState(false);
  const [allBouquets, setAllBouquets] = useState([]);
  const [bouquetSel, setBouquetSel] = useState([]);
  const [bouquetBusy, setBouquetBusy] = useState(false);

  // ── Omnichannel Inbox (Facebook / Viber / Gmail) ──
  const [inboxConvos, setInboxConvos] = useState([]);
  const [inboxSel, setInboxSel] = useState(null);          // selected conversation id
  const [inboxThread, setInboxThread] = useState(null);    // { conversation, messages }
  const [inboxReply, setInboxReply] = useState("");
  const [inboxBusy, setInboxBusy] = useState(false);
  const [inboxFilter, setInboxFilter] = useState({ channel:"all", status:"open", unread:false, q:"" });
  const [inboxUnread, setInboxUnread] = useState(0);
  const [inboxChannels, setInboxChannels] = useState([]);
  const [showInboxChannels, setShowInboxChannels] = useState(false);
  const [inboxLinkQuery, setInboxLinkQuery] = useState("");
  const [inboxChannelForm, setInboxChannelForm] = useState({ gmail:{}, viber:{}, facebook:{} });
  const [inboxChannelTab, setInboxChannelTab] = useState("gmail");
  const [inboxChannelBusy, setInboxChannelBusy] = useState(false);
  const inboxThreadRef = useRef(null);
  // refs to dodge stale closures inside the (once-bound) socket handler
  const activePageRef = useRef("dashboard");
  const inboxSelRef = useRef(null);
  const loadInboxConvosRef = useRef(null);
  const openInboxConvoRef = useRef(null);

  // NAP-port assignment flow (Network modal → "Not assigned" → pick nearby NAP → pick port)
  const [showNapPicker, setShowNapPicker] = useState(false);
  const [napPickerData, setNapPickerData] = useState([]);     // [{nap, distanceM}]
  const [napPickerLoading, setNapPickerLoading] = useState(false);
  const [showPortPicker, setShowPortPicker] = useState(false);
  const [portPickerNap, setPortPickerNap] = useState(null);   // {id, name, totalPorts}
  const [portPickerData, setPortPickerData] = useState([]);   // ports[]
  const [portPickerLoading, setPortPickerLoading] = useState(false);
  const [portAssigning, setPortAssigning] = useState(null);   // port.id while saving
  const napMapRef = useRef(null);
  const napMapInstance = useRef(null);
  // Lazy-load Leaflet (CSS + JS) once on first picker open.
  const ensureLeaflet = () => {
    if (window.L) return Promise.resolve(window.L);
    if (window._leafletLoading) return window._leafletLoading;
    window._leafletLoading = new Promise((resolve, reject) => {
      const css = document.createElement("link");
      css.rel = "stylesheet";
      css.href = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css";
      document.head.appendChild(css);
      const js = document.createElement("script");
      js.src = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";
      js.onload = () => resolve(window.L);
      js.onerror = reject;
      document.head.appendChild(js);
    });
    return window._leafletLoading;
  };
  // Render the picker map whenever data is ready.
  useEffect(() => {
    if (!showNapPicker || napPickerLoading || !selectedSub || !napPickerData.length) return;
    let cancelled = false;
    ensureLeaflet().then(L => {
      if (cancelled || !napMapRef.current) return;
      const subLat = Number(selectedSub.lat), subLng = Number(selectedSub.lng);
      if (!napMapInstance.current) {
        napMapInstance.current = L.map(napMapRef.current, { zoomControl:true }).setView([subLat, subLng], 17);
        L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", { maxZoom: 19, attribution: "© OpenStreetMap" }).addTo(napMapInstance.current);
      } else {
        napMapInstance.current.eachLayer(layer => { if (layer instanceof L.Marker) napMapInstance.current.removeLayer(layer); });
      }
      // Subscriber dot — same style as GIS active subscriber (green circle).
      const subIcon = L.divIcon({ className:"", html:'<svg width="16" height="16" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6" fill="#22c55e" stroke="#fff" stroke-width="1.8"/></svg>', iconSize:[16,16], iconAnchor:[8,8] });
      const subTipHtml = '<div style="text-align:center;line-height:1.35"><div style="font-weight:700">Subscriber</div><div style="font-family:monospace;font-size:10px;color:#94a3b8">'+subLat.toFixed(6)+', '+subLng.toFixed(6)+'</div></div>';
      L.marker([subLat, subLng], { icon: subIcon, zIndexOffset: 1000 }).addTo(napMapInstance.current).bindTooltip(subTipHtml, { permanent:false, direction:"top" });
      // Last-5-digits-of-NAP-name helper (or last 5 chars if no digit suffix).
      const shortName = (nm) => { const m = String(nm||"").match(/(\d{4,6})\s*$/); return m ? m[1] : String(nm||"").slice(-5); };
      napPickerData.forEach(({ nap }) => {
        const avail = (nap.totalPorts || 0) - (nap.usedPorts || 0);
        const full = avail <= 0;
        const color = full ? "#ef4444" : "#16a34a";
        const napIcon = L.divIcon({ className:"", html:'<svg width="22" height="22" viewBox="0 0 22 22"><circle cx="11" cy="11" r="8" fill="'+color+'" stroke="#fff" stroke-width="1.5"/><circle cx="11" cy="11" r="3" fill="#fff" opacity=".7"/></svg>', iconSize:[22,22], iconAnchor:[11,11] });
        const m = L.marker([Number(nap.lat), Number(nap.lng)], { icon: napIcon }).addTo(napMapInstance.current);
        // Permanent label so all NAPs show their last-5-digits id.
        m.bindTooltip(shortName(nap.name) + " · " + avail + "/" + nap.totalPorts, { permanent:true, direction:"right", offset:[10,0], className:"nap-pick-tip" });
        // Hover tooltip — full name + GPS coords for at-a-glance verification.
        const napHover = '<div style="text-align:left;line-height:1.4"><div style="font-weight:700;color:'+color+'">'+nap.name+'</div><div style="font-size:10px;color:#94a3b8">'+(nap.type||"nap")+' · '+avail+'/'+nap.totalPorts+' avail</div><div style="font-family:monospace;font-size:10px;color:#cbd5e1;margin-top:2px">'+Number(nap.lat).toFixed(6)+', '+Number(nap.lng).toFixed(6)+'</div></div>';
        m.bindPopup(napHover, { closeButton:false });
        m.on("mouseover", function(){ this.openPopup(); });
        m.on("mouseout", function(){ this.closePopup(); });
        m.on("click", async () => {
          if (full) return;
          setShowNapPicker(false);
          setShowPortPicker(true);
          setPortPickerNap({ id: nap.id, name: nap.name, totalPorts: nap.totalPorts });
          setPortPickerLoading(true); setPortPickerData([]);
          try {
            const r = await fetch(`/api/admin/map/naps/${nap.id}/ports`, { headers: authHeaders() });
            if (r.ok) { const d = await r.json(); setPortPickerData(d.ports || []); }
          } catch (e) { /* ignore */ }
          setPortPickerLoading(false);
        });
      });
      // Fit bounds to show subscriber + nearest NAPs
      const pts = napPickerData.slice(0, 8).map(({nap}) => [Number(nap.lat), Number(nap.lng)]).concat([[subLat, subLng]]);
      try { napMapInstance.current.fitBounds(pts, { padding: [40, 40], maxZoom: 18 }); } catch(e) {}
    });
    return () => { cancelled = true; };
  }, [showNapPicker, napPickerLoading, napPickerData]);
  // Tear down the Leaflet instance when the picker closes so reopening clean.
  useEffect(() => {
    if (showNapPicker) return;
    if (napMapInstance.current) { try { napMapInstance.current.remove(); } catch(e) {} napMapInstance.current = null; }
  }, [showNapPicker]);

  useEffect(() => {
    // Always call /line: it auto-links by account_number → XUI username if no link yet.
    if (showSubModal && selectedSub?.id) loadXuiLine(selectedSub.id);
    else setXuiLine(null);
  }, [showSubModal, selectedSub?.id]);

  const loadCreditHistory = async (subId) => {
    setCreditLoading(true);
    try {
      const res = await apiFetch("/admin/credits/" + subId);
      setCreditHistory(res.history || []);
    } catch(e) { setCreditHistory([]); }
    setCreditLoading(false);
  };
  const handleCreditAdjust = async () => {
    if (!creditAdjustForm.amount || Number(creditAdjustForm.amount) <= 0) return;
    try {
      const res = await apiFetch("/admin/credits/" + showCreditAdjust.id + "/adjust", {
        method: "POST",
        body: JSON.stringify({ type: creditAdjustForm.type, amount: Number(creditAdjustForm.amount), notes: creditAdjustForm.notes || (creditAdjustForm.type === "add" ? "Manual credit" : "Manual deduction") })
      });
      showToast(res.message || "Credit adjusted", "success");
      setShowCreditAdjust(null);
      setCreditAdjustForm({type:"add",amount:"",notes:""});
      fetchCrmData();
      if (selectedSub) loadCreditHistory(selectedSub.id);
    } catch(e) { showToast(e.message || "Failed to adjust credit", "error"); }
  };

  // ── XUI / IPTV line handlers ──
  const loadXuiLine = async (subId) => {
    setXuiLineLoading(true); setXuiLine(null);
    try {
      const res = await apiFetch("/admin/xconnect/subscribers/" + subId + "/line");
      setXuiLine(res.linked ? res.line : null);
      if (res.autoLinked && res.line) {
        showToast("Auto-linked to XUI line " + res.line.username, "success");
        setSelectedSub(s => s && s.id === subId ? {...s, xuiUserId: res.line.id} : s);
      }
      if (res.warning) showToast(res.warning, "warning");
    } catch(e) { setXuiLine(null); }
    setXuiLineLoading(false);
  };
  const openCreateXuiModal = async () => {
    if (!selectedSub) return;
    if (!selectedSub.acct) { showToast("Subscriber has no account number", "error"); return; }
    setCreateXuiForm({ownerId:"1", maxConnections:"1", expMode:"1year", customExpDate:""});
    setShowCreateXui(true);
    if (!xuiResellers.length) {
      try { const r = await apiFetch("/admin/xconnect/resellers"); setXuiResellers(r.resellers || []); }
      catch(e) { /* fall back to admin only */ }
    }
  };
  const handleCreateXuiLine = async () => {
    if (!selectedSub) return;
    const f = createXuiForm;
    const body = {
      ownerId: parseInt(f.ownerId, 10) || 1,
      maxConnections: parseInt(f.maxConnections, 10) || 1,
    };
    if (f.expMode === "never") body.noExpire = true;
    else if (f.expMode === "custom") { if (!f.customExpDate) { showToast("Pick an expiration date", "error"); return; } body.expDate = f.customExpDate; }
    else {
      const d = new Date();
      if (f.expMode === "1month") d.setMonth(d.getMonth() + 1);
      else if (f.expMode === "3months") d.setMonth(d.getMonth() + 3);
      else if (f.expMode === "6months") d.setMonth(d.getMonth() + 6);
