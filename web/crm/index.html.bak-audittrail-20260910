      const updated = { ...f, [field]: value };
      if (field === 'amount' || field === 'taxType') {
        const taxRate = parseFloat(cs.default_tax_rate || '0') || 0;
        const { tax, total } = computeNewInvTax(updated.amount, updated.taxType, taxRate);
        updated.tax = tax; updated.total = total;
      }
      return updated;
    });
    if (field === 'subSearch') {
      const q = value.toLowerCase();
      setNewInvSubResults(q.length < 2 ? [] : subscribers.filter(s => {
