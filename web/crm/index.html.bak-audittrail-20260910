                  <div style={{ display:"flex", alignItems:"center", justifyContent:"space-between", gap: 12, flexWrap:"wrap" }}>
                    <div style={{ fontSize: 12, color: t.textMuted, fontStyle: "italic", flex:"1 1 240px" }}>No IPTV line in XUI matches this account number. Create one to start streaming.</div>
                    <button onClick={openCreateXuiModal} style={{ padding:"8px 14px", borderRadius:8, background:"linear-gradient(135deg,#8b5cf6,#7c3aed)", color:"#fff", border:"none", fontSize:12, fontWeight:700, cursor:"pointer", fontFamily:"inherit" }}><i className="fas fa-plus" style={{marginRight:4}}></i>Create XUI Line</button>
                  </div>
