  const handleCsvParse = (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (ev) => {
      const text = ev.target.result;
      const lines = text.split('\n').filter(l => l.trim());
      if (lines.length < 2) { showConfirm({ icon:'fa-triangle-exclamation', title:'Invalid CSV', message:'CSV must have a header row and at least one data row', confirmText:'OK', confirmColor:'primary', onConfirm:()=>setShowConfirmModal(null) }); return; }
      const header = lines[0].split(',').map(h => h.trim().toLowerCase().replace(/[^a-z_]/g, ''));
      const macIdx = header.findIndex(h => h.includes('mac'));
      const modelIdx = header.findIndex(h => h.includes('model'));
      const serialIdx = header.findIndex(h => h.includes('serial'));
      const vendorIdx = header.findIndex(h => h.includes('vendor'));
      const priceIdx = header.findIndex(h => h.includes('price'));
      const dateIdx = header.findIndex(h => h.includes('purchase') && h.includes('date'));
      const warrantyIdx = header.findIndex(h => h.includes('warranty'));
      const notesIdx = header.findIndex(h => h.includes('note'));

      if (macIdx === -1 || modelIdx === -1) {
        showConfirm({ icon:"fa-triangle-exclamation", title:"Missing Columns", message:'CSV must have "mac_address" and "model" columns', confirmText:"OK", confirmColor:"primary", onConfirm:()=>setShowConfirmModal(null) });
        return;
      }

      const rows = [];
      for (let i = 1; i < lines.length; i++) {
        const cols = lines[i].split(',').map(c => c.trim().replace(/^"|"$/g, ''));
        if (!cols[macIdx]) continue;
        const row = {
          mac_address: formatMacInput(cols[macIdx] || ''),
          model: cols[modelIdx] || '',
          serial_number: serialIdx >= 0 ? cols[serialIdx] : '',
          vendor_name: vendorIdx >= 0 ? cols[vendorIdx] : '',
          purchase_price: priceIdx >= 0 ? cols[priceIdx] : '',
          purchase_date: dateIdx >= 0 ? cols[dateIdx] : '',
          warranty_until: warrantyIdx >= 0 ? cols[warrantyIdx] : '',
          notes: notesIdx >= 0 ? cols[notesIdx] : '',
        };
        rows.push(row);
      }
      setCsvData(rows);
    };
    reader.readAsText(file);
  };

