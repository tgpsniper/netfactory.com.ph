    <div>

      <div className="plans-scroll" style={{ overflowY: planShowAll && totalPlans > plansPerPage ? "auto" : "visible", maxHeight: planShowAll && totalPlans > plansPerPage ? "calc(100vh - 240px)" : "none", paddingRight: planShowAll && totalPlans > plansPerPage ? 4 : 0 }}>
        <div ref={planGridRef} style={{ display:"grid", gridTemplateColumns:"repeat(auto-fit, minmax(340px, 1fr))", gap:16 }}>
          {displayPlans.map((p, gi) => {
            const cnt = subscribers.filter(s => s.planId === p.id && s.status === "active").length;
            const rev = cnt * p.price;
            // Every status, not just active — a disconnected subscriber's billing
            // history is exactly what blocks deletion on the server.
            const linkedSubs = subscribers.filter(s => s.planId === p.id).length;
            // Header rows span the whole grid and appear wherever the group changes,
            // so they still land correctly when a page starts mid-group.
            const prevP = displayPlans[gi - 1];
            const showGroupHead = gi === 0 || (prevP && !prevP.isActive !== !p.isActive);
            const groupCount = p.isActive ? activePlans.length : inactivePlans.length;
            return (
              <React.Fragment key={p.id}>
              {showGroupHead && (
                <div style={{ gridColumn:"1 / -1", display:"flex", alignItems:"center", gap:10, marginTop: gi === 0 ? 0 : 14, marginBottom:-4 }}>
                  <span style={{ width:8, height:8, borderRadius:"50%", background: p.isActive ? t.success : t.textMuted }} />
                  <span style={{ fontSize:12, fontWeight:700, letterSpacing:1.5, textTransform:"uppercase", color: p.isActive ? t.text : t.textMuted }}>
                    {p.isActive ? "Active" : "Inactive"}
                  </span>
                  <span style={{ fontSize:11, color:t.textMuted }}>{groupCount} plan{groupCount!==1?"s":""}</span>
                  <span style={{ flex:1, height:1, background:t.border }} />
                </div>
              )}
              <Card style={{position:"relative",overflow:"hidden",opacity:p.isActive?1:0.6}}>
                <div style={{position:"absolute",top:0,left:0,right:0,height:4,background:p.color||t.accent}} />
                {p.isPopular && <div style={{position:"absolute",top:12,right:12,background:t.warning,color:"#fff",fontSize:10,fontWeight:700,padding:"3px 10px",borderRadius:20}}><i className="fas fa-star" style={{marginRight:4}}></i> POPULAR</div>}
                {!p.isActive && <div style={{position:"absolute",top:12,right:12,background:t.danger,color:"#fff",fontSize:10,fontWeight:700,padding:"3px 10px",borderRadius:20}}>INACTIVE</div>}

                <div style={{ display:"flex", justifyContent:"space-between", alignItems:"flex-start", marginBottom:12, paddingTop:8 }}>
                  <div>
                    <div style={{ fontSize:11, fontWeight:700, color:p.color||t.accent, textTransform:"uppercase", letterSpacing:2, marginBottom:4 }}>{p.name}</div>
                    <div style={{ fontSize:20, fontWeight:800, color:t.text, fontFamily:"'Space Grotesk'" }}>{p.speed}</div>
                  </div>
                  <div style={{ textAlign:"right" }}>
                    <div style={{ fontSize:28, fontWeight:800, color:t.text, fontFamily:"'Space Grotesk'" }}>{fmt(p.price)}</div>
                    <div style={{ fontSize:11, color:t.textMuted }}>/month</div>
                  </div>
                </div>

                {p.description && <div style={{fontSize:13,color:t.textSec,marginBottom:14,lineHeight:1.5}}>{p.description}</div>}

                {p.features && p.features.length > 0 && (
                  <div style={{marginBottom:14}}>
                    {p.features.map((f,i) => (
                      <div key={i} style={{display:"flex",alignItems:"center",gap:8,marginBottom:6}}>
                        <span style={{color:t.success,fontSize:13}}><i className="fas fa-check"></i></span>
                        <span style={{fontSize:12,color:t.textSec}}>{f.text||f}</span>
                      </div>
                    ))}
                  </div>
                )}

                {p.routerType && <div style={{fontSize:11,color:t.textMuted,marginBottom:12}}>{p.routerType}</div>}

                <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center", padding:"14px 0 0", borderTop:`1px solid ${t.border}` }}>
                  <div>
                    <span style={{ fontSize:13, fontWeight:600, color:t.text }}>{cnt}</span>
                    <span style={{ fontSize:12, color:t.textMuted }}> subscriber{cnt!==1?"s":""}</span>
                    {cnt > 0 && <span style={{ fontSize:11, color:t.success, marginLeft:8 }}>{fmt(rev)}/mo</span>}
                  </div>
                  <div style={{ display:"flex", gap:6 }}>
                    <Btn small onClick={()=>openPlanNotes(p)}>Notes</Btn>
                    <Btn small onClick={()=>openEditPlan(p)}><i className="fas fa-pen" style={{marginRight:4}}></i> Edit</Btn>
                    {['superadmin','admin'].includes(adminUser?.role) && (linkedSubs > 0
                      ? <Btn small title={`${linkedSubs} subscriber${linkedSubs!==1?"s are":" is"} on this plan — move them off, or set the plan Inactive`} onClick={()=>handleDeletePlan(p)} style={{background:"rgba(148,163,184,.12)",color:t.textMuted,border:`1px solid ${t.border}`,cursor:"not-allowed"}}><i className="fas fa-trash-can"></i></Btn>
                      : <Btn small title="Delete plan" onClick={()=>handleDeletePlan(p)} style={{background:"rgba(239,68,68,.15)",color:"#ef4444",border:"1px solid rgba(239,68,68,.3)"}}><i className="fas fa-trash-can"></i></Btn>)}
                  </div>
                </div>
              </Card>
              </React.Fragment>
            );
          })}
        </div>
      </div>

      {/* Pagination */}
      {!planShowAll && totalPlanPages > 1 && (
        <div style={{ marginTop:20, padding:"14px 20px", background:t.bgCard, borderRadius:12, border:`1px solid ${t.border}`, display:"flex", justifyContent:"space-between", alignItems:"center", flexWrap:"wrap", gap:8 }}>
          <span style={{ fontSize:12, color:t.textMuted }}>
            Showing {(safePlanPage - 1) * plansPerPage + 1}–{Math.min(safePlanPage * plansPerPage, totalPlans)} of {totalPlans} plans ({planCols} per row × 2 rows)
          </span>
          <div style={{ display:"flex", gap:4, alignItems:"center", flexWrap:"wrap" }}>
            <button onClick={() => setPlanPage(Math.max(1, safePlanPage - 1))} disabled={safePlanPage <= 1}
              style={{ padding:"6px 12px", borderRadius:8, border:`1px solid ${t.border}`, background:t.bgCard, color: safePlanPage <= 1 ? t.textMuted : t.textSec, fontSize:12, fontWeight:600, cursor: safePlanPage <= 1 ? "default" : "pointer", fontFamily:"inherit", opacity: safePlanPage <= 1 ? .5 : 1 }}><i className="fas fa-arrow-left" style={{marginRight:4}}></i> Prev</button>
            {planPageNums.map((pg, i) => (
              pg === "..." ? <span key={"e"+i} style={{ padding:"0 4px", color:t.textMuted, fontSize:12 }}>…</span> :
              <button key={pg} onClick={() => setPlanPage(pg)}
                style={{ width:32, height:32, borderRadius:8, border:`1px solid ${t.border}`, fontSize:12, fontWeight: pg === safePlanPage ? 700 : 400, cursor:"pointer", fontFamily:"inherit", transition:"all .2s",
                  background: pg === safePlanPage ? t.accent : t.bgCard, color: pg === safePlanPage ? "#fff" : t.textSec,
                }}>{pg}</button>
            ))}
            <button onClick={() => setPlanPage(Math.min(totalPlanPages, safePlanPage + 1))} disabled={safePlanPage >= totalPlanPages}
              style={{ padding:"6px 12px", borderRadius:8, border:`1px solid ${t.border}`, background:t.bgCard, color: safePlanPage >= totalPlanPages ? t.textMuted : t.textSec, fontSize:12, fontWeight:600, cursor: safePlanPage >= totalPlanPages ? "default" : "pointer", fontFamily:"inherit", opacity: safePlanPage >= totalPlanPages ? .5 : 1 }}>Next <i className="fas fa-arrow-right" style={{marginLeft:4}}></i></button>
          </div>
        </div>
      )}
      {!planShowAll && totalPlanPages <= 1 && totalPlans > 0 && (
        <div style={{ marginTop:20, padding:"12px 20px", background:t.bgCard, borderRadius:12, border:`1px solid ${t.border}`, textAlign:"center" }}>
          <span style={{ fontSize:12, color:t.textMuted }}>Showing all {totalPlans} plans ({planCols} per row × 2 rows)</span>
        </div>
      )}
      {planShowAll && totalPlans > 0 && (
        <div style={{ marginTop:20, padding:"12px 20px", background:t.bgCard, borderRadius:12, border:`1px solid ${t.border}`, textAlign:"center" }}>
          <span style={{ fontSize:12, color:t.textMuted }}>Showing all {totalPlans} plans</span>
        </div>
      )}
    </div>
    );
  };

  // ═══ Packages Page ═══
  const PackagesPage = () => {
    const sortedPkgs = [...installPackages].sort((a,b) => (a.sortOrder||0) - (b.sortOrder||0));
    return (
      <div>
        <div style={{ display:"grid", gridTemplateColumns:"repeat(auto-fit, minmax(340px, 1fr))", gap:16 }}>
          {sortedPkgs.map(p => {
            return (
              <Card key={p.id} style={{position:"relative",overflow:"hidden",opacity:p.isActive?1:0.6}}>
                <div style={{position:"absolute",top:0,left:0,right:0,height:4,background:p.color||t.accent}} />
                {!p.isActive && <div style={{position:"absolute",top:12,right:12,background:t.danger,color:"#fff",fontSize:10,fontWeight:700,padding:"3px 10px",borderRadius:20}}>INACTIVE</div>}
                <div style={{display:"flex",justifyContent:"space-between",alignItems:"flex-start",marginBottom:12,paddingTop:8}}>
                  <div>
                    <div style={{fontSize:11,fontWeight:700,color:p.color||t.accent,textTransform:"uppercase",letterSpacing:2,marginBottom:4}}>{p.name}</div>
                    <div style={{fontSize:15,fontWeight:700,color:t.text}}>{p.description||""}</div>
                  </div>
                  <span style={{fontSize:13,fontWeight:700,padding:"4px 12px",borderRadius:8,background:(p.color||t.accent)+"18",color:p.color||t.accent,border:`1px solid ${(p.color||t.accent)}30`}}>{p.code}</span>
                </div>
                {p.items && p.items.length > 0 && (
                  <div style={{marginBottom:14}}>
                    {p.items.map((item,i) => (
                      <div key={i} style={{display:"flex",alignItems:"center",gap:8,marginBottom:6}}>
                        <span style={{color:p.color||t.success,fontSize:11}}><i className="fas fa-check"></i></span>
                        <span style={{fontSize:13,color:t.textSec}}>{item.text||item}</span>
                      </div>
                    ))}
                  </div>
                )}
                <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",padding:"14px 0 0",borderTop:`1px solid ${t.border}`}}>
                  <div>
                    <span style={{fontSize:13,fontWeight:600,color:t.text}}>{p.subscriberCount||0}</span>
                    <span style={{fontSize:12,color:t.textMuted}}> subscriber{(p.subscriberCount||0)!==1?"s":""}</span>
                  </div>
                  <Btn small onClick={()=>openEditPkg(p)}><i className="fas fa-pen" style={{marginRight:4}}></i> Edit</Btn>
                </div>
              </Card>
            );
          })}
        </div>
        {sortedPkgs.length === 0 && <div style={{textAlign:"center",padding:"60px 20px",color:t.textMuted}}><i className="fas fa-cubes" style={{fontSize:40,marginBottom:12,opacity:0.3,display:"block"}}></i>No packages yet. Click "Add Package" to create one.</div>}
      </div>
    );
  };

  const ReportsPage = () => {
    // ── Period helpers ──
    const periodMonths = [];
    for (let y = 2026; y <= new Date().getFullYear(); y++) {
      const endM = y === new Date().getFullYear() ? new Date().getMonth() : 11;
      for (let m = 0; m <= endM; m++) periodMonths.push(new Date(y, m, 1).toLocaleString("en-US",{month:"long",year:"numeric"}));
    }
    const periodIdx = (p) => periodMonths.indexOf(p);

    // ── Filter invoices for the report ──
    const invRptData = (() => {
      let list;
      if (invRptMode === "non-periodic") {
        list = invoices.filter(inv => !inv.period || inv.period.trim() === "" || inv.period === "—");
      } else {
        const fromIdx = periodIdx(invRptFrom);
        const toIdx = periodIdx(invRptTo);
        const validPeriods = periodMonths.slice(Math.min(fromIdx, toIdx), Math.max(fromIdx, toIdx) + 1);
        list = invoices.filter(inv => inv.period && validPeriods.includes(inv.period));
      }
      if (invRptSearch) {
        const q = invRptSearch.toLowerCase();
        list = list.filter(inv => {
          const sub = getSub(inv.subId);
          const subName = subDisplayName(sub).toLowerCase() || (inv.subName||"").toLowerCase();
          return inv.number?.toLowerCase().includes(q) || subName.includes(q) || (sub.acct||inv.subAcct||"").toLowerCase().includes(q);
        });
      }
      return list;
    })();
    const rptTotalAmt = invRptData.reduce((s,i) => s + (i.amount||0), 0);
    const rptTotalPaid = invRptData.reduce((s,i) => s + (i.paid||0), 0);
    const rptTotalBal = invRptData.reduce((s,i) => s + (i.balance||0), 0);
    const rptPaidCount = invRptData.filter(i => i.status === "paid").length;
    const rptPendingCount = invRptData.filter(i => i.status === "pending" || i.status === "overdue").length;
    const rptTotalPages = Math.ceil(invRptData.length / invRptPerPage);
    const rptPaged = invRptShowAll ? invRptData : invRptData.slice((invRptPage-1)*invRptPerPage, invRptPage*invRptPerPage);

    if (invRptOpen) return (
      <div>
        {/* Back + Title */}
        <div style={{ display:"flex", alignItems:"center", gap:12, marginBottom:20 }}>
          <Btn onClick={() => setInvRptOpen(false)}><i className="fas fa-arrow-left" style={{marginRight:6}}></i>Back to Reports</Btn>
          <h2 style={{ fontSize:20, fontWeight:800, color:t.text, fontFamily:"'Space Grotesk'", margin:0 }}><i className="fas fa-file-invoice" style={{color:t.accent,marginRight:8}}></i>Invoice Report</h2>
        </div>

        {/* Controls */}
        <Card style={{ marginBottom:16, padding:16 }}>
          <div style={{ display:"flex", flexWrap:"wrap", alignItems:"flex-end", gap:14 }}>
            {/* Mode toggle */}
            <div>
              <label style={{ fontSize:11, fontWeight:600, color:t.textSec, marginBottom:6, display:"block", textTransform:"uppercase", letterSpacing:.4 }}>Report Type</label>
              <div style={{ display:"flex", borderRadius:10, overflow:"hidden", border:`1px solid ${t.border}` }}>
                {[{k:"range",l:"By Period"},{k:"non-periodic",l:"Non-Periodic"}].map(m => (
                  <div key={m.k} onClick={() => { setInvRptMode(m.k); setInvRptPage(1); }} style={{ padding:"9px 16px", fontSize:12, fontWeight:600, cursor:"pointer", background: invRptMode===m.k ? t.accent : t.input, color: invRptMode===m.k ? "#fff" : t.textSec, transition:"all .2s" }}>{m.l}</div>
                ))}
              </div>
            </div>
            {/* Period selectors (only for range mode) */}
            {invRptMode === "range" && <>
              <div>
                <label style={{ fontSize:11, fontWeight:600, color:t.textSec, marginBottom:6, display:"block", textTransform:"uppercase", letterSpacing:.4 }}>From Period</label>
                <select value={invRptFrom} onChange={e => { setInvRptFrom(e.target.value); setInvRptPage(1); }} style={{ padding:"9px 14px", borderRadius:10, border:`1px solid ${t.inputBorder}`, background:t.input, color:t.text, fontSize:13, fontFamily:"inherit", outline:"none", minWidth:170 }}>
                  {periodMonths.map(p => <option key={p} value={p}>{p}</option>)}
                </select>
              </div>
              <div>
                <label style={{ fontSize:11, fontWeight:600, color:t.textSec, marginBottom:6, display:"block", textTransform:"uppercase", letterSpacing:.4 }}>To Period</label>
                <select value={invRptTo} onChange={e => { setInvRptTo(e.target.value); setInvRptPage(1); }} style={{ padding:"9px 14px", borderRadius:10, border:`1px solid ${t.inputBorder}`, background:t.input, color:t.text, fontSize:13, fontFamily:"inherit", outline:"none", minWidth:170 }}>
                  {periodMonths.map(p => <option key={p} value={p}>{p}</option>)}
                </select>
              </div>
            </>}
            {/* Search */}
            <div style={{ flex:1, minWidth:200 }}>
              <label style={{ fontSize:11, fontWeight:600, color:t.textSec, marginBottom:6, display:"block", textTransform:"uppercase", letterSpacing:.4 }}>Search</label>
              <div style={{ position:"relative" }}>
                <i className="fas fa-search" style={{ position:"absolute", left:12, top:"50%", transform:"translateY(-50%)", color:t.textMuted, fontSize:12 }}></i>
                <input ref={invSearchRef} value={invRptSearch} onChange={e => { setInvRptSearch(e.target.value); setInvRptPage(1); }} placeholder="Invoice #, name, account..." style={{ width:"100%", padding:"9px 12px 9px 34px", borderRadius:10, border:`1px solid ${t.inputBorder}`, background:t.input, color:t.text, fontSize:13, fontFamily:"inherit", outline:"none", boxSizing:"border-box" }} />
              </div>
            </div>
            {/* Print */}
            <Btn onClick={() => window.print()} style={{ alignSelf:"flex-end" }}><i className="fas fa-print" style={{marginRight:6}}></i>Print</Btn>
          </div>
        </Card>

        {/* KPI Summary */}
        <div style={{ display:"grid", gridTemplateColumns:"repeat(auto-fit, minmax(150px, 1fr))", gap:12, marginBottom:16 }}>
          {[
            { label:"Invoices", value:invRptData.length, color:t.accent, icon:"fa-file-invoice" },
            { label:"Total Billed", value:fmt(rptTotalAmt), color:t.text, icon:"fa-peso-sign" },
            { label:"Total Collected", value:fmt(rptTotalPaid), color:t.success, icon:"fa-circle-check" },
            { label:"Outstanding", value:fmt(rptTotalBal), color:t.danger, icon:"fa-clock" },
            { label:"Paid", value:rptPaidCount, color:t.success, icon:"fa-check" },
            { label:"Pending/Overdue", value:rptPendingCount, color:t.warning, icon:"fa-hourglass-half" },
          ].map(s => (
            <div key={s.label} style={{ background:t.bgCard, borderRadius:12, border:`1px solid ${t.border}`, padding:"14px 16px" }}>
              <div style={{ fontSize:10, fontWeight:600, color:t.textMuted, textTransform:"uppercase", letterSpacing:.5, marginBottom:4 }}><_Icon name={s.icon} /> {s.label}</div>
              <div style={{ fontSize:20, fontWeight:800, color:s.color, fontFamily:"'Space Grotesk'" }}>{s.value}</div>
            </div>
          ))}
        </div>

        {/* Results Table */}
        <Card style={{ padding:0, overflow:"hidden" }}>
          <div style={{ overflowX:"auto", overflowY: invRptShowAll ? "auto" : "visible", maxHeight: invRptShowAll ? 560 : "none" }}>
            <table style={{ width:"100%", borderCollapse:"collapse", fontSize:13 }}>
              <thead>
                <tr style={{ background:t.bgCard, borderBottom:`2px solid ${t.border}` }}>
                  {["Invoice #","Subscriber","Account","Period","Amount","Paid","Balance","Status","Payment","Due Date"].map(h => (
                    <th key={h} style={{ padding:"10px 12px", textAlign:"left", fontSize:11, fontWeight:700, color:t.textMuted, textTransform:"uppercase", letterSpacing:.4, whiteSpace:"nowrap" }}>{h}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {rptPaged.length === 0 && <tr><td colSpan={10} style={{ padding:40, textAlign:"center", color:t.textMuted }}>No invoices found for this selection</td></tr>}
                {rptPaged.map(inv => {
                  const sub = getSub(inv.subId);
                  const subName = subDisplayName(sub) || (inv.subName||"—");
                  return (
                    <tr key={inv.id} style={{ borderBottom:`1px solid ${t.border}` }}>
                      <td style={{ padding:"10px 12px", fontFamily:"monospace", fontSize:12, fontWeight:600, color:t.accent, cursor:"pointer" }} onClick={() => openInvoiceDetail(inv.id)}>{inv.number}</td>
                      <td style={{ padding:"10px 12px", fontWeight:600, color:t.text, maxWidth:180, overflow:"hidden", textOverflow:"ellipsis", whiteSpace:"nowrap" }}>{subName}</td>
                      <td style={{ padding:"10px 12px", fontSize:12, color:t.textSec, fontFamily:"monospace" }}>{sub.acct||inv.subAcct||"—"}</td>
                      <td style={{ padding:"10px 12px", fontSize:12, color:t.textSec }}>{inv.period||"—"}</td>
                      <td style={{ padding:"10px 12px", fontWeight:700, color:t.text, fontFamily:"'Space Grotesk'", textAlign:"right" }}>{fmt(inv.amount)}</td>
                      <td style={{ padding:"10px 12px", fontWeight:600, color:t.success, fontFamily:"'Space Grotesk'", textAlign:"right" }}>{inv.paid > 0 ? fmt(inv.paid) : "—"}</td>
                      <td style={{ padding:"10px 12px", fontWeight:700, color:inv.balance>0?t.danger:t.success, fontFamily:"'Space Grotesk'", textAlign:"right" }}>{inv.status==="cancelled"?"—":inv.balance>0?fmt(inv.balance):"₱0.00"}</td>
                      <td style={{ padding:"10px 12px" }}><Badge color={statusColor(inv.status)} label={inv.status} /></td>
                      <td style={{ padding:"10px 12px", fontSize:12, color:t.textSec }}>{(paymentMethods.find(m=>m.code===inv.method)||{}).name || inv.method || "—"}</td>
                      <td style={{ padding:"10px 12px", fontSize:12, color:t.textSec, whiteSpace:"nowrap" }}>{inv.dueDate ? new Date(inv.dueDate).toLocaleDateString("en-US",{month:"short",day:"numeric",year:"numeric"}) : "—"}</td>
                    </tr>
                  );
                })}
              </tbody>
              {rptPaged.length > 0 && <tfoot>
                <tr style={{ background:t.bgCard, borderTop:`2px solid ${t.border}` }}>
                  <td colSpan={4} style={{ padding:"10px 12px", fontWeight:700, color:t.text, fontSize:12 }}>TOTALS ({invRptData.length} invoices)</td>
                  <td style={{ padding:"10px 12px", fontWeight:800, color:t.text, fontFamily:"'Space Grotesk'", textAlign:"right" }}>{fmt(rptTotalAmt)}</td>
                  <td style={{ padding:"10px 12px", fontWeight:800, color:t.success, fontFamily:"'Space Grotesk'", textAlign:"right" }}>{fmt(rptTotalPaid)}</td>
                  <td style={{ padding:"10px 12px", fontWeight:800, color:t.danger, fontFamily:"'Space Grotesk'", textAlign:"right" }}>{fmt(rptTotalBal)}</td>
                  <td colSpan={3}></td>
                </tr>
              </tfoot>}
            </table>
          </div>
          {/* Pagination */}
          {invRptData.length > invRptPerPage && <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center", padding:"10px 16px", borderTop:`1px solid ${t.border}`, fontSize:12 }}>
            <span style={{ color:t.textMuted }}>
              {invRptShowAll ? `Showing all ${invRptData.length}` : `Showing ${(invRptPage-1)*invRptPerPage+1}–${Math.min(invRptPage*invRptPerPage, invRptData.length)} of ${invRptData.length}`}
            </span>
            <div style={{ display:"flex", gap:6, alignItems:"center" }}>
              <Btn small disabled={invRptPage<=1} onClick={() => setInvRptPage(p=>p-1)}>Prev</Btn>
              {Array.from({length:Math.min(rptTotalPages,5)},(_, i)=>{
                let pg;
                if(rptTotalPages<=5) pg=i+1;
                else if(invRptPage<=3) pg=i+1;
                else if(invRptPage>=rptTotalPages-2) pg=rptTotalPages-4+i;
                else pg=invRptPage-2+i;
                return <div key={pg} onClick={()=>setInvRptPage(pg)} style={{width:28,height:28,borderRadius:8,display:"flex",alignItems:"center",justifyContent:"center",cursor:"pointer",fontWeight:700,fontSize:12,background:invRptPage===pg?t.accent:"transparent",color:invRptPage===pg?"#fff":t.textMuted}}>{pg}</div>;
              })}
              {rptTotalPages>5 && <span style={{color:t.textMuted}}>... {rptTotalPages}</span>}
              <Btn small disabled={invRptPage>=rptTotalPages} onClick={() => setInvRptPage(p=>p+1)}>Next</Btn>
              <Btn small onClick={() => { setInvRptShowAll(!invRptShowAll); setInvRptPage(1); }}>{invRptShowAll?"Paginate":"Show All"}</Btn>
            </div>
          </div>}
        </Card>
      </div>
    );

    // ═══════════════ SOA VIEW ═══════════════
    if (soaOpen) {
      const soaSubResults = soaSubSearch.length >= 2 ? subscribers.filter(s => {
        const q = soaSubSearch.toLowerCase();
        const name = subDisplayName(s).toLowerCase();
        return name.includes(q) || (s.acct||'').toLowerCase().includes(q);
      }).slice(0, 8) : [];

      // Build SOA data for selected subscriber
      const soaLines = [];
      let soaTotalDebit = 0, soaTotalCredit = 0;
      if (soaSub) {
        const fromIdx = periodIdx(soaFrom); const toIdx = periodIdx(soaTo);
        const validPeriods = periodMonths.slice(Math.min(fromIdx, toIdx), Math.max(fromIdx, toIdx) + 1);
        // Filter: periodic invoices in range + optionally non-periodic ones within the date range
        const fromDate = new Date(soaFrom + ' 1'); const toDate = new Date(new Date(soaTo + ' 1').getFullYear(), new Date(soaTo + ' 1').getMonth() + 1, 0, 23, 59, 59);
        const subInvs = invoices.filter(inv => {
          if (inv.subId !== soaSub.id) return false;
          if (inv.status === 'cancelled') return false;
          // Periodic invoice — match by period name
          if (inv.period && validPeriods.includes(inv.period)) return true;
          // Non-periodic invoice (installation, reconnection, other, or no period) — match by date if toggle is on
          if (soaIncludeAll && (!inv.period || !periodMonths.includes(inv.period))) {
            const invDate = new Date(inv.invoiceDate || inv.dueDate || 0);
            return invDate >= fromDate && invDate <= toDate;
          }
          return false;
        }).sort((a,b) => new Date(a.invoiceDate||a.dueDate) - new Date(b.invoiceDate||b.dueDate));
        subInvs.forEach(inv => {
          const label = inv.period && periodMonths.includes(inv.period) ? inv.period : (inv.period || 'One-time Charge');
          soaLines.push({ date: inv.invoiceDate||inv.dueDate, type:'charge', desc: label+' — '+inv.number, number: inv.number, debit: inv.amount, credit: 0, status: inv.status, isPeriodic: !!(inv.period && periodMonths.includes(inv.period)) });
          if (inv.totalPaid > 0) {
            const methodLabel = inv.method ? ((paymentMethods.find(m=>m.code===inv.method)||{}).name || inv.method) : '';
            const appliedAmt = Math.min(inv.totalPaid, inv.amount);
            soaLines.push({ date: inv.paidAt||inv.dueDate, type:'payment', desc: 'Payment'+(methodLabel?' — '+methodLabel:'')+(inv.number?' for '+inv.number:''), number: inv.number, debit: 0, credit: appliedAmt, status: 'payment', isPeriodic: !!(inv.period && periodMonths.includes(inv.period)) });
          }
        });
        soaLines.sort((a,b) => new Date(a.date) - new Date(b.date));
        let running = 0;
        soaLines.forEach(ln => { running += ln.debit - ln.credit; ln.balance = running; });
        soaTotalDebit = soaLines.reduce((s,l) => s + l.debit, 0);
        soaTotalCredit = soaLines.reduce((s,l) => s + l.credit, 0);
      }
      const soaFinalBalance = soaTotalDebit - soaTotalCredit;

      return (
      <div>
        <div style={{ display:"flex", alignItems:"center", gap:12, marginBottom:20 }}>
          <Btn onClick={() => { setSoaOpen(false); setSoaSub(null); setSoaSubSearch(""); }}><i className="fas fa-arrow-left" style={{marginRight:6}}></i>Back to Reports</Btn>
          <h2 style={{ fontSize:20, fontWeight:800, color:t.text, fontFamily:"'Space Grotesk'", margin:0 }}><i className="fas fa-file-lines" style={{color:t.accent,marginRight:8}}></i>Statement of Account</h2>
        </div>

        {/* Controls */}
        <Card style={{ marginBottom:16, padding:16 }}>
          <div style={{ display:"flex", flexWrap:"wrap", alignItems:"flex-end", gap:14 }}>
            {/* Subscriber search */}
            <div style={{ minWidth:260, position:"relative" }}>
              <label style={{ fontSize:11, fontWeight:600, color:t.textSec, marginBottom:6, display:"block", textTransform:"uppercase", letterSpacing:.4 }}>Subscriber</label>
              {soaSub ? (
                <div style={{ display:"flex", alignItems:"center", gap:8, padding:"8px 12px", background:t.bg, borderRadius:10, border:`1px solid ${t.border}` }}>
                  <div style={{ flex:1 }}>
                    <div style={{ fontWeight:700, color:t.text, fontSize:13 }}>{subDisplayName(soaSub)}</div>
                    <div style={{ fontSize:11, color:t.textMuted }}>{soaSub.acct}</div>
                  </div>
                  <i className="fas fa-times" onClick={() => { setSoaSub(null); setSoaSubSearch(""); }} style={{ cursor:"pointer", color:t.textMuted, fontSize:12 }}></i>
                </div>
              ) : (
                <>
                  <input ref={soaSearchRef} value={soaSubSearch} onChange={e => setSoaSubSearch(e.target.value)} placeholder="Type name or account #..." style={{ width:"100%", padding:"9px 14px", borderRadius:10, border:`1px solid ${t.inputBorder}`, background:t.input, color:t.text, fontSize:13, fontFamily:"inherit", outline:"none", boxSizing:"border-box" }} />
                  {soaSubResults.length > 0 && <div style={{ position:"absolute", top:"100%", left:0, right:0, background:t.bgCard, border:`1px solid ${t.border}`, borderRadius:10, zIndex:10, maxHeight:200, overflowY:"auto", boxShadow:"0 8px 24px rgba(0,0,0,.3)", marginTop:2 }}>
                    {soaSubResults.map(s => (
                      <div key={s.id} onClick={() => { setSoaSub(s); setSoaSubSearch(""); }} style={{ padding:"8px 14px", cursor:"pointer", borderBottom:`1px solid ${t.border}`, fontSize:13 }} onMouseOver={e=>e.currentTarget.style.background="rgba(59,130,246,.1)"} onMouseOut={e=>e.currentTarget.style.background=""}>
                        <div style={{ fontWeight:700, color:t.text }}>{subDisplayName(s)}</div>
                        <div style={{ fontSize:11, color:t.textMuted }}>{s.acct} — {s.planName||''}</div>
                      </div>
                    ))}
                  </div>}
                </>
              )}
            </div>
            <div>
              <label style={{ fontSize:11, fontWeight:600, color:t.textSec, marginBottom:6, display:"block", textTransform:"uppercase", letterSpacing:.4 }}>From Period</label>
              <select value={soaFrom} onChange={e => setSoaFrom(e.target.value)} style={{ padding:"9px 14px", borderRadius:10, border:`1px solid ${t.inputBorder}`, background:t.input, color:t.text, fontSize:13, fontFamily:"inherit", outline:"none", minWidth:170 }}>
                {periodMonths.map(p => <option key={p} value={p}>{p}</option>)}
              </select>
            </div>
            <div>
              <label style={{ fontSize:11, fontWeight:600, color:t.textSec, marginBottom:6, display:"block", textTransform:"uppercase", letterSpacing:.4 }}>To Period</label>
              <select value={soaTo} onChange={e => setSoaTo(e.target.value)} style={{ padding:"9px 14px", borderRadius:10, border:`1px solid ${t.inputBorder}`, background:t.input, color:t.text, fontSize:13, fontFamily:"inherit", outline:"none", minWidth:170 }}>
                {periodMonths.map(p => <option key={p} value={p}>{p}</option>)}
              </select>
            </div>
            {/* Include All toggle */}
            <div style={{ alignSelf:"flex-end" }}>
              <div onClick={() => setSoaIncludeAll(!soaIncludeAll)} style={{ display:"flex", alignItems:"center", gap:8, padding:"9px 14px", borderRadius:10, border:`1px solid ${soaIncludeAll ? t.accent : t.border}`, background: soaIncludeAll ? t.accent+'15' : t.input, cursor:"pointer", transition:"all .2s", whiteSpace:"nowrap" }}>
                <div style={{ width:32, height:18, borderRadius:9, background: soaIncludeAll ? t.accent : t.border, position:"relative", transition:"all .2s" }}>
                  <div style={{ width:14, height:14, borderRadius:7, background:"#fff", position:"absolute", top:2, left: soaIncludeAll ? 16 : 2, transition:"all .2s" }}></div>
                </div>
                <span style={{ fontSize:12, fontWeight:600, color: soaIncludeAll ? t.accent : t.textMuted }}>Include All Invoices</span>
              </div>
            </div>
            <div style={{ display:"flex", gap:8, alignSelf:"flex-end" }}>
              {soaSub && <Btn onClick={() => window.open(`${API}/admin/subscribers/${soaSub.id}/soa-pdf?token=${localStorage.getItem('j2_admin_token')}&from=${encodeURIComponent(soaFrom)}&to=${encodeURIComponent(soaTo)}&includeAll=${soaIncludeAll}`, '_blank')}><i className="fas fa-file-pdf" style={{marginRight:6,color:"#ef4444"}}></i>View PDF</Btn>}
              <Btn onClick={() => window.print()}><i className="fas fa-print" style={{marginRight:6}}></i>Print</Btn>
            </div>
          </div>
        </Card>

        {!soaSub ? (
          <Card style={{ padding:40, textAlign:"center" }}>
            <i className="fas fa-user-circle" style={{ fontSize:48, color:t.textMuted, marginBottom:12 }}></i>
            <div style={{ fontSize:16, fontWeight:700, color:t.text, marginBottom:6 }}>Select a Subscriber</div>
            <div style={{ fontSize:13, color:t.textMuted }}>Search and select a subscriber above to generate their Statement of Account</div>
          </Card>
        ) : (
          <>
            {/* SOA Header Info */}
            <Card style={{ marginBottom:16, padding:16 }}>
              <div style={{ display:"flex", justifyContent:"space-between", flexWrap:"wrap", gap:16 }}>
                <div>
                  <div style={{ fontSize:18, fontWeight:800, color:t.text, fontFamily:"'Space Grotesk'" }}>{subDisplayName(soaSub)}</div>
                  <div style={{ fontSize:12, color:t.textMuted, marginTop:4 }}>Account: {soaSub.acct} {soaSub.planName ? ' | Plan: '+soaSub.planName : ''}</div>
                  <div style={{ fontSize:12, color:t.textMuted }}>{[soaSub.address, soaSub.barangay, soaSub.municipality].filter(Boolean).join(', ')}</div>
                </div>
                <div style={{ textAlign:"right" }}>
                  <div style={{ fontSize:11, color:t.textMuted, textTransform:"uppercase", letterSpacing:.5 }}>Period</div>
                  <div style={{ fontSize:14, fontWeight:700, color:t.accent }}>{soaFrom} — {soaTo}</div>
                  <div style={{ fontSize:22, fontWeight:800, fontFamily:"'Space Grotesk'", color: soaFinalBalance > 0 ? t.danger : t.success, marginTop:4 }}>
                    {soaFinalBalance > 0 ? 'Balance Due: ' : 'Settled: '}{fmt(Math.abs(soaFinalBalance))}
                  </div>
                </div>
              </div>
            </Card>

            {/* KPIs */}
            <div style={{ display:"grid", gridTemplateColumns:"repeat(auto-fit, minmax(140px, 1fr))", gap:12, marginBottom:16 }}>
              {[
                { label:"Total Charges", value:fmt(soaTotalDebit), color:t.text, icon:"fa-file-invoice" },
                { label:"Total Payments", value:fmt(soaTotalCredit), color:t.success, icon:"fa-circle-check" },
                { label:"Balance", value:fmt(soaFinalBalance), color:soaFinalBalance>0?t.danger:t.success, icon:"fa-scale-balanced" },
                { label:"Transactions", value:soaLines.length, color:t.accent, icon:"fa-list" },
              ].map(s => (
                <div key={s.label} style={{ background:t.bgCard, borderRadius:12, border:`1px solid ${t.border}`, padding:"14px 16px" }}>
                  <div style={{ fontSize:10, fontWeight:600, color:t.textMuted, textTransform:"uppercase", letterSpacing:.5, marginBottom:4 }}><_Icon name={s.icon} /> {s.label}</div>
                  <div style={{ fontSize:20, fontWeight:800, color:s.color, fontFamily:"'Space Grotesk'" }}>{s.value}</div>
                </div>
              ))}
            </div>

            {/* SOA Table */}
            <Card style={{ padding:0, overflow:"hidden" }}>
              <div style={{ overflowX:"auto" }}>
                <table style={{ width:"100%", borderCollapse:"collapse", fontSize:13 }}>
                  <thead>
                    <tr style={{ background:t.bgCard, borderBottom:`2px solid ${t.border}` }}>
                      {["Date","Description","Invoice #","Charges (Debit)","Payments (Credit)","Running Balance"].map(h => (
                        <th key={h} style={{ padding:"10px 12px", textAlign: h.includes("Charges")||h.includes("Payments")||h.includes("Balance") ? "right":"left", fontSize:11, fontWeight:700, color:t.textMuted, textTransform:"uppercase", letterSpacing:.4, whiteSpace:"nowrap" }}>{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {soaLines.length === 0 && <tr><td colSpan={6} style={{ padding:40, textAlign:"center", color:t.textMuted }}>No transactions for this period</td></tr>}
                    {soaLines.map((ln, idx) => (
                      <tr key={idx} style={{ borderBottom:`1px solid ${t.border}`, background: ln.type==='payment' ? `${t.success}08` : 'transparent' }}>
                        <td style={{ padding:"10px 12px", fontSize:12, color:t.textSec, whiteSpace:"nowrap" }}>{ln.date ? new Date(ln.date).toLocaleDateString("en-US",{month:"short",day:"numeric",year:"numeric"}) : "—"}</td>
                        <td style={{ padding:"10px 12px", fontWeight:600, color: ln.type==='payment' ? t.success : t.text, fontSize:12 }}>{ln.type==='payment' ? <><i className="fas fa-arrow-down" style={{marginRight:4,fontSize:10}}></i>{ln.desc}</> : <>{!ln.isPeriodic && <span style={{display:"inline-block",padding:"1px 6px",borderRadius:4,background:`${t.warning}20`,color:t.warning,fontSize:9,fontWeight:700,marginRight:6,verticalAlign:"middle"}}>ONE-TIME</span>}{ln.desc}</>}</td>
                        <td style={{ padding:"10px 12px", fontFamily:"monospace", fontSize:12, color:t.accent, cursor:"pointer" }} onClick={() => { const inv = invoices.find(i=>i.number===ln.number); if(inv) openInvoiceDetail(inv.id); }}>{ln.number||"—"}</td>
                        <td style={{ padding:"10px 12px", fontWeight:700, color:t.text, fontFamily:"'Space Grotesk'", textAlign:"right" }}>{ln.debit > 0 ? fmt(ln.debit) : ""}</td>
                        <td style={{ padding:"10px 12px", fontWeight:700, color:t.success, fontFamily:"'Space Grotesk'", textAlign:"right" }}>{ln.credit > 0 ? fmt(ln.credit) : ""}</td>
                        <td style={{ padding:"10px 12px", fontWeight:800, color: ln.balance > 0 ? t.danger : t.success, fontFamily:"'Space Grotesk'", textAlign:"right" }}>{fmt(ln.balance)}</td>
                      </tr>
                    ))}
                  </tbody>
                  {soaLines.length > 0 && <tfoot>
                    <tr style={{ background:t.bgCard, borderTop:`2px solid ${t.border}` }}>
                      <td colSpan={3} style={{ padding:"10px 12px", fontWeight:700, color:t.text, fontSize:12 }}>TOTALS</td>
                      <td style={{ padding:"10px 12px", fontWeight:800, color:t.text, fontFamily:"'Space Grotesk'", textAlign:"right" }}>{fmt(soaTotalDebit)}</td>
                      <td style={{ padding:"10px 12px", fontWeight:800, color:t.success, fontFamily:"'Space Grotesk'", textAlign:"right" }}>{fmt(soaTotalCredit)}</td>
                      <td style={{ padding:"10px 12px", fontWeight:800, color:soaFinalBalance>0?t.danger:t.success, fontFamily:"'Space Grotesk'", textAlign:"right", fontSize:14 }}>{fmt(soaFinalBalance)}</td>
                    </tr>
                  </tfoot>}
                </table>
              </div>
            </Card>

            {/* Balance Summary */}
            <div style={{ marginTop:16, padding:"16px 20px", borderRadius:12, background: soaFinalBalance <= 0 ? `${t.success}12` : `${t.danger}12`, border: `1px solid ${soaFinalBalance <= 0 ? t.success : t.danger}30` }}>
              <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center" }}>
                <div>
                  <div style={{ fontSize:14, fontWeight:800, color: soaFinalBalance <= 0 ? t.success : t.danger }}>
                    {soaFinalBalance <= 0 ? <><i className="fas fa-circle-check" style={{marginRight:6}}></i>Account Current — No Balance Due</> : <><i className="fas fa-triangle-exclamation" style={{marginRight:6}}></i>Outstanding Balance</>}
                  </div>
                  <div style={{ fontSize:12, color:t.textMuted, marginTop:4 }}>{soaFinalBalance <= 0 ? 'All invoices settled for this period.' : 'Please settle the outstanding amount.'}</div>
                </div>
                <div style={{ fontSize:24, fontWeight:800, color: soaFinalBalance <= 0 ? t.success : t.danger, fontFamily:"'Space Grotesk'" }}>{fmt(Math.abs(soaFinalBalance))}</div>
              </div>
            </div>
          </>
        )}
      </div>);
    }

    // ═══════════════ COLLECTION REPORT VIEW ═══════════════
    if (collRptOpen) {
      const fromIdx2 = periodIdx(collRptFrom); const toIdx2 = periodIdx(collRptTo);
      const collPeriods = periodMonths.slice(Math.min(fromIdx2, toIdx2), Math.max(fromIdx2, toIdx2) + 1);
      // Bucket by invoiceDate (or dueDate fallback) — billing_period
      // free-text values like "subscription" / "installation" don't
      // line up with calendar months otherwise.
      const _monthKeyOf = (inv) => {
        const d = inv.invoiceDate || inv.dueDate;
        if (d) { const dt = new Date(d); if (!isNaN(dt)) return dt.toLocaleString("en-US",{month:"long",year:"numeric"}); }
        return inv.period || null;
      };
      let collInvs = invoices.filter(inv => { const k = _monthKeyOf(inv); return k && collPeriods.includes(k); });
      if (collRptSearch) {
        const q = collRptSearch.toLowerCase();
        collInvs = collInvs.filter(inv => {
          const sub = getSub(inv.subId);
          const name = sub.firstName ? (sub.firstName+(sub.middleName?' '+sub.middleName:'')+' '+sub.lastName).toLowerCase() : (inv.subName||'').toLowerCase();
          return inv.number?.toLowerCase().includes(q) || name.includes(q) || (sub.acct||inv.subAcct||'').toLowerCase().includes(q);
        });
      }
      // Group by subscriber for collection summary
      const collByStatus = { paid:0, partial:0, pending:0, overdue:0, cancelled:0 };
      collInvs.forEach(inv => { collByStatus[inv.status] = (collByStatus[inv.status]||0) + 1; });
      const collTotalAmt = collInvs.reduce((s,i) => s + i.amount, 0);
      const collTotalPaid = collInvs.reduce((s,i) => s + (i.totalPaid||0), 0);
      const collTotalBal = collInvs.reduce((s,i) => s + Math.max(0, i.balance||0), 0);
      const collRate = collTotalAmt > 0 ? Math.round(collTotalPaid / collTotalAmt * 100) : 0;
      const collTotalPages = Math.ceil(collInvs.length / collRptPerPage);
      const collPaged = collRptShowAll ? collInvs : collInvs.slice((collRptPage-1)*collRptPerPage, collRptPage*collRptPerPage);

      // Aging analysis
      const now = new Date();
      const aging = { current:0, d30:0, d60:0, d90:0, over90:0 };
      collInvs.filter(i => i.status==='pending'||i.status==='overdue').forEach(inv => {
        const due = new Date(inv.dueDate);
        const days = Math.floor((now - due) / 86400000);
        const bal = Math.max(0, inv.balance||0);
        if (days <= 0) aging.current += bal;
        else if (days <= 30) aging.d30 += bal;
        else if (days <= 60) aging.d60 += bal;
        else if (days <= 90) aging.d90 += bal;
        else aging.over90 += bal;
      });

      return (
      <div>
        <div style={{ display:"flex", alignItems:"center", gap:12, marginBottom:20 }}>
          <Btn onClick={() => setCollRptOpen(false)}><i className="fas fa-arrow-left" style={{marginRight:6}}></i>Back to Reports</Btn>
          <h2 style={{ fontSize:20, fontWeight:800, color:t.text, fontFamily:"'Space Grotesk'", margin:0 }}><i className="fas fa-hand-holding-dollar" style={{color:t.success,marginRight:8}}></i>Collection Report</h2>
        </div>

        {/* Controls */}
        <Card style={{ marginBottom:16, padding:16 }}>
          {/* Quick period presets */}
          {(() => {
            const fmtMon = (d) => d.toLocaleString("en-US",{month:"long",year:"numeric"});
            const today = new Date();
            const startOfYear = new Date(today.getFullYear(), 0, 1);
            const lastMonth = new Date(today.getFullYear(), today.getMonth()-1, 1);
            const qStart = new Date(today.getFullYear(), Math.floor(today.getMonth()/3)*3, 1);
            const lastQEnd = new Date(today.getFullYear(), Math.floor(today.getMonth()/3)*3 - 1, 1);
            const lastQStart = new Date(lastQEnd.getFullYear(), Math.floor(lastQEnd.getMonth()/3)*3, 1);
            const sixMonthsAgo = new Date(today.getFullYear(), today.getMonth()-5, 1);
            const presets = [
              { label:"Current Month",  from: fmtMon(today),       to: fmtMon(today) },
              { label:"Last Month",     from: fmtMon(lastMonth),   to: fmtMon(lastMonth) },
              { label:"This Quarter",   from: fmtMon(qStart),      to: fmtMon(today) },
              { label:"Last Quarter",   from: fmtMon(lastQStart),  to: fmtMon(lastQEnd) },
              { label:"Last 6 Months",  from: fmtMon(sixMonthsAgo),to: fmtMon(today) },
              { label:"Year to Date",   from: fmtMon(startOfYear), to: fmtMon(today) },
              { label:"All",            from: periodMonths[0],     to: periodMonths[periodMonths.length-1] },
            ];
            const isActive = (p) => collRptFrom === p.from && collRptTo === p.to;
            return (
              <div style={{ display:"flex", flexWrap:"wrap", gap:6, marginBottom:14 }}>
                <span style={{ fontSize:11, fontWeight:600, color:t.textMuted, textTransform:"uppercase", letterSpacing:.4, alignSelf:"center", marginRight:4 }}>Quick:</span>
                {presets.map(p => {
                  const valid = periodMonths.includes(p.from) && periodMonths.includes(p.to);
                  if (!valid) return null;
                  const active = isActive(p);
                  return (
                    <button key={p.label} onClick={() => { setCollRptFrom(p.from); setCollRptTo(p.to); setCollRptPage(1); }} style={{ padding:"5px 12px", borderRadius:16, border:`1px solid ${active?t.success:t.border}`, background:active?`${t.success}18`:t.bgCard, color:active?t.success:t.textSec, fontSize:11, fontWeight:600, cursor:"pointer", fontFamily:"inherit", transition:"all .15s" }}
                      onMouseEnter={e=>{if(!active){e.currentTarget.style.borderColor=t.success;e.currentTarget.style.color=t.success;}}}
                      onMouseLeave={e=>{if(!active){e.currentTarget.style.borderColor=t.border;e.currentTarget.style.color=t.textSec;}}}>
                      {active && <i className="fas fa-check" style={{marginRight:5,fontSize:9}}></i>}{p.label}
                    </button>
                  );
                })}
              </div>
            );
          })()}
          <div style={{ display:"flex", flexWrap:"wrap", alignItems:"flex-end", gap:14 }}>
            <div>
              <label style={{ fontSize:11, fontWeight:600, color:t.textSec, marginBottom:6, display:"block", textTransform:"uppercase", letterSpacing:.4 }}>From Period</label>
              <select value={collRptFrom} onChange={e => { setCollRptFrom(e.target.value); setCollRptPage(1); }} style={{ padding:"9px 14px", borderRadius:10, border:`1px solid ${t.inputBorder}`, background:t.input, color:t.text, fontSize:13, fontFamily:"inherit", outline:"none", minWidth:170 }}>
                {periodMonths.map(p => <option key={p} value={p}>{p}</option>)}
              </select>
            </div>
            <div>
              <label style={{ fontSize:11, fontWeight:600, color:t.textSec, marginBottom:6, display:"block", textTransform:"uppercase", letterSpacing:.4 }}>To Period</label>
              <select value={collRptTo} onChange={e => { setCollRptTo(e.target.value); setCollRptPage(1); }} style={{ padding:"9px 14px", borderRadius:10, border:`1px solid ${t.inputBorder}`, background:t.input, color:t.text, fontSize:13, fontFamily:"inherit", outline:"none", minWidth:170 }}>
                {periodMonths.map(p => <option key={p} value={p}>{p}</option>)}
              </select>
            </div>
            <div style={{ flex:1, minWidth:200 }}>
              <label style={{ fontSize:11, fontWeight:600, color:t.textSec, marginBottom:6, display:"block", textTransform:"uppercase", letterSpacing:.4 }}>Search</label>
              <div style={{ position:"relative" }}>
                <i className="fas fa-search" style={{ position:"absolute", left:12, top:"50%", transform:"translateY(-50%)", color:t.textMuted, fontSize:12 }}></i>
                <input ref={collSearchRef} value={collRptSearch} onChange={e => { setCollRptSearch(e.target.value); setCollRptPage(1); }} placeholder="Invoice #, name, account..." style={{ width:"100%", padding:"9px 12px 9px 34px", borderRadius:10, border:`1px solid ${t.inputBorder}`, background:t.input, color:t.text, fontSize:13, fontFamily:"inherit", outline:"none", boxSizing:"border-box" }} />
              </div>
            </div>
            <Btn onClick={() => window.print()} style={{ alignSelf:"flex-end" }}><i className="fas fa-print" style={{marginRight:6}}></i>Print</Btn>
          </div>
        </Card>

        {/* Collection Rate KPIs */}
        <div style={{ display:"grid", gridTemplateColumns:"repeat(auto-fit, minmax(130px, 1fr))", gap:12, marginBottom:16 }}>
          {[
            { label:"Collection Rate", value:collRate+"%", color:collRate>=80?t.success:collRate>=50?t.warning:t.danger, icon:"fa-percent" },
            { label:"Total Billed", value:fmt(collTotalAmt), color:t.text, icon:"fa-file-invoice" },
            { label:"Collected", value:fmt(collTotalPaid), color:t.success, icon:"fa-circle-check" },
            { label:"Outstanding", value:fmt(collTotalBal), color:t.danger, icon:"fa-clock" },
            { label:"Paid", value:collByStatus.paid||0, color:t.success, icon:"fa-check" },
            { label:"Partial", value:collByStatus.partial||0, color:"#f59e0b", icon:"fa-adjust" },
            { label:"Pending", value:collByStatus.pending||0, color:t.warning, icon:"fa-hourglass-half" },
            { label:"Overdue", value:collByStatus.overdue||0, color:t.danger, icon:"fa-triangle-exclamation" },
          ].map(s => (
            <div key={s.label} style={{ background:t.bgCard, borderRadius:12, border:`1px solid ${t.border}`, padding:"12px 14px" }}>
              <div style={{ fontSize:10, fontWeight:600, color:t.textMuted, textTransform:"uppercase", letterSpacing:.5, marginBottom:3 }}><_Icon name={s.icon} /> {s.label}</div>
              <div style={{ fontSize:18, fontWeight:800, color:s.color, fontFamily:"'Space Grotesk'" }}>{s.value}</div>
            </div>
          ))}
        </div>

        {/* Aging Analysis */}
        <Card style={{ marginBottom:16, padding:16 }}>
          <h3 style={{ fontSize:14, fontWeight:700, color:t.text, marginBottom:12 }}><i className="fas fa-hourglass-half" style={{color:t.warning,marginRight:6}}></i>Receivables Aging Analysis</h3>
          <div style={{ display:"grid", gridTemplateColumns:"repeat(5, 1fr)", gap:10 }}>
            {[
              { label:"Current", value:aging.current, color:t.success },
              { label:"1-30 Days", value:aging.d30, color:"#f59e0b" },
              { label:"31-60 Days", value:aging.d60, color:t.warning },
              { label:"61-90 Days", value:aging.d90, color:"#f97316" },
              { label:"90+ Days", value:aging.over90, color:t.danger },
            ].map(a => (
              <div key={a.label} style={{ textAlign:"center", padding:"12px 8px", borderRadius:10, background:`${a.color}10`, border:`1px solid ${a.color}25` }}>
                <div style={{ fontSize:10, fontWeight:600, color:t.textMuted, textTransform:"uppercase", marginBottom:4 }}>{a.label}</div>
                <div style={{ fontSize:16, fontWeight:800, color:a.color, fontFamily:"'Space Grotesk'" }}>{fmt(a.value)}</div>
              </div>
            ))}
          </div>
        </Card>

        {/* Collection Table */}
        <Card style={{ padding:0, overflow:"hidden" }}>
          <div style={{ overflowX:"auto", overflowY: collRptShowAll ? "auto" : "visible", maxHeight: collRptShowAll ? 560 : "none" }}>
            <table style={{ width:"100%", borderCollapse:"collapse", fontSize:13 }}>
              <thead>
                <tr style={{ background:t.bgCard, borderBottom:`2px solid ${t.border}` }}>
                  {["Invoice #","Subscriber","Account","Period","Billed","Paid","Balance","Status","Due Date","Days Overdue"].map(h => (
                    <th key={h} style={{ padding:"10px 12px", textAlign: ["Billed","Paid","Balance","Days Overdue"].includes(h)?"right":"left", fontSize:11, fontWeight:700, color:t.textMuted, textTransform:"uppercase", letterSpacing:.4, whiteSpace:"nowrap" }}>{h}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {collPaged.length === 0 && <tr><td colSpan={10} style={{ padding:40, textAlign:"center", color:t.textMuted }}>No invoices found</td></tr>}
                {collPaged.map(inv => {
                  const sub = getSub(inv.subId);
                  const subName = sub.firstName ? (sub.firstName+(sub.middleName?' '+sub.middleName+' ':' ')+sub.lastName) : (inv.subName||'—');
                  const daysOver = (inv.status==='pending'||inv.status==='overdue') && inv.dueDate ? Math.max(0, Math.floor((new Date()-new Date(inv.dueDate))/86400000)) : 0;
                  return (
                    <tr key={inv.id} style={{ borderBottom:`1px solid ${t.border}` }}>
                      <td style={{ padding:"10px 12px", fontFamily:"monospace", fontSize:12, fontWeight:600, color:t.accent, cursor:"pointer" }} onClick={() => openInvoiceDetail(inv.id)}>{inv.number}</td>
                      <td style={{ padding:"10px 12px", fontWeight:600, color:t.text, maxWidth:160, overflow:"hidden", textOverflow:"ellipsis", whiteSpace:"nowrap", fontSize:12 }}>{subName}</td>
                      <td style={{ padding:"10px 12px", fontSize:12, color:t.textSec, fontFamily:"monospace" }}>{sub.acct||inv.subAcct||'—'}</td>
                      <td style={{ padding:"10px 12px", fontSize:12, color:t.textSec }}>{inv.period||'—'}</td>
                      <td style={{ padding:"10px 12px", fontWeight:700, color:t.text, fontFamily:"'Space Grotesk'", textAlign:"right" }}>{fmt(inv.amount)}</td>
                      <td style={{ padding:"10px 12px", fontWeight:600, color:t.success, fontFamily:"'Space Grotesk'", textAlign:"right" }}>{inv.totalPaid>0?fmt(inv.totalPaid):'—'}</td>
                      <td style={{ padding:"10px 12px", fontWeight:700, color:inv.balance>0?t.danger:t.success, fontFamily:"'Space Grotesk'", textAlign:"right" }}>{inv.status==='cancelled'?'—':inv.balance>0?fmt(inv.balance):'₱0.00'}</td>
                      <td style={{ padding:"10px 12px" }}><Badge color={statusColor(inv.status)} label={inv.status} /></td>
                      <td style={{ padding:"10px 12px", fontSize:12, color:t.textSec, whiteSpace:"nowrap" }}>{inv.dueDate?new Date(inv.dueDate).toLocaleDateString("en-US",{month:"short",day:"numeric",year:"numeric"}):'—'}</td>
                      <td style={{ padding:"10px 12px", fontWeight:700, textAlign:"right", color: daysOver>60?t.danger:daysOver>30?"#f59e0b":daysOver>0?t.warning:t.textMuted, fontFamily:"'Space Grotesk'" }}>{daysOver>0?daysOver+'d':'—'}</td>
                    </tr>
                  );
                })}
              </tbody>
              {collPaged.length > 0 && <tfoot>
                <tr style={{ background:t.bgCard, borderTop:`2px solid ${t.border}` }}>
                  <td colSpan={4} style={{ padding:"10px 12px", fontWeight:700, color:t.text, fontSize:12 }}>TOTALS ({collInvs.length} invoices) — Collection Rate: {collRate}%</td>
                  <td style={{ padding:"10px 12px", fontWeight:800, color:t.text, fontFamily:"'Space Grotesk'", textAlign:"right" }}>{fmt(collTotalAmt)}</td>
                  <td style={{ padding:"10px 12px", fontWeight:800, color:t.success, fontFamily:"'Space Grotesk'", textAlign:"right" }}>{fmt(collTotalPaid)}</td>
                  <td style={{ padding:"10px 12px", fontWeight:800, color:t.danger, fontFamily:"'Space Grotesk'", textAlign:"right" }}>{fmt(collTotalBal)}</td>
                  <td colSpan={3}></td>
                </tr>
              </tfoot>}
            </table>
          </div>
          {collInvs.length > collRptPerPage && <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center", padding:"10px 16px", borderTop:`1px solid ${t.border}`, fontSize:12 }}>
            <span style={{ color:t.textMuted }}>{collRptShowAll ? `Showing all ${collInvs.length}` : `Showing ${(collRptPage-1)*collRptPerPage+1}–${Math.min(collRptPage*collRptPerPage, collInvs.length)} of ${collInvs.length}`}</span>
            <div style={{ display:"flex", gap:6, alignItems:"center" }}>
              <Btn small disabled={collRptPage<=1} onClick={() => setCollRptPage(p=>p-1)}>Prev</Btn>
              {Array.from({length:Math.min(collTotalPages,5)},(_, i)=>{
                let pg; if(collTotalPages<=5) pg=i+1; else if(collRptPage<=3) pg=i+1; else if(collRptPage>=collTotalPages-2) pg=collTotalPages-4+i; else pg=collRptPage-2+i;
                return <div key={pg} onClick={()=>setCollRptPage(pg)} style={{width:28,height:28,borderRadius:8,display:"flex",alignItems:"center",justifyContent:"center",cursor:"pointer",fontWeight:700,fontSize:12,background:collRptPage===pg?t.accent:"transparent",color:collRptPage===pg?"#fff":t.textMuted}}>{pg}</div>;
              })}
              {collTotalPages>5 && <span style={{color:t.textMuted}}>... {collTotalPages}</span>}
              <Btn small disabled={collRptPage>=collTotalPages} onClick={() => setCollRptPage(p=>p+1)}>Next</Btn>
              <Btn small onClick={() => { setCollRptShowAll(!collRptShowAll); setCollRptPage(1); }}>{collRptShowAll?"Paginate":"Show All"}</Btn>
            </div>
          </div>}
        </Card>
      </div>);
    }

    // ═══════════════ FOR COLLECTION LIST VIEW ═══════════════
    if (forColOpen) {
      const nowMs = Date.now();
      const dayMs = 86400000;
      // Aggregate outstanding invoices by subscriber
      const bySub = {};
      invoices.forEach(inv => {
        if (inv.status === 'paid' || inv.status === 'cancelled') return;
        const bal = Number(inv.balance) || 0;
        if (bal <= 0) return;
        const sub = getSub(inv.subId);
        if (!sub.id) return;
        if (!bySub[sub.id]) {
          bySub[sub.id] = {
            subId: sub.id,
            sub: sub,
            invoices: [],
            totalBal: 0,
            oldestDue: null,
            maxDaysOverdue: 0,
            aging: { current:0, d30:0, d60:0, d90:0, over90:0 },
          };
        }
        const entry = bySub[sub.id];
        entry.invoices.push(inv);
        entry.totalBal += bal;
        const due = inv.dueDate ? new Date(inv.dueDate) : null;
        const days = due ? Math.floor((nowMs - due.getTime()) / dayMs) : 0;
        if (due && (!entry.oldestDue || due < entry.oldestDue)) entry.oldestDue = due;
        if (days > entry.maxDaysOverdue) entry.maxDaysOverdue = days;
        if (days <= 0) entry.aging.current += bal;
        else if (days <= 30) entry.aging.d30 += bal;
        else if (days <= 60) entry.aging.d60 += bal;
        else if (days <= 90) entry.aging.d90 += bal;
        else entry.aging.over90 += bal;
      });

      let rows = Object.values(bySub);

      // Aging filter
      const ageFilter = forColAgeFilter;
      if (ageFilter !== 'all') {
        rows = rows.filter(r => {
          const d = r.maxDaysOverdue;
          if (ageFilter === 'overdue') return d > 0;
          if (ageFilter === '1-30') return d > 0 && d <= 30;
          if (ageFilter === '31-60') return d > 30 && d <= 60;
          if (ageFilter === '61-90') return d > 60 && d <= 90;
          if (ageFilter === '90+') return d > 90;
          return true;
        });
      }
      // Municipality / barangay filter
      if (forColMuni !== 'all') rows = rows.filter(r => (r.sub.municipality||'') === forColMuni);
      if (forColBrgy !== 'all') rows = rows.filter(r => (r.sub.barangay||'') === forColBrgy);
      // Min balance filter
      const minBal = parseFloat(forColMinBal);
      if (!isNaN(minBal) && minBal > 0) rows = rows.filter(r => r.totalBal >= minBal);
      // Search filter
      const fq = (forColSearch||'').trim().toLowerCase();
      if (fq) {
        rows = rows.filter(r => {
          const name = (r.sub.firstName||'') + ' ' + (r.sub.middleName||'') + ' ' + (r.sub.lastName||'') + ' ' + (r.sub.companyName||'');
          const hay = (name + ' ' + (r.sub.acct||'') + ' ' + (r.sub.phone||'') + ' ' + (r.sub.email||'') + ' ' + (r.sub.address||'')).toLowerCase();
          return hay.includes(fq);
        });
      }

      // Sort
      if (forColSort === 'oldest') rows.sort((a,b) => b.maxDaysOverdue - a.maxDaysOverdue);
      else if (forColSort === 'amount') rows.sort((a,b) => b.totalBal - a.totalBal);
      else if (forColSort === 'name') rows.sort((a,b) => {
        const an = (a.sub.lastName||a.sub.companyName||'').toLowerCase();
        const bn = (b.sub.lastName||b.sub.companyName||'').toLowerCase();
        return an.localeCompare(bn);
      });

      // Totals + buckets across the filtered set
      const totSubs = rows.length;
      const totBal = rows.reduce((s,r) => s + r.totalBal, 0);
      const totInvs = rows.reduce((s,r) => s + r.invoices.length, 0);
      const buckets = { current:0, d30:0, d60:0, d90:0, over90:0 };
      rows.forEach(r => { buckets.current += r.aging.current; buckets.d30 += r.aging.d30; buckets.d60 += r.aging.d60; buckets.d90 += r.aging.d90; buckets.over90 += r.aging.over90; });

      // Municipality + barangay options derived from the data
      const muniSet = new Set();
      const brgySet = new Set();
      Object.values(bySub).forEach(r => {
        if (r.sub.municipality) muniSet.add(r.sub.municipality);
        if ((forColMuni === 'all' || r.sub.municipality === forColMuni) && r.sub.barangay) brgySet.add(r.sub.barangay);
      });
      const muniOpts = Array.from(muniSet).sort();
      const brgyOpts = Array.from(brgySet).sort();

      // Pagination
      const fcTotalPages = Math.max(1, Math.ceil(rows.length / forColPerPage));
      const fcPaged = forColShowAll ? rows : rows.slice((forColPage-1)*forColPerPage, forColPage*forColPerPage);

      const ageColor = (d) => d > 90 ? t.danger : d > 60 ? '#f97316' : d > 30 ? t.warning : d > 0 ? '#f59e0b' : t.success;

      return (
      <div>
        <div style={{ display:"flex", alignItems:"center", gap:12, marginBottom:20 }}>
          <Btn onClick={() => setForColOpen(false)}><i className="fas fa-arrow-left" style={{marginRight:6}}></i>Back to Reports</Btn>
          <h2 style={{ fontSize:20, fontWeight:800, color:t.text, fontFamily:"'Space Grotesk'", margin:0 }}><i className="fas fa-list-check" style={{color:t.danger,marginRight:8}}></i>For Collection List</h2>
        </div>

        {/* Filters */}
        <Card style={{ marginBottom:16, padding:16 }}>
          <div style={{ display:"flex", flexWrap:"wrap", gap:6, marginBottom:14 }}>
            <span style={{ fontSize:11, fontWeight:600, color:t.textMuted, textTransform:"uppercase", letterSpacing:.4, alignSelf:"center", marginRight:4 }}>Aging:</span>
            {[
              { k:'all',     label:'All Outstanding' },
              { k:'overdue', label:'Overdue Only' },
              { k:'1-30',    label:'1–30 Days' },
              { k:'31-60',   label:'31–60 Days' },
              { k:'61-90',   label:'61–90 Days' },
              { k:'90+',     label:'90+ Days' },
            ].map(p => {
              const active = forColAgeFilter === p.k;
              return (
                <button key={p.k} onClick={() => { setForColAgeFilter(p.k); setForColPage(1); }} style={{ padding:"5px 12px", borderRadius:16, border:`1px solid ${active?t.danger:t.border}`, background:active?`${t.danger}18`:t.bgCard, color:active?t.danger:t.textSec, fontSize:11, fontWeight:600, cursor:"pointer", fontFamily:"inherit", transition:"all .15s" }}>
                  {active && <i className="fas fa-check" style={{marginRight:5,fontSize:9}}></i>}{p.label}
                </button>
              );
            })}
          </div>
          <div style={{ display:"flex", flexWrap:"wrap", alignItems:"flex-end", gap:14 }}>
            <div>
              <label style={{ fontSize:11, fontWeight:600, color:t.textSec, marginBottom:6, display:"block", textTransform:"uppercase", letterSpacing:.4 }}>Municipality</label>
              <select value={forColMuni} onChange={e => { setForColMuni(e.target.value); setForColBrgy('all'); setForColPage(1); }} style={{ padding:"9px 14px", borderRadius:10, border:`1px solid ${t.inputBorder}`, background:t.input, color:t.text, fontSize:13, fontFamily:"inherit", outline:"none", minWidth:160 }}>
                <option value="all">All</option>
                {muniOpts.map(m => <option key={m} value={m}>{m}</option>)}
              </select>
            </div>
            <div>
              <label style={{ fontSize:11, fontWeight:600, color:t.textSec, marginBottom:6, display:"block", textTransform:"uppercase", letterSpacing:.4 }}>Barangay</label>
              <select value={forColBrgy} onChange={e => { setForColBrgy(e.target.value); setForColPage(1); }} style={{ padding:"9px 14px", borderRadius:10, border:`1px solid ${t.inputBorder}`, background:t.input, color:t.text, fontSize:13, fontFamily:"inherit", outline:"none", minWidth:160 }}>
                <option value="all">All</option>
                {brgyOpts.map(b => <option key={b} value={b}>{b}</option>)}
              </select>
            </div>
            <div>
              <label style={{ fontSize:11, fontWeight:600, color:t.textSec, marginBottom:6, display:"block", textTransform:"uppercase", letterSpacing:.4 }}>Min Balance</label>
              <input type="number" value={forColMinBal} onChange={e => { setForColMinBal(e.target.value); setForColPage(1); }} placeholder="0" style={{ padding:"9px 14px", borderRadius:10, border:`1px solid ${t.inputBorder}`, background:t.input, color:t.text, fontSize:13, fontFamily:"inherit", outline:"none", width:110 }} />
            </div>
            <div>
              <label style={{ fontSize:11, fontWeight:600, color:t.textSec, marginBottom:6, display:"block", textTransform:"uppercase", letterSpacing:.4 }}>Sort</label>
              <select value={forColSort} onChange={e => setForColSort(e.target.value)} style={{ padding:"9px 14px", borderRadius:10, border:`1px solid ${t.inputBorder}`, background:t.input, color:t.text, fontSize:13, fontFamily:"inherit", outline:"none", minWidth:160 }}>
                <option value="oldest">Days Overdue (desc)</option>
                <option value="amount">Balance (desc)</option>
                <option value="name">Last Name (A→Z)</option>
              </select>
            </div>
            <div style={{ flex:1, minWidth:200 }}>
              <label style={{ fontSize:11, fontWeight:600, color:t.textSec, marginBottom:6, display:"block", textTransform:"uppercase", letterSpacing:.4 }}>Search</label>
              <div style={{ position:"relative" }}>
                <i className="fas fa-search" style={{ position:"absolute", left:12, top:"50%", transform:"translateY(-50%)", color:t.textMuted, fontSize:12 }}></i>
                <input ref={forColSearchRef} value={forColSearch} onChange={e => { setForColSearch(e.target.value); setForColPage(1); }} placeholder="Name, account, phone, address..." style={{ width:"100%", padding:"9px 12px 9px 34px", borderRadius:10, border:`1px solid ${t.inputBorder}`, background:t.input, color:t.text, fontSize:13, fontFamily:"inherit", outline:"none", boxSizing:"border-box" }} />
              </div>
            </div>
            <Btn onClick={() => window.print()} style={{ alignSelf:"flex-end" }}><i className="fas fa-print" style={{marginRight:6}}></i>Print</Btn>
            <Btn onClick={() => {
              const headers = ['Account','Name','Company','Phone','Alt Phones','Email','Address','Barangay','Municipality','Invoices','Total Balance','Oldest Due','Max Days Overdue','Bucket'];
              const csvRows = rows.map(r => {
                const s = r.sub;
                const name = s.firstName ? (s.firstName + (s.middleName?' '+s.middleName:'') + ' ' + s.lastName) : '';
                const altPh = (s.altContacts||[]).map(c => (c.name?c.name+': ':'') + formatPhone(c.phone||'')).join(' | ');
                const d = r.maxDaysOverdue;
                const bucket = d <= 0 ? 'Current' : d <= 30 ? '1-30' : d <= 60 ? '31-60' : d <= 90 ? '61-90' : '90+';
                return [s.acct||'', name, s.companyName||'', formatPhone(s.phone||''), altPh, s.email||'', s.address||'', s.barangay||'', s.municipality||'', r.invoices.length, r.totalBal.toFixed(2), r.oldestDue?r.oldestDue.toLocaleDateString('en-US'):'', d, bucket];
              });
              const csv = [headers, ...csvRows].map(rr => rr.map(c => `"${String(c).replace(/"/g,'""')}"`).join(',')).join('\n');
              const blob = new Blob([csv], {type:'text/csv;charset=utf-8'});
              const url = URL.createObjectURL(blob);
              const a = document.createElement('a');
              a.href = url; a.download = `for-collection-${new Date().toISOString().substring(0,10)}.csv`;
              document.body.appendChild(a); a.click(); document.body.removeChild(a);
              URL.revokeObjectURL(url);
            }} style={{ alignSelf:"flex-end" }}><i className="fas fa-file-csv" style={{marginRight:6}}></i>CSV</Btn>
          </div>
        </Card>

        {/* KPIs */}
        <div style={{ display:"grid", gridTemplateColumns:"repeat(auto-fit, minmax(160px, 1fr))", gap:12, marginBottom:16 }}>
          {[
            { label:"Total Outstanding", value:fmt(totBal), color:t.danger, icon:"fa-coins" },
            { label:"Subscribers", value:totSubs, color:t.text, icon:"fa-users" },
            { label:"Open Invoices", value:totInvs, color:t.warning, icon:"fa-file-invoice" },
            { label:"Avg Balance/Sub", value:fmt(totSubs>0?totBal/totSubs:0), color:t.info, icon:"fa-calculator" },
          ].map(s => (
            <div key={s.label} style={{ background:t.bgCard, borderRadius:12, border:`1px solid ${t.border}`, padding:"12px 14px" }}>
              <div style={{ fontSize:10, fontWeight:600, color:t.textMuted, textTransform:"uppercase", letterSpacing:.5, marginBottom:3 }}><_Icon name={s.icon} /> {s.label}</div>
              <div style={{ fontSize:18, fontWeight:800, color:s.color, fontFamily:"'Space Grotesk'" }}>{s.value}</div>
            </div>
          ))}
        </div>

        {/* Aging buckets */}
        <Card style={{ marginBottom:16, padding:16 }}>
          <h3 style={{ fontSize:14, fontWeight:700, color:t.text, marginBottom:12 }}><i className="fas fa-hourglass-half" style={{color:t.warning,marginRight:6}}></i>Aging Distribution</h3>
          <div style={{ display:"grid", gridTemplateColumns:"repeat(5, 1fr)", gap:10 }}>
            {[
              { label:"Current",   value:buckets.current, color:t.success },
              { label:"1–30 Days", value:buckets.d30,     color:"#f59e0b" },
              { label:"31–60",     value:buckets.d60,     color:t.warning },
              { label:"61–90",     value:buckets.d90,     color:"#f97316" },
              { label:"90+ Days",  value:buckets.over90,  color:t.danger },
            ].map(a => (
              <div key={a.label} style={{ textAlign:"center", padding:"12px 8px", borderRadius:10, background:`${a.color}10`, border:`1px solid ${a.color}25` }}>
                <div style={{ fontSize:10, fontWeight:600, color:t.textMuted, textTransform:"uppercase", marginBottom:4 }}>{a.label}</div>
                <div style={{ fontSize:16, fontWeight:800, color:a.color, fontFamily:"'Space Grotesk'" }}>{fmt(a.value)}</div>
              </div>
            ))}
          </div>
        </Card>

        {/* Subscribers Table */}
        <Card style={{ padding:0, overflow:"hidden" }}>
          <div style={{ overflowX:"auto", overflowY: forColShowAll ? "auto" : "visible", maxHeight: forColShowAll ? 600 : "none" }}>
            <table style={{ width:"100%", borderCollapse:"collapse", fontSize:13 }}>
              <thead>
                <tr style={{ background:t.bgCard, borderBottom:`2px solid ${t.border}` }}>
                  {["Account","Subscriber","Contact","Address","Invoices","Oldest Due","Days","Balance"].map(h => (
                    <th key={h} style={{ padding:"10px 12px", textAlign: (h==="Balance"||h==="Days"||h==="Invoices")?"right":"left", fontSize:11, fontWeight:700, color:t.textMuted, textTransform:"uppercase", letterSpacing:.4, whiteSpace:"nowrap" }}>{h}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {fcPaged.length === 0 && <tr><td colSpan={8} style={{ padding:40, textAlign:"center", color:t.textMuted }}>No subscribers match these filters</td></tr>}
                {fcPaged.map(r => {
                  const s = r.sub;
                  const name = s.firstName ? (s.firstName + (s.middleName?' '+s.middleName+' ':' ') + s.lastName) : (s.companyName || '—');
                  const alts = s.altContacts || [];
                  return (
                    <tr key={s.id} style={{ borderBottom:`1px solid ${t.border}`, cursor:"pointer" }} onClick={() => { setSelectedSub(s); setShowSubModal(true); }}>
                      <td style={{ padding:"10px 12px", fontFamily:"monospace", fontSize:12, fontWeight:600, color:t.accent }}>{s.acct}</td>
                      <td style={{ padding:"10px 12px", fontWeight:600, color:t.text, maxWidth:200, overflow:"hidden", textOverflow:"ellipsis", whiteSpace:"nowrap", fontSize:12 }}>
                        {name}
                        {s.companyName && s.firstName && <div style={{ fontSize:10, color:t.textMuted }}>{s.companyName}</div>}
                      </td>
                      <td style={{ padding:"10px 12px", fontSize:11, color:t.textSec }}>
                        <div style={{ fontFamily:"monospace" }}>{formatPhone(s.phone||'') || '—'}</div>
                        {alts.length > 0 && alts.map((c,idx) => (
                          <div key={idx} style={{ fontFamily:"monospace", color:t.textMuted, fontSize:10 }}>{c.name?c.name+': ':''}{formatPhone(c.phone||'')}</div>
                        ))}
                        {s.email && <div style={{ fontSize:10, color:t.textMuted, marginTop:2 }}>{s.email}</div>}
                      </td>
                      <td style={{ padding:"10px 12px", fontSize:11, color:t.textSec, maxWidth:200 }}>
                        <div style={{ overflow:"hidden", textOverflow:"ellipsis", whiteSpace:"nowrap" }}>{s.address||'—'}</div>
                        <div style={{ fontSize:10, color:t.textMuted }}>{s.barangay||''}{s.barangay&&s.municipality?', ':''}{s.municipality||''}</div>
                      </td>
                      <td style={{ padding:"10px 12px", textAlign:"right", fontWeight:700, color:t.text, fontFamily:"'Space Grotesk'" }}>{r.invoices.length}</td>
                      <td style={{ padding:"10px 12px", fontSize:12, color:t.textSec, whiteSpace:"nowrap" }}>{r.oldestDue?r.oldestDue.toLocaleDateString("en-US",{month:"short",day:"numeric",year:"numeric"}):'—'}</td>
                      <td style={{ padding:"10px 12px", textAlign:"right", fontWeight:700, color:ageColor(r.maxDaysOverdue), fontFamily:"'Space Grotesk'" }}>{r.maxDaysOverdue>0?r.maxDaysOverdue+'d':'—'}</td>
                      <td style={{ padding:"10px 12px", textAlign:"right", fontWeight:800, color:t.danger, fontFamily:"'Space Grotesk'" }}>{fmt(r.totalBal)}</td>
                    </tr>
                  );
                })}
              </tbody>
              {fcPaged.length > 0 && <tfoot>
                <tr style={{ background:t.bgCard, borderTop:`2px solid ${t.border}` }}>
                  <td colSpan={4} style={{ padding:"10px 12px", fontWeight:700, color:t.text, fontSize:12 }}>TOTAL ({totSubs} subscriber{totSubs!==1?'s':''})</td>
                  <td style={{ padding:"10px 12px", textAlign:"right", fontWeight:800, color:t.text, fontFamily:"'Space Grotesk'" }}>{totInvs}</td>
                  <td colSpan={2}></td>
                  <td style={{ padding:"10px 12px", textAlign:"right", fontWeight:800, color:t.danger, fontFamily:"'Space Grotesk'" }}>{fmt(totBal)}</td>
                </tr>
              </tfoot>}
            </table>
          </div>
          {rows.length > forColPerPage && <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center", padding:"10px 16px", borderTop:`1px solid ${t.border}`, fontSize:12 }}>
            <span style={{ color:t.textMuted }}>{forColShowAll ? `Showing all ${rows.length}` : `Showing ${(forColPage-1)*forColPerPage+1}–${Math.min(forColPage*forColPerPage, rows.length)} of ${rows.length}`}</span>
            <div style={{ display:"flex", gap:6, alignItems:"center" }}>
              <Btn small disabled={forColPage<=1} onClick={() => setForColPage(p=>p-1)}>Prev</Btn>
              {Array.from({length:Math.min(fcTotalPages,5)},(_, i)=>{
                let pg; if(fcTotalPages<=5) pg=i+1; else if(forColPage<=3) pg=i+1; else if(forColPage>=fcTotalPages-2) pg=fcTotalPages-4+i; else pg=forColPage-2+i;
                return <div key={pg} onClick={()=>setForColPage(pg)} style={{width:28,height:28,borderRadius:8,display:"flex",alignItems:"center",justifyContent:"center",cursor:"pointer",fontWeight:700,fontSize:12,background:forColPage===pg?t.accent:"transparent",color:forColPage===pg?"#fff":t.textMuted}}>{pg}</div>;
              })}
              {fcTotalPages>5 && <span style={{color:t.textMuted}}>... {fcTotalPages}</span>}
              <Btn small disabled={forColPage>=fcTotalPages} onClick={() => setForColPage(p=>p+1)}>Next</Btn>
              <Btn small onClick={() => { setForColShowAll(!forColShowAll); setForColPage(1); }}>{forColShowAll?"Paginate":"Show All"}</Btn>
            </div>
          </div>}
        </Card>
      </div>);
    }

    // ═══════════════ DAILY COLLECTION REPORT VIEW ═══════════════
    if (dailyColOpen) {
      const fromD = dailyColFrom ? new Date(dailyColFrom + 'T00:00:00') : null;
      const toD   = dailyColTo   ? new Date(dailyColTo   + 'T23:59:59.999') : null;
      const searchQ = (dailyColSearch||"").trim().toLowerCase();
      // Build a flat list of payment events from invoices[].payments
      const allPays = [];
      invoices.forEach(inv => {
        (inv.payments||[]).forEach((p, idx) => {
          if (!p || !p.paidAt) return;
          const pd = new Date(p.paidAt);
          if (isNaN(pd)) return;
          if (fromD && pd < fromD) return;
          if (toD && pd > toD) return;
          if (dailyColMethod !== "all" && p.method !== dailyColMethod) return;
          if (!dailyColIncludeCredit && p.method === 'credit') return;
          const sub = getSub(inv.subId);
          const subName = sub.firstName ? (sub.firstName + (sub.middleName?' '+sub.middleName+' ':' ') + sub.lastName) : (inv.subName||'—');
          if (searchQ) {
            const hay = (inv.number + ' ' + (sub.acct||inv.subAcct||'') + ' ' + subName).toLowerCase();
            if (!hay.includes(searchQ)) return;
          }
          allPays.push({
            id: inv.id + '-' + idx,
            invId: inv.id,
            invNumber: inv.number,
            subId: inv.subId,
            subName: subName,
            subAcct: sub.acct || inv.subAcct || '—',
            amount: Number(p.amount) || 0,
            method: p.method || null,
            paidAt: p.paidAt,
            period: inv.period || null,
          });
        });
      });
      // Sort newest first
      allPays.sort((a,b) => new Date(b.paidAt) - new Date(a.paidAt));

      const totalCollected = allPays.reduce((s,p) => s + p.amount, 0);
      const totalCount = allPays.length;
      const uniqueSubs = new Set(allPays.map(p => p.subId)).size;
      const avgPayment = totalCount > 0 ? totalCollected / totalCount : 0;

      // Group by date
      const byDate = {};
      allPays.forEach(p => {
        const k = new Date(p.paidAt).toISOString().substring(0,10);
        if (!byDate[k]) byDate[k] = { date:k, count:0, amount:0 };
        byDate[k].count++;
        byDate[k].amount += p.amount;
      });
      const dailyRows = Object.values(byDate).sort((a,b) => b.date.localeCompare(a.date));
      const maxDaily = Math.max(...dailyRows.map(r=>r.amount), 1);

      // Group by method
      const byMethod = {};
      allPays.forEach(p => {
        const mName = p.method ? ((paymentMethods.find(m=>m.code===p.method)||{}).name || p.method) : 'Unspecified';
        if (!byMethod[mName]) byMethod[mName] = { name:mName, code:p.method, count:0, amount:0 };
        byMethod[mName].count++;
        byMethod[mName].amount += p.amount;
      });
      const methodRowsD = Object.values(byMethod).sort((a,b) => b.amount - a.amount);

      // Pagination
      const dailyTotalPages = Math.max(1, Math.ceil(allPays.length / dailyColPerPage));
      const dailyPaged = dailyColShowAll ? allPays : allPays.slice((dailyColPage-1)*dailyColPerPage, dailyColPage*dailyColPerPage);

      // Quick presets
      const today = new Date();
      const toIso = (d) => d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');
      const yesterday = new Date(today); yesterday.setDate(yesterday.getDate()-1);
      const last7 = new Date(today); last7.setDate(last7.getDate()-6);
      const last30 = new Date(today); last30.setDate(last30.getDate()-29);
      const firstOfMonth = new Date(today.getFullYear(), today.getMonth(), 1);
      const presetsD = [
        { label:"Today",         from: toIso(today),        to: toIso(today) },
        { label:"Yesterday",     from: toIso(yesterday),    to: toIso(yesterday) },
        { label:"Last 7 Days",   from: toIso(last7),        to: toIso(today) },
        { label:"Last 30 Days",  from: toIso(last30),       to: toIso(today) },
        { label:"This Month",    from: toIso(firstOfMonth), to: toIso(today) },
      ];

      return (
      <div>
        <div style={{ display:"flex", alignItems:"center", gap:12, marginBottom:20 }}>
          <Btn onClick={() => setDailyColOpen(false)}><i className="fas fa-arrow-left" style={{marginRight:6}}></i>Back to Reports</Btn>
          <h2 style={{ fontSize:20, fontWeight:800, color:t.text, fontFamily:"'Space Grotesk'", margin:0 }}><i className="fas fa-calendar-day" style={{color:t.success,marginRight:8}}></i>Daily Collection Report</h2>
        </div>

        {/* Controls */}
        <Card style={{ marginBottom:16, padding:16 }}>
          <div style={{ display:"flex", flexWrap:"wrap", gap:6, marginBottom:14 }}>
            <span style={{ fontSize:11, fontWeight:600, color:t.textMuted, textTransform:"uppercase", letterSpacing:.4, alignSelf:"center", marginRight:4 }}>Quick:</span>
            {presetsD.map(p => {
              const active = dailyColFrom === p.from && dailyColTo === p.to;
              return (
                <button key={p.label} onClick={() => { setDailyColFrom(p.from); setDailyColTo(p.to); setDailyColPage(1); }} style={{ padding:"5px 12px", borderRadius:16, border:`1px solid ${active?t.success:t.border}`, background:active?`${t.success}18`:t.bgCard, color:active?t.success:t.textSec, fontSize:11, fontWeight:600, cursor:"pointer", fontFamily:"inherit", transition:"all .15s" }}>
                  {active && <i className="fas fa-check" style={{marginRight:5,fontSize:9}}></i>}{p.label}
                </button>
              );
            })}
          </div>
          <div style={{ display:"flex", flexWrap:"wrap", alignItems:"flex-end", gap:14 }}>
            <div>
              <label style={{ fontSize:11, fontWeight:600, color:t.textSec, marginBottom:6, display:"block", textTransform:"uppercase", letterSpacing:.4 }}>From Date</label>
              <input type="date" value={dailyColFrom} onChange={e => { setDailyColFrom(e.target.value); setDailyColPage(1); }} style={{ padding:"9px 14px", borderRadius:10, border:`1px solid ${t.inputBorder}`, background:t.input, color:t.text, fontSize:13, fontFamily:"inherit", outline:"none", colorScheme:"dark" }} />
            </div>
            <div>
              <label style={{ fontSize:11, fontWeight:600, color:t.textSec, marginBottom:6, display:"block", textTransform:"uppercase", letterSpacing:.4 }}>To Date</label>
              <input type="date" value={dailyColTo} onChange={e => { setDailyColTo(e.target.value); setDailyColPage(1); }} style={{ padding:"9px 14px", borderRadius:10, border:`1px solid ${t.inputBorder}`, background:t.input, color:t.text, fontSize:13, fontFamily:"inherit", outline:"none", colorScheme:"dark" }} />
            </div>
            <div>
              <label style={{ fontSize:11, fontWeight:600, color:t.textSec, marginBottom:6, display:"block", textTransform:"uppercase", letterSpacing:.4 }}>Method</label>
              <select value={dailyColMethod} onChange={e => { setDailyColMethod(e.target.value); setDailyColPage(1); }} style={{ padding:"9px 14px", borderRadius:10, border:`1px solid ${t.inputBorder}`, background:t.input, color:t.text, fontSize:13, fontFamily:"inherit", outline:"none", minWidth:160 }}>
                <option value="all">All Methods</option>
                {paymentMethods.map(m => <option key={m.code} value={m.code}>{m.name}</option>)}
              </select>
            </div>
            <div style={{ alignSelf:"flex-end", paddingBottom:9 }} title="Credit applications are ledger moves from a subscriber's existing credit balance — not new cash collected. Off by default to match cash-collection totals.">
              <label style={{ display:"flex", alignItems:"center", gap:6, fontSize:12, color:t.textSec, cursor:"pointer", userSelect:"none" }}>
                <input type="checkbox" checked={dailyColIncludeCredit} onChange={e => { setDailyColIncludeCredit(e.target.checked); setDailyColPage(1); }} style={{ width:16, height:16, accentColor:t.accent, cursor:"pointer" }} />
                <span>Include credit applications</span>
              </label>
            </div>
            <div style={{ flex:1, minWidth:200 }}>
              <label style={{ fontSize:11, fontWeight:600, color:t.textSec, marginBottom:6, display:"block", textTransform:"uppercase", letterSpacing:.4 }}>Search</label>
              <div style={{ position:"relative" }}>
                <i className="fas fa-search" style={{ position:"absolute", left:12, top:"50%", transform:"translateY(-50%)", color:t.textMuted, fontSize:12 }}></i>
                <input ref={dailyColSearchRef} value={dailyColSearch} onChange={e => { setDailyColSearch(e.target.value); setDailyColPage(1); }} placeholder="Invoice #, name, account..." style={{ width:"100%", padding:"9px 12px 9px 34px", borderRadius:10, border:`1px solid ${t.inputBorder}`, background:t.input, color:t.text, fontSize:13, fontFamily:"inherit", outline:"none", boxSizing:"border-box" }} />
              </div>
            </div>
            <Btn onClick={() => window.print()} style={{ alignSelf:"flex-end" }}><i className="fas fa-print" style={{marginRight:6}}></i>Print</Btn>
            <Btn onClick={() => {
              const headers = ['Date','Time','Invoice #','Subscriber','Account','Method','Amount','Period'];
              const rows = allPays.map(p => {
                const d = new Date(p.paidAt);
                const mName = p.method ? ((paymentMethods.find(m=>m.code===p.method)||{}).name || p.method) : 'Unspecified';
                return [
                  d.toLocaleDateString('en-US',{year:'numeric',month:'2-digit',day:'2-digit'}),
                  d.toLocaleTimeString('en-US',{hour:'2-digit',minute:'2-digit'}),
                  p.invNumber,
                  p.subName,
                  p.subAcct,
                  mName,
                  p.amount.toFixed(2),
                  p.period||''
                ];
              });
              const csv = [headers, ...rows].map(r => r.map(c => `"${String(c).replace(/"/g,'""')}"`).join(',')).join('\n');
              const blob = new Blob([csv], {type:'text/csv;charset=utf-8'});
              const url = URL.createObjectURL(blob);
              const a = document.createElement('a');
              a.href = url; a.download = `daily-collection-${dailyColFrom}-to-${dailyColTo}.csv`;
              document.body.appendChild(a); a.click(); document.body.removeChild(a);
              URL.revokeObjectURL(url);
            }} style={{ alignSelf:"flex-end" }}><i className="fas fa-file-csv" style={{marginRight:6}}></i>CSV</Btn>
          </div>
        </Card>

        {/* KPIs */}
        <div style={{ display:"grid", gridTemplateColumns:"repeat(auto-fit, minmax(160px, 1fr))", gap:12, marginBottom:16 }}>
          {[
            { label:"Total Collected", value:fmt(totalCollected), color:t.success, icon:"fa-circle-check" },
            { label:"Transactions", value:totalCount, color:t.text, icon:"fa-receipt" },
            { label:"Unique Subscribers", value:uniqueSubs, color:t.accent, icon:"fa-users" },
            { label:"Avg Payment", value:fmt(avgPayment), color:t.info, icon:"fa-calculator" },
            { label:"Days With Activity", value:dailyRows.length, color:t.warning, icon:"fa-calendar-check" },
          ].map(s => (
            <div key={s.label} style={{ background:t.bgCard, borderRadius:12, border:`1px solid ${t.border}`, padding:"12px 14px" }}>
              <div style={{ fontSize:10, fontWeight:600, color:t.textMuted, textTransform:"uppercase", letterSpacing:.5, marginBottom:3 }}><_Icon name={s.icon} /> {s.label}</div>
              <div style={{ fontSize:18, fontWeight:800, color:s.color, fontFamily:"'Space Grotesk'" }}>{s.value}</div>
            </div>
          ))}
        </div>

        {/* Daily Breakdown + Method Breakdown side-by-side */}
        <div style={{ display:"grid", gridTemplateColumns:"1.4fr 1fr", gap:16, marginBottom:16 }}>
          <Card style={{ padding:16 }}>
            <h3 style={{ fontSize:14, fontWeight:700, color:t.text, marginBottom:12 }}><i className="fas fa-chart-bar" style={{color:t.success,marginRight:6}}></i>Daily Breakdown</h3>
            {dailyRows.length === 0 && <div style={{ padding:24, textAlign:"center", color:t.textMuted, fontSize:13 }}>No payments in the selected range.</div>}
            {dailyRows.length > 0 && (
              <div style={{ display:"flex", flexDirection:"column", gap:8 }}>
                {dailyRows.map(r => {
                  const pct = (r.amount / maxDaily) * 100;
                  const dateLabel = new Date(r.date + 'T12:00:00').toLocaleDateString("en-US",{weekday:"short",month:"short",day:"numeric",year:"numeric"});
                  return (
                    <div key={r.date} style={{ display:"grid", gridTemplateColumns:"140px 1fr 100px 50px", alignItems:"center", gap:10, fontSize:12 }}>
                      <div style={{ color:t.textSec, fontWeight:600 }}>{dateLabel}</div>
                      <div style={{ background:t.input, borderRadius:6, height:18, overflow:"hidden", position:"relative" }}>
                        <div style={{ background:t.success, height:"100%", width:pct+"%", transition:"width .3s" }}></div>
                      </div>
                      <div style={{ textAlign:"right", fontWeight:700, color:t.text, fontFamily:"'Space Grotesk'" }}>{fmt(r.amount)}</div>
                      <div style={{ textAlign:"right", color:t.textMuted, fontSize:11 }}>{r.count} tx</div>
                    </div>
                  );
                })}
              </div>
            )}
          </Card>
          <Card style={{ padding:16 }}>
            <h3 style={{ fontSize:14, fontWeight:700, color:t.text, marginBottom:12 }}><i className="fas fa-credit-card" style={{color:t.accent,marginRight:6}}></i>By Payment Method</h3>
            {methodRowsD.length === 0 && <div style={{ padding:24, textAlign:"center", color:t.textMuted, fontSize:13 }}>—</div>}
            {methodRowsD.length > 0 && (
              <div style={{ display:"flex", flexDirection:"column", gap:8 }}>
                {methodRowsD.map(m => {
                  const pct = totalCollected > 0 ? (m.amount / totalCollected) * 100 : 0;
                  return (
                    <div key={m.name} style={{ borderBottom:`1px solid ${t.border}`, paddingBottom:8 }}>
                      <div style={{ display:"flex", justifyContent:"space-between", marginBottom:4, fontSize:12 }}>
                        <span style={{ fontWeight:600, color:t.text }}>{m.name}</span>
                        <span style={{ color:t.textMuted }}>{m.count} tx · {pct.toFixed(1)}%</span>
                      </div>
                      <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center", gap:8 }}>
                        <div style={{ flex:1, background:t.input, borderRadius:6, height:8, overflow:"hidden" }}>
                          <div style={{ background:t.accent, height:"100%", width:pct+"%", transition:"width .3s" }}></div>
                        </div>
                        <span style={{ fontWeight:700, color:t.text, fontFamily:"'Space Grotesk'", fontSize:13, minWidth:90, textAlign:"right" }}>{fmt(m.amount)}</span>
                      </div>
                    </div>
                  );
                })}
              </div>
            )}
          </Card>
        </div>

        {/* Transaction Table */}
        <Card style={{ padding:0, overflow:"hidden" }}>
          <div style={{ overflowX:"auto", overflowY: dailyColShowAll ? "auto" : "visible", maxHeight: dailyColShowAll ? 560 : "none" }}>
            <table style={{ width:"100%", borderCollapse:"collapse", fontSize:13 }}>
              <thead>
                <tr style={{ background:t.bgCard, borderBottom:`2px solid ${t.border}` }}>
                  {["Date / Time","Invoice #","Subscriber","Account","Method","Period","Amount"].map(h => (
                    <th key={h} style={{ padding:"10px 12px", textAlign: h==="Amount"?"right":"left", fontSize:11, fontWeight:700, color:t.textMuted, textTransform:"uppercase", letterSpacing:.4, whiteSpace:"nowrap" }}>{h}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {dailyPaged.length === 0 && <tr><td colSpan={7} style={{ padding:40, textAlign:"center", color:t.textMuted }}>No payments found</td></tr>}
                {dailyPaged.map(p => {
                  const d = new Date(p.paidAt);
                  const mName = p.method ? ((paymentMethods.find(m=>m.code===p.method)||{}).name || p.method) : '—';
                  return (
                    <tr key={p.id} style={{ borderBottom:`1px solid ${t.border}` }}>
                      <td style={{ padding:"10px 12px", fontSize:12, color:t.textSec, whiteSpace:"nowrap" }}>{d.toLocaleString("en-US",{month:"short",day:"numeric",year:"numeric",hour:"numeric",minute:"2-digit"})}</td>
                      <td style={{ padding:"10px 12px", fontFamily:"monospace", fontSize:12, fontWeight:600, color:t.accent, cursor:"pointer" }} onClick={() => openInvoiceDetail(p.invId)}>{p.invNumber}</td>
                      <td style={{ padding:"10px 12px", fontWeight:600, color:t.text, maxWidth:200, overflow:"hidden", textOverflow:"ellipsis", whiteSpace:"nowrap", fontSize:12 }}>{p.subName}</td>
                      <td style={{ padding:"10px 12px", fontSize:12, color:t.textSec, fontFamily:"monospace" }}>{p.subAcct}</td>
                      <td style={{ padding:"10px 12px", fontSize:12, color:t.textSec }}>{mName}</td>
                      <td style={{ padding:"10px 12px", fontSize:12, color:t.textSec }}>{p.period||'—'}</td>
                      <td style={{ padding:"10px 12px", fontWeight:700, color:t.success, fontFamily:"'Space Grotesk'", textAlign:"right" }}>{fmt(p.amount)}</td>
                    </tr>
                  );
                })}
              </tbody>
              {dailyPaged.length > 0 && <tfoot>
                <tr style={{ background:t.bgCard, borderTop:`2px solid ${t.border}` }}>
                  <td colSpan={6} style={{ padding:"10px 12px", fontWeight:700, color:t.text, fontSize:12 }}>TOTAL ({totalCount} payments across {dailyRows.length} day{dailyRows.length!==1?'s':''})</td>
                  <td style={{ padding:"10px 12px", fontWeight:800, color:t.success, fontFamily:"'Space Grotesk'", textAlign:"right" }}>{fmt(totalCollected)}</td>
                </tr>
              </tfoot>}
            </table>
          </div>
          {allPays.length > dailyColPerPage && <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center", padding:"10px 16px", borderTop:`1px solid ${t.border}`, fontSize:12 }}>
            <span style={{ color:t.textMuted }}>{dailyColShowAll ? `Showing all ${allPays.length}` : `Showing ${(dailyColPage-1)*dailyColPerPage+1}–${Math.min(dailyColPage*dailyColPerPage, allPays.length)} of ${allPays.length}`}</span>
            <div style={{ display:"flex", gap:6, alignItems:"center" }}>
              <Btn small disabled={dailyColPage<=1} onClick={() => setDailyColPage(p=>p-1)}>Prev</Btn>
              {Array.from({length:Math.min(dailyTotalPages,5)},(_, i)=>{
                let pg; if(dailyTotalPages<=5) pg=i+1; else if(dailyColPage<=3) pg=i+1; else if(dailyColPage>=dailyTotalPages-2) pg=dailyTotalPages-4+i; else pg=dailyColPage-2+i;
                return <div key={pg} onClick={()=>setDailyColPage(pg)} style={{width:28,height:28,borderRadius:8,display:"flex",alignItems:"center",justifyContent:"center",cursor:"pointer",fontWeight:700,fontSize:12,background:dailyColPage===pg?t.accent:"transparent",color:dailyColPage===pg?"#fff":t.textMuted}}>{pg}</div>;
              })}
              {dailyTotalPages>5 && <span style={{color:t.textMuted}}>... {dailyTotalPages}</span>}
              <Btn small disabled={dailyColPage>=dailyTotalPages} onClick={() => setDailyColPage(p=>p+1)}>Next</Btn>
              <Btn small onClick={() => { setDailyColShowAll(!dailyColShowAll); setDailyColPage(1); }}>{dailyColShowAll?"Paginate":"Show All"}</Btn>
            </div>
          </div>}
        </Card>
      </div>);
    }

    // ═══════════════ REVENUE REPORT VIEW ═══════════════
    if (revRptOpen) {
      const fromIdx3 = periodIdx(revRptFrom); const toIdx3 = periodIdx(revRptTo);
      const revPeriods = periodMonths.slice(Math.min(fromIdx3, toIdx3), Math.max(fromIdx3, toIdx3) + 1);

      // Bucket every invoice into its calendar month using the
      // invoice's own date (invoiceDate / dueDate) — NOT the
      // free-text billing_period field. The DB stores values like
      // "subscription" / "installation" / "Activation — One-Time Fees"
      // there, which would silently drop those rows from the report.
      const monthKeyOf = (inv) => {
        const d = inv.invoiceDate || inv.dueDate;
        if (!d) return inv.period || null;
        const dt = new Date(d);
        if (isNaN(dt)) return inv.period || null;
        return dt.toLocaleString("en-US",{month:"long",year:"numeric"});
      };

      // Group revenue by month
      const revByMonth = {};
      revPeriods.forEach(p => { revByMonth[p] = { period:p, billed:0, collected:0, pending:0, paidCount:0, pendingCount:0, totalCount:0 }; });
      invoices.forEach(inv => {
        const key = monthKeyOf(inv);
        if (!key || !revByMonth[key]) return;
        const m = revByMonth[key];
        m.totalCount++;
        m.billed += inv.amount;
        if (inv.status === 'paid') { m.collected += inv.amount; m.paidCount++; }
        else if (inv.status === 'partial') { m.collected += (inv.totalPaid||0); m.pending += Math.max(0, inv.balance||0); m.paidCount++; m.pendingCount++; }
        else if (inv.status !== 'cancelled') { m.pending += inv.amount; m.pendingCount++; }
      });
      const revRows = revPeriods.map(p => revByMonth[p]);
      const revTotalBilled = revRows.reduce((s,r) => s + r.billed, 0);
      const revTotalCollected = revRows.reduce((s,r) => s + r.collected, 0);
      const revTotalPending = revRows.reduce((s,r) => s + r.pending, 0);
      const revTotalCount = revRows.reduce((s,r) => s + r.totalCount, 0);

      // Revenue by plan
      const revByPlan = {};
      invoices.forEach(inv => {
        const key = monthKeyOf(inv);
        if (!key || !revPeriods.includes(key)) return;
        const sub = getSub(inv.subId);
        const planName = sub.planName || 'No Plan';
        if (!revByPlan[planName]) revByPlan[planName] = { name:planName, billed:0, collected:0, count:0 };
        revByPlan[planName].billed += inv.amount;
        revByPlan[planName].count++;
        if (inv.status === 'paid') revByPlan[planName].collected += inv.amount;
        else if (inv.status === 'partial') revByPlan[planName].collected += (inv.totalPaid||0);
      });
      const planRows = Object.values(revByPlan).sort((a,b) => b.billed - a.billed);

      // Revenue by payment method
      const revByMethod = {};
      invoices.forEach(inv => {
        const key = monthKeyOf(inv);
        if (!key || !revPeriods.includes(key) || inv.status === 'cancelled') return;
        if (inv.totalPaid > 0 && inv.method) {
          const mName = (paymentMethods.find(m=>m.code===inv.method)||{}).name || inv.method || 'Unknown';
          if (!revByMethod[mName]) revByMethod[mName] = { name:mName, amount:0, count:0 };
          revByMethod[mName].amount += inv.totalPaid;
          revByMethod[mName].count++;
        }
      });
      const methodRows = Object.values(revByMethod).sort((a,b) => b.amount - a.amount);

      // Highest bar for visual chart
      const maxBilled = Math.max(...revRows.map(r => r.billed), 1);

      return (
      <div>
        <div style={{ display:"flex", alignItems:"center", gap:12, marginBottom:20 }}>
          <Btn onClick={() => setRevRptOpen(false)}><i className="fas fa-arrow-left" style={{marginRight:6}}></i>Back to Reports</Btn>
          <h2 style={{ fontSize:20, fontWeight:800, color:t.text, fontFamily:"'Space Grotesk'", margin:0 }}><i className="fas fa-chart-line" style={{color:"#8b5cf6",marginRight:8}}></i>Revenue Report</h2>
        </div>

        {/* Controls */}
        <Card style={{ marginBottom:16, padding:16 }}>
          <div style={{ display:"flex", flexWrap:"wrap", alignItems:"flex-end", gap:14 }}>
            <div>
              <label style={{ fontSize:11, fontWeight:600, color:t.textSec, marginBottom:6, display:"block", textTransform:"uppercase", letterSpacing:.4 }}>From Period</label>
              <select value={revRptFrom} onChange={e => setRevRptFrom(e.target.value)} style={{ padding:"9px 14px", borderRadius:10, border:`1px solid ${t.inputBorder}`, background:t.input, color:t.text, fontSize:13, fontFamily:"inherit", outline:"none", minWidth:170 }}>
                {periodMonths.map(p => <option key={p} value={p}>{p}</option>)}
              </select>
            </div>
            <div>
              <label style={{ fontSize:11, fontWeight:600, color:t.textSec, marginBottom:6, display:"block", textTransform:"uppercase", letterSpacing:.4 }}>To Period</label>
              <select value={revRptTo} onChange={e => setRevRptTo(e.target.value)} style={{ padding:"9px 14px", borderRadius:10, border:`1px solid ${t.inputBorder}`, background:t.input, color:t.text, fontSize:13, fontFamily:"inherit", outline:"none", minWidth:170 }}>
                {periodMonths.map(p => <option key={p} value={p}>{p}</option>)}
              </select>
            </div>
            <Btn onClick={() => window.print()} style={{ alignSelf:"flex-end" }}><i className="fas fa-print" style={{marginRight:6}}></i>Print</Btn>
          </div>
        </Card>

        {/* Revenue KPIs */}
        <div style={{ display:"grid", gridTemplateColumns:"repeat(auto-fit, minmax(150px, 1fr))", gap:12, marginBottom:16 }}>
          {[
            { label:"Total Revenue", value:fmt(revTotalBilled), color:"#8b5cf6", icon:"fa-peso-sign" },
            { label:"Collected", value:fmt(revTotalCollected), color:t.success, icon:"fa-circle-check" },
            { label:"Pending", value:fmt(revTotalPending), color:t.warning, icon:"fa-clock" },
            { label:"Invoices", value:revTotalCount, color:t.accent, icon:"fa-file-invoice" },
            { label:"Avg Monthly", value:fmt(revPeriods.length>0?revTotalBilled/revPeriods.length:0), color:t.text, icon:"fa-chart-simple" },
            { label:"Collection %", value:(revTotalBilled>0?Math.round(revTotalCollected/revTotalBilled*100):0)+"%", color:t.success, icon:"fa-percent" },
          ].map(s => (
            <div key={s.label} style={{ background:t.bgCard, borderRadius:12, border:`1px solid ${t.border}`, padding:"14px 16px" }}>
              <div style={{ fontSize:10, fontWeight:600, color:t.textMuted, textTransform:"uppercase", letterSpacing:.5, marginBottom:4 }}><_Icon name={s.icon} /> {s.label}</div>
              <div style={{ fontSize:20, fontWeight:800, color:s.color, fontFamily:"'Space Grotesk'" }}>{s.value}</div>
            </div>
          ))}
        </div>

        {/* Monthly Revenue Chart (CSS bars) */}
        <Card style={{ marginBottom:16, padding:16 }}>
          <h3 style={{ fontSize:14, fontWeight:700, color:t.text, marginBottom:16 }}><i className="fas fa-chart-bar" style={{color:"#8b5cf6",marginRight:6}}></i>Monthly Revenue Breakdown</h3>
          <div style={{ display:"flex", gap:8, alignItems:"flex-end", height:180, paddingBottom:24, position:"relative" }}>
            {revRows.map(r => {
              const billedH = Math.max(4, (r.billed / maxBilled) * 150);
              const collectedH = Math.max(0, (r.collected / maxBilled) * 150);
              return (
                <div key={r.period} style={{ flex:1, display:"flex", flexDirection:"column", alignItems:"center", gap:4 }}>
                  <div style={{ fontSize:10, fontWeight:700, color:t.text, fontFamily:"'Space Grotesk'" }}>{fmt(r.billed)}</div>
                  <div style={{ position:"relative", width:"100%", maxWidth:60 }}>
                    <div style={{ height:billedH, background:`${"#8b5cf6"}30`, borderRadius:"6px 6px 0 0", width:"100%" }}></div>
                    <div style={{ height:collectedH, background:"#8b5cf6", borderRadius:"6px 6px 0 0", width:"100%", position:"absolute", bottom:0 }}></div>
                  </div>
                  <div style={{ fontSize:9, color:t.textMuted, textAlign:"center", whiteSpace:"nowrap", overflow:"hidden" }}>{r.period.split(' ')[0].substring(0,3)}</div>
                </div>
              );
            })}
          </div>
          <div style={{ display:"flex", gap:16, justifyContent:"center", marginTop:8 }}>
            <div style={{ display:"flex", alignItems:"center", gap:6, fontSize:11, color:t.textMuted }}><div style={{ width:12, height:12, borderRadius:3, background:"#8b5cf630" }}></div>Billed</div>
            <div style={{ display:"flex", alignItems:"center", gap:6, fontSize:11, color:t.textMuted }}><div style={{ width:12, height:12, borderRadius:3, background:"#8b5cf6" }}></div>Collected</div>
          </div>
        </Card>

        <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr", gap:16, marginBottom:16 }}>
          {/* Revenue by Plan */}
          <Card style={{ padding:0, overflow:"hidden" }}>
            <div style={{ padding:"12px 16px", borderBottom:`1px solid ${t.border}` }}>
              <h3 style={{ fontSize:13, fontWeight:700, color:t.text, margin:0 }}><i className="fas fa-wifi" style={{color:t.accent,marginRight:6}}></i>Revenue by Plan</h3>
            </div>
            <table style={{ width:"100%", borderCollapse:"collapse", fontSize:12 }}>
              <thead>
                <tr style={{ borderBottom:`1px solid ${t.border}` }}>
                  <th style={{ padding:"8px 12px", textAlign:"left", fontSize:10, fontWeight:700, color:t.textMuted, textTransform:"uppercase" }}>Plan</th>
                  <th style={{ padding:"8px 12px", textAlign:"right", fontSize:10, fontWeight:700, color:t.textMuted, textTransform:"uppercase" }}>Billed</th>
                  <th style={{ padding:"8px 12px", textAlign:"right", fontSize:10, fontWeight:700, color:t.textMuted, textTransform:"uppercase" }}>Collected</th>
                  <th style={{ padding:"8px 12px", textAlign:"right", fontSize:10, fontWeight:700, color:t.textMuted, textTransform:"uppercase" }}>#</th>
                </tr>
              </thead>
              <tbody>
                {planRows.map(p => (
                  <tr key={p.name} style={{ borderBottom:`1px solid ${t.border}` }}>
                    <td style={{ padding:"8px 12px", fontWeight:600, color:t.text }}>{p.name}</td>
                    <td style={{ padding:"8px 12px", textAlign:"right", fontFamily:"'Space Grotesk'", fontWeight:700, color:t.text }}>{fmt(p.billed)}</td>
                    <td style={{ padding:"8px 12px", textAlign:"right", fontFamily:"'Space Grotesk'", fontWeight:600, color:t.success }}>{fmt(p.collected)}</td>
                    <td style={{ padding:"8px 12px", textAlign:"right", color:t.textMuted }}>{p.count}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </Card>

          {/* Revenue by Payment Method */}
          <Card style={{ padding:0, overflow:"hidden" }}>
            <div style={{ padding:"12px 16px", borderBottom:`1px solid ${t.border}` }}>
              <h3 style={{ fontSize:13, fontWeight:700, color:t.text, margin:0 }}><i className="fas fa-credit-card" style={{color:t.success,marginRight:6}}></i>Collections by Method</h3>
            </div>
            <table style={{ width:"100%", borderCollapse:"collapse", fontSize:12 }}>
              <thead>
                <tr style={{ borderBottom:`1px solid ${t.border}` }}>
                  <th style={{ padding:"8px 12px", textAlign:"left", fontSize:10, fontWeight:700, color:t.textMuted, textTransform:"uppercase" }}>Method</th>
                  <th style={{ padding:"8px 12px", textAlign:"right", fontSize:10, fontWeight:700, color:t.textMuted, textTransform:"uppercase" }}>Amount</th>
                  <th style={{ padding:"8px 12px", textAlign:"right", fontSize:10, fontWeight:700, color:t.textMuted, textTransform:"uppercase" }}># Payments</th>
                </tr>
              </thead>
              <tbody>
                {methodRows.map(m => (
                  <tr key={m.name} style={{ borderBottom:`1px solid ${t.border}` }}>
                    <td style={{ padding:"8px 12px", fontWeight:600, color:t.text }}>{m.name}</td>
                    <td style={{ padding:"8px 12px", textAlign:"right", fontFamily:"'Space Grotesk'", fontWeight:700, color:t.success }}>{fmt(m.amount)}</td>
                    <td style={{ padding:"8px 12px", textAlign:"right", color:t.textMuted }}>{m.count}</td>
                  </tr>
                ))}
                {methodRows.length === 0 && <tr><td colSpan={3} style={{ padding:20, textAlign:"center", color:t.textMuted }}>No payments recorded</td></tr>}
              </tbody>
            </table>
          </Card>
        </div>

        {/* Monthly Breakdown Table */}
        <Card style={{ padding:0, overflow:"hidden" }}>
          <div style={{ overflowX:"auto" }}>
            <table style={{ width:"100%", borderCollapse:"collapse", fontSize:13 }}>
              <thead>
                <tr style={{ background:t.bgCard, borderBottom:`2px solid ${t.border}` }}>
                  {["Period","Invoices","Total Billed","Collected","Pending","Collection Rate"].map(h => (
                    <th key={h} style={{ padding:"10px 12px", textAlign: h==="Period"?"left":"right", fontSize:11, fontWeight:700, color:t.textMuted, textTransform:"uppercase", letterSpacing:.4, whiteSpace:"nowrap" }}>{h}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {revRows.map((r, idx) => {
                  const rate = r.billed > 0 ? Math.round(r.collected / r.billed * 100) : 0;
                  return (
                    <tr key={r.period} style={{ borderBottom:`1px solid ${t.border}`, background: idx%2===0 ? 'transparent' : `${t.border}15` }}>
                      <td style={{ padding:"10px 12px", fontWeight:700, color:t.text }}>{r.period}</td>
                      <td style={{ padding:"10px 12px", textAlign:"right", color:t.textSec }}>{r.totalCount}</td>
                      <td style={{ padding:"10px 12px", fontWeight:700, color:t.text, fontFamily:"'Space Grotesk'", textAlign:"right" }}>{fmt(r.billed)}</td>
                      <td style={{ padding:"10px 12px", fontWeight:700, color:t.success, fontFamily:"'Space Grotesk'", textAlign:"right" }}>{fmt(r.collected)}</td>
                      <td style={{ padding:"10px 12px", fontWeight:700, color:t.warning, fontFamily:"'Space Grotesk'", textAlign:"right" }}>{fmt(r.pending)}</td>
                      <td style={{ padding:"10px 12px", textAlign:"right" }}>
                        <div style={{ display:"inline-flex", alignItems:"center", gap:6 }}>
                          <div style={{ width:60, height:8, borderRadius:4, background:`${t.border}40`, overflow:"hidden" }}><div style={{ width:rate+'%', height:"100%", borderRadius:4, background:rate>=80?t.success:rate>=50?t.warning:t.danger }}></div></div>
                          <span style={{ fontWeight:700, fontSize:12, color:rate>=80?t.success:rate>=50?t.warning:t.danger, fontFamily:"'Space Grotesk'" }}>{rate}%</span>
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
              <tfoot>
                <tr style={{ background:t.bgCard, borderTop:`2px solid ${t.border}` }}>
                  <td style={{ padding:"10px 12px", fontWeight:700, color:t.text }}>TOTALS</td>
                  <td style={{ padding:"10px 12px", fontWeight:700, color:t.text, textAlign:"right" }}>{revTotalCount}</td>
                  <td style={{ padding:"10px 12px", fontWeight:800, color:t.text, fontFamily:"'Space Grotesk'", textAlign:"right" }}>{fmt(revTotalBilled)}</td>
                  <td style={{ padding:"10px 12px", fontWeight:800, color:t.success, fontFamily:"'Space Grotesk'", textAlign:"right" }}>{fmt(revTotalCollected)}</td>
                  <td style={{ padding:"10px 12px", fontWeight:800, color:t.warning, fontFamily:"'Space Grotesk'", textAlign:"right" }}>{fmt(revTotalPending)}</td>
                  <td style={{ padding:"10px 12px", fontWeight:800, textAlign:"right" }}>
                    <span style={{ color:revTotalBilled>0&&Math.round(revTotalCollected/revTotalBilled*100)>=80?t.success:t.warning, fontFamily:"'Space Grotesk'" }}>{revTotalBilled>0?Math.round(revTotalCollected/revTotalBilled*100):0}%</span>
                  </td>
                </tr>
              </tfoot>
            </table>
          </div>
        </Card>
      </div>);
    }

    // ═══════════════ REPORTS HOME (CARDS) ═══════════════
    const fetchSubscriberRows = async () => {
      const tok = localStorage.getItem('j2_admin_token');
      const params = new URLSearchParams({ limit:'10000', page:'1' });
      if (subRptStatus && subRptStatus.length) params.set('status', subRptStatus.join(','));
      if (subRptPlanId) params.set('planId', subRptPlanId);
      if (subRptSearch) params.set('search', subRptSearch);
      const r = await fetch('/api/admin/subscribers?'+params.toString(), { headers: { Authorization: 'Bearer ' + tok } });
      if (!r.ok) throw new Error('Failed to fetch subscribers ('+r.status+')');
      const data = await r.json();
      return data.subscribers || [];
    };
    const previewSubRpt = async () => {
      setSubRptBusy(true);
      try { const rows = await fetchSubscriberRows(); setSubRptCount(rows.length); }
      catch (e) { alert(e.message); setSubRptCount(null); }
      finally { setSubRptBusy(false); }
    };
    const downloadSubscriberReport = async () => {
      setSubRptBusy(true);
      try {
        const rows = await fetchSubscriberRows();
        if (!rows.length) { alert('No subscribers match the selected filters.'); setSubRptBusy(false); return; }
        const cols = [
          ['accountNumber','Account #'],
          ['firstName','First Name'],
          ['lastName','Last Name'],
          ['companyName','Company'],
          ['email','Email'],
          ['phone','Phone'],
          ['address','Address'],
          ['barangay','Barangay'],
          ['municipality','Municipality'],
          ['planName','Plan'],
          ['planSpeed','Speed'],
          ['planPrice','Plan Price'],
          ['status','Status'],
          ['balance','Balance'],
          ['creditBalance','Credit'],
          ['installedAt','Installed'],
          ['macAddress','MAC'],
          ['createdAt','Created'],
        ];
        const esc = v => {
          if (v === null || v === undefined) return '';
          const s = String(v).replace(/"/g, '""');
          return /[",\n\r]/.test(s) ? '"'+s+'"' : s;
        };
        const flat = rows.map(s => ({
          ...s,
          planName: s.plan ? s.plan.name : '',
          planSpeed: s.plan ? s.plan.speed : '',
          planPrice: s.plan ? s.plan.price : '',
          installedAt: s.installedAt ? new Date(s.installedAt).toISOString().slice(0,10) : '',
          createdAt: s.createdAt ? new Date(s.createdAt).toISOString().slice(0,10) : '',
        }));
        const header = cols.map(c => esc(c[1])).join(',');
        const body = flat.map(r => cols.map(c => esc(r[c[0]])).join(',')).join('\r\n');
        const csv = '﻿' + header + '\r\n' + body;
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'subscribers-' + new Date().toISOString().slice(0,10) + '.csv';
        document.body.appendChild(a); a.click(); a.remove();
        URL.revokeObjectURL(url);
        setSubRptOpen(false);
      } catch (e) {
        alert('Subscriber report failed: ' + e.message);
      } finally {
        setSubRptBusy(false);
      }
    };

    const SUB_STATUSES = [
      { v:"prospective", label:"Prospective" },
      { v:"surveyed",    label:"Surveyed" },
      { v:"approved",    label:"Approved" },
      { v:"pending",     label:"Pending" },
      { v:"active",      label:"Active" },
      { v:"inactive",    label:"Inactive" },
      { v:"suspended",   label:"Suspended" },
      { v:"disconnected",label:"Disconnected" },
      { v:"declined",    label:"Declined" },
    ];
    const toggleSubStatus = v => setSubRptStatus(prev => prev.includes(v) ? prev.filter(x=>x!==v) : [...prev, v]);

    return (
    <div>
      <div style={{ display:"grid", gridTemplateColumns:"repeat(auto-fit, minmax(280px, 1fr))", gap:16 }}>
        {[
          { icon:"fa-file-invoice", title:"Invoice Report", desc:"Generated invoices by billing period with summary totals and collection status", action:"Generate", onClick:() => { setInvRptOpen(true); setInvRptPage(1); } },
          { icon:"fa-file-lines", title:"Statement of Account", desc:"Per-subscriber SOA showing all charges & payments with running balance — PDF export", action:"Generate", onClick:() => { setSoaOpen(true); } },
          { icon:"fa-hand-holding-dollar", title:"Collection Report", desc:"Payment collection rate, overdue accounts, aging analysis by period", action:"Generate", onClick:() => { setCollRptOpen(true); setCollRptPage(1); } },
          { icon:"fa-calendar-day", title:"Daily Collection", desc:"Payments received per day with method breakdown and transaction list", action:"Generate", onClick:() => { setDailyColOpen(true); setDailyColPage(1); setDailyColFrom(_todayIso()); setDailyColTo(_todayIso()); } },
          { icon:"fa-list-check", title:"For Collection List", desc:"Subscribers with outstanding balances — contact info, aging buckets, ready for field calling/SMS", action:"Generate", onClick:() => { setForColOpen(true); setForColPage(1); } },
          { icon:"fa-chart-line", title:"Revenue Report", desc:"Monthly revenue breakdown by plan, payment method with visual charts", action:"Generate", onClick:() => { setRevRptOpen(true); } },
          { icon:"fa-users", title:"Subscriber Report", desc:"Active/inactive subscribers by barangay and plan distribution", action:"Download CSV", onClick:() => { setSubRptOpen(true); setSubRptCount(null); } },
          { icon:"fa-chart-bar", title:"Ticket Analytics", desc:"Resolution times, ticket volume, category breakdown", action:"Generate" },
          { icon:"fa-map-location-dot", title:"Coverage Report", desc:"Coverage density, fiber utilization, expansion opportunities", action:"Generate" },
          { icon:"fa-heart-pulse", title:"Network Health", desc:"RADIUS session data, uptime stats, bandwidth utilization", action:"Generate" },
        ].map((r, i) => (
          <Card key={i} style={{ display:"flex", flexDirection:"column" }}>
            <div style={{ fontSize:30, marginBottom:12 }}><_Icon name={r.icon} /></div>
            <h3 style={{ fontSize:16, fontWeight:700, color:t.text, marginBottom:6 }}>{r.title}</h3>
            <p style={{ fontSize:13, color:t.textMuted, lineHeight:1.6, marginBottom:16, flex:1 }}>{r.desc}</p>
            <Btn primary style={{ width:"100%", justifyContent:"center" }} onClick={r.onClick}>{r.action}</Btn>
          </Card>
        ))}
      </div>

      {subRptOpen && (
        <div onClick={() => setSubRptOpen(false)} style={{ position:"fixed", inset:0, background:"rgba(0,0,0,0.6)", zIndex:1000, display:"flex", alignItems:"center", justifyContent:"center" }}>
          <div onClick={e => e.stopPropagation()} style={{ background:t.bgCard, border:`1px solid ${t.border}`, borderRadius:12, padding:24, width:560, maxWidth:"92vw", maxHeight:"86vh", overflow:"auto" }}>
            <div style={{ display:"flex", alignItems:"center", justifyContent:"space-between", marginBottom:16 }}>
              <h3 style={{ fontSize:17, fontWeight:700, color:t.text, margin:0 }}><i className="fas fa-users" style={{color:t.accent, marginRight:8}}></i>Subscriber Report — Filters</h3>
              <Btn small onClick={() => setSubRptOpen(false)}><i className="fas fa-times"></i></Btn>
            </div>

            <div style={{ marginBottom:14 }}>
              <label style={{ fontSize:11, fontWeight:700, color:t.textMuted, textTransform:"uppercase", letterSpacing:0.6, display:"block", marginBottom:8 }}>Status</label>
              <div style={{ display:"flex", flexWrap:"wrap", gap:6 }}>
                {SUB_STATUSES.map(s => {
                  const on = subRptStatus.includes(s.v);
                  return (
                    <button key={s.v} onClick={() => { toggleSubStatus(s.v); setSubRptCount(null); }} style={{ padding:"6px 12px", fontSize:12, fontWeight:600, borderRadius:6, border:`1px solid ${on?t.accent:t.border}`, background:on?t.accent:"transparent", color:on?"#fff":t.text, cursor:"pointer" }}>{s.label}</button>
                  );
                })}
              </div>
              <div style={{ display:"flex", gap:10, marginTop:8 }}>
                <a onClick={() => { setSubRptStatus(SUB_STATUSES.map(s=>s.v)); setSubRptCount(null); }} style={{ fontSize:11, color:t.accent, cursor:"pointer", textDecoration:"underline" }}>Select all</a>
                <a onClick={() => { setSubRptStatus([]); setSubRptCount(null); }} style={{ fontSize:11, color:t.accent, cursor:"pointer", textDecoration:"underline" }}>Clear</a>
