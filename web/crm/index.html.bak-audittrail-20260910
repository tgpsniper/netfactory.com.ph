                <div style={{background:"#1f2937",color:"#f9fafb",borderRadius:16,padding:"13px 16px",fontSize:13.5,lineHeight:1.55,maxWidth:330,wordBreak:"break-word",whiteSpace:"pre-wrap"}}>
