        {[
          {icon:"fa-users",label:"Total Subscribers",value:totalSubs,sub:`${activeSubs} active`,color:t.accent,page:"subscribers"},
          {icon:"fa-coins",label:"Monthly Revenue",value:fmt(monthlyRevenue),sub:new Date().toLocaleString("en-US",{month:"short",year:"numeric"}),color:t.success,page:"invoices",filter:"paid",tipKind:"revenue"},
          {icon:"fa-ticket",label:"Open Tickets",value:openTickets,sub:`${tickets.filter(tk=>tk.priority==="critical").length} critical`,color:t.warning,page:"tickets"},
