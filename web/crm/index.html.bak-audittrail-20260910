  const handleActivation = async () => {
    if (!activationModal || activationLoading) return;
    const af = parseFloat(activationForm.activationFee) || 0;
    const inf = parseFloat(activationForm.installationFee) || 0;
    const ef = parseFloat(activationForm.extraFiberCharge) || 0;
    // Prorate first month based on remaining days
    const now = new Date();
    const daysInMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate();
    const daysRemaining = daysInMonth - now.getDate() + 1;
    const fullPrice = activationModal.planPrice || 0;
    const prorated = Math.round((fullPrice / daysInMonth * daysRemaining) * 100) / 100;
    const mp = activationForm.includeFirstMonth ? prorated : 0;
    const oneTimeFees = af + inf + ef;
    const total = oneTimeFees + mp;
    if (total <= 0) { showConfirm({ icon:"fa-triangle-exclamation", title:"No Charges", message:"Enter at least one charge amount.", confirmText:"OK", confirmColor:"primary", onConfirm:()=>setShowConfirmModal(null) }); return; }
    if (!activationForm.dueDate) { showConfirm({ icon:"fa-triangle-exclamation", title:"Due Date Required", message:"Please set a due date for the prorated monthly.", confirmText:"OK", confirmColor:"primary", onConfirm:()=>setShowConfirmModal(null) }); return; }
    const taxRate = activationForm.taxType === "dti" ? 0.03 : 0.12;
    const taxLabel = activationForm.taxType === "dti" ? "DTI 3% PT" : "12% VAT";
    const who = toTitleCase(adminUser?.fullName || "Admin");
    const todayISO = new Date().toISOString().split("T")[0];
    setActivationLoading(true);
    try {
      const invoiceNums = [];
      // ── Invoice 1: One-time fees (due immediately) ──
      if (oneTimeFees > 0) {
        const feeLines = [];
        if (af > 0) feeLines.push("ACTIVATION FEE: " + af.toFixed(2));
        if (inf > 0) feeLines.push("INSTALLATION FEE: " + inf.toFixed(2));
        if (ef > 0) feeLines.push("EXTRA DROP FIBER: " + ef.toFixed(2));
        feeLines.push("TAX: " + taxLabel + " (INCLUSIVE)");
        const feeResp = await fetch(`${API}/admin/invoices/create`, {
          method: "POST", headers: authHeaders(),
          body: JSON.stringify({
            subscriberId: activationModal.id,
            amount: oneTimeFees,
            billingPeriod: "Activation — One-Time Fees",
            dueDate: todayISO,
            description: feeLines.join(" | "),
            notes: activationForm.notes || "",
            type: "activation"
          })
        });
        const feeData = await feeResp.json();
        if (feeData.error) { setActivationLoading(false); showConfirm({ icon:"fa-circle-xmark", title:"Invoice Error", message:feeData.error, confirmText:"OK", confirmColor:"primary", onConfirm:()=>setShowConfirmModal(null) }); return; }
        invoiceNums.push(feeData.invoiceNumber || feeData.number);
      }
      // ── Invoice 2: Prorated first month (due on selected date) ──
      if (mp > 0) {
        const monthLines = [];
        monthLines.push("FIRST MONTH PRORATED (" + activationModal.planNameFull + "): " + mp.toFixed(2) + " (" + daysRemaining + "/" + daysInMonth + " DAYS, FULL: " + fullPrice.toFixed(2) + ")");
        monthLines.push("TAX: " + taxLabel + " (INCLUSIVE)");
        const monthResp = await fetch(`${API}/admin/invoices/create`, {
          method: "POST", headers: authHeaders(),
          body: JSON.stringify({
            subscriberId: activationModal.id,
            amount: mp,
            billingPeriod: "Prorated — " + now.toLocaleDateString("en-PH", { month:"long", year:"numeric" }),
            dueDate: activationForm.dueDate,
            description: monthLines.join(" | "),
            notes: "",
            type: "monthly"
          })
        });
        const monthData = await monthResp.json();
        if (monthData.error) { setActivationLoading(false); showConfirm({ icon:"fa-circle-xmark", title:"Invoice Error", message:monthData.error, confirmText:"OK", confirmColor:"primary", onConfirm:()=>setShowConfirmModal(null) }); return; }
        invoiceNums.push(monthData.invoiceNumber || monthData.number);
      }
      // ── Update subscriber status to active ──
      const allLines = [];
      if (af > 0) allLines.push("ACTIVATION FEE: " + af.toFixed(2));
      if (inf > 0) allLines.push("INSTALLATION FEE: " + inf.toFixed(2));
      if (ef > 0) allLines.push("EXTRA DROP FIBER: " + ef.toFixed(2));
      if (mp > 0) allLines.push("PRORATED 1ST MONTH: " + mp.toFixed(2));
      allLines.push("TAX: " + taxLabel + " (INCLUSIVE)");
      const activateNote = `ACTIVATED: ${allLines.join(" | ")} — TOTAL: ${total.toFixed(2)} | INV: ${invoiceNums.join(", ")} (by ${who}, ${fmtDate(new Date())})`;
      const updatedNotes = (activationModal.notes ? activationModal.notes + "\n" : "") + activateNote;
      const subResp = await fetch(`${API}/admin/subscribers/${activationModal.id}`, {
        method: "PUT", headers: authHeaders(),
        body: JSON.stringify({ status: "active", notes: updatedNotes })
      });
      const subData = await subResp.json();
      if (subData.error) { setActivationLoading(false); return; }
      setActivationLoading(false);
      setActivationModal(null);
      setShowSubModal(false);
      setSelectedSub(null);
      fetchCrmData();
      const msg = invoiceNums.length === 2
        ? `2 invoices generated:\n• One-time fees: ₱${oneTimeFees.toFixed(2)} (due today)\n• Prorated monthly: ₱${mp.toFixed(2)} (due ${activationForm.dueDate})\n\nSubscriber is now active.`
