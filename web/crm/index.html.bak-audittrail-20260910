            onMouseLeave={e=>{e.currentTarget.style.transform="translateY(0)";e.currentTarget.style.boxShadow=t.shadow;e.currentTarget.style.borderColor=t.border;if(s.tipKind)e.currentTarget.style.zIndex=60;}}>
            <div style={{position:"absolute",top:0,right:0,width:80,height:80,background:`${s.color}08`,borderRadius:"0 0 0 80px",pointerEvents:"none"}} />
            <div style={{display:"flex",alignItems:"center",gap:14}}>
              <div style={{fontSize:28,width:48,height:48,display:"flex",alignItems:"center",justifyContent:"center",borderRadius:14,background:`${s.color}12`}}><_Icon name={s.icon} /></div>
