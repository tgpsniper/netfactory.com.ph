                  <div style={{ fontSize:24 }}><i className="fas fa-arrow-right"></i></div>
                  <div style={{ textAlign:"right" }}>
                    <div style={{ fontSize:11, fontWeight:600, color:t.warning, textTransform:"uppercase" }}>New Date</div>
                    <div style={{ fontSize:14, fontWeight:700, color:t.warning, marginTop:4 }}>{rescheduleDate ? new Date(rescheduleDate + "T00:00:00").toLocaleDateString('en-PH', {weekday:'short', month:'short', day:'numeric', year:'numeric'}) : "Pick date below"}</div>
                  </div>
                </div>
              )}

              {/* Date Picker */}
              <div style={{ marginBottom:16 }}>
                <label style={{ fontSize:12, fontWeight:700, color:t.textSec, textTransform:"uppercase", letterSpacing:1, marginBottom:8, display:"block" }}>Installation Date *</label>
                <input type="date" value={rescheduleDate} onChange={e => setRescheduleDate(e.target.value)}
                  min={new Date().toISOString().split('T')[0]}
                  style={{ width:"100%", padding:"12px 14px", border:`1px solid ${!rescheduleDate ? t.danger+"80" : t.inputBorder}`, borderRadius:10, fontSize:14, background:t.input, color:t.text, fontFamily:"inherit", outline:"none" }} />
              </div>

              {/* Reason (required for reschedule, optional for first time) */}
              <div style={{ marginBottom:20 }}>
                <label style={{ fontSize:12, fontWeight:700, color:t.textSec, textTransform:"uppercase", letterSpacing:1, marginBottom:8, display:"block" }}>
                  {isFirstTime ? "Notes (Optional)" : "Reason for Rescheduling *"} {!isFirstTime && <span style={{color:t.danger}}>(Required)</span>}
                </label>
                {!isFirstTime && (
                  <div style={{ display:"flex", flexDirection:"column", gap:6, marginBottom:10 }}>
                    {[
                      "Customer requested earlier date",
                      "Customer requested later date",
                      "Customer unavailable on original date",
                      "Installation crew unavailable",
                      "Materials/ONU not yet available",
                      "Weather or safety concerns",
                      "Area access issue",
                    ].map((r, i) => (
                      <div key={i} onClick={() => setRescheduleReason(r)}
                        style={{ padding:"10px 14px", borderRadius:10, cursor:"pointer", transition:"all .15s", fontSize:13,
                          background: rescheduleReason === r ? t.warning+"12" : t.bg,
                          border: rescheduleReason === r ? `2px solid ${t.warning}` : `1px solid ${t.border}`,
                          color: rescheduleReason === r ? t.warning : t.text, fontWeight: rescheduleReason === r ? 600 : 400 }}>
                        {r}
                      </div>
                    ))}
                  </div>
                )}
                <textarea value={rescheduleReason} onChange={e => setRescheduleReason(e.target.value)}
                  placeholder={isFirstTime ? "e.g. Customer prefers morning, needs ladder access..." : "Or type a custom reason..."}
                  style={{ width:"100%", padding:"12px 14px", border:`1px solid ${!isFirstTime && !rescheduleReason.trim() ? t.danger+"80" : t.inputBorder}`, borderRadius:10, fontSize:13, background:t.input, color:t.text, fontFamily:"inherit", outline:"none", resize:"vertical", minHeight:60 }} />
              </div>

              <div style={{ display:"flex", gap:12 }}>
                <Btn onClick={() => setRescheduleModal(null)} style={{ flex:1, justifyContent:"center" }}>Cancel</Btn>
                <Btn primary onClick={handleRescheduleSubmit} style={{ flex:2, justifyContent:"center", opacity: (rescheduleDate && (isFirstTime || rescheduleReason.trim())) ? 1 : 0.5 }}>
                  {isFirstTime ? "Set Date" : "Confirm Reschedule"}
                </Btn>
              </div>
            </div>
          </div>
        </div>
        );
      })()}

      {/* ========== ASSIGN INSTALLER MODAL ========== */}
      {assignInstallerModal && (
        <div style={{ position:"fixed", inset:0, background:"rgba(0,0,0,.6)", backdropFilter:"blur(6px)", zIndex:500, display:"flex", alignItems:"center", justifyContent:"center", padding:16 }}
>
          <div style={{ background:t.bgCard, borderRadius:20, maxWidth:520, width:"100%", boxShadow:"0 40px 80px rgba(0,0,0,.3)", border:`1px solid ${t.border}`, maxHeight:"90vh", display:"flex", flexDirection:"column" }}
            onClick={e => e.stopPropagation()}>
            <div style={{ padding:"22px 24px", borderBottom:`1px solid ${t.border}`, display:"flex", justifyContent:"space-between", alignItems:"center", flexShrink:0 }}>
              <div>
                <h2 style={{ fontSize:18, fontWeight:700, color:t.text, fontFamily:"'Space Grotesk'" }}>Assign Installer & ONU</h2>
                <div style={{ fontSize:13, color:t.textMuted, marginTop:4 }}>{subDisplayName(assignInstallerModal)} — {assignInstallerModal.acct}</div>
              </div>
              <div style={{ cursor:"pointer", fontSize:18, color:t.textMuted }} onClick={() => setAssignInstallerModal(null)}><i className="fas fa-xmark"></i></div>
            </div>
            <div style={{ padding:24, overflowY:"auto", flex:1 }}>
              {/* Subscriber Summary */}
              <div style={{ padding:"12px 16px", background:t.bg, borderRadius:12, marginBottom:20 }}>
                <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr", gap:10 }}>
                  <div><div style={{ fontSize:10, fontWeight:600, color:t.textMuted }}>ADDRESS</div><div style={{ fontSize:12, color:t.text, marginTop:2 }}>{assignInstallerModal.address}, {assignInstallerModal.barangay}</div></div>
                  <div><div style={{ fontSize:10, fontWeight:600, color:t.textMuted }}>PLAN</div><div style={{ fontSize:12, fontWeight:600, color:t.accent, marginTop:2 }}>{assignInstallerModal.planName || "—"}</div></div>
                  {(() => { const si = parseScheduleInfo(assignInstallerModal.notes); return si ? <div><div style={{ fontSize:10, fontWeight:600, color:t.textMuted }}>INSTALL DATE</div><div style={{ fontSize:12, fontWeight:600, color:t.warning, marginTop:2 }}>{si.displayDate}</div></div> : null; })()}
                </div>
              </div>

              {/* Select Installer */}
              <div style={{ marginBottom:20 }}>
                <label style={{ fontSize:12, fontWeight:700, color:t.textSec, textTransform:"uppercase", letterSpacing:1, marginBottom:10, display:"block" }}>Select Installer <span style={{ fontWeight:400, fontSize:11, color:t.textMuted }}>(optional)</span></label>
                <div style={{ display:"flex", flexDirection:"column", gap:6 }}>
                  {staffList.filter(s => s.is_active).map(s => (
                    <div key={s.id} onClick={() => setSelectedInstaller(prev => prev === s.id ? null : s.id)}
                      style={{
                        display:"flex", alignItems:"center", gap:12, padding:"12px 16px", borderRadius:12, cursor:"pointer", transition:"all .15s",
                        background: selectedInstaller === s.id ? t.accent+"10" : t.bg,
                        border: selectedInstaller === s.id ? `2px solid ${t.accent}` : `1px solid ${t.border}`,
                      }}>
                      <div style={{ width:36, height:36, borderRadius:10, background: selectedInstaller === s.id ? `linear-gradient(135deg,${t.accent},${t.accentDk})` : t.border, display:"flex", alignItems:"center", justifyContent:"center", color: selectedInstaller === s.id ? "#fff" : t.textMuted, fontWeight:700, fontSize:14 }}>{(s.full_name||"?")[0]}</div>
                      <div style={{ flex:1 }}>
                        <div style={{ fontSize:13, fontWeight: selectedInstaller === s.id ? 700 : 500, color: selectedInstaller === s.id ? t.accent : t.text }}>{s.full_name}</div>
                        <div style={{ fontSize:11, color:t.textMuted }}>{s.role || "Staff"}</div>
                      </div>
                      {selectedInstaller === s.id && <span style={{ fontSize:16, color:t.accent }}><i className="fas fa-check"></i></span>}
                    </div>
                  ))}
                  {staffList.filter(s => s.is_active).length === 0 && (
                    <div style={{ padding:20, textAlign:"center", color:t.textMuted, fontSize:13 }}>No active staff members found.</div>
                  )}
                </div>
              </div>

              {/* Select ONU — Enhanced with Current / Inventory / BYO / Skip */}
              {(() => {
                const alreadyAssigned = onuDevices.find(d => d.subscriber_id === assignInstallerModal.id && d.status === "deployed");
                const availableOnus = onuDevices.filter(d => d.status === "in_stock");
                const showTabs = onuAllocMode !== "current";
                return (
                  <div style={{ marginBottom:20 }}>
                    <label style={{ fontSize:12, fontWeight:700, color:t.textSec, textTransform:"uppercase", letterSpacing:1, marginBottom:10, display:"block" }}>ONU Device</label>

                    {/* Currently assigned — show when in "current" mode */}
                    {alreadyAssigned && onuAllocMode === "current" && (
                      <div style={{ padding:"14px 16px", background:t.success+"10", border:`1px solid ${t.success}30`, borderRadius:12, display:"flex", alignItems:"center", justifyContent:"space-between" }}>
                        <div>
                          <div style={{ fontSize:11, fontWeight:700, color:t.success, textTransform:"uppercase", letterSpacing:1, marginBottom:4 }}>Currently Assigned</div>
                          <div style={{ fontSize:13, fontWeight:700, color:t.text, fontFamily:"monospace" }}>{(alreadyAssigned.mac_address||"").toUpperCase()} — {alreadyAssigned.model}</div>
                          {alreadyAssigned.serial_number && <div style={{ fontSize:11, color:t.textMuted, marginTop:2 }}>SN: {alreadyAssigned.serial_number}</div>}
                        </div>
                        <Btn small onClick={() => setOnuAllocMode("inventory")} style={{ whiteSpace:"nowrap" }}>Change</Btn>
                      </div>
                    )}

                    {/* Mode tabs — show when changing or no existing ONU */}
                    {showTabs && (
                      <>
                        {alreadyAssigned && (
                          <div style={{ fontSize:12, color:t.warning, marginBottom:8, display:"flex", alignItems:"center", gap:6 }}>
                            <i className="fas fa-triangle-exclamation" style={{marginRight:4}}></i> Current ONU ({(alreadyAssigned.mac_address||"").toUpperCase()}) will be returned to stock
                            <span onClick={() => setOnuAllocMode("current")} style={{ color:t.accent, cursor:"pointer", fontWeight:600, marginLeft:4 }}>Cancel change</span>
                          </div>
                        )}
                        <div style={{ display:"flex", gap:4, marginBottom:12, background:t.bg, padding:3, borderRadius:10, border:`1px solid ${t.border}` }}>
                          {[
                            { id:"inventory", icon:"fas fa-box-open", label:"From Inventory" },
                            { id:"byo", icon:"fas fa-pen", label:"BYO / Manual" },
                            { id:"skip", icon:"fas fa-forward-step", label:"Skip" },
                          ].map(m => (
                            <button key={m.id} onClick={() => { setOnuAllocMode(m.id); if(m.id !== "inventory") setSelectedOnuForInstall(null); if(m.id !== "byo") setByoOnu({mac:"",model:"",serial:"",notes:""}); }}
                              style={{
                                flex:1, padding:"8px 12px", borderRadius:8, border:"none", cursor:"pointer", fontFamily:"inherit", transition:"all .15s",
                                background: onuAllocMode === m.id ? t.bgCard : "transparent", boxShadow: onuAllocMode === m.id ? t.shadow : "none",
                                color: onuAllocMode === m.id ? t.text : t.textMuted, fontWeight: onuAllocMode === m.id ? 700 : 500, fontSize:11,
                              }}><i className={m.icon} style={{marginRight:4}}></i> {m.label}</button>
                          ))}
                        </div>

                        {/* Inventory mode */}
                        {onuAllocMode === "inventory" && (
                          availableOnus.length > 0 ? (
                            <div style={{ maxHeight:200, overflowY:"auto", display:"flex", flexDirection:"column", gap:4 }}>
                              {availableOnus.slice(0, 20).map(d => (
                                <div key={d.id} onClick={() => setSelectedOnuForInstall(d.id)}
                                  style={{
                                    display:"flex", alignItems:"center", gap:12, padding:"10px 14px", borderRadius:10, cursor:"pointer", transition:"all .15s",
                                    background: selectedOnuForInstall === d.id ? t.success+"10" : t.bg,
                                    border: selectedOnuForInstall === d.id ? `2px solid ${t.success}` : `1px solid ${t.border}`,
                                  }}>
                                  <span style={{ fontSize:16 }}></span>
                                  <div style={{ flex:1 }}>
                                    <div style={{ fontSize:12, fontWeight:700, color: selectedOnuForInstall === d.id ? t.success : t.text, fontFamily:"monospace" }}>{(d.mac_address||'').toUpperCase()}</div>
                                    <div style={{ fontSize:11, color:t.textMuted }}>{d.model}{d.serial_number ? ` · SN: ${d.serial_number}` : ""}{d.vendor?.name ? ` · ${d.vendor.name}` : ""}</div>
                                  </div>
                                  {selectedOnuForInstall === d.id && <span style={{ fontSize:14, color:t.success }}><i className="fas fa-check"></i></span>}
                                </div>
                              ))}
                              {availableOnus.length > 20 && <div style={{ fontSize:11, color:t.textMuted, textAlign:"center", padding:6 }}>+{availableOnus.length - 20} more in stock</div>}
                            </div>
                          ) : (
                            <div style={{ padding:"14px 16px", background:t.warning+"08", border:`1px solid ${t.warning}20`, borderRadius:10, fontSize:13, color:t.warning }}>
                              No ONU in stock. Use <strong>BYO / Manual</strong> tab to enter customer's device, or add stock via ONU Inventory.
                            </div>
                          )
                        )}

                        {/* BYO / Manual mode */}
                        {onuAllocMode === "byo" && (
                          <div style={{ padding:"16px", background:t.bg, borderRadius:12, border:`1px solid ${t.border}` }}>
                            <div style={{ fontSize:12, color:t.info, fontWeight:600, marginBottom:12, display:"flex", alignItems:"center", gap:6 }}>
                              <span><i className="fas fa-circle-info"></i></span> Enter the customer's own ONU device details. This will be added to inventory as a deployed unit.
                            </div>
                            <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr", gap:10, marginBottom:10 }}>
                              <div>
                                <label style={{ fontSize:11, fontWeight:600, color:t.textMuted, marginBottom:4, display:"block" }}>MAC Address *</label>
                                <input className="input-upper" value={byoOnu.mac} onChange={e => setByoOnu({...byoOnu, mac:e.target.value})}
                                  placeholder="AA:BB:CC:DD:EE:FF"
                                  style={{ width:"100%", padding:"10px 12px", border:`1px solid ${!byoOnu.mac.trim() ? t.danger+"60" : t.inputBorder}`, borderRadius:8, fontSize:13, background:t.input, color:t.text, fontFamily:"'Courier New',monospace", outline:"none", letterSpacing:0.5 }} />
                              </div>
                              <div>
                                <label style={{ fontSize:11, fontWeight:600, color:t.textMuted, marginBottom:4, display:"block" }}>Model</label>
                                <input value={byoOnu.model} onChange={e => setByoOnu({...byoOnu, model:e.target.value})}
                                  placeholder="e.g. HG8546M, AN5506-04-F"
                                  style={{ width:"100%", padding:"10px 12px", border:`1px solid ${t.inputBorder}`, borderRadius:8, fontSize:13, background:t.input, color:t.text, fontFamily:"inherit", outline:"none" }} />
                              </div>
                            </div>
                            <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr", gap:10 }}>
                              <div>
                                <label style={{ fontSize:11, fontWeight:600, color:t.textMuted, marginBottom:4, display:"block" }}>Serial Number</label>
                                <input className="input-upper" value={byoOnu.serial} onChange={e => setByoOnu({...byoOnu, serial:e.target.value})}
                                  placeholder="Optional"
                                  style={{ width:"100%", padding:"10px 12px", border:`1px solid ${t.inputBorder}`, borderRadius:8, fontSize:13, background:t.input, color:t.text, fontFamily:"monospace", outline:"none" }} />
                              </div>
                              <div>
                                <label style={{ fontSize:11, fontWeight:600, color:t.textMuted, marginBottom:4, display:"block" }}>Notes</label>
                                <input value={byoOnu.notes} onChange={e => setByoOnu({...byoOnu, notes:e.target.value})}
                                  placeholder="e.g. Used unit from prev ISP"
                                  style={{ width:"100%", padding:"10px 12px", border:`1px solid ${t.inputBorder}`, borderRadius:8, fontSize:13, background:t.input, color:t.text, fontFamily:"inherit", outline:"none" }} />
                              </div>
                            </div>
                          </div>
                        )}

                        {/* Skip mode */}
                        {onuAllocMode === "skip" && (
                          <div style={{ padding:"14px 16px", background:t.bg, border:`1px solid ${t.border}`, borderRadius:10, fontSize:13, color:t.textMuted, textAlign:"center" }}>
                            No ONU will be assigned. You can allocate one later from the Provisioning queue.
                          </div>
                        )}
                      </>
                    )}
                  </div>
                );
              })()}

              {/* Summary */}
              {(selectedInstaller || selectedOnuForInstall || (onuAllocMode === "byo" && byoOnu.mac.trim()) || onuAllocMode === "current") && (
                <div style={{ padding:"12px 16px", background:t.accent+"08", border:`1px solid ${t.accent}20`, borderRadius:12, marginBottom:20 }}>
                  <div style={{ fontSize:11, fontWeight:700, color:t.accent, textTransform:"uppercase", letterSpacing:1, marginBottom:6 }}>Assignment Summary</div>
                  {selectedInstaller && <div style={{ fontSize:13, color:t.text }}><strong>{staffList.find(s => s.id === selectedInstaller)?.full_name || "—"}</strong> assigned as installer</div>}
                  {onuAllocMode === "current" && (() => { const a = onuDevices.find(d => d.subscriber_id === assignInstallerModal.id && d.status === "deployed"); return a ? <div style={{ fontSize:13, color:t.text, marginTop:4 }}>ONU <strong style={{ fontFamily:"monospace" }}>{(a.mac_address||"").toUpperCase()}</strong> (keeping current)</div> : null; })()}
                  {onuAllocMode === "inventory" && selectedOnuForInstall && <div style={{ fontSize:13, color:t.text, marginTop:4 }}>ONU <strong style={{ fontFamily:"monospace" }}>{(onuDevices.find(d => d.id === selectedOnuForInstall)?.mac_address || "—").toUpperCase()}</strong> will be deployed</div>}
                  {onuAllocMode === "byo" && byoOnu.mac.trim() && <div style={{ fontSize:13, color:t.text, marginTop:4 }}><i className="fas fa-pen" style={{marginRight:4}}></i> BYO ONU <strong style={{ fontFamily:"monospace" }}>{byoOnu.mac.trim().toUpperCase()}</strong>{byoOnu.model ? ` (${byoOnu.model})` : ""} will be registered & deployed</div>}
                  {onuAllocMode === "skip" && <div style={{ fontSize:12, color:t.warning, marginTop:4 }}><i className="fas fa-triangle-exclamation" style={{marginRight:4}}></i> No ONU selected — you can assign one later</div>}
                  {onuAllocMode === "inventory" && !selectedOnuForInstall && !onuDevices.find(d => d.subscriber_id === assignInstallerModal.id && d.status === "deployed") && <div style={{ fontSize:12, color:t.warning, marginTop:4 }}><i className="fas fa-triangle-exclamation" style={{marginRight:4}}></i> No ONU selected — pick one or switch to BYO/Skip</div>}
                </div>
              )}

              <div style={{ display:"flex", gap:12 }}>
                <Btn onClick={() => setAssignInstallerModal(null)} style={{ flex:1, justifyContent:"center" }}>Cancel</Btn>
                <Btn primary onClick={handleAssignInstaller} style={{ flex:2, justifyContent:"center", opacity: (selectedInstaller || (onuAllocMode === "inventory" && selectedOnuForInstall) || (onuAllocMode === "byo" && byoOnu.mac.trim()) || onuAllocMode === "current") ? 1 : 0.5 }}>
                  {installAssignLoading ? "Assigning..." : "Confirm Assignment"}
                </Btn>
              </div>
            </div>
          </div>
        </div>
      )}

      {/* ========== DECLINE APPLICATION MODAL ========== */}
      {/* Survey Modal - Photo + GPS */}
      {showSurveyModal && (
        <div style={{ position:"fixed", inset:0, background:"rgba(0,0,0,0.5)", zIndex:1000, display:"flex", alignItems:"center", justifyContent:"center", padding:16 }}
>
          <div style={{ background:t.bgCard, borderRadius:20, width:"100%", maxWidth:500, maxHeight:"90vh", overflowY:"auto", boxShadow:t.shadow }}>
            <div style={{ padding:"24px 28px", borderBottom:"1px solid "+t.border, display:"flex", justifyContent:"space-between", alignItems:"center" }}>
              <div>
                <h2 style={{ fontSize:18, fontWeight:700, color: showSurveyModal.surveyResult === "approved" ? "#8b5cf6" : t.danger, fontFamily:"'Space Grotesk'" }}>
                  {showSurveyModal.surveyResult === "approved" ? "Approve Survey" : "Decline Survey"}
                </h2>
                <div style={{ fontSize:13, color:t.textMuted, marginTop:4 }}>{subDisplayName(showSurveyModal)} — {showSurveyModal.acct}</div>
              </div>
              <div style={{ cursor:"pointer", fontSize:18, color:t.textMuted }} onClick={() => setShowSurveyModal(null)}><i className="fas fa-xmark"></i></div>
            </div>
            <div style={{ padding:"20px 28px" }}>
              <div style={{ padding:"12px 16px", borderRadius:10, marginBottom:16, fontSize:13, background: surveyForm.latitude ? t.success+"15" : t.warning+"15", color: surveyForm.latitude ? t.success : t.warning, fontWeight:600 }}>
                 {surveyForm.gpsStatus}
                {surveyForm.latitude && <span style={{ fontSize:11, fontWeight:400, marginLeft:8 }}>({surveyForm.latitude.toFixed(6)}, {surveyForm.longitude.toFixed(6)})</span>}
              </div>
              <div style={{ marginBottom:16 }}>
                <label style={{ fontSize:12, fontWeight:600, color:t.textSec, marginBottom:8, display:"block" }}>Site Photo (Required)</label>
                {surveyForm.photoPreview ? (
                  <div style={{ position:"relative" }}>
                    <img src={surveyForm.photoPreview} style={{ width:"100%", maxHeight:300, objectFit:"cover", borderRadius:12, border:"1px solid "+t.border }} />
                    <button onClick={() => setSurveyForm(f=>({...f, photo:null, photoPreview:null}))} style={{ position:"absolute", top:8, right:8, background:"rgba(0,0,0,0.6)", color:"#fff", border:"none", borderRadius:"50%", width:28, height:28, cursor:"pointer", fontSize:14 }}><i className="fas fa-xmark"></i></button>
                  </div>
                ) : (
                  <div style={{ display:"flex", gap:8 }}>
                    <label style={{ flex:1, padding:"20px 16px", borderRadius:12, border:"2px dashed "+t.border, textAlign:"center", cursor:"pointer", background:t.bg, transition:"all .2s" }}>
                      <div style={{ fontSize:28, marginBottom:6 }}></div>
                      <div style={{ fontSize:12, fontWeight:600, color:t.accent }}>Take Photo</div>
                      <div style={{ fontSize:10, color:t.textMuted, marginTop:2 }}>Use camera</div>
                      <input type="file" accept="image/*" capture="environment" onChange={handleSurveyPhoto} style={{ display:"none" }} />
                    </label>
                    <label style={{ flex:1, padding:"20px 16px", borderRadius:12, border:"2px dashed "+t.border, textAlign:"center", cursor:"pointer", background:t.bg, transition:"all .2s" }}>
                      <div style={{ fontSize:28, marginBottom:6 }}></div>
                      <div style={{ fontSize:12, fontWeight:600, color:t.accent }}>Upload Photo</div>
                      <div style={{ fontSize:10, color:t.textMuted, marginTop:2 }}>From gallery</div>
                      <input type="file" accept="image/*" onChange={handleSurveyPhoto} style={{ display:"none" }} />
                    </label>
                  </div>
                )}
              </div>
              <div style={{ marginBottom:16 }}>
                <label style={{ fontSize:12, fontWeight:600, color:t.textSec, marginBottom:6, display:"block" }}>Survey Notes</label>
                <textarea value={surveyForm.notes} onChange={e => setSurveyForm(f=>({...f, notes:e.target.value}))}
                  placeholder={showSurveyModal.surveyResult === "approved" ? "Site is accessible, clear LOS to tower..." : "Reason for declining..."}
                  rows={3} style={{ width:"100%", padding:"12px 14px", border:"1px solid "+t.inputBorder, borderRadius:10, fontSize:13, background:t.input, color:t.text, fontFamily:"inherit", outline:"none", resize:"vertical" }} />
              </div>
              <div style={{ display:"flex", gap:10 }}>
                <Btn onClick={() => setShowSurveyModal(null)} style={{ flex:1, justifyContent:"center" }}>Cancel</Btn>
                {showSurveyModal.surveyResult === "approved" ? (
                  <Btn primary style={{ flex:2, justifyContent:"center", background:"#8b5cf6", borderColor:"#8b5cf6", opacity: !surveyForm.photo ? 0.5 : 1 }} onClick={submitSurvey}>
                    {surveyLoading ? "Submitting..." : React.createElement("span",null,React.createElement("i",{className:"fas fa-check",style:{marginRight:4}})," Approve & Submit Survey")}
                  </Btn>
                ) : (
                  <Btn danger style={{ flex:2, justifyContent:"center", opacity: !surveyForm.photo ? 0.5 : 1 }} onClick={submitSurvey}>
                    {surveyLoading ? "Submitting..." : <><i className="fas fa-circle-xmark" style={{marginRight:4}}></i> Decline &amp; Submit Survey</>}
                  </Btn>
                )}
              </div>
              {!surveyForm.photo && <div style={{ fontSize:11, color:t.danger, textAlign:"center", marginTop:8 }}><i className="fas fa-triangle-exclamation" style={{marginRight:4}}></i> Photo is required to submit survey</div>}
            </div>
          </div>
        </div>
      )}

      {/* ========== DECLINE APPLICATION MODAL ========== */}
