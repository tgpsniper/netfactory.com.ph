              {csvData.length > 0 && (
                <div>
                  <div style={{ fontSize:14, fontWeight:700, color:t.text, marginBottom:12 }}>
                    Preview ({csvData.length} device{csvData.length !== 1 ? 's' : ''})
                  </div>
                  <div style={{ overflowX:"auto", maxHeight:300, overflowY:"auto", borderRadius:10, border:'1px solid '+t.border }}>
                    <table style={{ width:"100%", borderCollapse:"collapse", minWidth:500 }}>
                      <thead>
                        <tr style={{ background:t.bg }}>
                          <th style={{ padding:"8px 12px", fontSize:11, fontWeight:700, color:t.textMuted, textAlign:"left", borderBottom:'1px solid '+t.border }}>#</th>
                          <th style={{ padding:"8px 12px", fontSize:11, fontWeight:700, color:t.textMuted, textAlign:"left", borderBottom:'1px solid '+t.border }}>MAC</th>
                          <th style={{ padding:"8px 12px", fontSize:11, fontWeight:700, color:t.textMuted, textAlign:"left", borderBottom:'1px solid '+t.border }}>Model</th>
                          <th style={{ padding:"8px 12px", fontSize:11, fontWeight:700, color:t.textMuted, textAlign:"left", borderBottom:'1px solid '+t.border }}>Vendor</th>
                          <th style={{ padding:"8px 12px", fontSize:11, fontWeight:700, color:t.textMuted, textAlign:"right", borderBottom:'1px solid '+t.border }}>Price</th>
                        </tr>
                      </thead>
                      <tbody>
                        {csvData.slice(0, 20).map((row, i) => (
                          <tr key={i}>
                            <td style={{ padding:"6px 12px", fontSize:11, color:t.textMuted, borderBottom:'1px solid '+t.border }}>{i+1}</td>
                            <td style={{ padding:"6px 12px", fontSize:11, fontFamily:"monospace", color:t.accent, fontWeight:600, borderBottom:'1px solid '+t.border }}>{row.mac_address}</td>
                            <td style={{ padding:"6px 12px", fontSize:11, color:t.text, borderBottom:'1px solid '+t.border }}>{row.model}</td>
                            <td style={{ padding:"6px 12px", fontSize:11, color:t.textSec, borderBottom:'1px solid '+t.border }}>{row.vendor_name || '—'}</td>
                            <td style={{ padding:"6px 12px", fontSize:11, color:t.textSec, borderBottom:'1px solid '+t.border, textAlign:"right" }}>{row.purchase_price ? fmtPrice(row.purchase_price) : '—'}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                    {csvData.length > 20 && <div style={{ padding:10, textAlign:"center", fontSize:11, color:t.textMuted }}>...and {csvData.length - 20} more</div>}
                  </div>

                  <div style={{ display:"flex", gap:12, marginTop:16 }}>
                    <Btn onClick={() => { setCsvData([]); }} style={{ flex:1, justifyContent:"center" }}>Clear</Btn>
                    <Btn primary onClick={handleCsvImport} style={{ flex:2, justifyContent:"center" }}>
                      {csvImporting ? 'Importing...' : 'Import '+csvData.length+' Device'+(csvData.length !== 1 ? 's' : '')}
                    </Btn>
                  </div>
                </div>
              )}

              {csvData.length === 0 && (
                <div style={{ display:"flex", gap:12, marginTop:8 }}>
                  <Btn onClick={() => { setShowCsvImport(false); setCsvData([]); }} style={{ width:"100%", justifyContent:"center" }}>Cancel</Btn>
                </div>
              )}
            </div>
          </div>
        </div>
      )}

      {/* ========== INCOMING CALL POPUP ========== */}
      {incomingCall && (
        <div style={{position:"fixed",bottom:24,right:24,width:340,background:t.bgCard,borderRadius:16,border:`2px solid ${t.accent}`,boxShadow:"0 20px 60px rgba(0,0,0,.3)",zIndex:10000,animation:"fadeIn .3s",overflow:"hidden"}}>
          <div style={{background:`linear-gradient(135deg,${t.accent},${t.accentDk})`,padding:"14px 18px",display:"flex",alignItems:"center",gap:12}}>
            <div style={{width:40,height:40,borderRadius:12,background:"rgba(255,255,255,.2)",display:"flex",alignItems:"center",justifyContent:"center",animation:"pulse 1.5s infinite"}}><i className="fas fa-phone-volume" style={{color:"#fff",fontSize:18}}></i></div>
            <div style={{flex:1}}>
              <div style={{color:"#fff",fontWeight:700,fontSize:14}}>Incoming Call</div>
              <div style={{color:"rgba(255,255,255,.8)",fontSize:11}}>{incomingCall.direction === "inbound" ? "Inbound" : "Outbound"} call on ext. {incomingCall.extension || "—"}</div>
            </div>
          </div>
          <div style={{padding:"14px 18px"}}>
            <div style={{fontSize:16,fontWeight:700,color:t.text,marginBottom:4}}>{incomingCall.subscriber ? `${incomingCall.subscriber.first_name} ${incomingCall.subscriber.last_name}` : "Unknown Caller"}</div>
            <div style={{fontSize:13,color:t.textMuted,fontFamily:"monospace",marginBottom:4}}>{incomingCall.callerNumber}</div>
            {incomingCall.subscriber && <div style={{fontSize:11,color:t.accent,fontWeight:600}}>{incomingCall.subscriber.account_number}</div>}
          </div>
          <div style={{display:"flex",gap:8,padding:"0 18px 14px"}}>
            {incomingCall.subscriber && <button onClick={()=>{const sub=subscribers.find(s=>s.id===incomingCall.subscriber.id);if(sub){setSelectedSub(sub);setShowSubModal(true);loadCreditHistory(sub.id);loadCallHistory(sub.id);loadSmsHistory(sub.id);}setIncomingCall(null);}} style={{flex:1,padding:"8px 12px",borderRadius:10,background:`${t.accent}15`,color:t.accent,border:`1px solid ${t.accent}30`,fontSize:12,fontWeight:700,cursor:"pointer",fontFamily:"inherit"}}>View Account</button>}
            <button onClick={()=>setIncomingCall(null)} style={{padding:"8px 16px",borderRadius:10,background:t.bg,color:t.textSec,border:`1px solid ${t.border}`,fontSize:12,fontWeight:600,cursor:"pointer",fontFamily:"inherit"}}>Dismiss</button>
          </div>
        </div>
      )}

      {/* ========== NOTIFICATIONS MODAL ========== */}
      {showNotifModal && (() => {
        const totalNotifs = notifications.length;
        const totalPages = notifShowAll ? 1 : Math.ceil(totalNotifs / notifsPerPage);
        const displayNotifs = notifShowAll ? notifications : notifications.slice((notifModalPage - 1) * notifsPerPage, notifModalPage * notifsPerPage);
        const safePage = Math.min(notifModalPage, totalPages || 1);

        // Page numbers to show (max 7 centered around current)
        const pageNumbers = [];
        if (totalPages <= 7) {
          for (let i = 1; i <= totalPages; i++) pageNumbers.push(i);
        } else {
          pageNumbers.push(1);
          let start = Math.max(2, safePage - 1);
          let end = Math.min(totalPages - 1, safePage + 1);
          if (safePage <= 3) { start = 2; end = 5; }
          if (safePage >= totalPages - 2) { start = totalPages - 4; end = totalPages - 1; }
          if (start > 2) pageNumbers.push("...");
          for (let i = start; i <= end; i++) pageNumbers.push(i);
          if (end < totalPages - 1) pageNumbers.push("...");
          pageNumbers.push(totalPages);
        }

        return (
          <div style={{ position:"fixed", inset:0, background:"rgba(0,0,0,.6)", backdropFilter:"blur(6px)", zIndex:1100, display:"flex", alignItems:"center", justifyContent:"center", padding:16, animation:"fadeIn .2s" }}
>
            <div style={{
              background:t.bgCard, borderRadius:20, width:"100%",
              maxWidth: notifExpanded ? "95%" : 640,
              maxHeight: notifExpanded ? "95vh" : "85vh",
              display:"flex", flexDirection:"column",
              boxShadow:"0 40px 80px rgba(0,0,0,.3)", border:`1px solid ${t.border}`,
              transition:"max-width .3s, max-height .3s",
            }}>
              {/* Header */}
              <div style={{ padding:"18px 24px", borderBottom:`1px solid ${t.border}`, display:"flex", justifyContent:"space-between", alignItems:"center", flexShrink:0 }}>
                <div style={{ display:"flex", alignItems:"center", gap:10 }}>
                  <span style={{ fontSize:20 }}></span>
                  <h2 style={{ fontSize:18, fontWeight:700, color:t.text, fontFamily:"'Space Grotesk',sans-serif" }}>All Notifications</h2>
                  <span style={{ fontSize:12, color:t.textMuted, background:t.bg, padding:"3px 10px", borderRadius:12 }}>{totalNotifs} total</span>
                </div>
                <div style={{ display:"flex", alignItems:"center", gap:8 }}>
                  {/* Show All toggle */}
                  <button onClick={() => { setNotifShowAll(!notifShowAll); setNotifModalPage(1); }} style={{
                    padding:"6px 14px", borderRadius:8, fontSize:12, fontWeight:600, cursor:"pointer", fontFamily:"inherit", border:`1px solid ${t.border}`, transition:"all .2s",
                    background: notifShowAll ? t.accent : t.bgCard, color: notifShowAll ? "#fff" : t.textSec,
                  }}>{notifShowAll ? "Paginated" : "Show All"}</button>
                  {/* Expand toggle */}
                  <button onClick={() => setNotifExpanded(!notifExpanded)} style={{
                    padding:"6px 10px", borderRadius:8, fontSize:14, cursor:"pointer", border:`1px solid ${t.border}`,
                    background:t.bgCard, color:t.textSec, fontFamily:"inherit", lineHeight:1,
                  }} title={notifExpanded ? "Collapse" : "Expand"}>{notifExpanded ? React.createElement("i",{className:"fas fa-square-minus"}) : React.createElement("i",{className:"fas fa-square-plus"})}</button>
                  {/* Close */}
                  <div style={{ cursor:"pointer", fontSize:18, color:t.textMuted, padding:"2px 6px" }} onClick={() => setShowNotifModal(false)}><i className="fas fa-xmark"></i></div>
                </div>
              </div>

              {/* Notification list */}
              <div className="notif-scroll" style={{ flex:1, overflowY:"auto", padding:"0" }}>
                {displayNotifs.length === 0 && <div style={{ padding:40, textAlign:"center", fontSize:14, color:t.textMuted }}>No notifications found.</div>}
                {displayNotifs.map((n, idx) => (
                  <div key={n.id} style={{ padding:"14px 24px", borderBottom:`1px solid ${t.border}`, display:"flex", gap:12, alignItems:"flex-start", transition:"background .15s" }}
                    onMouseEnter={e => e.currentTarget.style.background = `${t.accent}06`}
                    onMouseLeave={e => e.currentTarget.style.background = "transparent"}>
                    <div style={{ width:10, height:10, borderRadius:"50%", background:{ danger:t.danger, warning:t.warning, success:t.success, info:t.info }[n.type] || t.info, marginTop:4, flexShrink:0 }} />
                    <div style={{ flex:1, minWidth:0 }}>
                      <div style={{ fontSize:13, color:t.text, lineHeight:1.6 }}>{n.text}</div>
                      <div style={{ fontSize:11, color:t.textMuted, marginTop:4 }}>{n.time}</div>
                    </div>
                    {!notifShowAll && <span style={{ fontSize:11, color:t.textMuted, flexShrink:0 }}>#{(notifModalPage - 1) * notifsPerPage + idx + 1}</span>}
                    {notifShowAll && <span style={{ fontSize:11, color:t.textMuted, flexShrink:0 }}>#{idx + 1}</span>}
                  </div>
                ))}
              </div>

              {/* Pagination footer */}
              {!notifShowAll && totalPages > 0 && (
                <div style={{ padding:"14px 24px", borderTop:`1px solid ${t.border}`, display:"flex", justifyContent:"space-between", alignItems:"center", flexShrink:0, flexWrap:"wrap", gap:8 }}>
                  <span style={{ fontSize:12, color:t.textMuted }}>
                    Showing {Math.min((safePage - 1) * notifsPerPage + 1, totalNotifs)}–{Math.min(safePage * notifsPerPage, totalNotifs)} of {totalNotifs}
                  </span>
                  <div style={{ display:"flex", gap:4, alignItems:"center", flexWrap:"wrap" }}>
                    {/* Prev */}
                    <button onClick={() => setNotifModalPage(Math.max(1, safePage - 1))} disabled={safePage <= 1}
                      style={{ padding:"6px 12px", borderRadius:8, border:`1px solid ${t.border}`, background:t.bgCard, color: safePage <= 1 ? t.textMuted : t.textSec, fontSize:12, fontWeight:600, cursor: safePage <= 1 ? "default" : "pointer", fontFamily:"inherit", opacity: safePage <= 1 ? .5 : 1 }}><i className="fas fa-arrow-left" style={{marginRight:4}}></i> Prev</button>
                    {/* Page numbers */}
                    {pageNumbers.map((p, i) => (
                      p === "..." ? <span key={"e"+i} style={{ padding:"0 4px", color:t.textMuted, fontSize:12 }}>…</span> :
                      <button key={p} onClick={() => setNotifModalPage(p)}
                        style={{ width:32, height:32, borderRadius:8, border:`1px solid ${t.border}`, fontSize:12, fontWeight: p === safePage ? 700 : 400, cursor:"pointer", fontFamily:"inherit", transition:"all .2s",
                          background: p === safePage ? t.accent : t.bgCard, color: p === safePage ? "#fff" : t.textSec,
                        }}>{p}</button>
                    ))}
                    {/* Next */}
                    <button onClick={() => setNotifModalPage(Math.min(totalPages, safePage + 1))} disabled={safePage >= totalPages}
                      style={{ padding:"6px 12px", borderRadius:8, border:`1px solid ${t.border}`, background:t.bgCard, color: safePage >= totalPages ? t.textMuted : t.textSec, fontSize:12, fontWeight:600, cursor: safePage >= totalPages ? "default" : "pointer", fontFamily:"inherit", opacity: safePage >= totalPages ? .5 : 1 }}>Next <i className="fas fa-arrow-right" style={{marginLeft:4}}></i></button>
                  </div>
                </div>
              )}
              {notifShowAll && (
                <div style={{ padding:"14px 24px", borderTop:`1px solid ${t.border}`, display:"flex", justifyContent:"center", alignItems:"center", flexShrink:0 }}>
                  <span style={{ fontSize:12, color:t.textMuted }}>Showing all {totalNotifs} notifications</span>
                </div>
              )}
            </div>
          </div>
        );
      })()}
</div>
  );
};



