                    </div>
                    <button onClick={()=>setAddSubForm(f=>({...f,referrerId:null,referrerLabel:"",referrerQuery:""}))} style={{background:"none",border:"none",color:t.danger,cursor:"pointer",fontSize:14,flexShrink:0}}><i className="fas fa-xmark"></i></button>
                  </div>
                ) : (
                  <div style={{position:"relative"}}>
                    <input value={addSubForm.referrerQuery||""} onChange={e=>setAddSubForm(f=>({...f,referrerQuery:e.target.value}))} placeholder="Search existing subscriber by name or account #..." style={{width:"100%",padding:"12px 14px",border:"1px solid "+t.inputBorder,borderRadius:10,fontSize:13,background:t.input,color:t.text,fontFamily:"inherit",outline:"none"}} />
                    {(addSubForm.referrerQuery||"").trim().length>=2 && (()=>{
                      const q=(addSubForm.referrerQuery||"").trim().toLowerCase();
                      const nm=s=>((s.firstName||s.lastName)?`${s.firstName||""} ${s.lastName||""}`.trim():(s.companyName||s.acct));
                      const matches=subscribers.filter(s=>nm(s).toLowerCase().includes(q)||(s.acct||"").toLowerCase().includes(q)).slice(0,6);
                      return matches.length?(
                        <div style={{position:"absolute",top:"100%",left:0,right:0,zIndex:10,marginTop:4,background:t.bgCard,border:`1px solid ${t.border}`,borderRadius:10,boxShadow:"0 10px 30px rgba(0,0,0,.25)",overflow:"hidden"}}>
                          {matches.map(s=>(
                            <div key={s.id} onClick={()=>setAddSubForm(f=>({...f,referrerId:s.id,referrerLabel:`${nm(s)} · ${s.acct}`,referrerQuery:""}))} style={{padding:"10px 14px",cursor:"pointer",borderBottom:`1px solid ${t.border}`,display:"flex",justifyContent:"space-between",gap:8}}>
                              <span style={{fontSize:13,color:t.text,fontWeight:500}}>{nm(s)}</span>
                              <span style={{fontSize:12,color:t.textMuted,fontFamily:"monospace"}}>{s.acct}</span>
                            </div>
                          ))}
                        </div>
                      ):null;
                    })()}
                  </div>
                )}
                {addSubForm.referrerId && Number(cs.referral_reward_amount)>0 && (
                  <div style={{fontSize:11,color:t.textMuted,marginTop:6}}><i className="fas fa-circle-info" style={{marginRight:5}}></i>Referrer gets ₱{Number(cs.referral_reward_amount).toLocaleString()} credit when this subscriber is activated.</div>
                )}
              </div>
              {/* Attachments */}
