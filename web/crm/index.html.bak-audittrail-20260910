                <div style={{fontSize:11,fontWeight:600,color:t.textMuted,marginBottom:4,textTransform:"uppercase",letterSpacing:".5px"}}>{s.label}</div>
                <div style={{fontSize:26,fontWeight:800,color:t.text,fontFamily:"'Space Grotesk'",lineHeight:1,textAlign:"right"}}>{s.value}</div>
                <div style={{fontSize:11,color:s.color,fontWeight:600,marginTop:4}}>{s.sub}</div>
              </div>
            </div>
            {s.tipKind === "revenue" && (
              <label onClick={e=>e.stopPropagation()} style={{display:"flex",alignItems:"center",gap:6,marginTop:12,fontSize:10,color:t.textMuted,cursor:"pointer",userSelect:"none",position:"relative",zIndex:1}}>
                <input type="checkbox" checked={dashInclCredit} onClick={e=>e.stopPropagation()} onChange={e=>setDashInclCredit(e.target.checked)} style={{width:13,height:13,accentColor:s.color,cursor:"pointer"}} />
                <span>Include credit applications{monthlyRevenueCredit>0?` (${fmt(monthlyRevenueCredit)})`:""}</span>
              </label>
            )}
            {s.tipKind === "revenue" && (
              <div className="kpi-tip" style={{position:"absolute",top:"100%",left:0,minWidth:520,marginTop:8,background:t.bgCard,border:`1px solid ${t.border}`,borderRadius:12,padding:"14px 16px",boxShadow:"0 16px 40px -8px rgba(0,0,0,.4)",zIndex:50,opacity:0,visibility:"hidden",transform:"translateY(-4px)",transition:"all .15s",pointerEvents:"none"}}>
                {/* Shared 4-column grid for header + quarter rows + total */}
                <div style={{display:"grid",gridTemplateColumns:"42px 70px 1fr 1fr",gap:10,fontSize:11,fontWeight:700,color:t.textMuted,textTransform:"uppercase",letterSpacing:".8px",paddingBottom:6,borderBottom:`1px solid ${t.border}`}}>
                  <span style={{gridColumn:"1 / span 2"}}>Quarterly · {_ytdYear}</span>
                  <span style={{color:t.success,fontSize:10,fontWeight:600,textAlign:"right"}}>Collected</span>
                  <span style={{color:t.danger,fontSize:10,fontWeight:600,textAlign:"right"}}>Outstanding</span>
                </div>
                {["Q1","Q2","Q3","Q4"].map(q => {
                  const row = _quarterly[q] || {collected:0,outstanding:0};
                  const months = q==="Q1"?"Jan–Mar":q==="Q2"?"Apr–Jun":q==="Q3"?"Jul–Sep":"Oct–Dec";
                  return (
                    <div key={q} style={{display:"grid",gridTemplateColumns:"42px 70px 1fr 1fr",gap:10,padding:"6px 0",fontSize:12,alignItems:"center",borderTop:`1px dashed ${t.border}`}}>
                      <span style={{fontWeight:700,color:t.text}}>{q}</span>
                      <span style={{color:t.textMuted,fontSize:10}}>{months}</span>
                      <span style={{color:t.success,fontWeight:600,textAlign:"right",fontFamily:"'Space Grotesk'"}}>{fmt(row.collected||0)}</span>
                      <span style={{color:row.outstanding>0?t.danger:t.textMuted,fontSize:11,fontFamily:"'Space Grotesk'",textAlign:"right"}}>{row.outstanding>0?'−':''}{fmt(row.outstanding||0)}</span>
                    </div>
                  );
                })}
                <div style={{display:"grid",gridTemplateColumns:"42px 70px 1fr 1fr",gap:10,padding:"10px 0 0",marginTop:6,fontSize:12,alignItems:"center",borderTop:`2px solid ${t.border}`}}>
                  <span style={{fontWeight:700,color:t.text,gridColumn:"1 / span 2"}}>YTD net</span>
                  <span style={{color:t.success,fontWeight:700,textAlign:"right",fontFamily:"'Space Grotesk'"}}>{fmt(_ytdCollected)}</span>
                  <span style={{color:_ytdOutstanding>0?t.danger:t.textMuted,fontSize:11,fontFamily:"'Space Grotesk'",textAlign:"right"}}>{_ytdOutstanding>0?'−':''}{fmt(_ytdOutstanding)}</span>
                </div>
                {/* Outstanding broken down by subscriber status */}
                {Object.keys(_owedByStatus).length > 0 && (
                  <div style={{marginTop:14,paddingTop:10,borderTop:`1px dashed ${t.border}`}}>
                    <div style={{fontSize:10,fontWeight:700,color:t.textMuted,textTransform:"uppercase",letterSpacing:".8px",marginBottom:6}}>Outstanding by status</div>
                    <div style={{display:"grid",gridTemplateColumns:"112px 1fr 1fr 1fr 1fr 1fr",gap:6,fontSize:10,color:t.textMuted,fontWeight:600,paddingBottom:4,borderBottom:`1px solid ${t.border}`,textAlign:"right"}}>
                      <span style={{textAlign:"left"}}>Status</span>
                      <span>Q1</span><span>Q2</span><span>Q3</span><span>Q4</span>
                      <span style={{color:t.danger}}>Total</span>
                    </div>
                    {(() => {
                      const order = ["active","inactive","suspended","disconnected","declined","unknown"];
                      const rows = order.filter(st => _owedByStatus[st]);
                      const totals = rows.reduce((acc, st) => {
                        const r = _owedByStatus[st] || {};
                        acc.Q1 += r.Q1||0; acc.Q2 += r.Q2||0;
                        acc.Q3 += r.Q3||0; acc.Q4 += r.Q4||0;
                        acc.total += r.total||0; acc.invoices += r.invoices||0;
                        return acc;
                      }, {Q1:0,Q2:0,Q3:0,Q4:0,total:0,invoices:0});
                      const cellStyle = (v)=>({color:v>0?t.danger:t.textMuted,textAlign:"right",fontFamily:"'Space Grotesk'",fontSize:11});
                      return (
                        <>
