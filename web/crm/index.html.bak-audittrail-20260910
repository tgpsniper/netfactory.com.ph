            <div style={{ marginBottom:14 }}>
              <label style={{ fontSize:11, fontWeight:700, color:t.textMuted, textTransform:"uppercase", letterSpacing:0.6, display:"block", marginBottom:6 }}>Plan</label>
              <select value={subRptPlanId} onChange={e => { setSubRptPlanId(e.target.value); setSubRptCount(null); }} style={{ width:"100%", padding:"8px 10px", borderRadius:6, border:`1px solid ${t.border}`, background:t.bg, color:t.text, fontSize:13 }}>
                <option value="">All Plans</option>
                {selectablePlans().map(p => <option key={p.id} value={p.id}>{p.name} {p.speed ? "— " + p.speed : ""}</option>)}
              </select>
            </div>

            <div style={{ marginBottom:18 }}>
              <label style={{ fontSize:11, fontWeight:700, color:t.textMuted, textTransform:"uppercase", letterSpacing:0.6, display:"block", marginBottom:6 }}>Search (optional)</label>
              <input value={subRptSearch} onChange={e => { setSubRptSearch(e.target.value); setSubRptCount(null); }} placeholder="Account #, name, email, phone…" style={{ width:"100%", padding:"8px 10px", borderRadius:6, border:`1px solid ${t.border}`, background:t.bg, color:t.text, fontSize:13 }} />
            </div>

            {subRptCount !== null && (
              <div style={{ marginBottom:14, padding:"10px 12px", borderRadius:6, background:t.bg, border:`1px solid ${t.border}`, fontSize:13, color:t.text }}>
                <i className="fas fa-info-circle" style={{color:t.accent, marginRight:6}}></i>
                {subRptCount.toLocaleString()} subscriber{subRptCount===1?"":"s"} match these filters.
              </div>
            )}

            <div style={{ display:"flex", gap:8, justifyContent:"flex-end", paddingTop:14, borderTop:`1px solid ${t.border}` }}>
              <Btn small disabled={subRptBusy} onClick={previewSubRpt}><i className="fas fa-eye" style={{marginRight:6}}></i>Preview count</Btn>
              <Btn primary disabled={subRptBusy || subRptStatus.length===0} onClick={downloadSubscriberReport}>
                <i className={"fas " + (subRptBusy ? "fa-spinner fa-spin" : "fa-download")} style={{marginRight:6}}></i>
                {subRptBusy ? "Working…" : "Download CSV"}
              </Btn>
            </div>
          </div>
        </div>
      )}
    </div>
  );
  };

  const fetchServices = async () => {
    setSrvLoading(true);
    try {
      const r = await fetch('/api/admin/services/config', {headers:{Authorization:'Bearer '+localStorage.getItem('j2_admin_token')}});
      const d = await r.json();
      if(d && !d.error) setSrv(d);
    } catch(e){} finally { setSrvLoading(false); }
  };
  const saveService = async (section, values) => {
    setSrvSaving(section); setSrvMsg(''); setSrvMsgOk(false);
    try {
      const r = await fetch('/api/admin/services/config', {method:'PUT',headers:{'Content-Type':'application/json',Authorization:'Bearer '+localStorage.getItem('j2_admin_token')},body:JSON.stringify({section,values})});
      const d = await r.json();
      setSrvMsgOk(!d.error);
      setSrvMsg(d.error ? d.error : 'Saved successfully');
    } catch(e){ setSrvMsgOk(false); setSrvMsg('Error saving'); } finally { setSrvSaving(''); }
  };
  const fetchToggles = async () => {
    try {
      const r = await fetch('/api/admin/system/toggles', {headers:{Authorization:'Bearer '+localStorage.getItem('j2_admin_token')}});
      const d = await r.json();
      if (d && d.toggles) setSrvToggles(d.toggles);
    } catch(e) {}
  };
  const saveToggle = async (key, value) => {
    setSrvToggleSaving(key);
    try {
      const r = await fetch('/api/admin/system/toggles', {method:'PUT',headers:{'Content-Type':'application/json',Authorization:'Bearer '+localStorage.getItem('j2_admin_token')},body:JSON.stringify({key, value})});
      const d = await r.json();
      if (!d.error) setSrvToggles(p => ({...p, [key]: d.value}));
    } catch(e) {} finally { setSrvToggleSaving(''); }
  };
  const testEmail = async () => {
    setSrvTesting(true); setSrvTestResult(null);
    try {
      const r = await fetch('/api/admin/services/test-email', {method:'POST',headers:{'Content-Type':'application/json',Authorization:'Bearer '+localStorage.getItem('j2_admin_token')},body:JSON.stringify({to:srvTestEmail})});
      const d = await r.json();
      setSrvTestResult({ok: !d.error, msg: d.error ? d.error : 'Test email sent!'});
    } catch(e){ setSrvTestResult({ok:false,msg:'Request failed'}); } finally { setSrvTesting(false); }
  };
  const testSms = async () => {
    setSrvTesting(true); setSrvTestResult(null);
    try {
      const r = await fetch('/api/admin/services/test-sms', {method:'POST',headers:{'Content-Type':'application/json',Authorization:'Bearer '+localStorage.getItem('j2_admin_token')},body:JSON.stringify({to:srvTestPhone})});
      const d = await r.json();
      setSrvTestResult({ok: !d.error, msg: d.error ? d.error : 'Test SMS sent!'});
    } catch(e){ setSrvTestResult({ok:false,msg:'Request failed'}); } finally { setSrvTesting(false); }
  };
  const applyEnv = async () => {
    setSrvApplying(true); setSrvMsg(''); setSrvMsgOk(false);
    try {
      const r = await fetch('/api/admin/services/apply-env', {method:'POST',headers:{Authorization:'Bearer '+localStorage.getItem('j2_admin_token')}});
      const d = await r.json();
      setSrvMsgOk(!d.error);
      setSrvMsg(d.error ? d.error : 'Applied — the API is restarting, this page will be briefly unresponsive.');
    } catch(e){ setSrvMsgOk(false); setSrvMsg('Failed'); } finally { setSrvApplying(false); }
  };
  const fetchCompanySettings = async () => {
    try {
      const res = await fetch(API + "/admin/settings", { headers: { Authorization: "Bearer " + getToken() } });
      const data = await res.json();
      const map = {};
      (data.settings || []).forEach(s => { map[s.key] = s.value; });
      setCs(map);
    } catch (e) { console.error("Settings load error:", e); }
    setCsLoading(false);
  };

  const updateCs = (key, val) => setCs(prev => ({ ...prev, [key]: val }));

  // Dashboard shortcut for the billing cutoff switch. Whether tonight's run cuts
  // anyone off is the one setting staff need to see without opening Settings, so it
  // gets a control on the dashboard too. Only this one key is sent — PUT /admin/settings
  // upserts per key, so toggling here cannot clobber unsaved edits in the Settings form.
  const setAutoRestrict = async (on) => {
    setArSaving(true); setArMsg("");
    try {
      const res = await fetch(API + "/admin/settings", {
        method: "PUT",
        headers: { "Content-Type": "application/json", Authorization: "Bearer " + getToken() },
        body: JSON.stringify({ settings: [{ key: "billing_auto_restrict_enabled", value: on ? "true" : "false", category: "billing" }] }),
      });
      if (!res.ok) { const d = await res.json().catch(() => ({})); throw new Error(d.error || "Save failed"); }
      updateCs("billing_auto_restrict_enabled", on ? "true" : "false");
      setArMsg(on ? "Automatic restriction is ON — the next run will cut off overdue accounts."
                  : "Automatic restriction is OFF — the run still logs who it would have cut.");
      setTimeout(() => setArMsg(""), 6000);
    } catch (e) {
      setArMsg(e.message || "Network error — setting unchanged.");
    }
    setArSaving(false);
  };

  // Turning it ON is the destructive direction, so that one is confirmed and the
  // dialog states the parameters that decide who gets cut. Turning it OFF is safe
  // and immediate — nobody should have to click twice to stop a cutoff.
  const confirmAutoRestrict = (on) => {
    if (!on) return setAutoRestrict(false);
    const grace = cs.billing_grace_period_days || "15";
    const hour = String(cs.billing_restrict_hour ?? "9").padStart(2, "0");
    const cap = cs.billing_auto_restrict_max_per_run || "25";
    const mode = cs.billing_restriction_mode === "walled-garden" ? "throttled to the payment portal" : "cut off completely";
    showConfirm({
      icon: "fa-triangle-exclamation",
      title: "Turn on automatic restriction?",
      message: "Every day at " + hour + ":00 Manila, accounts more than " + grace + " days past due will be "
        + mode + " without further review — up to " + cap + " per run. Service is restored automatically when payment is recorded.",
      confirmText: "Turn it on",
      confirmColor: "danger",
      onConfirm: () => setAutoRestrict(true),
    });
  };

  useEffect(() => {
    const handler = (e) => {
      if(globalSearchRef.current && !globalSearchRef.current.contains(e.target)) {
        setShowGlobalResults(false);
      }
    };
    document.addEventListener("mousedown", handler);
    return () => document.removeEventListener("mousedown", handler);
  }, []);

  const loadAiSettings = async () => {
    try {
      const res = await fetch(`${API}/ai/admin/settings`, { headers: authHeaders() });
      const d = await res.json();
      if (d.ai_assistant_enabled !== undefined) setAiOn(d.ai_assistant_enabled === 'true');
      if (d.ai_assistant_name) { setAiName(d.ai_assistant_name); setAiNameInput(d.ai_assistant_name); }
    } catch(e) {}
  };
  const saveAiSetting = async (key, value) => {
    setAiSaving(true);
    try {
      const res = await fetch(`${API}/ai/admin/settings`, { method:'PUT', headers: authHeaders(), body: JSON.stringify({ [key]: value }) });
      const d = await res.json();
      if (d.settings) {
        setAiOn(d.settings.ai_assistant_enabled === 'true');
        if (d.settings.ai_assistant_name) { setAiName(d.settings.ai_assistant_name); setAiNameInput(d.settings.ai_assistant_name); }
      }
      setAiSaved(true); setTimeout(() => setAiSaved(false), 2500);
    } catch(e) { alert('Failed to save'); } finally { setAiSaving(false); }
  };
  const uploadLogo = async (file) => {
    setLogoUploading(true); setCsMsg("");
    try {
      const fd = new FormData();
      fd.append("logo", file);
      const res = await fetch(API + "/admin/settings/logo", { method: "POST", headers: { Authorization: "Bearer " + getToken() }, body: fd });
      const data = await res.json();
      if (res.ok) {
        setCsMsg("Logo uploaded successfully!");
        setCs(prev => ({ ...prev, company_logo: data.logoUrl }));
        setTimeout(() => setCsMsg(""), 3000);
      } else { setCsMsg("" + (data.error || "Upload failed")); }
    } catch (e) { setCsMsg("Network error uploading logo"); }
    setLogoUploading(false);
  };
  const removeLogo = async () => {
    setLogoUploading(true); setCsMsg("");
    try {
      const res = await fetch(API + "/admin/settings/logo", { method: "DELETE", headers: { Authorization: "Bearer " + getToken() } });
      if (res.ok) {
        setCsMsg("Logo removed");
        setCs(prev => ({ ...prev, company_logo: "" }));
        setTimeout(() => setCsMsg(""), 3000);
      }
    } catch (e) { setCsMsg("Failed to remove logo"); }
    setLogoUploading(false);
  };
  const saveCompanySettings = async () => {
    setCsSaving(true); setCsMsg("");
    try {
      const keys = ["company_name","company_short_name","company_tagline","company_subtitle","company_tin","company_vat_label","company_brc","company_address1","company_address2","company_city","company_address","company_email","company_phone","company_website","support_email","business_hours","bank_name","bank_account_number","bank_account_name","default_tax_type","default_tax_rate","default_tax_label","referral_reward_amount","billing_grace_period_days","billing_restriction_mode","billing_auto_restrict_enabled","billing_restrict_hour","billing_auto_restrict_max_per_run"];
      // noCase = stored verbatim. Numeric and machine-read values must never be
      // title-cased — toTitleCase would happily mangle them.
      const noCase = ["company_email","company_website","support_email","default_tax_rate","default_tax_type","bank_account_number","company_phone","company_tin","company_brc","company_vat_label","company_name","company_short_name","company_tagline","company_subtitle","bank_name","bank_account_name","referral_reward_amount","billing_grace_period_days","billing_restriction_mode","billing_auto_restrict_enabled","billing_restrict_hour","billing_auto_restrict_max_per_run"];
      const settings = keys.map(k => ({
        key: k,
        value: noCase.includes(k) ? (cs[k]||"") : toTitleCase(cs[k]||""),
        category: k.startsWith("bank_") || k.startsWith("default_tax") || k.startsWith("referral_") || k.startsWith("billing_") ? "billing" : "company"
      }));
      const res = await fetch(API + "/admin/settings", {
        method: "PUT",
        headers: { "Content-Type": "application/json", Authorization: "Bearer " + getToken() },
        body: JSON.stringify({ settings })
      });
      if (res.ok) { setCsMsg("Settings saved successfully!"); setTimeout(() => setCsMsg(""), 3000); }
      else { const d = await res.json(); setCsMsg(d.error || "Save failed"); }
    } catch (e) { setCsMsg("Network error"); }
    setCsSaving(false);
  };

  // ── Subscriber message templates (Settings → Subscriber Messages) ──
  const [mtList, setMtList] = useState([]);
  const [mtCanEdit, setMtCanEdit] = useState(false);
  const [mtLoading, setMtLoading] = useState(false);
  const [mtChannel, setMtChannel] = useState("sms");
  const [mtEditing, setMtEditing] = useState(null);   // the template open in the modal
  const [mtDraft, setMtDraft] = useState({ subject: "", body: "" });
  const [mtPreview, setMtPreview] = useState(null);
  const [mtSaving, setMtSaving] = useState(false);
  const [mtTestTo, setMtTestTo] = useState("");

  const fetchMsgTemplates = async () => {
    setMtLoading(true);
    try {
      const res = await fetch(`${API}/admin/message-templates`, { headers: authHeaders() });
      const d = await res.json();
      if (d.templates) { setMtList(d.templates); setMtCanEdit(!!d.canEdit); }
    } catch (e) { /* the panel just stays empty */ }
    setMtLoading(false);
  };

  const openMsgTemplate = (tpl) => {
    setMtEditing(tpl);
    setMtDraft({ subject: tpl.subject || "", body: tpl.body || "" });
    setMtPreview(null);
    setMtTestTo("");
  };

  // The preview is rendered server-side against the same sample data the test
  // send uses, so what staff read here is what actually goes out.
  const refreshMsgPreview = async (tpl, draft) => {
    try {
      const res = await fetch(`${API}/admin/message-templates/preview`, {
        method: "POST", headers: authHeaders(),
        body: JSON.stringify({ channel: tpl.channel, key: tpl.key, subject: draft.subject, body: draft.body })
      });
      const d = await res.json();
      setMtPreview(d.error ? null : d);
    } catch (e) { setMtPreview(null); }
  };

  // Debounced so typing does not fire a request per keystroke.
  useEffect(() => {
    if (!mtEditing) return;
    const id = setTimeout(() => refreshMsgPreview(mtEditing, mtDraft), 350);
    return () => clearTimeout(id);
  }, [mtEditing, mtDraft.subject, mtDraft.body]);

  const saveMsgTemplate = async () => {
    if (!mtEditing || mtSaving) return;
    if (mtPreview && mtPreview.unknown && mtPreview.unknown.length) {
      showToast(`Remove ${mtPreview.unknown.map(u=>"{{"+u+"}}").join(", ")} first — this message never fills those in.`, "error");
      return;
    }
    setMtSaving(true);
    try {
      const res = await fetch(`${API}/admin/message-templates/${mtEditing.channel}/${mtEditing.key}`, {
        method: "PUT", headers: authHeaders(),
        body: JSON.stringify({ subject: mtDraft.subject, body: mtDraft.body })
      });
      const d = await res.json();
      if (d.error) { showToast(d.error, "error"); }
      else { showToast(d.message || "Saved", "success"); setMtEditing(null); fetchMsgTemplates(); }
    } catch (e) { showToast("Failed to save template", "error"); }
    setMtSaving(false);
  };

  const resetMsgTemplate = () => {
    if (!mtEditing) return;
    const tpl = mtEditing;
    showConfirm({
      icon: "fa-rotate-left", title: "Restore Built-in Text",
      message: `Discard your edits to "${tpl.label}" (${tpl.channel.toUpperCase()}) and go back to the wording that ships with the system?`,
      confirmText: "Restore Default", confirmColor: "danger",
      onConfirm: async () => {
        setShowConfirmModal(null);
        try {
          const res = await fetch(`${API}/admin/message-templates/${tpl.channel}/${tpl.key}`, {
            method: "DELETE", headers: authHeaders()
          });
          const d = await res.json();
          if (d.error) { showToast(d.error, "error"); return; }
          showToast(d.message || "Restored", "success");
          setMtEditing(null); fetchMsgTemplates();
        } catch (e) { showToast("Failed to restore default", "error"); }
      }
    });
  };

  // On/off is saved immediately — it is a one-click switch, not part of the edit
  // form, so there is nothing to "save" afterwards.
  const toggleMsgTemplate = async (tpl, next) => {
    const apply = async () => {
      try {
        const res = await fetch(`${API}/admin/message-templates/${tpl.channel}/${tpl.key}/enabled`, {
          method: "PATCH", headers: authHeaders(), body: JSON.stringify({ enabled: next })
        });
        const d = await res.json();
        if (d.error) { showToast(d.error, "error"); return; }
        showToast(d.message, next ? "success" : "info");
        setMtList(prev => prev.map(x => (x.channel===tpl.channel && x.key===tpl.key) ? { ...x, enabled: next } : x));
        setMtEditing(prev => (prev && prev.channel===tpl.channel && prev.key===tpl.key) ? { ...prev, enabled: next } : prev);
      } catch (e) { showToast("Failed to change the setting", "error"); }
    };
    // Switching off a message that carries a credential or a reset code does not
    // just go quiet — it removes the only copy the subscriber gets.
    if (!next && tpl.critical) {
      showConfirm({
        icon: "fa-triangle-exclamation", title: "Switch this message off?",
        message: `"${tpl.label}" carries details the subscriber cannot get anywhere else — their portal password or reset code. With it off they will not receive those, and staff will have to pass them on by hand. Switch it off anyway?`,
        confirmText: "Switch Off", confirmColor: "danger",
        onConfirm: () => { setShowConfirmModal(null); apply(); }
      });
      return;
    }
    apply();
  };

  const sendMsgTest = async () => {
    if (!mtEditing || !mtTestTo.trim()) return;
    setMtSaving(true);
    try {
      const res = await fetch(`${API}/admin/message-templates/test`, {
        method: "POST", headers: authHeaders(),
        body: JSON.stringify({ channel: mtEditing.channel, key: mtEditing.key, to: mtTestTo.trim() })
      });
      const d = await res.json();
      showToast(d.error || d.message, d.error ? "error" : "success");
    } catch (e) { showToast("Failed to send test", "error"); }
    setMtSaving(false);
  };

  // Insert a {{placeholder}} where the cursor is, rather than making people type
  // the braces and risk a typo the save would then reject.
  const insertMsgField = (field, targetId) => {
    const el = document.getElementById(targetId);
    const token = `{{${field}}}`;
    if (!el) { setMtDraft(p => ({ ...p, body: p.body + token })); return; }
    const key = targetId.endsWith("subject") ? "subject" : "body";
    const start = el.selectionStart, end = el.selectionEnd;
    setMtDraft(p => {
      const v = p[key] || "";
      return { ...p, [key]: v.slice(0, start) + token + v.slice(end) };
    });
    setTimeout(() => { el.focus(); el.setSelectionRange(start + token.length, start + token.length); }, 0);
  };

  // ── Account number assignment (subscriber detail → Change) ──
  const [acctModal, setAcctModal] = useState(null);      // the subscriber being reassigned
  const [acctMode, setAcctMode] = useState("auto");
  const [acctInput, setAcctInput] = useState("");
  const [acctNext, setAcctNext] = useState(null);        // what auto would assign
  const [acctCheck, setAcctCheck] = useState(null);      // the verification report
  const [acctChecking, setAcctChecking] = useState(false);
  const [acctFixes, setAcctFixes] = useState({});
  const [acctBusy, setAcctBusy] = useState(false);
  const [acctResult, setAcctResult] = useState(null);    // what happened, shown after applying

  const openAcctModal = async (sub) => {
    setAcctModal(sub); setAcctMode("auto"); setAcctInput("");
    setAcctCheck(null); setAcctNext(null); setAcctFixes({}); setAcctResult(null);
    try {
      const res = await fetch(`${API}/admin/account-number/${sub.id}/next`, { headers: authHeaders() });
      const d = await res.json();
      if (!d.error) setAcctNext(d);
    } catch (e) { /* the modal still works in manual mode */ }
  };

  const runAcctCheck = async (sub, mode, value) => {
    if (mode === "manual" && !String(value || "").trim()) { setAcctCheck(null); return; }
    setAcctChecking(true);
    try {
      const res = await fetch(`${API}/admin/account-number/${sub.id}/check`, {
        method: "POST", headers: authHeaders(),
        body: JSON.stringify({ mode, accountNumber: value })
      });
      const d = await res.json();
      if (d.error && !d.checks) { setAcctCheck(null); showToast(d.error, "error"); }
      else {
        setAcctCheck(d);
        // Every offered fix starts ticked. Leaving a known breakage unticked by
        // default would make "just press the button" the wrong thing to do.
        const next = {};
        (d.checks || []).forEach(c => { if (c.fix) next[c.fix] = c.fixDefault !== false; });
        setAcctFixes(next);
      }
    } catch (e) { setAcctCheck(null); }
    setAcctChecking(false);
  };

  // Re-verify as the number is typed, and whenever the mode flips.
  useEffect(() => {
    if (!acctModal || acctResult) return;
    const id = setTimeout(() => runAcctCheck(acctModal, acctMode, acctInput), 400);
    return () => clearTimeout(id);
  }, [acctModal, acctMode, acctInput, acctResult]);

  const applyAcctChange = async () => {
    if (!acctModal || !acctCheck || acctCheck.blocking) return;
    setAcctBusy(true);
    try {
      const res = await fetch(`${API}/admin/account-number/${acctModal.id}/apply`, {
        method: "POST", headers: authHeaders(),
        body: JSON.stringify({ mode: acctMode, accountNumber: acctInput, resolutions: acctFixes })
      });
      const d = await res.json();
      if (d.error) {
        showToast(d.error, "error");
        // The number may have been taken while the modal was open — re-verify
        // so the operator sees why rather than just a failed button.
        if (d.checks) setAcctCheck({ ...acctCheck, ...d, blocking: true });
      } else {
        setAcctResult(d);
        showToast(d.message, "success");
        fetchCrmData();
        setSelectedSub(prev => prev && prev.id === acctModal.id ? { ...prev, acct: d.to, accountNumber: d.to } : prev);
      }
    } catch (e) { showToast("Failed to change the account number", "error"); }
    setAcctBusy(false);
  };

  // ── Account number on the Add Subscriber form ──
  // Left on "automatic" this behaves exactly as before: the field is sent empty
  // and the database trigger assigns the next number. "Enter it myself" is for
  // bringing a number across from the old system.
  const [addAcctMode, setAddAcctMode] = useState("auto");
  const [addAcctNumber, setAddAcctNumber] = useState("");
  const [addAcctNext, setAddAcctNext] = useState(null);
  const [addAcctCheck, setAddAcctCheck] = useState(null);
  const [addAcctChecking, setAddAcctChecking] = useState(false);
  const [addAcctAdvance, setAddAcctAdvance] = useState(false);

  useEffect(() => {
    if (!showAddSub) return;
    setAddAcctMode("auto"); setAddAcctNumber(""); setAddAcctCheck(null); setAddAcctAdvance(false);
    fetch(`${API}/admin/account-number/next-new`, { headers: authHeaders() })
      .then(r => r.json()).then(d => { if (!d.error) setAddAcctNext(d); })
