            {newInvSubResults.length > 0 && <div style={{position:"absolute",top:"100%",left:0,right:0,background:t.bgCard,border:`1px solid ${t.border}`,borderRadius:10,zIndex:10,maxHeight:200,overflowY:"auto",boxShadow:"0 8px 24px rgba(0,0,0,.3)",marginTop:2}}>
