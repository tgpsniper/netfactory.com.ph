            {referralsList.length ? (
              <div style={{display:"flex",flexDirection:"column",gap:6,maxHeight:240,overflowY:"auto"}}>
                {referralsList.map(r=>(
                  <div key={r.id} style={{display:"flex",alignItems:"center",justifyContent:"space-between",padding:"8px 12px",borderRadius:8,background:t.bgAlt,border:`1px solid ${t.border}`}}>
                    <div style={{minWidth:0}}>
                      <div style={{fontSize:13,color:t.text,fontWeight:600,overflow:"hidden",textOverflow:"ellipsis",whiteSpace:"nowrap"}}>{r.referrerName} <i className="fas fa-arrow-right" style={{fontSize:9,color:t.textMuted,margin:"0 4px"}}></i> {r.refereeName||"—"}</div>
