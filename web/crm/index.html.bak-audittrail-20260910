            </div>
          </div>
        </div>
      )}

      {/* ========== NETWORK ATTACHMENT MODAL ========== */}
      {showNetworkModal && selectedSub && (() => {
        const lat = Number(selectedSub.lat), lng = Number(selectedSub.lng);
        // OpenStreetMap embed — small bbox around the subscriber GPS.
        const dLat = 0.003, dLng = 0.003;
        const bbox = `${lng-dLng}%2C${lat-dLat}%2C${lng+dLng}%2C${lat+dLat}`;
        const osmEmbed = `https://www.openstreetmap.org/export/embed.html?bbox=${bbox}&layer=mapnik&marker=${lat}%2C${lng}`;
        const osmLink = `https://www.openstreetmap.org/?mlat=${lat}&mlon=${lng}#map=18/${lat}/${lng}`;
        const gisLink = `/gis/?focus=sub&id=${selectedSub.id}`;
        const card = (label, color, body) => (
          <div style={{ background:t.bgAlt, border:`1px solid ${t.border}`, borderRadius:12, padding:14 }}>
            <div style={{ fontSize:11, fontWeight:700, color:color||t.accent, textTransform:"uppercase", letterSpacing:.5, marginBottom:8 }}>{label}</div>
            {body}
          </div>
        );
        const kv = (k, v) => (
          <div style={{ display:"flex", justifyContent:"space-between", gap:12, padding:"3px 0", fontSize:13 }}>
            <span style={{ color:t.textMuted }}>{k}</span>
            <span style={{ color:t.text, fontWeight:500, textAlign:"right" }}>{v}</span>
          </div>
        );
        const fiberHex = { Blue:"#0066CC", Orange:"#FF6B00", Green:"#00A651", Brown:"#8B4513",
                           Slate:"#808080", White:"#F5F5F5", Red:"#E50000", Black:"#1A1A1A",
                           Yellow:"#FFD700", Violet:"#8B00FF", Rose:"#FF69B4", Aqua:"#00CED1" };
        const data = networkData || {};
        return (
          <div style={{ position:"fixed", inset:0, background:"rgba(0,0,0,.75)", backdropFilter:"blur(8px)", zIndex:9999, display:"flex", alignItems:"center", justifyContent:"center", padding:16 }} onClick={() => setShowNetworkModal(false)}>
            <div style={{ background:t.bgCard, borderRadius:20, width:"100%", maxWidth:780, maxHeight:"90vh", display:"flex", flexDirection:"column", boxShadow:"0 40px 80px rgba(0,0,0,.45)", border:`1px solid ${t.border}` }} onClick={e => e.stopPropagation()}>
              {/* Header */}
              <div style={{ padding:"20px 24px", borderBottom:`1px solid ${t.border}`, display:"flex", justifyContent:"space-between", alignItems:"center", flexShrink:0 }}>
                <div>
                  <h2 style={{ fontSize:16, fontWeight:700, color:t.text, fontFamily:"'Space Grotesk'", margin:0 }}>
                    <i className="fas fa-location-dot" style={{ marginRight:8, color:t.accent }}></i>
                    Network Attachment
                  </h2>
                  <div style={{ fontSize:12, color:t.textMuted, marginTop:3 }}>
                    {subDisplayName(selectedSub)} — {selectedSub.acct} · GPS {Number(lat).toFixed(6)}, {Number(lng).toFixed(6)}
                  </div>
                </div>
                <button onClick={() => setShowNetworkModal(false)} style={{ background:"none", border:"none", cursor:"pointer", width:32, height:32, borderRadius:8, display:"flex", alignItems:"center", justifyContent:"center", color:t.text, fontSize:16, opacity:.7 }}>
                  <i className="fas fa-xmark"></i>
                </button>
              </div>
              {/* Body */}
              <div style={{ padding:20, overflowY:"auto", flex:1, display:"flex", flexDirection:"column", gap:14 }}>
                {/* Map */}
                <div style={{ borderRadius:14, overflow:"hidden", border:`1px solid ${t.border}`, background:t.bg }}>
                  <iframe src={osmEmbed} style={{ width:"100%", height:240, border:0, display:"block" }} title="Subscriber location"></iframe>
                  <div style={{ display:"flex", gap:8, padding:"10px 12px", borderTop:`1px solid ${t.border}` }}>
                    <a href={osmLink} target="_blank" rel="noopener noreferrer" style={{ flex:1, padding:"8px 12px", borderRadius:8, background:`${t.accent}18`, color:t.accent, fontSize:12, fontWeight:600, textAlign:"center", textDecoration:"none" }}>
                      <i className="fas fa-up-right-from-square" style={{ marginRight:6 }}></i>Open in OpenStreetMap
                    </a>
                    <a href={gisLink} target="_blank" rel="noopener noreferrer" style={{ flex:1, padding:"8px 12px", borderRadius:8, background:`${t.success}18`, color:t.success, fontSize:12, fontWeight:600, textAlign:"center", textDecoration:"none" }}>
                      <i className="fas fa-network-wired" style={{ marginRight:6 }}></i>View in GIS
                    </a>
                  </div>
                </div>
                {/* Loading / error / content */}
                {networkLoading && (
                  <div style={{ padding:24, textAlign:"center", color:t.textMuted, fontSize:13 }}>
                    <i className="fas fa-spinner fa-spin" style={{ marginRight:8 }}></i>Loading network attachment…
                  </div>
                )}
                {!networkLoading && data.error && (
                  <div style={{ padding:14, background:`${t.danger||'#ef4444'}18`, borderRadius:10, color:t.danger||'#ef4444', fontSize:13, textAlign:"center" }}>{data.error}</div>
                )}
                {!networkLoading && !data.error && data.subscriber && (
                  <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr", gap:12 }}>
                    {/* NAP */}
                    {data.nap ? card("NAP — Port Attachment", "#8b5cf6", (
                      <div>
                        {kv("Name", <span style={{ color:"#8b5cf6", fontWeight:700 }}>{data.nap.name}</span>)}
                        {kv("Type", data.nap.type)}
                        {kv("Port", <span style={{ color:t.accent, fontWeight:700 }}>Port {data.nap.portNumber} of {data.nap.totalPorts}</span>)}
                        {kv("Used Ports", `${data.nap.usedPorts} / ${data.nap.totalPorts}`)}
                        {data.nap.lat!=null && kv("Location", <span style={{ fontFamily:"monospace", fontSize:11 }}>{data.nap.lat.toFixed(6)}, {data.nap.lng.toFixed(6)}</span>)}
                      </div>
                    )) : (
                      <div onClick={async () => {
                        // Click "Not assigned" → pick a nearby NAP for this subscriber
                        if (lat == null || lng == null) return;
                        setShowNapPicker(true); setNapPickerLoading(true); setNapPickerData([]);
                        try {
                          const r = await fetch('/api/admin/map/naps', { headers: authHeaders() });
                          if (r.ok) {
                            const d = await r.json();
                            const haversine = (a, b, c, e) => {
                              const toRad = (x) => x * Math.PI / 180;
                              const R = 6371000; const dLat = toRad(c - a); const dLng = toRad(e - b);
                              const A = Math.sin(dLat/2)**2 + Math.cos(toRad(a)) * Math.cos(toRad(c)) * Math.sin(dLng/2)**2;
                              return 2 * R * Math.asin(Math.sqrt(A));
                            };
                            const naps = (d.naps || [])
                              .filter(n => n.lat != null && n.lng != null)
                              .map(n => ({ nap: n, distanceM: haversine(lat, lng, Number(n.lat), Number(n.lng)) }))
                              .sort((a, b) => a.distanceM - b.distanceM)
                              .slice(0, 25);
                            setNapPickerData(naps);
                          }
                        } catch (e) { /* ignore */ }
                        setNapPickerLoading(false);
                      }}
                      style={{ background:t.bgAlt, border:`1px dashed ${t.border}`, borderRadius:12, padding:14, cursor:"pointer", transition:"border-color .15s, background .15s" }}
                      onMouseEnter={e => { e.currentTarget.style.borderColor = "#8b5cf6"; e.currentTarget.style.background = `${t.bgAlt}cc`; }}
                      onMouseLeave={e => { e.currentTarget.style.borderColor = t.border; e.currentTarget.style.background = t.bgAlt; }}>
                        <div style={{ fontSize:11, fontWeight:700, color:"#8b5cf6", textTransform:"uppercase", letterSpacing:.5, marginBottom:8 }}>NAP — Port Attachment</div>
                        <div style={{ color:t.textMuted, fontSize:12, fontStyle:"italic", marginBottom:6 }}>Not assigned to any NAP port</div>
                        <div style={{ color:"#8b5cf6", fontSize:12, fontWeight:600 }}>
                          <i className="fas fa-plus-circle" style={{ marginRight:6 }}></i>Click to assign a nearby NAP
                        </div>
                      </div>
                    )}
                    {/* Strand */}
                    {data.strand ? card("FOC Strand", "#f97316", (
                      <div>
                        {kv("Number", <span style={{ fontWeight:700 }}>S{data.strand.number}</span>)}
                        {kv("Color", (
                          <span style={{ display:"inline-flex", alignItems:"center", gap:6 }}>
                            <span style={{ width:12, height:12, borderRadius:"50%", background:fiberHex[data.strand.color]||"#999", border:"1px solid rgba(255,255,255,.2)" }}></span>
                            <span style={{ fontWeight:600 }}>{data.strand.color}</span>
                          </span>
                        ))}
                        {data.strand.tube!=null && kv("Tube", `T${data.strand.tube}`)}
                      </div>
                    )) : card("FOC Strand", "#f97316", <div style={{ color:t.textMuted, fontSize:12, fontStyle:"italic" }}>No strand assigned</div>)}
                    {/* Main FOC */}
                    {data.foc ? card("Main FOC Cable", "#0ea5e9", (
                      <div>
                        {kv("Cable", <span style={{ color:"#0ea5e9", fontWeight:700 }}>{data.foc.name}</span>)}
                        {kv("Capacity", `${data.foc.cableSize}-Core`)}
                        {kv("Type", data.foc.type)}
                      </div>
                    )) : card("Main FOC Cable", "#0ea5e9", <div style={{ color:t.textMuted, fontSize:12, fontStyle:"italic" }}>No FOC route linked</div>)}
                    {/* Lateral */}
                    {data.lateral ? card("Lateral (Side C)", "#a855f7", (
                      <div>
                        {kv("Cable", <span style={{ color:"#a855f7", fontWeight:700 }}>{data.lateral.name}</span>)}
                        {kv("Capacity", `${data.lateral.cableSize}-Core`)}
                        {kv("Type", data.lateral.type)}
                      </div>
                    )) : card("Lateral (Side C)", "#a855f7", <div style={{ color:t.textMuted, fontSize:12, fontStyle:"italic" }}>No lateral cable on the parent closure</div>)}
                    {/* Closure (full width) */}
                    {data.closure && (
                      <div style={{ gridColumn:"1 / -1" }}>
                        {card("Parent Closure", "#dc2626", (
                          <div>
                            {kv("Name", <span style={{ color:"#dc2626", fontWeight:700 }}>{data.closure.name}</span>)}
                            {data.closure.lat!=null && kv("Location", <span style={{ fontFamily:"monospace", fontSize:11 }}>{data.closure.lat.toFixed(6)}, {data.closure.lng.toFixed(6)}</span>)}
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                )}
              </div>
              {/* Footer */}
              <div style={{ padding:"14px 24px", borderTop:`1px solid ${t.border}`, display:"flex", justifyContent:"flex-end", flexShrink:0 }}>
                <button onClick={() => setShowNetworkModal(false)} style={{ padding:"8px 24px", borderRadius:10, background:t.accent, border:"none", color:"#fff", fontSize:13, fontWeight:600, cursor:"pointer", fontFamily:"inherit" }}>Close</button>
              </div>
            </div>
          </div>
        );
      })()}

      {/* ========== NEARBY NAP PICKER ========== */}
      {showNapPicker && selectedSub && (
        <div style={{ position:"fixed", inset:0, background:"rgba(0,0,0,.78)", backdropFilter:"blur(8px)", zIndex:10000, display:"flex", alignItems:"center", justifyContent:"center", padding:16 }} onClick={() => setShowNapPicker(false)}>
          <div style={{ background:t.bgCard, borderRadius:18, width:"min(1100px, 96vw)", height:"min(820px, 88vh)", display:"flex", flexDirection:"column", boxShadow:"0 40px 80px rgba(0,0,0,.5)", border:`1px solid ${t.border}` }} onClick={e => e.stopPropagation()}>
            <div style={{ padding:"16px 20px", borderBottom:`1px solid ${t.border}`, display:"flex", justifyContent:"space-between", alignItems:"center", flexShrink:0 }}>
              <div>
                <h2 style={{ fontSize:15, fontWeight:700, color:t.text, margin:0, fontFamily:"'Space Grotesk'" }}>
                  <i className="fas fa-location-crosshairs" style={{ marginRight:8, color:"#8b5cf6" }}></i>Pick a Nearby NAP
                </h2>
                <div style={{ fontSize:11, color:t.textMuted, marginTop:3 }}>{subDisplayName(selectedSub)} — click any NAP marker on the map to assign a port</div>
              </div>
              <button onClick={() => setShowNapPicker(false)} style={{ background:"none", border:"none", cursor:"pointer", color:t.text, fontSize:18, opacity:.7, padding:6 }}><i className="fas fa-xmark"></i></button>
            </div>
            <div style={{ display:"flex", flex:1, minHeight:0 }}>
              {/* Map */}
              <div style={{ flex:1, position:"relative", background:t.bg }}>
                {napPickerLoading && (
                  <div style={{ position:"absolute", inset:0, display:"flex", alignItems:"center", justifyContent:"center", color:t.textMuted, fontSize:13, zIndex:5 }}>
                    <i className="fas fa-spinner fa-spin" style={{ marginRight:8 }}></i>Loading NAPs from GIS…
                  </div>
                )}
                {!napPickerLoading && napPickerData.length === 0 && (
                  <div style={{ position:"absolute", inset:0, display:"flex", alignItems:"center", justifyContent:"center", color:t.textMuted, fontSize:13, zIndex:5 }}>
                    No NAPs found near this subscriber
                  </div>
                )}
                <div ref={napMapRef} style={{ width:"100%", height:"100%" }}></div>
                {/* Legend overlay */}
                <div style={{ position:"absolute", left:12, bottom:12, background:"rgba(15,23,42,.92)", border:"1px solid rgba(255,255,255,.1)", borderRadius:8, padding:"8px 12px", color:"#e2e8f0", fontSize:11, zIndex:600, display:"flex", flexDirection:"column", gap:4 }}>
                  <div style={{ display:"flex", alignItems:"center", gap:6 }}><span style={{ width:10, height:10, borderRadius:"50%", background:"#22c55e", border:"1.5px solid #fff" }}></span> Subscriber</div>
                  <div style={{ display:"flex", alignItems:"center", gap:6 }}><span style={{ width:14, height:14, borderRadius:"50%", background:"#16a34a", border:"1.5px solid #fff" }}></span> NAP — has free ports</div>
                  <div style={{ display:"flex", alignItems:"center", gap:6 }}><span style={{ width:14, height:14, borderRadius:"50%", background:"#ef4444", border:"1.5px solid #fff" }}></span> NAP — full</div>
                </div>
              </div>
              {/* Right side: text list */}
              <div style={{ width:300, borderLeft:`1px solid ${t.border}`, overflowY:"auto", padding:10, flexShrink:0 }}>
                <div style={{ fontSize:11, fontWeight:700, color:t.textMuted, textTransform:"uppercase", letterSpacing:.5, padding:"4px 6px 8px" }}>Nearest NAPs</div>
                {napPickerLoading ? (
                  <div style={{ padding:14, color:t.textMuted, fontSize:12 }}>Loading…</div>
                ) : napPickerData.length === 0 ? (
                  <div style={{ padding:14, color:t.textMuted, fontSize:12 }}>No NAPs found</div>
                ) : napPickerData.slice(0, 25).map(({ nap, distanceM }) => {
                  const avail = (nap.totalPorts || 0) - (nap.usedPorts || 0);
                  const distLabel = distanceM >= 1000 ? `${(distanceM/1000).toFixed(2)} km` : `${Math.round(distanceM)} m`;
                  const full = avail <= 0;
                  const m2 = String(nap.name||"").match(/(\d{4,6})\s*$/);
                  const shortId = m2 ? m2[1] : String(nap.name||"").slice(-5);
                  return (
                    <div key={nap.id} onClick={async () => {
                      if (full) return;
                      setShowNapPicker(false);
                      setShowPortPicker(true);
                      setPortPickerNap({ id: nap.id, name: nap.name, totalPorts: nap.totalPorts });
                      setPortPickerLoading(true); setPortPickerData([]);
                      try {
                        const r = await fetch(`/api/admin/map/naps/${nap.id}/ports`, { headers: authHeaders() });
                        if (r.ok) { const d = await r.json(); setPortPickerData(d.ports || []); }
                      } catch (e) { /* ignore */ }
                      setPortPickerLoading(false);
                    }} style={{ display:"flex", alignItems:"center", gap:8, padding:"8px 10px", borderRadius:8, background:t.bgAlt, border:`1px solid ${t.border}`, cursor: full ? "not-allowed" : "pointer", opacity: full ? .55 : 1, marginBottom:6, transition:"border-color .15s" }}
                    onMouseEnter={e => { if (!full) e.currentTarget.style.borderColor = "#8b5cf6"; }}
                    onMouseLeave={e => { e.currentTarget.style.borderColor = t.border; }}>
                      <div style={{ width:28, height:28, borderRadius:"50%", background: full?"#ef444418":"#16a34a18", color: full?"#ef4444":"#16a34a", display:"flex", alignItems:"center", justifyContent:"center", fontSize:11, fontWeight:700, flexShrink:0 }}>{shortId}</div>
                      <div style={{ flex:1, minWidth:0 }}>
                        <div style={{ fontSize:12, fontWeight:700, color:t.text, whiteSpace:"nowrap", overflow:"hidden", textOverflow:"ellipsis" }}>{nap.name}</div>
                        <div style={{ fontSize:10, color:t.textMuted }}>{distLabel} · {avail}/{nap.totalPorts} avail</div>
                        {nap.lat != null && nap.lng != null && (
                          <div style={{ fontSize:10, fontFamily:"monospace", color:t.textMuted, marginTop:1 }}>
                            {Number(nap.lat).toFixed(6)}, {Number(nap.lng).toFixed(6)}
                          </div>
                        )}
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          </div>
        </div>
      )}

      {/* ========== PORT PICKER ========== */}
      {showPortPicker && selectedSub && portPickerNap && (
        <div style={{ position:"fixed", inset:0, background:"rgba(0,0,0,.78)", backdropFilter:"blur(8px)", zIndex:10001, display:"flex", alignItems:"center", justifyContent:"center", padding:16 }} onClick={() => setShowPortPicker(false)}>
          <div style={{ background:t.bgCard, borderRadius:18, width:"100%", maxWidth:560, maxHeight:"86vh", display:"flex", flexDirection:"column", boxShadow:"0 40px 80px rgba(0,0,0,.5)", border:`1px solid ${t.border}` }} onClick={e => e.stopPropagation()}>
            <div style={{ padding:"18px 22px", borderBottom:`1px solid ${t.border}`, display:"flex", justifyContent:"space-between", alignItems:"center" }}>
              <div>
                <h2 style={{ fontSize:15, fontWeight:700, color:t.text, margin:0, fontFamily:"'Space Grotesk'" }}>
                  <i className="fas fa-plug" style={{ marginRight:8, color:t.accent }}></i>Pick a Port — {portPickerNap.name}
                </h2>
                <div style={{ fontSize:11, color:t.textMuted, marginTop:3 }}>Click an available port to attach {subDisplayName(selectedSub)}</div>
              </div>
              <button onClick={() => setShowPortPicker(false)} style={{ background:"none", border:"none", cursor:"pointer", color:t.text, fontSize:18, opacity:.7, padding:6 }}><i className="fas fa-xmark"></i></button>
            </div>
            <div style={{ padding:14, overflowY:"auto", flex:1 }}>
              {portPickerLoading ? (
                <div style={{ textAlign:"center", padding:32, color:t.textMuted, fontSize:13 }}><i className="fas fa-spinner fa-spin" style={{ marginRight:8 }}></i>Loading ports…</div>
              ) : portPickerData.length === 0 ? (
                <div style={{ textAlign:"center", padding:32, color:t.textMuted, fontSize:13 }}>No ports configured</div>
              ) : (
                <div style={{ display:"grid", gridTemplateColumns:"repeat(auto-fill, minmax(140px, 1fr))", gap:8 }}>
                  {portPickerData.map(p => {
                    const isAvail = p.status === "available";
                    const isSaving = portAssigning === p.id;
                    const statusBg = isAvail ? "#22c55e18" : p.status === "used" ? "#ef444418" : "#f59e0b18";
                    const statusFg = isAvail ? "#22c55e" : p.status === "used" ? "#ef4444" : "#f59e0b";
                    return (
                      <div key={p.id} onClick={async () => {
                        if (!isAvail || isSaving) return;
                        setPortAssigning(p.id);
                        const subLabel = subDisplayName(selectedSub) + (selectedSub.acct ? ` (${selectedSub.acct})` : '');
                        try {
                          const r = await fetch(`/api/admin/map/ports/${p.id}`, {
                            method:"PUT", headers: authHeaders(),
                            body: JSON.stringify({ status:"used", subscriberId: selectedSub.id, subscriberLabel: subLabel, strandId: p.strandId || null, notes: p.notes || null })
                          });
                          if (r.ok) {
                            // Refresh the network attachment data and close port picker
                            setShowPortPicker(false);
                            const nr = await fetch(`/api/admin/subscribers/${selectedSub.id}/network`);
                            if (nr.ok) setNetworkData(await nr.json());
                          } else {
                            const e = await r.json().catch(() => ({}));
                            alert(e.error || "Assignment failed");
                          }
                        } catch (e) { alert("Network error"); }
                        setPortAssigning(null);
                      }} style={{ background:t.bgAlt, border:`1px solid ${isAvail ? "#22c55e" : t.border}`, borderRadius:10, padding:"14px 10px", textAlign:"center", cursor: isAvail && !isSaving ? "pointer" : "not-allowed", opacity: isAvail ? 1 : .55, transition:"transform .15s, box-shadow .15s" }}
                      onMouseEnter={e => { if (isAvail && !isSaving) { e.currentTarget.style.transform = "translateY(-2px)"; e.currentTarget.style.boxShadow = "0 8px 16px rgba(34,197,94,.25)"; } }}
                      onMouseLeave={e => { e.currentTarget.style.transform = ""; e.currentTarget.style.boxShadow = ""; }}>
                        <div style={{ width:36, height:36, borderRadius:"50%", background:statusBg, color:statusFg, display:"flex", alignItems:"center", justifyContent:"center", margin:"0 auto 6px", fontSize:14, fontWeight:700 }}>{p.number}</div>
                        <div style={{ fontSize:11, fontWeight:700, color:statusFg, textTransform:"uppercase", letterSpacing:.5 }}>{isSaving ? "saving…" : p.status}</div>
                        {p.subscriberLabel && <div style={{ fontSize:10, color:t.textMuted, marginTop:3, whiteSpace:"nowrap", overflow:"hidden", textOverflow:"ellipsis" }} title={p.subscriberLabel}>{p.subscriberLabel}</div>}
                      </div>
                    );
                  })}
                </div>
              )}
            </div>
            <div style={{ padding:"12px 22px", borderTop:`1px solid ${t.border}`, display:"flex", justifyContent:"space-between", alignItems:"center" }}>
              <button onClick={() => { setShowPortPicker(false); setShowNapPicker(true); }} style={{ padding:"8px 14px", borderRadius:8, background:"transparent", border:`1px solid ${t.border}`, color:t.text, fontSize:12, fontWeight:600, cursor:"pointer", fontFamily:"inherit" }}>
                <i className="fas fa-arrow-left" style={{ marginRight:6 }}></i>Pick a different NAP
              </button>
              <button onClick={() => setShowPortPicker(false)} style={{ padding:"8px 18px", borderRadius:8, background:t.accent, border:"none", color:"#fff", fontSize:12, fontWeight:600, cursor:"pointer", fontFamily:"inherit" }}>Close</button>
            </div>
          </div>
        </div>
      )}

      {/* ========== ATTACHMENT VIEWER MODAL ========== */}
      {showAttachViewer && selectedSub && (() => {
        const attachFields = [
          { field:"proof_of_billing", label:"Proof of Billing", icon:"fa-file-invoice" },
          { field:"valid_id1",        label:"Valid ID 1",       icon:"fa-id-card" },
          { field:"valid_id2",        label:"Valid ID 2",       icon:"fa-id-card" },
          { field:"other_attachment", label:"Other Attachment", icon:"fa-file" },
        ];
        const normalizeUrl = (u) => u && !u.startsWith('/') && !u.startsWith('http') ? '/' + u : u;
        const files = attachFields.filter(a => selectedSub[a.field]).map(a => ({ ...a, url: normalizeUrl(selectedSub[a.field]) }));
        const isImage = (url) => /\.(jpg|jpeg|png|webp|gif)(\?|$)/i.test(url);
        return (
        <div style={{ position:"fixed", inset:0, background:"rgba(0,0,0,.75)", backdropFilter:"blur(8px)", zIndex:9999, display:"flex", alignItems:"center", justifyContent:"center", padding:16 }} onClick={() => { setShowAttachViewer(false); setViewerFile(null); }}>
          <div style={{ background:t.bgCard, borderRadius:20, width:"100%", maxWidth:720, maxHeight:"90vh", display:"flex", flexDirection:"column", boxShadow:"0 40px 80px rgba(0,0,0,.45)", border:`1px solid ${t.border}` }} onClick={e => e.stopPropagation()}>
            {/* Header */}
            <div style={{ padding:"20px 24px", borderBottom:`1px solid ${t.border}`, display:"flex", justifyContent:"space-between", alignItems:"center", flexShrink:0 }}>
              <div>
                <h2 style={{ fontSize:16, fontWeight:700, color:t.text, fontFamily:"'Space Grotesk'", margin:0 }}><i className="fas fa-folder-open" style={{ marginRight:8, color:t.accent }}></i>Attachment Viewer</h2>
                <div style={{ fontSize:12, color:t.textMuted, marginTop:3 }}>{subDisplayName(selectedSub)} — {selectedSub.acct} &middot; {files.length} file{files.length !== 1 ? "s" : ""} attached</div>
              </div>
              <button onClick={() => { setShowAttachViewer(false); setViewerFile(null); }} style={{ background:"none", border:"none", cursor:"pointer", width:32, height:32, borderRadius:8, display:"flex", alignItems:"center", justifyContent:"center", color:t.text, fontSize:16, opacity:.7 }} onMouseEnter={e=>e.currentTarget.style.opacity=1} onMouseLeave={e=>e.currentTarget.style.opacity=.7}><i className="fas fa-xmark"></i></button>
            </div>
            {/* Body */}
            <div style={{ padding:24, overflowY:"auto", flex:1 }}>
              {files.length === 0 ? (
                <div style={{ textAlign:"center", padding:"48px 24px" }}>
                  <i className="fas fa-folder-open" style={{ fontSize:40, color:t.textMuted, marginBottom:12, opacity:.4 }}></i>
                  <div style={{ fontSize:14, color:t.textMuted }}>No files attached to this subscriber</div>
                  <button onClick={() => { setShowAttachViewer(false); setShowAttachModal(true); }} style={{ marginTop:16, padding:"8px 20px", borderRadius:10, background:t.accent, border:"none", color:"#fff", fontSize:13, fontWeight:600, cursor:"pointer", fontFamily:"inherit" }}>
                    <i className="fas fa-upload" style={{ marginRight:6 }}></i>Upload Files
                  </button>
                </div>
              ) : (
                <div style={{ display:"grid", gridTemplateColumns:"repeat(auto-fill, minmax(280px, 1fr))", gap:16 }}>
                  {files.map(({ field, label, icon, url }) => {
                    const fileName = url.split('/').pop();
                    const img = isImage(url);
                    return (
