              <div key={a[0]} style={{background:"rgba(148,163,184,.08)",border:`1px solid ${t.border}`,borderRadius:12,padding:"12px 14px"}}>
                <div style={{fontSize:11,color:t.textMuted,textTransform:"uppercase",letterSpacing:".5px"}}>{a[0]}</div>
                <div style={{fontSize:22,fontWeight:800,color:a[2],marginTop:4,fontFamily:"'Space Grotesk'"}}>{a[1]}</div>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* Automatic restriction switch.
          Same setting as Settings → Billing, surfaced here because its state is
          operational news: it decides whether tonight's run cuts customers off.
          Superadmin only — this is the one dashboard control that can take a
          hundred accounts offline. */}
      {adminUser?.role === "superadmin" && (() => {
        const arOn = cs.billing_auto_restrict_enabled === "true";
        const arHour = String(cs.billing_restrict_hour ?? "9").padStart(2,"0");
        return (
          <div style={{background:t.bgCard,borderRadius:16,border:`1px solid ${arOn?"#ef444455":t.border}`,boxShadow:t.shadow,padding:"16px 20px",marginBottom:24,display:"flex",alignItems:"center",gap:16,flexWrap:"wrap"}}>
            <div style={{fontSize:20,width:44,height:44,display:"flex",alignItems:"center",justifyContent:"center",borderRadius:12,background:arOn?"#ef444414":"rgba(148,163,184,.12)",color:arOn?t.danger:t.textMuted,flexShrink:0}}>
