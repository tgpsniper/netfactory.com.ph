  // Parse installer assignment from notes
  const parseInstallerInfo = (notes) => {
    if (!notes) return null;
    const lines = notes.split("\n");
    for (let i = lines.length - 1; i >= 0; i--) {
      if (lines[i].startsWith("INSTALLER ASSIGNED:")) {
        const after = lines[i].replace("INSTALLER ASSIGNED: ", "");
        const nameMatch = after.match(/^([^|(]+)/);
        const byMatch = after.match(/\(by ([^,)]+)/);
        const onuMatch = after.match(/ONU: ([A-Fa-f0-9:]+)/);
        return {
          name: nameMatch ? nameMatch[1].trim() : "Unknown",
          byWho: byMatch ? byMatch[1] : null,
          onuMac: onuMatch ? onuMatch[1] : null,
        };
      }
      if (lines[i].startsWith("ONU ASSIGNED:")) {
        const onuMatch = lines[i].match(/ONU ASSIGNED: ([A-Fa-f0-9:]+)/);
        const byMatch = lines[i].match(/\(by ([^,)]+)/);
        return {
          name: null,
          byWho: byMatch ? byMatch[1] : null,
          onuMac: onuMatch ? onuMatch[1] : null,
        };
      }
    }
    return null;
  };

  const handleAssignInstaller = async () => {
    const hasInstaller = !!selectedInstaller;
    const hasOnu = (onuAllocMode === "inventory" && selectedOnuForInstall) || (onuAllocMode === "byo" && byoOnu.mac.trim());
    const isKeepingCurrent = onuAllocMode === "current";
    if (!assignInstallerModal || (!hasInstaller && !hasOnu && !isKeepingCurrent)) return;
    setInstallAssignLoading(true);
    const who = toTitleCase(adminUser?.fullName || "Admin");
    const installer = selectedInstaller ? staffList.find(s => s.id === selectedInstaller) : null;
    const installerName = installer ? installer.full_name : null;
    const sub = assignInstallerModal;

    try {
      let onuMac = "";
      const alreadyAssigned = onuDevices.find(d => d.subscriber_id === sub.id && d.status === "deployed");

      if (onuAllocMode === "byo" && byoOnu.mac.trim()) {
        // BYO: Create new ONU device with status deployed + subscriber linked
        const byoBody = {
          mac_address: byoOnu.mac.trim().toUpperCase(),
          model: toTitleCase(byoOnu.model.trim()) || "BYO",
          serial_number: byoOnu.serial.trim().toUpperCase() || "",
          notes: (byoOnu.notes.trim() ? toTitleCase(byoOnu.notes.trim()) + " — " : "") + "CUSTOMER BYO DEVICE",
        };
        // First return existing ONU if swapping
        if (alreadyAssigned) {
          await fetch(API + '/admin/onu/' + alreadyAssigned.id + '/return', { method: 'POST', headers: authHeaders() });
        }
        // Create the BYO device
        const createRes = await fetch(API + '/admin/onu', {
          method: 'POST', headers: authHeaders(),
          body: JSON.stringify(byoBody)
        });
        if (createRes.ok) {
          const createData = await createRes.json();
          const newId = createData.device?.id || createData.id;
          if (newId) {
            // Assign to subscriber
            await fetch(API + '/admin/onu/' + newId + '/assign', {
              method: 'POST', headers: authHeaders(),
              body: JSON.stringify({ subscriber_id: sub.id }),
            });
          }
          onuMac = byoBody.mac_address;
          fetchOnuList(onuPage); fetchOnuStats();
        }
      } else if (onuAllocMode === "inventory" && selectedOnuForInstall) {
        // Return existing ONU if swapping
        if (alreadyAssigned && alreadyAssigned.id !== selectedOnuForInstall) {
          await fetch(API + '/admin/onu/' + alreadyAssigned.id + '/return', { method: 'POST', headers: authHeaders() });
        }
        // Assign selected inventory ONU
        if (!alreadyAssigned || alreadyAssigned.id !== selectedOnuForInstall) {
          const assignRes = await fetch(API + '/admin/onu/' + selectedOnuForInstall + '/assign', {
            method: 'POST', headers: authHeaders(),
            body: JSON.stringify({ subscriber_id: sub.id }),
          });
          if (assignRes.ok) {
            const onu = onuDevices.find(d => d.id === selectedOnuForInstall);
            onuMac = onu ? onu.mac_address : "";
            fetchOnuList(onuPage); fetchOnuStats();
          }
        } else {
          onuMac = alreadyAssigned.mac_address;
        }
      } else if (alreadyAssigned) {
        onuMac = alreadyAssigned.mac_address;
      }

      // Log assignment in subscriber notes
      const now = new Date().toLocaleDateString('en-PH', { month:'short', day:'numeric', year:'numeric' });
      let installNote = "";
      if (installerName && onuMac) {
        installNote = `INSTALLER ASSIGNED: ${toTitleCase(installerName)} | ONU: ${onuMac.toUpperCase()} (by ${who}, ${now})`;
      } else if (installerName) {
        installNote = `INSTALLER ASSIGNED: ${toTitleCase(installerName)} (by ${who}, ${now})`;
      } else if (onuMac) {
        installNote = `ONU ASSIGNED: ${onuMac.toUpperCase()} (by ${who}, ${now})`;
      }
      const updatedNotes = installNote ? (sub.notes ? sub.notes + "\n" : "") + installNote : sub.notes || "";
      await fetch(API + "/admin/subscribers/" + sub.id, {
        method: "PUT", headers: authHeaders(),
        body: JSON.stringify({ status: sub.status || "pending", notes: updatedNotes, macAddress: onuMac || undefined })
      });

      // Immediately update local state
