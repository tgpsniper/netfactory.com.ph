          {!invoiceEdit && adminUser?.role === 'superadmin' && <Btn onClick={()=>setInvoiceEdit({ amount:String(invoiceDetail.amount), billing_period:invoiceDetail.period||'', due_date: invoiceDetail.dueDate ? new Date(invoiceDetail.dueDate).toISOString().slice(0,10) : '', notes: invoiceDetail.notes||'' })}><i className="fas fa-pen-to-square" style={{marginRight:6}}></i>Edit</Btn>}
