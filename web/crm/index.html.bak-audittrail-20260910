                                <span style={cellStyle(r.Q4)}>{r.Q4>0?'−':''}{fmt(r.Q4||0)}</span>
                                <span style={{color:r.total>0?t.danger:t.textMuted,textAlign:"right",fontFamily:"'Space Grotesk'",fontSize:11,fontWeight:700}}>{r.total>0?'−':''}{fmt(r.total||0)}</span>
                              </div>
                            );
                          })}
                          {rows.length > 0 && (
                            <div style={{display:"grid",gridTemplateColumns:"112px 1fr 1fr 1fr 1fr 1fr",gap:6,padding:"7px 0 0",marginTop:4,fontSize:11,alignItems:"center",borderTop:`2px solid ${t.border}`}}>
                              <span style={{fontWeight:700,color:t.text}}>Total <span style={{color:t.textMuted,fontWeight:400,fontSize:10}}>({totals.invoices})</span></span>
                              <span style={{color:totals.Q1>0?t.danger:t.textMuted,textAlign:"right",fontFamily:"'Space Grotesk'",fontSize:11,fontWeight:700}}>{totals.Q1>0?'−':''}{fmt(totals.Q1)}</span>
                              <span style={{color:totals.Q2>0?t.danger:t.textMuted,textAlign:"right",fontFamily:"'Space Grotesk'",fontSize:11,fontWeight:700}}>{totals.Q2>0?'−':''}{fmt(totals.Q2)}</span>
                              <span style={{color:totals.Q3>0?t.danger:t.textMuted,textAlign:"right",fontFamily:"'Space Grotesk'",fontSize:11,fontWeight:700}}>{totals.Q3>0?'−':''}{fmt(totals.Q3)}</span>
                              <span style={{color:totals.Q4>0?t.danger:t.textMuted,textAlign:"right",fontFamily:"'Space Grotesk'",fontSize:11,fontWeight:700}}>{totals.Q4>0?'−':''}{fmt(totals.Q4)}</span>
                              <span style={{color:totals.total>0?t.danger:t.textMuted,textAlign:"right",fontFamily:"'Space Grotesk'",fontSize:11,fontWeight:800}}>{totals.total>0?'−':''}{fmt(totals.total)}</span>
                            </div>
                          )}
                        </>
                      );
                    })()}
                  </div>
                )}
              </div>
            )}
          </div>
        ))}
      </div>
      <style>{`
        .kpi-tip { display: block; }
        div:hover > .kpi-tip { opacity:1 !important; visibility:visible !important; transform:translateY(0) !important; pointer-events:auto !important; }
      `}</style>

      {/* Fiber Plant (ONU) — appears once SmartOLT is connected (avoids showing the stale pre-sync snapshot) */}
      {fiber && fiber.configured && fiber.total > 0 && (
        <div onClick={()=>setActivePage('smartolt')} style={{background:t.bgCard,borderRadius:16,border:`1px solid ${t.border}`,boxShadow:t.shadow,padding:"18px 22px",marginBottom:24,cursor:"pointer"}}>
          <div style={{display:"flex",alignItems:"center",justifyContent:"space-between",flexWrap:"wrap",gap:12,marginBottom:14}}>
            <div style={{display:"flex",alignItems:"center",gap:12}}>
              <div style={{fontSize:22,width:44,height:44,display:"flex",alignItems:"center",justifyContent:"center",borderRadius:12,background:"#0ea5e912",color:"#0ea5e9"}}><i className="fas fa-network-wired"/></div>
              <div>
                <div style={{fontSize:15,fontWeight:800,color:t.text,fontFamily:"'Space Grotesk'"}}>Fiber Plant · ONUs</div>
                <div style={{fontSize:11,color:t.textMuted,marginTop:2}}>via SmartOLT{fiber.lastSync?` · synced ${new Date(fiber.lastSync).toLocaleString()}`:""}</div>
