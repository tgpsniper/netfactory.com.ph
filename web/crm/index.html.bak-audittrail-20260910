  const computeNewInvTax = (amount, taxType, taxRate) => {
    const amt = parseFloat(String(amount).replace(/,/g,'')) || 0;
    let tax = 0, total = amt;
    if (taxType === 'exclusive') { tax = Math.round(amt * taxRate * 100) / 100; total = amt + tax; }
    else if (taxType === 'inclusive' && taxRate > 0) { tax = Math.round((amt - amt / (1 + taxRate)) * 100) / 100; total = amt; }
    return { tax: tax.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}), total: total.toLocaleString('en-US',{minimumFractionDigits:2,maximumFractionDigits:2}) };
  };

  const handleNewInvChange = (field, value) => {
