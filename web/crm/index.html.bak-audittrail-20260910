  // Parse the LAST scheduled date from notes (handles reschedules)
  const parseScheduleInfo = (notes) => {
    if (!notes) return null;
    const lines = notes.split("\n");
    // Find last RESCHEDULED or INSTALLATION SCHEDULED line
    let lastLine = null;
    for (let i = lines.length - 1; i >= 0; i--) {
      if (lines[i].startsWith("RESCHEDULED:") || lines[i].startsWith("INSTALLATION SCHEDULED:")) {
        lastLine = lines[i]; break;
      }
    }
    if (!lastLine) return null;
    const isResched = lastLine.startsWith("RESCHEDULED:");
    const after = lastLine.replace(/^(RESCHEDULED:|INSTALLATION SCHEDULED:)\s*/, "");
    const isoDate = after.substring(0, 10); // YYYY-MM-DD
    const rest = after.substring(10).replace(/^\s*\|\s*/, "");
    const displayDate = rest.split("—")[0].split("(")[0].trim();
    // Extract "by Name" from parentheses
    const byMatch = lastLine.match(/\(by ([^)]+)\)/);
    const byWho = byMatch ? byMatch[1] : null;
    // Count total reschedules
    const reschedCount = lines.filter(l => l.startsWith("RESCHEDULED:")).length;
    return { isoDate, displayDate, byWho, isResched, reschedCount };
  };

  const handleRescheduleSubmit = () => {
