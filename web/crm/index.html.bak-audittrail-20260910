                      <button onClick={() => { setXuiExtendCustomDate(""); setShowXuiExtend(true); }} style={{ padding:"7px 12px", borderRadius:8, background:`${t.success}15`, color:t.success, border:`1px solid ${t.success}40`, fontSize:12, fontWeight:600, cursor:"pointer", fontFamily:"inherit" }}><i className="fas fa-calendar-plus" style={{marginRight:6}}></i>Extend / Renew</button>
