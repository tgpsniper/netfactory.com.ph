                    <div style={{ display:"flex", gap:8, marginTop:12, paddingTop:12, borderTop:`1px solid ${t.border}`, flexWrap:"wrap" }}>
                      <button onClick={() => setShowXuiDetails(true)} style={{ padding:"7px 12px", borderRadius:8, background:"transparent", color:t.text, border:`1px solid ${t.border}`, fontSize:12, fontWeight:600, cursor:"pointer", fontFamily:"inherit" }}><i className="fas fa-eye" style={{marginRight:6}}></i>View Account Details</button>
