                {(selectedSub.status !== "prospective" && selectedSub.status !== "surveyed" && selectedSub.status !== "approved" && selectedSub.status !== "declined") && <Btn onClick={() => { setTicketSearch(selectedSub.acct); setTicketFilter("all"); setShowSubModal(false); setActivePage("tickets"); }}>View Tickets</Btn>}
