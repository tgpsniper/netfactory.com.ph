        const res = await fetch(`${API_BASE}/devtools/run`, { method:'POST', headers: authH(), body: JSON.stringify({ command: btn.command, buttonId: btn.id }) });
        const data = await res.json();
        setDtResults(r => ({ ...r, [btn.id]: { running: false, ...data } }));
      } catch(e) {
        setDtResults(r => ({ ...r, [btn.id]: { running: false, success: false, stdout:'', stderr: e.message } }));
