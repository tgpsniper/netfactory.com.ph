                      <div><div style={{ color: t.textSec, fontSize: 10, textTransform: "uppercase", marginBottom: 2, fontWeight: 700 }}>Username</div><div style={{ color: t.text, fontWeight: 600, fontFamily: "monospace" }}>{xuiLine.username}</div></div>
                      <div><div style={{ color: t.textSec, fontSize: 10, textTransform: "uppercase", marginBottom: 2, fontWeight: 700 }}>Password</div><div style={{ color: t.text, fontFamily: "monospace" }}>{xuiLine.password || "—"}</div></div>
                      <div><div style={{ color: t.textSec, fontSize: 10, textTransform: "uppercase", marginBottom: 2, fontWeight: 700 }}>Reseller</div><div style={{ color: t.text }}>{xuiLine.ownerName || xuiLine.createdByName || "—"}</div></div>
                      <div><div style={{ color: t.textSec, fontSize: 10, textTransform: "uppercase", marginBottom: 2, fontWeight: 700 }}>Expires</div><div style={{ color: t.text }}>{xuiLine.noExpire ? "Never" : (xuiLine.expDate ? new Date(xuiLine.expDate).toLocaleDateString("en-PH",{year:"numeric",month:"short",day:"numeric"}) : "—")}</div></div>
                      <div><div style={{ color: t.textSec, fontSize: 10, textTransform: "uppercase", marginBottom: 2, fontWeight: 700 }}>Connections</div><div style={{ color: t.text, fontFamily: "monospace" }}>{xuiLine.maxConnections}</div></div>
