    } else {
      const prevDateStr = prevInfo.displayDate;
      note = `RESCHEDULED: ${rescheduleDate} | ${newDateStr} — REASON: ${toTitleCase(rescheduleReason.trim())} (by ${who}, was: ${prevDateStr})`;
    }
    const updatedNotes = (rescheduleModal.notes ? rescheduleModal.notes + "\n" : "") + note;
    fetch(API + "/admin/subscribers/" + rescheduleModal.id, {
      method: "PUT", headers: authHeaders(),
