  const handleGenSubInvoice = async () => {
    const amt = parseFloat(String(genSubInvForm.amount).replace(/,/g,'')) || 0;
    if (!genSubInvForm.periodFrom || !genSubInvForm.periodTo || !genSubInvForm.dueDate || amt <= 0) {
      return showToast('Period range, due date, and amount are required', 'error');
    }
    const from = new Date(genSubInvForm.periodFrom + 'T00:00:00');
    const to = new Date(genSubInvForm.periodTo + 'T00:00:00');
    if (from >= to) return showToast('Period From must be before Period To', 'error');
    // Build list of months: one invoice per month
    const months = [];
    const cur = new Date(from.getFullYear(), from.getMonth(), 1);
    const endMonth = new Date(to.getFullYear(), to.getMonth(), 1);
    while (cur <= endMonth) {
      months.push(new Date(cur));
      cur.setMonth(cur.getMonth() + 1);
    }
    if (months.length === 0) return showToast('Invalid period range', 'error');
    setGenSubInvSaving(true);
    let created = 0, errors = 0;
    for (const m of months) {
      const billingPeriod = m.toLocaleDateString('en-US', { month: 'long', year: 'numeric' });
