      }).then(r=>r.json()).catch(()=>({error:'Network error'}));
      if (res.error) errors++; else created++;
    }
    setGenSubInvSaving(false);
    if (errors > 0) showToast('Generated ' + created + ' of ' + months.length + ' invoices (' + errors + ' failed)', 'error');
