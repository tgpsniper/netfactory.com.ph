            <div style={{ padding:"20px 24px", borderBottom:`1px solid ${t.border}`, display:"flex", justifyContent:"space-between", alignItems:"center" }}>
              <div>
                <h2 style={{ fontSize:16, fontWeight:700, color:t.text, fontFamily:"'Space Grotesk'", margin:0 }}><i className="fas fa-paperclip" style={{ marginRight:8, color:t.accent }}></i>Attached Files</h2>
                <div style={{ fontSize:12, color:t.textMuted, marginTop:3 }}>{subDisplayName(selectedSub)} — {selectedSub.acct}</div>
              </div>
              <button onClick={() => setShowAttachModal(false)} style={{ background:"none", border:"none", cursor:"pointer", width:32, height:32, borderRadius:8, display:"flex", alignItems:"center", justifyContent:"center", color:t.text, fontSize:16, opacity:.7 }} onMouseEnter={e=>e.currentTarget.style.opacity=1} onMouseLeave={e=>e.currentTarget.style.opacity=.7}><i className="fas fa-xmark"></i></button>
            </div>
            {/* Body */}
            <div style={{ padding:24, display:"flex", flexDirection:"column", gap:16 }}>
              {[
                { field:"proof_of_billing", label:"Proof of Billing", icon:"fa-file-invoice" },
                { field:"valid_id1",        label:"Valid ID 1",       icon:"fa-id-card" },
                { field:"valid_id2",        label:"Valid ID 2",       icon:"fa-id-card" },
                { field:"other_attachment", label:"Other Attachment", icon:"fa-file" },
              ].map(({ field, label, icon }) => {
                const url = selectedSub[field];
                const isUploading = attachUploading === field;
                const isDeleting  = attachDeleting  === field;
                const inputId = `attach_${field}`;
                return (
                  <div key={field} style={{ background:t.bgAlt, borderRadius:12, padding:"14px 16px", border:`1px solid ${t.border}`, display:"flex", alignItems:"center", gap:12 }}>
