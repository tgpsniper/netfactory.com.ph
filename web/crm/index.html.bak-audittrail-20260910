                  </div>
                  {xuiLine && <span style={{ fontSize: 10, padding: "2px 8px", borderRadius: 10, background: xuiLine.status === "active" ? `${t.success}20` : xuiLine.status === "expired" ? `${t.warning}20` : `${t.danger}20`, color: xuiLine.status === "active" ? t.success : xuiLine.status === "expired" ? t.warning : t.danger, fontWeight: 700, textTransform: "uppercase" }}>{xuiLine.status}</span>}
