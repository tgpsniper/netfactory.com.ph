                <label style={{fontSize:12,fontWeight:600,color:t.textSec,marginBottom:8,display:"flex",alignItems:"center",gap:6}}><i className="fas fa-paperclip" style={{color:t.accent}}></i> Attachments <span style={{fontWeight:400,color:t.textMuted,fontSize:11}}>(optional)</span></label>
                <div style={{display:"flex",flexDirection:"column",gap:8}}>
                  {[
                    { field:"proof_of_billing", label:"Proof of Billing" },
                    { field:"valid_id1",        label:"Valid ID 1" },
                    { field:"valid_id2",        label:"Valid ID 2" },
                    { field:"other_attachment", label:"Other Attachment" },
                  ].map(({ field, label }) => {
                    const file = addSubAttachments[field];
                    return (
                      <div key={field} style={{display:"flex",alignItems:"center",gap:10,padding:"8px 12px",borderRadius:10,background:t.bgAlt,border:`1px solid ${file ? t.accent+"50" : t.border}`}}>
                        <i className="fas fa-file" style={{fontSize:13,color:file ? t.accent : t.textMuted,flexShrink:0}}></i>
                        <div style={{flex:1,minWidth:0}}>
                          <div style={{fontSize:11,fontWeight:600,color:t.textMuted,textTransform:"uppercase",letterSpacing:.4}}>{label}</div>
                          {file ? <div style={{fontSize:12,color:t.text,fontWeight:500,overflow:"hidden",textOverflow:"ellipsis",whiteSpace:"nowrap"}}>{file.name}</div>
                                : <div style={{fontSize:12,color:t.textMuted,fontStyle:"italic"}}>No file selected</div>}
                        </div>
                        <label htmlFor={`newattach_${field}`} style={{padding:"5px 10px",borderRadius:8,background:file ? t.bgAlt : t.accent,color:file ? t.textSec : "#fff",border:`1px solid ${file ? t.border : t.accent}`,fontSize:11,fontWeight:600,cursor:"pointer",flexShrink:0}}>
                          {file ? "Change" : "Browse"}
                        </label>
                        <input id={`newattach_${field}`} type="file" accept=".jpg,.jpeg,.png,.pdf,.webp" style={{display:"none"}}
                          onChange={e => { if(e.target.files[0]) setAddSubAttachments(a=>({...a,[field]:e.target.files[0]})); e.target.value=""; }} />
                        {file && <button onClick={() => setAddSubAttachments(a=>({...a,[field]:null}))} style={{background:"none",border:"none",color:t.danger,cursor:"pointer",fontSize:13,padding:"2px 4px",flexShrink:0}}><i className="fas fa-xmark"></i></button>}
                      </div>
                    );
                  })}
                </div>
              </div>
              <div style={{ display:"flex", gap:12, marginTop:8 }}>
