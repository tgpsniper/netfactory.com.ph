    const [busy, setBusy] = useState(false);
    const [msg, setMsg] = useState(null);   // {type:"ok"|"err", text}

    const load = () => {
      setLoading(true);
      apiFetch("/admin/tr069/subscriber/" + subId + "/device")
        .then(d => setDev(d))
        // TR-069 disabled globally answers 503; treat as "no device" so the card
        // reports plainly instead of rendering a broken control.
        .catch(() => setDev({ linked:false, device:null }))
        .finally(() => setLoading(false));
    };
    useEffect(() => { load(); }, [subId]);

    const apply = async () => {
      setMsg(null); setBusy(true);
      try {
        // Password only. The SSID is deliberately not settable from here: the two radios
        // usually carry different names ("Home" / "Home_5G"), so one SSID box would have
        // to either rename both to the same thing or silently touch only one band.
        const r = await apiFetch("/admin/tr069/devices/" + encodeURIComponent(dev.device.device_id) + "/wifi",
          { method:"POST", body: JSON.stringify(band ? { password: pass, band } : { password: pass }) });
        // Name the radios the server actually wrote to. Saying "both bands" on a
        // single-band unit would be a claim we cannot back up to the customer.
        const bands = (r && r.bands || []).map(b => b.band).filter(Boolean);
        const where = bands.length > 1 ? "both bands (" + bands.join(" + ") + ")"
                    : bands.length === 1 ? bands[0] : "the router";
        setMsg({ type:"ok", text:"Sent to " + where + ". Applies on the router's next check-in — up to 5 min." });
        setPass("");
        load();
      } catch (e) {
        setMsg({ type:"err", text: e.message || "Failed to update WiFi" });
      } finally { setBusy(false); }
    };

    const box = { background:t.bgAlt, borderRadius:14, padding:16, marginTop:12, border:`1px solid ${t.border}` };
    const title = (
      <div style={{fontSize:14, fontWeight:700, color:t.text, marginBottom:12}}>
        <i className="fas fa-wifi" style={{marginRight:8, color:t.accent}}></i>WiFi (TR-069)
      </div>
    );

    if (loading) return <div style={box}>{title}<div style={{fontSize:12, color:t.textMuted}}>Loading router…</div></div>;
    if (!dev || !dev.linked) return (
      <div style={box}>{title}
        <div style={{fontSize:12, color:t.textMuted, fontStyle:"italic", lineHeight:1.6}}>
          No TR-069 device linked to this subscriber. Link one in the TR-069 Manager to manage WiFi from here.
        </div>
      </div>
    );

    const d = dev.device;
    const cooling = d.cooldown_remaining_sec > 0;
    const input = { width:"100%", padding:"9px 12px", border:`1px solid ${t.inputBorder}`, borderRadius:10,
                    fontSize:13, background:t.input, color:t.text, fontFamily:"inherit", outline:"none" };
    return (
      <div style={box}>{title}
        <div style={{display:"flex", flexWrap:"wrap", gap:10, alignItems:"center", marginBottom:12, fontSize:12}}>
          <span style={{display:"inline-flex", alignItems:"center", gap:6, fontWeight:700,
                        color: d.online ? t.success : t.textMuted}}>
            <span style={{width:7, height:7, borderRadius:"50%", background: d.online ? t.success : t.textMuted}} />
            {d.online ? "Online" : "Offline"}
          </span>
          {/* Every radio, not just the stored wifi_ssid — that column only ever holds the
              2.4 GHz name, so staff looking at a dual-band ONU could not see the 5 GHz
              network the customer might actually be asking about. */}
          {dev.bands && dev.bands.length ? dev.bands.map(b => (
            <span key={b.index} style={{display:"inline-flex", alignItems:"center", gap:5}}>
              <span style={{color:t.textMuted}}>{b.band || "SSID"}:</span>
              <span style={{color:t.text, fontWeight:600}}>{b.ssid || "not reported yet"}</span>
            </span>
          )) : (
            <span style={{display:"inline-flex", alignItems:"center", gap:5}}>
              <span style={{color:t.textMuted}}>SSID:</span>
              <span style={{color:t.text, fontWeight:600}}>{d.wifi_ssid || "not reported yet"}</span>
            </span>
          )}
          <span style={{color:t.textMuted, fontFamily:"monospace", fontSize:11}}>
            {[d.manufacturer, d.product_class].filter(Boolean).join(" ")}
          </span>
        </div>

        {/* An offline CPE cannot take the change; queueing it silently would look like
            success to whoever is on the phone with the customer. */}
        {!d.online && (
          <div style={{fontSize:11, color:t.warning, marginBottom:10}}>
            <i className="fas fa-triangle-exclamation" style={{marginRight:6}}></i>
            Router is offline — it will not receive changes until it informs again.
          </div>
        )}
        {cooling && (
          <div style={{fontSize:11, color:t.textMuted, marginBottom:10}}>
            <i className="fas fa-clock" style={{marginRight:6}}></i>
            Cooldown active — about {Math.ceil(d.cooldown_remaining_sec / 60)} min remaining.
          </div>
        )}

        {/* Band picker is populated from the radios the ONU reported, so a single-band
            unit shows no choice at all rather than an option that would fail on apply.
            Default is every radio, which keeps the bands on one password unless the
            operator deliberately splits them. */}
        <div style={{display:"grid", gridTemplateColumns: (dev.bands && dev.bands.length > 1) ? "170px 1fr" : "1fr", gap:8, marginBottom:8}}>
          {dev.bands && dev.bands.length > 1 && (
            <select value={band} onChange={e=>setBand(e.target.value)} style={input}>
              <option value="">Both bands</option>
              {dev.bands.map(b => (
                <option key={b.index} value={b.band && b.band.indexOf("5") === 0 ? "5" : "2.4"}>
                  {b.band}{b.ssid ? " — " + b.ssid : ""}
                </option>
