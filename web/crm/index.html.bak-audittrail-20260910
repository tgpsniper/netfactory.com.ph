                {selectedSub.status === "prospective" && <Btn danger onClick={() => { setDeclineForm({reasons:[],customNote:""}); setShowDeclineModal(selectedSub); }}>Decline</Btn>}
                {selectedSub.status === "surveyed" && <Btn primary style={{background:"#8b5cf6",borderColor:"#8b5cf6"}} onClick={() => openSurveyModal(selectedSub, "approved")}><i className="fas fa-check" style={{marginRight:4}}></i> Survey Approve</Btn>}
                {selectedSub.status === "surveyed" && <Btn danger onClick={() => openSurveyModal(selectedSub, "declined")}><i className="fas fa-xmark" style={{marginRight:4}}></i> Survey Decline</Btn>}
                {selectedSub.status === "declined" && <Btn primary onClick={() => handleSubAction(selectedSub.id, "reopen")}>Reopen Application</Btn>}
                {selectedSub.status === "approved" && <Btn primary onClick={() => handleSubAction(selectedSub.id, "schedule_install")}>Schedule Installation</Btn>}
                {selectedSub.status === "pending" && <Btn primary onClick={() => handleSubAction(selectedSub.id, "activate")}>Mark as Installed</Btn>}
                {selectedSub.status === "active" && <Btn danger onClick={() => handleSubAction(selectedSub.id, "suspend")}>Suspend Account</Btn>}
                {selectedSub.status === "suspended" && <Btn primary onClick={() => handleSubAction(selectedSub.id, "reconnect")}>Reconnect</Btn>}
                {selectedSub.status === "disconnected" && <Btn primary onClick={() => handleSubAction(selectedSub.id, "reconnect")}>Reconnect</Btn>}
              </div>
            </div>
          </div>
        </div>
      )}

      {/* ========== SUBSCRIBER ATTACHMENTS MODAL ========== */}
      {showAttachModal && selectedSub && (
        <div style={{ position:"fixed", inset:0, background:"rgba(0,0,0,.65)", backdropFilter:"blur(6px)", zIndex:9999, display:"flex", alignItems:"center", justifyContent:"center", padding:16 }}>
          <div style={{ background:t.bgCard, borderRadius:20, width:"100%", maxWidth:560, boxShadow:"0 40px 80px rgba(0,0,0,.35)", border:`1px solid ${t.border}` }}>
