                <Btn primary onClick={() => {
                  const _em = (addSubForm.email||"").trim();
                  if (_em && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(_em)) { showToast("Invalid email format", "error"); return; }
                  // A manual number has to survive verification first — the server
                  // re-checks it anyway, but failing here says why, in the field.
                  if (addAcctMode === "manual") {
                    if (!addAcctNumber.trim()) { showToast("Enter an account number, or switch to automatic", "error"); return; }
                    if (addAcctCheck && addAcctCheck.blocking) {
                      showToast(addAcctCheck.checks.find(c=>c.level==="block").title, "error"); return;
                    }
                  }
                  fetch(`${API}/admin/subscribers`,{method:"POST",headers:authHeaders(),body:JSON.stringify({...addSubForm, firstName:toTitleCase(addSubForm.firstName)||null, middleName:toTitleCase(addSubForm.middleName||"") || null, lastName:toTitleCase(addSubForm.lastName)||null, companyName:addSubForm.companyName?.trim()||null, email:(addSubForm.email||"").toLowerCase(), address:toTitleCase(addSubForm.address), subdivision:toTitleCase(addSubForm.subdivision||"") || null, phone:(addSubForm.phone||""), municipalityId: muniIdMap[addSubForm.municipality]||null, installationPackage:addSubForm.installationPackage||"A",
                    // Empty means "let the database assign the next one".
                    accountNumber: addAcctMode==="manual" ? addAcctNumber.trim() : "",
                    advanceSequence: addAcctMode==="manual" && addAcctAdvance})})
                  .then(r=>r.json()).then(async data=>{
                    if(data.subscriber||data.accountNumber||data.id){
                      const subId = data.subscriber?.id || data.id;
                      // Upload any selected attachments
                      if (subId) {
                        const fields = ['proof_of_billing','valid_id1','valid_id2','other_attachment'];
                        for (const f of fields) {
                          if (addSubAttachments[f]) {
                            try {
                              const form = new FormData();
                              form.append("file", addSubAttachments[f]);
                              form.append("field", f);
                              await fetch(`${API}/admin/subscribers/${subId}/attachments`, { method:"POST", credentials:"include", body:form });
                            } catch(e) { /* non-fatal */ }
                          }
                        }
                      }
                      fetchCrmData();
                      setShowAddSub(false);
                      setAddSubForm({firstName:"",lastName:"",companyName:"",email:"",phone:"",address:"",barangay:"",barangayId:null,municipality:"",planId:3,status:"pending"});
                      setAddSubAttachments({proof_of_billing:null,valid_id1:null,valid_id2:null,other_attachment:null});
                    } else { showConfirm({ icon:"fa-circle-xmark", title:"Save Failed", message:data.error||"Failed to save subscriber", confirmText:"OK", confirmColor:"primary", onConfirm:()=>setShowConfirmModal(null) }); }
                  }).catch(()=>showConfirm({ icon:"fa-circle-xmark", title:"Error", message:"Network error", confirmText:"OK", confirmColor:"primary", onConfirm:()=>setShowConfirmModal(null) }));
                }} style={{ flex:2, justifyContent:"center" }}>Save Subscriber</Btn>
              </div>
            </div>
          </div>
        </div>
      )}

