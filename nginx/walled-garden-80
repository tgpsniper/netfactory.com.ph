# ============================================================
# walled-garden-80 — the captive portal, served on the intercepted connection
# ============================================================
# The access routers dst-nat port 80 from nf-restricted to this host, so an
# intercepted request arrives here already on a path that demonstrably works.
#
# This used to answer every such request with:
#     return 302 https://netfactory.com.ph/restricted/;
# which threw that working connection away and told the phone to open a new one to
# the PUBLIC address over HTTPS. The 302 itself was always delivered — it travels
# back down the port-80 path the router had already rewritten to 10.0.98.4 — but the
# second connection only succeeded from some subnets. Measured over one day:
#
#   100.67.0.x    1901 redirects -> 363 portal loads
#   100.65.32.x   3082 redirects -> 216 portal loads
#   100.64.104.x  1989 redirects ->  39 portal loads
#   100.64.96.x    482 redirects ->   0      <- never once
#   100.64.120.x    95 redirects ->   0      <- never once
#   100.66.48.x      5 redirects ->   0      <- never once
#
# 100.64.96.x sends dozens of Android generate_204 probes, which do follow redirects,
# so those zeros are failures to arrive, not absence of attempts. Customers on three
# subnets were redirected correctly and then sent somewhere they cannot reach.
#
# So the portal is served HERE now. The redirect below is relative — same host, same
# scheme, same port — so the browser stays on the connection the router already
# guarantees, and nothing depends on the client reaching 36.50.30.102:443.
#
# Scanners still get 444 on every path: the source-address split in
# conf.d/nf-garden-clients.conf decides which audience a request belongs to, because
# a captive probe can carry whatever Host header it likes.
# ============================================================
server {
    listen 80;
    listen [::]:80;
    server_name
        connectivitycheck.gstatic.com
        connectivitycheck.android.com
        android.clients.google.com
        clients3.google.com
        clients1.google.com
        captive.apple.com
        gsp1.apple.com
        www.msftconnecttest.com
        ipv6.msftconnecttest.com
        www.msftncsi.com
        dns.msftncsi.com
        detectportal.firefox.com
        nmcheck.gnome.org
        network-test.debian.org
        connectivity-check.ubuntu.com
        ~^.*$;

    access_log /var/log/nginx/walled-garden-access.log combined if=$nf_garden_client;
    access_log /var/log/nginx/catchall-access.log      combined if=$nf_garden_scanner;

    # Anything that is not a customer pool gets nothing, on every path.
    if ($nf_garden_scanner) { return 444; }

    root /var/www/netfactory.com.ph/html;
    client_max_body_size 2m;

    # The portal itself.
    location ^~ /restricted/ {
        try_files $uri $uri/ /restricted/index.html;
    }

    # Its logo. The page renders without it, but a broken image on a payment page
    # reads as a broken page.
    location ^~ /uploads/ {
        try_files $uri =404;
    }

    # Status and the pay button. Same upstream the main vhost uses.
    location ^~ /api/restricted/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Everything else a restricted customer asks for. Relative on purpose — see above.
    location / {
        return 302 /restricted/;
    }
}
